module Format.Gren exposing (formatPackage, significantTokens)

{-| Run gilramir/gren-format on a generated package directory.

The formatter is the community reimplementation of `gren format` (official CLI
format was removed in Gren 0.5). It must be invoked with the package root as
cwd so it discovers `gren.json` and walks every source directory.

After formatting, a small Node post-pass collapses multi-line pure-field record
patterns back to single-line form. Gren accepts multi-line record *expressions*
but rejects multi-line pure-field record *patterns* (`{ a\\n, b\\n }`).

**Law (formatting is layout only).** A pretty-printer's whole licence over a
file is whitespace, blank lines and redundant parentheses; `significantTokens`
is exactly that licence written down. The host holds the pre-format text of
every module exactly, so a file whose significant tokens the tool chain changed
is restored from ours rather than shipped. D70: the vendored formatter matches
the `as` keyword without a word boundary and rewrote `infixOperator fn opParser
assoc` into `infixOperator fn (opParser as soc)`, deleting a binder and leaving
a module that cannot compile. Unformatted-but-correct is already the standing
preference here (see the `Task.onError` below); this extends it from "the tool
failed" to "the tool lied".
-}

import Array exposing (Array)
import ChildProcess
import Dict
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Node
import Port.Error as PortError exposing (Error)
import System.File
import System.Process
import Task exposing (Task)


formatPackage
    : Node.Platform
    -> FileSystem.Permission
    -> ChildProcess.Permission
    ->
        { packageDirectory : Path
        , formatExecutable : String
        }
    -> Task Error {}
formatPackage platform fileSystem permission options =
    readSources fileSystem options.packageDirectory
        |> Task.andThen
            (\before ->
                runFormatter platform permission options
                    |> Task.andThen (\_ -> restoreRewritten fileSystem before)
            )


runFormatter
    : Node.Platform
    -> ChildProcess.Permission
    ->
        { packageDirectory : Path
        , formatExecutable : String
        }
    -> Task Error {}
runFormatter platform permission options =
    let
        cwd =
            System.File.pathToString platform options.packageDirectory

        -- The vendored app is a Node script with a shebang. Spawn through
        -- node so Windows (no shebang) and Linux share one path.
        program =
            "node"

        arguments =
            [ options.formatExecutable ]

        collapseScript =
            collapseRecordPatternsScript options.formatExecutable
    in
    System.Process.run permission
        { program = program
        , arguments = arguments
        , workingDirectory = cwd
        , environment = Dict.empty
        , allowedExitCodes = [ 0 ]
        , timeoutMilliseconds = 10 * 60 * 1000
        , maximumOutputBytes = 16 * 1024 * 1024
        }
        |> Task.map (\_ -> {})
        -- Best-effort: formatter bugs (non-idempotent pretty, partial syntax
        -- coverage) must not fail an otherwise valid port. Unformatted but
        -- verified Gren is preferred to a hard FORMAT_FAILED.
        |> Task.onError (\_ -> Task.succeed {})
        |> Task.andThen
            (\_ ->
                System.Process.run permission
                    { program = program
                    , arguments = [ collapseScript, cwd ]
                    , workingDirectory = cwd
                    , environment = Dict.empty
                    , allowedExitCodes = [ 0 ]
                    , timeoutMilliseconds = 60 * 1000
                    , maximumOutputBytes = 4 * 1024 * 1024
                    }
                    |> Task.map (\_ -> {})
                    |> Task.onError (\_ -> Task.succeed {})
            )


{-| Every `.gren` file under the package with the text we wrote. I/O failures
yield an empty snapshot: the guard is a safety net over an optional tool, never
a reason to fail a port.
-}
readSources :
    FileSystem.Permission
    -> Path
    -> Task Error (Array { path : Path, text : String })
readSources permission packageDirectory =
    System.File.listFilesRecursively permission packageDirectory
        |> Task.map (Array.keepIf isGrenSource)
        |> Task.andThen
            (\paths ->
                Array.foldl
                    (\path pending ->
                        pending
                            |> Task.andThen
                                (\found ->
                                    System.File.readText permission path
                                        |> Task.map
                                            (\text ->
                                                Array.pushLast
                                                    { path = path, text = text }
                                                    found
                                            )
                                        |> Task.onError (\_ -> Task.succeed found)
                                )
                    )
                    (Task.succeed [])
                    paths
            )
        |> Task.onError (\_ -> Task.succeed [])


{-| Put back every file whose significant tokens the tool chain changed.
-}
restoreRewritten :
    FileSystem.Permission
    -> Array { path : Path, text : String }
    -> Task Error {}
restoreRewritten permission before =
    Array.foldl
        (\entry pending ->
            pending
                |> Task.andThen
                    (\_ ->
                        System.File.readText permission entry.path
                            |> Task.andThen
                                (\after ->
                                    if
                                        significantTokens after
                                            == significantTokens entry.text
                                    then
                                        Task.succeed {}

                                    else
                                        System.File.writeText permission
                                            entry.path
                                            entry.text
                                            |> Task.map (\_ -> {})
                                )
                            |> Task.onError (\_ -> Task.succeed {})
                    )
        )
        (Task.succeed {})
        before


isGrenSource : Path -> Bool
isGrenSource path =
    String.endsWith ".gren" (Path.toPosixString path)


{-| The formatter's licence, written down: whitespace, blank lines and
parentheses. Everything else — identifiers, keywords, literals, commas,
operators, braces, brackets — must survive formatting unchanged, so the token
string is a total order-preserving fingerprint of a file's meaning under that
licence. Parentheses are dropped because a pretty-printer legitimately removes
redundant grouping (`Composite ({ … })` → `Composite { … }`); nothing else it
does to a `.gren` file is legitimate.
-}
significantTokens : String -> String
significantTokens source =
    String.foldl collectToken { tokens = [], current = "" } source
        |> flushToken
        |> .tokens
        |> String.join " "


type alias TokenState =
    { tokens : Array String
    , current : String
    }


collectToken : Char -> TokenState -> TokenState
collectToken char state =
    if isWordChar char then
        { state | current = state.current ++ String.fromChar char }

    else if char == '(' || char == ')' || isLayout char then
        flushToken state

    else
        let
            flushed =
                flushToken state
        in
        { flushed
            | tokens = Array.pushLast (String.fromChar char) flushed.tokens
        }


flushToken : TokenState -> TokenState
flushToken state =
    if String.isEmpty state.current then
        state

    else
        { tokens = Array.pushLast state.current state.tokens
        , current = ""
        }


isWordChar : Char -> Bool
isWordChar char =
    Char.isAlphaNum char || char == '_' || char == '\''


isLayout : Char -> Bool
isLayout char =
    char == ' ' || char == '\t' || char == '\n' || char == '\r'


{-| Resolve the collapse helper next to the vendored format app.
-}
collapseRecordPatternsScript : String -> String
collapseRecordPatternsScript formatExecutable =
    let
        normalized =
            String.replace "\\" "/" formatExecutable

        marker =
            "/tools/gren-format/"

        idx =
            String.indices marker normalized
                |> Array.first
    in
    when idx is
        Just i ->
            String.slice 0 (i + String.count marker) normalized
                ++ "collapse-record-patterns.cjs"

        Nothing ->
            -- Fallback: sibling of the format executable.
            let
                slashes =
                    String.indices "/" normalized

                slash =
                    if Array.isEmpty slashes then
                        -1

                    else
                        Array.get (Array.length slashes - 1) slashes
                            |> Maybe.withDefault -1
            in
            if slash < 0 then
                "collapse-record-patterns.cjs"

            else
                String.slice 0 (slash + 1) normalized
                    ++ "collapse-record-patterns.cjs"
