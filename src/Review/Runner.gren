module Review.Runner exposing (Options, elmSourceBytes, extractionBudgetMs, loadCachedExtraction, run)

{-| Run elm-review extract for a package.

Caches the compiled review application under `reviewAppCache` so multi-package
ports (and prove scripts) pay the ~3–20s compile once per rule version, not
once per package tree.
-}

import Bytes exposing (Bytes)
import ChildProcess
import Dict
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Node
import Port.Error as PortError exposing (Error)
import Review.ExtractCache as ExtractCache
import Review.Protocol as Protocol exposing (Extraction)
import Stream exposing (Writable)
import Stream.Log
import System.File
import System.Process
import Task exposing (Task)


type alias Options =
    { packageRoot : Path
    , elmJson : Path
    , reviewConfig : Path
    , executable : String
    , elmHome : Maybe Path
    , files : Array String
    , offline : Bool
    , -- Shared cache of elm-review's generated CLI app (cli/2.13.5 tree).
      -- Nothing disables seeding/saving.
      reviewAppCache : Maybe Path
    , -- Content-addressed cache of the extraction result. `Just` for immutable
      -- registry packages when caching is enabled; `Nothing` bypasses (local
      -- paths, `--no-extract-cache`) and always shells out to elm-review.
      extractCache : Maybe ExtractCache.Key
    , -- D82: canonical digest of the dependency versions this extract run is
      -- pinned to (from Review.DependencyPins.digest). Part of the extract-
      -- cache key so a skew-era entry cannot be reused after pins change.
      dependencyPinsDigest : String
    , -- Progress sink for the honest "(extract cached)" note on a cache hit.
      logStream : Maybe (Writable Bytes)
    , fileSystem : FileSystem.Permission
    , -- D93: total bytes of Elm source elm-review is about to parse. The
      -- extraction budget scales with it — see `extractionBudgetMs`.
      sourceBytes : Int
    }


{-| Relative path where elm-review stores its compiled app for a project.
Version segment tracks the elm-review dependency used by this repo. Used only
as an extract-cache digest marker; the seed/save copy is version-agnostic
(see `reviewCliParentRelative`) so it survives elm-review app-version drift.
-}
reviewCliRelative : String
reviewCliRelative =
    "elm-stuff/generated-code/jfmengels/elm-review/cli/2.13.5"


{-| Parent of elm-review's per-version generated CLI app. elm-review names the
segment underneath (e.g. `2.13.4`) after its OWN package version, which is not
the `elm-review --version` string and drifts independently. Seeding/saving the
review-app cache at this parent level copies whatever version dir exists, so a
version mismatch can no longer silently defeat the cache (which forced every
cold package to recompile the review app from scratch under the D30 lock).
-}
reviewCliParentRelative : String
reviewCliParentRelative =
    "elm-stuff/generated-code/jfmengels/elm-review/cli"


run : Node.Platform -> ChildProcess.Permission -> Options -> Task Error Extraction
run platform childProcess options =
    when options.extractCache is
        Nothing ->
            -- Bypass: local-path input or caching disabled. Always shell out.
            runFresh platform childProcess options
                |> Task.map .extraction

        Just key ->
            ExtractCache.digestFor
                options.fileSystem
                options.reviewConfig
                reviewCliRelative
                options.files
                options.dependencyPinsDigest
                |> Task.andThen
                    (\digestHex ->
                        if String.isEmpty digestHex then
                            -- Digest ingredients unreadable: port without caching.
                            runFresh platform childProcess options
                                |> Task.map .extraction

                        else
                            let
                                cachePath =
                                    ExtractCache.cacheFilePath key.cacheRoot key.coordinate digestHex
                            in
                            ExtractCache.load options.fileSystem cachePath
                                |> Task.andThen
                                    (\cached ->
                                        when cached is
                                            Just extraction ->
                                                -- Cache hit: return WITHOUT taking the D30
                                                -- compile lock. Skipping serialization is the
                                                -- entire point of the extract cache.
                                                logCached options key.coordinate
                                                    |> Task.map (\_ -> extraction)

                                            Nothing ->
                                                runFresh platform childProcess options
                                                    |> Task.andThen
                                                        (\result ->
                                                            ExtractCache.store options.fileSystem cachePath result.stdout
                                                                |> Task.map (\_ -> result.extraction)
                                                        )
                                    )
                    )


{-| D45: read a package's cached extraction WITHOUT ever shelling out (returns
Nothing on any miss). Used by the orchestrator to recover dependency ctor
arities when the ported-dependency cache already served the transformed tree
and the normal extract step was skipped.
-}
loadCachedExtraction :
    FileSystem.Permission
    -> Path
    -> Array String
    -> String
    -> ExtractCache.Key
    -> Task x (Maybe Extraction)
loadCachedExtraction fileSystem reviewConfig files dependencyPinsDigest key =
    ExtractCache.digestFor fileSystem reviewConfig reviewCliRelative files dependencyPinsDigest
        |> Task.andThen
            (\digestHex ->
                if String.isEmpty digestHex then
                    Task.succeed Nothing

                else
                    ExtractCache.load fileSystem
                        (ExtractCache.cacheFilePath key.cacheRoot key.coordinate digestHex)
            )


{-| Cold extraction: seed the shared review app, shell out under the D30 compile
lock, then save the app. Returns the decoded extraction together with the raw
(noise-stripped) stdout so a caller may persist it in the extraction cache.
-}
runFresh :
    Node.Platform
    -> ChildProcess.Permission
    -> Options
    -> Task Error { extraction : Extraction, stdout : String }
runFresh platform childProcess options =
    withCompileLock platform childProcess options


logCached : Options -> ExtractCache.Coordinate -> Task x {}
logCached options coordinate =
    when options.logStream is
        Nothing ->
            Task.succeed {}

        Just stream ->
            Stream.Log.line stream (ExtractCache.coordinateLabel coordinate ++ " (extract cached)")


{-| D30: concurrent elm-review invocations recompile dep-set variant apps in
shared caches and race — elm emits non-JSON errors and elm-review crashes.
One retry cannot escape a sustained contention window, so extraction is
SERIALIZED machine-wide via an atomic mkdir spinlock next to the shared
review-app cache. The extract cache makes most entries skip this entirely.

D32: seed (shared→local) and save (local→shared) also run INSIDE the lock.
Unlocked cp -a of the shared tree let a save tear a concurrent seed; the
torn tree then poisoned every later cold package deterministically (gate
v5: 23 consecutive "is not valid JSON" fails from package 179 on).
-}
withCompileLock : Node.Platform -> ChildProcess.Permission -> Options -> Task Error { extraction : Extraction, stdout : String }
withCompileLock platform childProcess options =
    when options.reviewAppCache is
        Nothing ->
            invokeReviewHealing platform childProcess options

        Just cacheRoot ->
            let
                lockDir =
                    System.File.pathToString platform cacheRoot ++ ".extract-lock"

                acquire =
                    System.Process.run childProcess
                        { program = "bash"
                        , arguments =
                            [ "-c"
                            , -- D93b: every constant here is derived from
                              -- `lockHoldSeconds` so the lock can never again be
                              -- shorter than the work it protects. A killed holder
                              -- (harness reaping, ^C) never runs release, so a lock
                              -- older than the longest legitimate hold is stolen.
                              lockScript
                            , "elm-to-gren-extract-lock"
                            , lockDir
                            ]
                        , workingDirectory = "."
                        , environment = Dict.empty
                        , allowedExitCodes = [ 0 ]
                        , timeoutMilliseconds = lockHoldSeconds * 1000
                        , maximumOutputBytes = 4096
                        }

                release =
                    System.Process.run childProcess
                        { program = "bash"
                        , arguments =
                            [ "-c"
                            , "rmdir \"$1\" 2>/dev/null || true"
                            , "elm-to-gren-extract-unlock"
                            , lockDir
                            ]
                        , workingDirectory = "."
                        , environment = Dict.empty
                        , allowedExitCodes = [ 0 ]
                        , timeoutMilliseconds = 10 * 1000
                        , maximumOutputBytes = 4096
                        }
            in
            acquire
                |> Task.mapError (\_ -> PortError.create "EXTRACT_LOCK" "Timed out waiting for the extraction lock.")
                |> Task.andThen
                    (\_ ->
                        seedReviewApp platform childProcess options
                            |> Task.andThen (\_ -> invokeReviewHealing platform childProcess options)
                            |> Task.andThen
                                (\result ->
                                    saveReviewApp platform childProcess options
                                        |> Task.map (\_ -> result)
                                )
                            |> Task.andThen
                                (\result ->
                                    release |> Task.map (\_ -> result)
                                )
                            |> Task.onError
                                (\reviewError ->
                                    release
                                        |> Task.andThen (\_ -> Task.fail reviewError)
                                        |> Task.onError (\_ -> Task.fail reviewError)
                                )
                    )


{-| D33 auto-heal: a kill mid-extraction can truncate compiler cache files
inside the package's persistent elm-stuff (registry cache source trees keep
it between runs). elm then errors with mixed art+JSON that elm-review's
JSON.parse chokes on — deterministically, forever. On that signature, purge
the package's elm-stuff and retry once.
-}
invokeReviewHealing : Node.Platform -> ChildProcess.Permission -> Options -> Task Error { extraction : Extraction, stdout : String }
invokeReviewHealing platform childProcess options =
    invokeReview platform childProcess options
        |> Task.onError
            (\error ->
                if String.contains "is not valid JSON" (PortError.toString error) then
                    purgeLocalElmStuff platform childProcess options
                        |> Task.andThen (\_ -> invokeReview platform childProcess options)

                else
                    Task.fail error
            )


purgeLocalElmStuff : Node.Platform -> ChildProcess.Permission -> Options -> Task Error {}
purgeLocalElmStuff platform childProcess options =
    System.Process.run childProcess
        { program = "rm"
        , arguments =
            [ "-rf"
            , System.File.pathToString platform options.packageRoot ++ "/elm-stuff"
            ]
        , workingDirectory = "."
        , environment = Dict.empty
        , allowedExitCodes = [ 0 ]
        , timeoutMilliseconds = 60 * 1000
        , maximumOutputBytes = 4096
        }
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


invokeReview : Node.Platform -> ChildProcess.Permission -> Options -> Task Error { extraction : Extraction, stdout : String }
invokeReview platform childProcess options =
    let
        baseArguments =
            Array.append options.files
                [ "--elmjson"
                , System.File.pathToString platform options.elmJson
                , "--config"
                , System.File.pathToString platform options.reviewConfig
                , "--report=json"
                , "--extract"
                , "--no-color"

                -- D26: elm-review 2.13.5's JS optimizer splices exact-string
                -- patches into the compiled review app; against elm 0.19.1-6
                -- output one splice deletes a span mid-file (SyntaxError) for
                -- some dep-set variants. --debug skips the optimizer entirely;
                -- we only extract JSON, so app speed is irrelevant.
                , "--debug"
                ]

        arguments =
            if options.offline then
                Array.pushLast "--offline" baseArguments

            else
                baseArguments

        environment =
            when options.elmHome is
                Nothing ->
                    Dict.empty

                Just elmHome ->
                    Dict.singleton "ELM_HOME" (System.File.pathToString platform elmHome)
    in
    System.Process.run childProcess
        { program = options.executable
        , arguments = arguments
        , workingDirectory = System.File.pathToString platform options.packageRoot
        , environment = environment
        , allowedExitCodes = [ 0, 1 ]
        , timeoutMilliseconds = extractionBudgetMs options.sourceBytes
        , -- D54: the whole resolved AST of the package arrives on stdout, and
          -- 64MB was not enough for generated-code packages (Chadtech/elm-vector
          -- died with ERR_CHILD_PROCESS_STDIO_MAXBUFFER, banked as a bare
          -- `exit-1`). Proper fix is to have the extractor write to a file
          -- instead of a pipe; until then the ceiling is generous.
          maximumOutputBytes = 256 * 1024 * 1024
        }
        |> Task.andThen
            (\output ->
                let
                    cleaned =
                        dropLeadingNoise output.stdout
                in
                when Protocol.decode cleaned is
                    Ok extraction ->
                        Task.succeed { extraction = extraction, stdout = cleaned }

                    Err error ->
                        let
                            stderr =
                                String.trim output.stderr

                            enriched =
                                if String.isEmpty stderr then
                                    error

                                else
                                    PortError.withHint ("elm-review stderr:\n" ++ stderr) error
                        in
                        Task.fail enriched
            )


{-| elm-review under --debug (D26) prints progress lines to stdout before the
JSON report. The report is the first line opening a JSON object; drop
everything above it.
-}
dropLeadingNoise : String -> String
dropLeadingNoise stdout =
    let
        lines =
            String.split "\n" stdout

        noiseCount =
            Array.foldl
                (\line state ->
                    if state.done then
                        state

                    else if String.startsWith "{" (String.trimLeft line) then
                        { state | done = True }

                    else
                        { done = False, count = state.count + 1 }
                )
                { done = False, count = 0 }
                lines
    in
    lines
        |> Array.dropFirst noiseCount.count
        |> String.join "\n"


seedReviewApp : Node.Platform -> ChildProcess.Permission -> Options -> Task Error {}
seedReviewApp platform childProcess options =
    when options.reviewAppCache is
        Nothing ->
            Task.succeed {}

        Just cacheRoot ->
            let
                shared =
                    Path.join [ cacheRoot, Path.fromPosixString reviewCliParentRelative ]

                destination =
                    Path.join [ options.packageRoot, Path.fromPosixString reviewCliParentRelative ]
            in
            hasReviewApp platform childProcess shared
                |> Task.andThen
                    (\sharedReady ->
                        if not sharedReady then
                            Task.succeed {}

                        else
                            hasReviewApp platform childProcess destination
                                |> Task.andThen
                                    (\already ->
                                        if already then
                                            Task.succeed {}

                                        else
                                            -- Fast path: native recursive copy (~ms) instead of
                                            -- per-file Gren copies of the whole review app tree.
                                            System.File.ensureDirectory options.fileSystem destination
                                                |> Task.andThen
                                                    (\_ ->
                                                        shellCopyTree platform childProcess shared destination
                                                    )
                                    )
                    )


saveReviewApp : Node.Platform -> ChildProcess.Permission -> Options -> Task Error {}
saveReviewApp platform childProcess options =
    when options.reviewAppCache is
        Nothing ->
            Task.succeed {}

        Just cacheRoot ->
            let
                source =
                    Path.join [ options.packageRoot, Path.fromPosixString reviewCliParentRelative ]

                shared =
                    Path.join [ cacheRoot, Path.fromPosixString reviewCliParentRelative ]
            in
            hasReviewApp platform childProcess source
                |> Task.andThen
                    (\ready ->
                        if not ready then
                            Task.succeed {}

                        else
                            System.File.ensureDirectory options.fileSystem shared
                                |> Task.andThen
                                    (\_ ->
                                        shellCopyTree platform childProcess source shared
                                    )
                    )


{-| True when `root` (an `…/elm-review/cli` parent) holds a compiled review app
for ANY elm-review app-version. elm-review names the version dir after its own
package version, which differs from `elm-review --version`, so we discover the
app by presence rather than assume a fixed segment. Missing dir / error → False
(cold-build path). Uses `find` to stay consistent with the shell tree ops here.
-}
hasReviewApp : Node.Platform -> ChildProcess.Permission -> Path -> Task x Bool
hasReviewApp platform childProcess root =
    System.Process.run childProcess
        { program = "bash"
        , arguments =
            [ "-c"
            , "find \"$1\" -type d -name review-applications -print -quit 2>/dev/null"
            , "elm-to-gren-find-review-app"
            , System.File.pathToString platform root
            ]
        , workingDirectory = "."
        , environment = Dict.empty
        , allowedExitCodes = [ 0, 1 ]
        , timeoutMilliseconds = 10 * 1000
        , maximumOutputBytes = 65536
        }
        |> Task.map (\output -> not (String.isEmpty (String.trim output.stdout)))
        |> Task.onError (\_ -> Task.succeed False)


{-| Best-effort `cp -a source/. dest/`. Failures are swallowed so review can cold-build.
-}
shellCopyTree : Node.Platform -> ChildProcess.Permission -> Path -> Path -> Task Error {}
shellCopyTree platform childProcess source destination =
    let
        src =
            System.File.pathToString platform source ++ "/."

        dest =
            System.File.pathToString platform destination
    in
    System.Process.run childProcess
        { program = "cp"
        , arguments = [ "-a", src, dest ]
        , workingDirectory = System.File.pathToString platform destination
        , environment = Dict.empty
        , allowedExitCodes = [ 0 ]
        , timeoutMilliseconds = 60 * 1000
        , maximumOutputBytes = 1024 * 1024
        }
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| D93: how long elm-review may take, as a function of how much source it
has to read.

The budget was a flat ten minutes. `SiriusStarr/elm-password-strength` ships
`Internal/Zxcvbn/FrequencyLists.elm`, a 2.9 MB generated word list, and
elm-review is still parsing it when the ten minutes are up; the child is
killed and reports no exit code at all, which reached the ledger as
`PROCESS_FAILED: elm-review exited with code null` — a timeout wearing a
crash's clothes.

A fixed cap cannot serve both a 30 KB package and a 3 MB one. Ten minutes
stays the floor, so nothing that passes today gets a shorter budget, and
each further megabyte buys another fifteen. The hour ceiling keeps a
genuinely wedged run from holding a walk slot forever.
-}
extractionBudgetMs : Int -> Int
extractionBudgetMs sourceBytes =
    let
        megabytes =
            sourceBytes // (1024 * 1024)

        minutes =
            10 + (15 * megabytes)
    in
    min 60 minutes * 60 * 1000


{-| Total bytes of Elm source under the staged source directories. -}
elmSourceBytes : FileSystem.Permission -> Path -> Array String -> Task Error Int
elmSourceBytes fileSystem packageRoot directories =
    directories
        |> Array.foldl
            (\directory pending ->
                pending
                    |> Task.andThen
                        (\runningTotal ->
                            System.File.listFilesRecursively fileSystem
                                (Path.join [ packageRoot, Path.fromPosixString directory ])
                                |> Task.onError (\_ -> Task.succeed [])
                                |> Task.andThen
                                    (\files ->
                                        files
                                            |> Array.keepIf
                                                (\file -> String.toLower file.extension == "elm")
                                            |> Array.foldl
                                                (\file inner ->
                                                    inner
                                                        |> Task.andThen
                                                            (\subtotal ->
                                                                FileSystem.metadata fileSystem
                                                                    { resolveLink = True }
                                                                    file
                                                                    |> Task.map
                                                                        (\meta -> subtotal + meta.byteSize)
                                                                    |> Task.onError
                                                                        (\_ -> Task.succeed subtotal)
                                                            )
                                                )
                                                (Task.succeed runningTotal)
                                    )
                        )
            )
            (Task.succeed 0)


{-| D93b: how long a worker may hold, or wait for, the extraction lock.

The lock's three constants — spin count, steal threshold, and the acquire
process's own timeout — were all derived from a flat 600s extraction budget.
D93 made that budget scale to as much as an hour and left these behind, so
one 2.9 MB package holding the lock for 55 minutes starved every worker
queued behind it: `abradley2/edn-parser` and
`arowM/elm-html-extra-internal` both banked `EXTRACT_LOCK: Timed out
waiting for the extraction lock` in a walk where nothing was actually wrong
with them.

They are now all derived from this one number, which is the largest budget
`extractionBudgetMs` can hand out plus room for release, so the lock can
never again be shorter than the work it protects.
-}
lockHoldSeconds : Int
lockHoldSeconds =
    (60 * 60) + 300


{-| The acquire spinlock, parameterised by `lockHoldSeconds`. -}
lockScript : String
lockScript =
    let
        iterations =
            String.fromInt (lockHoldSeconds * 5)

        steal =
            String.fromInt lockHoldSeconds
    in
    "lock_dir=$1; for i in $(seq 1 "
        ++ iterations
        ++ "); do if mkdir \"$lock_dir\" 2>/dev/null; then exit 0; fi; m=$(stat -f %m \"$lock_dir\" 2>/dev/null || stat -c %Y \"$lock_dir\" 2>/dev/null || echo 0); n=$(date +%s); if [ \"$m\" -gt 0 ] && [ $((n - m)) -gt "
        ++ steal
        ++ " ]; then rmdir \"$lock_dir\" 2>/dev/null; fi; sleep 0.2; done; exit 1"
