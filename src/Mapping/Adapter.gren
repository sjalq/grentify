import Mapping.Adapter.Source.VirtualDomKeyed as VirtualDomKeyedSource
import Mapping.Types exposing (AdapterId(..), GeneratedModule, ModuleMapping, TranslationGuarantee(..), adapterIdName, weakestGuarantee)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))


type AdapterError
    = UnknownAdapter
        { requirement : String
        , available : Array String
        }


{-| Stable human text for adapter failures. Port layers wrap this with their
`INVALID_MAPPING` code so Graph and Orchestrator cannot drift on wording.
-}
errorMessage : AdapterError -> String
errorMessage adapterError =
    when adapterError is
        UnknownAdapter details ->
            "Unknown compatibility adapter "
                ++ details.requirement
                ++ ". Available adapters: "
                ++ String.join ", " details.available
                ++ "."


prefix : String
prefix =
    "ElmToGren.Compat."


all : Array AdapterId
all =
    [ ArrayAdapter
    , BasicsAdapter
    , BrowserAdapter
    , BytesEncodeAdapter
    , CharAdapter
    , DictAdapter
    , ExpectAdapter
    , HtmlAttributesAdapter
    , HtmlEventsAdapter
    , HtmlKeyedAdapter
    , HttpAdapter
    , JsonDecodeAdapter
    , JsonEncodeAdapter
    , ListAdapter
    , MarkdownAdapter
    , MaybeAdapter
    , PlatformAdapter
    , RandomAdapter
    , ResultAdapter
    , SetAdapter
    , StringAdapter
    , SvgKeyedAdapter
    , TaskAdapter
    , TupleAdapter
    , VirtualDomHandlerAdapter
    , VirtualDomKeyedAdapter
    ]


moduleName : AdapterId -> String
moduleName adapterId =
    prefix ++ adapterIdName adapterId


{-| D106: does this adapter declare a CUSTOM type, as opposed to only functions
and type aliases?

The distinction decides whether the adapter can be generated per package. Gren
compares aliases structurally, so two copies of `Compat.Markdown.Options` are
the same type; a custom type is nominal, so two copies of `Compat.Http.Error`
are two unrelated types and a value cannot cross the package boundary. Read
off the generated source so a custom type added to any adapter is shared from
that moment on, instead of silently reintroducing the defect.
-}
declaresNominalType : AdapterId -> Bool
declaresNominalType adapterId =
    sourceFor adapterId
        |> String.lines
        |> Array.any
            (\line ->
                String.startsWith "type " line
                    && not (String.startsWith "type alias " line)
            )


{-| The adapters that must live in ONE shared package for the whole port —
see `Port.CompatShim`.
-}
shared : Array AdapterId
shared =
    Array.keepIf declaresNominalType all


{-| The Elm packages an adapter's own imports need. A shim package is not in
the Elm dependency graph, so it has no manifest to derive its Gren dependencies
from; naming the Elm coordinates here lets it resolve them through the same
mapping registry its consumers were planned against.

Only `shared` adapters are ever asked. The default is deliberately minimal:
an adapter that needs more than core and reaches this list unlisted fails
loudly at `gren docs` with the module it could not find, which is a better
outcome than guessing a dependency set.
-}
elmRequirements : AdapterId -> Array String
elmRequirements adapterId =
    when adapterId is
        HttpAdapter ->
            [ "elm/core", "elm/json", "elm/http" ]

        _ ->
            [ "elm/core" ]


adapterModuleForTarget : String -> Maybe String
adapterModuleForTarget target =
    all
        |> Array.map moduleName
        |> Array.findFirst
            (\candidate ->
                target == candidate
                    || String.startsWith (candidate ++ ".") target
            )
        |> Maybe.map .value


adapterIdForTarget : String -> Maybe AdapterId
adapterIdForTarget target =
    adapterModuleForTarget target
        |> Maybe.andThen
            (\foundModule ->
                all
                    |> Array.findFirst (\adapterId -> moduleName adapterId == foundModule)
                    |> Maybe.map .value
            )


{-| Semantic guarantee for generating an adapter module as a whole.

Most adapters preserve behavior while reshaping Elm values to Gren values.
Markdown is intentionally incomplete and therefore approximate.
-}
guarantee : AdapterId -> TranslationGuarantee
guarantee adapterId =
    when adapterId is
        MarkdownAdapter ->
            Approximate

        ArrayAdapter ->
            RepresentationChange

        BasicsAdapter ->
            RepresentationChange

        BrowserAdapter ->
            RepresentationChange

        BytesEncodeAdapter ->
            RepresentationChange

        CharAdapter ->
            RepresentationChange

        DictAdapter ->
            RepresentationChange

        ExpectAdapter ->
            RepresentationChange

        HtmlAttributesAdapter ->
            RepresentationChange

        HtmlEventsAdapter ->
            RepresentationChange

        HtmlKeyedAdapter ->
            RepresentationChange

        HttpAdapter ->
            RepresentationChange

        JsonDecodeAdapter ->
            RepresentationChange

        JsonEncodeAdapter ->
            RepresentationChange

        ListAdapter ->
            RepresentationChange

        MaybeAdapter ->
            RepresentationChange

        PlatformAdapter ->
            RepresentationChange

        RandomAdapter ->
            RepresentationChange

        ResultAdapter ->
            RepresentationChange

        SetAdapter ->
            RepresentationChange

        StringAdapter ->
            RepresentationChange

        SvgKeyedAdapter ->
            RepresentationChange

        TaskAdapter ->
            RepresentationChange

        TupleAdapter ->
            RepresentationChange

        VirtualDomHandlerAdapter ->
            RepresentationChange

        VirtualDomKeyedAdapter ->
            RepresentationChange


{-| Classify every mapping target. Direct Gren targets are exact; compatibility
targets inherit their adapter promise, with symbol-level overrides where an
adapter contains both preserving and approximate operations.
-}
guaranteeForTarget : String -> TranslationGuarantee
guaranteeForTarget target =
    if
        target == "ElmToGren.Compat.Char.toLocaleLower"
            || target == "ElmToGren.Compat.Char.toLocaleUpper"
    then
        Approximate

    else
        when adapterIdForTarget target is
            Just adapterId ->
                guarantee adapterId

            Nothing ->
                if String.startsWith prefix target then
                    Unsupported

                else
                    Exact


guaranteeForModule : ModuleMapping -> TranslationGuarantee
guaranteeForModule mapping =
    [ mapping.target ]
        |> Array.append (Dict.values mapping.values)
        |> Array.append (Dict.values mapping.types)
        |> Array.foldl
            (\target found ->
                weakestGuarantee found (guaranteeForTarget target)
            )
            Exact


normalize : String -> Result AdapterError AdapterId
normalize requirement =
    let
        candidate =
            when adapterModuleForTarget requirement is
                Just foundModule ->
                    String.dropFirst (String.count prefix) foundModule

                Nothing ->
                    if String.startsWith prefix requirement then
                        String.dropFirst (String.count prefix) requirement

                    else
                        requirement

        lowered =
            String.toLower candidate
    in
    when Array.findFirst (\adapterId -> String.toLower (adapterIdName adapterId) == lowered) all is
        Just adapterId ->
            Ok adapterId.value

        Nothing ->
            Err
                (UnknownAdapter
                    { requirement = requirement
                    , available = Array.map adapterIdName all
                    }
                )


requiredForModules : Array ModuleMapping -> Array AdapterId
requiredForModules modules =
    modules
        |> Array.foldl collectModuleAdapters Dict.empty
        |> Dict.values


collectModuleAdapters : ModuleMapping -> Dict String AdapterId -> Dict String AdapterId
collectModuleAdapters mapping found =
    let
        targets =
            [ mapping.target ]
                |> Array.append (Dict.values mapping.values)
                |> Array.append (Dict.values mapping.types)
    in
    Array.foldl
        (\target current ->
            when adapterIdForTarget target is
                Just adapterId ->
                    Dict.set (adapterIdName adapterId) adapterId current

                Nothing ->
                    current
        )
        found
        targets


generateFromRequirements : Array String -> Result AdapterError (Array GeneratedModule)
generateFromRequirements requirements =
    requirements
        |> Array.foldl
            (\requirement accumulated ->
                accumulated
                    |> Result.andThen
                        (\byName ->
                            normalize requirement
                                |> Result.map
                                    (\adapterId ->
                                        Dict.set (adapterIdName adapterId) adapterId byName
                                    )
                        )
            )
            (Ok Dict.empty)
        |> Result.map (Dict.values >> generate)


generate : Array AdapterId -> Array GeneratedModule
generate adapterIds =
    adapterIds
        |> Array.foldl
            (\adapterId byName -> Dict.set (adapterIdName adapterId) adapterId byName)
            Dict.empty
        |> Dict.values
        |> Array.map generateOne


generateOne : AdapterId -> GeneratedModule
generateOne adapterId =
    let
        generatedModuleName =
            moduleName adapterId
    in
    { moduleName = generatedModuleName
    , relativePath = String.replace "." "/" generatedModuleName ++ ".gren"
    , source = sourceFor adapterId
    }


sourceFor : AdapterId -> String
sourceFor adapterId =
    when adapterId is
        ArrayAdapter ->
            ArraySource.source

        BasicsAdapter ->
            BasicsSource.source

        BrowserAdapter ->
            BrowserSource.source

        BytesEncodeAdapter ->
            BytesEncodeSource.source

        CharAdapter ->
            CharSource.source

        DictAdapter ->
            DictSource.source

        ExpectAdapter ->
            ExpectSource.source

        HtmlAttributesAdapter ->
            HtmlAttributesSource.source

        HtmlEventsAdapter ->
            HtmlEventsSource.source

        HtmlKeyedAdapter ->
            HtmlKeyedSource.source

        HttpAdapter ->
            HttpSource.source

        JsonDecodeAdapter ->
            JsonDecodeSource.source

        JsonEncodeAdapter ->
            JsonEncodeSource.source

        ListAdapter ->
            ListSource.source

        MarkdownAdapter ->
            MarkdownSource.source

        MaybeAdapter ->
            MaybeSource.source

        PlatformAdapter ->
            PlatformSource.source

        RandomAdapter ->
            RandomSource.source

        ResultAdapter ->
            ResultSource.source

        SetAdapter ->
            SetSource.source

        StringAdapter ->
            StringSource.source

        SvgKeyedAdapter ->
            SvgKeyedSource.source

        TaskAdapter ->
            TaskSource.source

        TupleAdapter ->
            TupleSource.source

        VirtualDomHandlerAdapter ->
            VirtualDomHandlerSource.source

        VirtualDomKeyedAdapter ->
            VirtualDomKeyedSource.source
