import Array
import Dict exposing (Dict)
import Mapping.Adapter.Source.Array as ArraySource
import Mapping.Adapter.Source.Basics as BasicsSource
import Mapping.Adapter.Source.Browser as BrowserSource
import Mapping.Adapter.Source.BytesEncode as BytesEncodeSource
import Mapping.Adapter.Source.Char as CharSource
import Mapping.Adapter.Source.Dict as DictSource
import Mapping.Adapter.Source.Expect as ExpectSource
import Mapping.Adapter.Source.HtmlAttributes as HtmlAttributesSource
import Mapping.Adapter.Source.HtmlEvents as HtmlEventsSource
import Mapping.Adapter.Source.HtmlKeyed as HtmlKeyedSource
import Mapping.Adapter.Source.Http as HttpSource
import Mapping.Adapter.Source.JsonDecode as JsonDecodeSource
import Mapping.Adapter.Source.JsonEncode as JsonEncodeSource
import Mapping.Adapter.Source.List as ListSource
import Mapping.Adapter.Source.Markdown as MarkdownSource
import Mapping.Adapter.Source.Maybe as MaybeSource
import Mapping.Adapter.Source.Platform as PlatformSource
