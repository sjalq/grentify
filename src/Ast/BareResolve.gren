module Ast.BareResolve exposing (apply)

{-| Restore bare vars that elm-review mis-marked LOCAL (shadow leak past lambda+let).

If a free name is in an explicit `exposing` list and not bound in scope, re-qualify
it to the import. Runs before NameSub. Uses `Ast.Scope` (same binder walk as NameSub).
`exposing (..)` is not repaired — member sets are unknown here.
-}

import Array exposing (Array)
import Ast.Scope as Scope
import Ast.Types as T exposing (NamedRef)
import Dict exposing (Dict)
import Set exposing (Set)


{-| Restore module qualifiers on wrongly-local bare vars, module-wide.
-}
apply : T.File -> T.File
apply file =
    let
        exposedImports =
            importedNameTable file.imports

        qualifiedTargets : Dict String NamedRef
        qualifiedTargets =
            Dict.map (\name sourceModule -> { moduleName = Just sourceModule, name = name }) exposedImports

        topLevel =
            Scope.topLevelNames file.declarations
    in
    if Dict.isEmpty exposedImports then
        file

    else
        { file
            | declarations =
                Array.map
                    (resolveDeclaration qualifiedTargets topLevel)
                    file.declarations
        }


{-| name -> importing module, for EXPLICIT value exposings only.
Later imports win on collision, matching Elm's shadow-of-imports rule closely
enough for repair purposes (real collisions are already compile errors in Elm).
-}
importedNameTable : Array T.Import -> Dict String String
importedNameTable imports =
    Array.foldl
        (\importDef acc ->
            when importDef.exposing_ is
                Just (T.ExposeExplicit items) ->
                    Array.foldl
                        (\item innerAcc ->
                            when item is
                                T.ExposeFunction exposedName ->
                                    Dict.set exposedName importDef.moduleName innerAcc

                                _ ->
                                    innerAcc
                        )
                        acc
                        items

                _ ->
                    acc
        )
        Dict.empty
        imports


resolveDeclaration : Dict String NamedRef -> Set String -> T.Declaration -> T.Declaration
resolveDeclaration qualifiedTargets topLevel declaration =
    when declaration is
        T.DeclFunction function ->
            T.DeclFunction
                { function
                    | expression =
                        Scope.rewriteBareVars
                            identity
                            qualifiedTargets
                            (Array.foldl Scope.addPatternNames topLevel function.arguments)
                            function.expression
                }

        T.DeclDestructure destructure ->
            T.DeclDestructure
                { destructure
                    | expression =
                        Scope.rewriteBareVars identity qualifiedTargets topLevel destructure.expression
                }

        _ ->
            declaration
