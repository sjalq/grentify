module Ast.RecordAliasTest exposing (tests)

{-| RecordAlias short-name isolation (elm-deque Deque vs Internal.Deque).
-}

import Array exposing (Array)
import Ast.Print as Print
import Ast.RecordAlias as RecordAlias
import Ast.Types exposing
    ( Declaration(..)
    , Exposing(..)
    , Expr(..)
    , File
    , ModuleKind(..)
    , Pattern(..)
    , TypeAnn(..)
    )
import Dict exposing (Dict)
import Mapping.Registry as Registry
import Mapping.Types exposing (PackageMapping(..), Platform(..), Registry)
import String
import Transform.Evidence as Evidence


type alias TestResult =
    { name : String
    , passed : Bool
    , details : String
    }


tests : Array TestResult
tests =
    [ localCtorNotShadowedByImportedRecordAlias
    , importedAliasStillRewritesWhenQualified
    , mappedPlatformAliasBecomesRecord
    , mappedAliasHintYieldsToPackageEvidence
    ]


{-| `type Deque a = Deque (Internal.Deque a)` must not treat bare `Deque` as
the imported record alias `Internal.Deque`.
-}
localCtorNotShadowedByImportedRecordAlias : TestResult
localCtorNotShadowedByImportedRecordAlias =
    let
        packageAliases =
            Dict.empty
                |> Dict.set "Internal.Deque" [ "sizeF", "front", "sizeR", "rear" ]

        file =
            { schemaVersion = 1
            , moduleDefinition =
                { kind = NormalModule
                , moduleName = "Deque"
                , exposing_ = ExposeAll
                }
            , comments = []
            , imports =
                [ { moduleName = "Internal", alias = Nothing, exposing_ = Just ExposeAll } ]
            , declarations =
                [ DeclCustomType
                    { name = "Deque"
                    , documentation = Nothing
                    , generics = [ "a" ]
                    , constructors =
                        [ { name = "Deque"
                          , arguments = [ TypeGeneric "a" ]
                          }
                        ]
                    }
                , DeclFunction
                    { name = "empty"
                    , documentation = Nothing
                    , signature = Nothing
                    , arguments = []
                    , expression =
                        ExprApplication
                            [ ExprVar { moduleName = Nothing, name = "Deque" }
                            , ExprVar { moduleName = Just "Internal", name = "empty" }
                            ]
                    }
                ]
            }

        printed =
            Print.print (RecordAlias.apply packageAliases file)

        ok =
            String.contains "Internal.empty" printed
                && not (String.contains "ra_" printed)
                && not (String.contains "sizeF = Internal.empty" printed)
    in
    outcome
        "local Deque ctor is not rewritten as Internal.Deque record alias"
        ok
        ("printed:\n" ++ printed)


importedAliasStillRewritesWhenQualified : TestResult
importedAliasStillRewritesWhenQualified =
    let
        packageAliases =
            Dict.empty
                |> Dict.set "Monocle.Iso.Iso" [ "get", "reverseGet" ]

        file =
            { schemaVersion = 1
            , moduleDefinition =
                { kind = NormalModule
                , moduleName = "Example"
                , exposing_ = ExposeAll
                }
            , comments = []
            , imports =
                [ { moduleName = "Monocle.Iso", alias = Nothing, exposing_ = Just ExposeAll } ]
            , declarations =
                [ DeclFunction
                    { name = "pair"
                    , documentation = Nothing
                    , signature = Nothing
                    , arguments = [ PatVar "f", PatVar "g" ]
                    , expression =
                        ExprApplication
                            [ ExprVar { moduleName = Just "Monocle.Iso", name = "Iso" }
                            , ExprVar { moduleName = Nothing, name = "f" }
                            , ExprVar { moduleName = Nothing, name = "g" }
                            ]
                    }
                ]
            }

        printed =
            Print.print (RecordAlias.apply packageAliases file)

        ok =
            String.contains "get = f" printed
                && String.contains "reverseGet = g" printed
    in
    outcome
        "qualified Monocle.Iso.Iso still becomes a record"
        ok
        ("printed:\n" ++ printed)


{-| D71: `Parser.DeadEnd row col problem` is legal Elm (record alias applied
positionally) but gren-lang/parser only has the record. elm/parser is mapped,
never transpiled, so the shape comes from the registry.
-}
mappedPlatformAliasBecomesRecord : TestResult
mappedPlatformAliasBecomesRecord =
    let
        printed =
            Print.print
                (RecordAlias.apply
                    (Evidence.mappedRecordAliases parserRegistry
                        [ deadEndUser ]
                        Dict.empty
                    )
                    deadEndUser
                )

        ok =
            String.contains "row = p.row" printed
                && String.contains "col = p.col" printed
                && String.contains "problem = p.problem" printed
                && not (String.contains "Parser.DeadEnd p.row" printed)
    in
    outcome
        "mapped Parser.DeadEnd is lowered to its Gren record"
        ok
        ("printed:\n" ++ printed)


{-| The registry shape is a HINT (D12). A package that speaks for the same
qualified name itself — by owning the module, or by declaring it as a real
multi-argument constructor — keeps its own meaning.
-}
mappedAliasHintYieldsToPackageEvidence : TestResult
mappedAliasHintYieldsToPackageEvidence =
    let
        ownsTheModule =
            Evidence.mappedRecordAliases parserRegistry
                [ { deadEndUser
                    | moduleDefinition =
                        { kind = NormalModule
                        , moduleName = "Parser"
                        , exposing_ = ExposeAll
                        }
                  }
                ]
                Dict.empty

        ownsTheConstructor =
            Evidence.mappedRecordAliases parserRegistry
                [ deadEndUser ]
                (Dict.singleton "Parser.DeadEnd" 3)

        stillSeeded =
            Evidence.mappedRecordAliases parserRegistry [ deadEndUser ] Dict.empty

        ok =
            Dict.get "Parser.DeadEnd" ownsTheModule
                == Nothing
                && Dict.get "Parser.DeadEnd" ownsTheConstructor
                == Nothing
                && Dict.get "Parser.DeadEnd" stillSeeded
                == Just [ "row", "col", "problem" ]
    in
    outcome
        "registry alias shapes lose to the package's own evidence"
        ok
        ("owns module: "
            ++ Debug.toString (Dict.get "Parser.DeadEnd" ownsTheModule)
            ++ ", owns ctor: "
            ++ Debug.toString (Dict.get "Parser.DeadEnd" ownsTheConstructor)
        )


parserRegistry : Registry
parserRegistry =
    Registry.fromDocument
        { schemaVersion = 1
        , versionedPackages = []
        , packages =
            [ GrenAnalogue
                { elmPackage = "elm/parser"
                , grenPackage = "gren-lang/parser"
                , grenVersion = "6.2.1"
                , platform = Common
                , modules =
                    [ { source = "Parser"
                      , target = "Parser"
                      , values = Dict.empty
                      , types = Dict.empty
                      , recordAliases =
                            Dict.singleton "DeadEnd" [ "row", "col", "problem" ]
                      }
                    ]
                , absentModules = Dict.empty
                }
            ]
        }


{-| `problemToDeadEnd p = Parser.DeadEnd p.row p.col p.problem`
-}
deadEndUser : File
deadEndUser =
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Parser.Extra"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports =
        [ { moduleName = "Parser", alias = Nothing, exposing_ = Nothing } ]
    , declarations =
        [ DeclFunction
            { name = "problemToDeadEnd"
            , documentation = Nothing
            , signature = Nothing
            , arguments = [ PatVar "p" ]
            , expression =
                ExprApplication
                    [ ExprVar { moduleName = Just "Parser", name = "DeadEnd" }
                    , access "row"
                    , access "col"
                    , access "problem"
                    ]
            }
        ]
    }


access : String -> Expr
access field =
    ExprAccess
        { record = ExprVar { moduleName = Nothing, name = "p" }
        , field = field
        }


outcome : String -> Bool -> String -> TestResult
outcome name passed details =
    { name = name
    , passed = passed
    , details = details
    }
