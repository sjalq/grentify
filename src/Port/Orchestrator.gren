type alias Context =
    { platform : Node.Platform
    , workingDirectory : Path
    , homeDirectory : Path
    , applicationPath : Path
    , toolVersion : String
    , -- Progress sink for per-package notes (e.g. "(extract cached)"). Kept off
      -- stdout so `--json` reports stay clean; wired to stderr by the CLI.
      logStream : Maybe (Writable Bytes.Bytes)
    }


type alias Permissions =
    { fileSystem : FileSystem.Permission
    , childProcess : ChildProcess.Permission
    , http : HttpClient.Permission
    }


type alias Outcome =
    { output : Path
    , rootPackage : String
    , packageCount : Int
    , testModuleCount : Int
    , report : String
    , behaviorMessage : Maybe String
    }


type alias Assets =
    { root : Path
    , mappings : Path
    , review : Path
    , elmReviewExecutable : String
    , -- The Elm compiler bundled with this tool, when it is installed.
      -- Handed to elm-review as `--compiler` so the extract phase does not
      -- depend on whatever `elm` the caller happens to have on PATH.
      elmExecutable : Maybe String
    , grenExecutable : String
    , formatExecutable : String
    }


type alias Draft =
    { source : Acquire.PackageSource
    , modules : Array Mapping.GeneratedModule
    , testModules : Array Mapping.GeneratedModule
    , diagnostics : Array Pipeline.Diagnostic
    , detectedPlatform : Mapping.Platform
    , -- Just when this draft was served from the ported-dependency cache.
      portedCacheHit : Maybe Path
    , -- Just after a cache miss for a cacheable package; store after verify.
      portedCachePending : Maybe PortedCache.Pending
    , -- D45/D45b: this package's exported cross-package maps (ctor
      -- arities + sole ctors), fed to every dependent's transform.
      depExports : Pipeline.DependencyMaps
    }


type alias Planned =
    { identities : Dict String Plan.Identity
    , targets : Dict String String
    , packages : Array Workspace.Package
    , testModuleCount : Int
    , rootTestModules : Array Mapping.GeneratedModule
    , diagnostics : Array Pipeline.Diagnostic
    , -- elmName -> cache entry path for packages served from the ported cache.
      portedCacheHits : Dict String Path
    , -- elmName -> pending store after successful gren verification.
      portedCachePending : Dict String PortedCache.Pending
    , -- D106: elmName -> modules `Port.CompatShim` lifted out of the package
      -- into a shared shim. The staged tree no longer has them, so the ported
      -- cache is handed them separately: an entry that imports a module it
      -- does not carry can never be restored.
      shimStripped : Dict String (Array Mapping.GeneratedModule)
    }


run : Context -> Permissions -> Cli.Options -> Task Error Outcome
run context permissions cliOptions =
    let
        output =
            System.File.resolve context.platform context.workingDirectory cliOptions.outputDirectory

        cache =
            System.File.resolve context.platform context.workingDirectory cliOptions.cacheDirectory

        acquireOptions =
            { cacheDirectory = cache
            , registryBaseUrl = "https://package.elm-lang.org"
            , offline = cliOptions.offline
            }
    in
    -- Pipeline: locate assets → load mappings → acquire → resolve → transform → plan → emit/verify
    locateAssets context permissions.fileSystem
        |> Task.andThen
            (\assets ->
                let
                    overlays =
                        Array.map
                            (System.File.resolve context.platform context.workingDirectory)
                            cliOptions.mappingFiles
                in
                Mapping.Load.load permissions.fileSystem assets.mappings overlays
                    |> Task.andThen
                        (\loaded ->
                            mappingDigestFromTexts loaded.texts
                                |> Task.andThen
                                    (\digest ->
                                        portPipeline context permissions cliOptions output cache acquireOptions assets digest loaded.registry
                                    )
                        )
            )


{-| Acquire root → prune false edges → resolve graph → acquire deps → transform →
plan → namespace/shim → emit (port workspace or add vendor). Named to match the
README pipeline so the control flow stays student-readable.
-}
portPipeline
    : Context
    -> Permissions
    -> Cli.Options
    -> Path
    -> Path
    -> Acquire.Options
    -> Assets
    -> String
    -> Registry
    -> Task Error Outcome
portPipeline context permissions cliOptions output cache acquireOptions assets digest registry =
    Acquire.parseInput context.platform context.workingDirectory context.homeDirectory cliOptions.input
        |> System.Task.fromResult identity
        |> Task.andThen (Acquire.acquire context.platform permissions acquireOptions)
        -- D100: drop declared-but-unimported root edges BEFORE anything reads
        -- the manifest, so the solver, the plan and the emitted gren.json all
        -- agree on one dependency set.
        |> Task.andThen
            (\acquired ->
                pruneFalseRootEdges permissions acquireOptions registry acquired
                    |> Task.map
                        (\pruned -> { acquired | manifest = pruned })
            )
        |> Task.andThen
            (\rootSource ->
                let
                    registryForRoot =
                        MappingRegistry.applyVersionedMappings
                            (manifestDependencyRanges rootSource.manifest)
                            registry
                in
                resolveGraph permissions acquireOptions registryForRoot rootSource
                    |> Task.andThen
                        (\resolution ->
                            acquireSources context.platform permissions acquireOptions rootSource resolution
                                |> Task.andThen
                                    (\sources ->
                                        let
                                            -- `add`: overlay synthetic `M -> Elm.M` so transform
                                            -- rewrites cross-module imports/refs under Elm. prefix.
                                            transformRegistry =
                                                if cliOptions.namespaceModules then
                                                    overlayPortedModules sources registryForRoot

                                                else
                                                    registryForRoot
                                        in
                                        transformSources context permissions cache cliOptions.offline cliOptions.namespaceModules cliOptions.extractCache cliOptions.portedCache (cliPlatformLabel cliOptions.platform) assets transformRegistry resolution cliOptions.withTests sources
                                    )
                                |> Task.andThen
                                    (\drafts ->
                                        planPackages cliOptions registryForRoot resolution drafts
                                            |> System.Task.fromResult identity
                                    )
                                |> Task.andThen
                                    (\planned ->
                                        let
                                            -- Feature 2: exposed-module names must track the
                                            -- Elm. prefix applied to the module sources, or
                                            -- `gren docs` cannot find the exposed modules.
                                            namespaced =
                                                if cliOptions.namespaceModules then
                                                    { planned | packages = Array.map namespaceExposedModules planned.packages }

                                                else
                                                    planned
                                        in
                                        -- D106: after namespacing, because the shim declares
                                        -- the adapter module name and adapters are never
                                        -- prefixed; before emit, because it rewrites both the
                                        -- module set and the manifests.
                                        CompatShim.apply registryForRoot
                                            (PackageName.toString resolution.root)
                                            namespaced.packages
                                            |> System.Task.fromResult identity
                                            |> Task.andThen
                                                (\hoisted ->
                                                    let
                                                        finalPlanned =
                                                            { namespaced
                                                                | packages = hoisted.packages
                                                                , shimStripped = hoisted.stripped
                                                            }
                                                    in
                                                    if cliOptions.vendor then
                                                        finalizeAdd context permissions cliOptions output assets resolution finalPlanned

                                                    else
                                                        finalize context permissions cliOptions output digest assets registryForRoot resolution finalPlanned
                                                )
                                    )
                        )
            )


resolveGraph : Permissions -> Acquire.Options -> Registry -> Acquire.PackageSource -> Task Error Resolution
resolveGraph permissions acquireOptions registry rootSource =
    resolveFrom permissions acquireOptions registry rootSource.manifest


{-| D100: drop a dependency the root DECLARES but no root module IMPORTS.

Elm does not require a declared dependency to be used, and
`vito/elm-ansi@12.0.0` declares `elm-explorations/benchmark` while importing
nothing from it. That package ships `src/Elm/Kernel/Benchmark.js`, so the port
refused the whole graph over an edge carrying nothing, and elm-ansi was banked
EXEMPT(kernel:dep) for a dependency it does not use.

Sound because Elm resolves a module name to exactly one package and forbids
importing from a package you did not declare: if no root module imports a
module this dependency EXPOSES, nothing the root emits can reference it.
Pruning the root's edge does not remove the package when another dependency
genuinely needs it — the solver still reaches it through that package's own
requirements.

Absent evidence never prunes: an unreadable manifest, or a constraint no
published version satisfies, keeps the edge so the solver reports it properly.

Scope: the ROOT's edges only. A dependency's own false edges still bite,
because its sources are not in hand until the solve has already run.
-}
pruneFalseRootEdges : Permissions -> Acquire.Options -> Registry -> Acquire.PackageSource -> Task Error Manifest
pruneFalseRootEdges permissions acquireOptions registry rootSource =
    let
        manifest =
            rootSource.manifest

        -- A CATALOG-MAPPED dependency is never pruned. Its modules reach the
        -- output through the Gren analogue and through the
        -- `ElmToGren.Compat.*` shims the tool generates, which import names
        -- (`Platform.Sub`, `Platform.Cmd`) no root source ever mentions.
        -- Dropping elm/core because a package only imports `Bitwise` took the
        -- canary from 14/14 to 2/14.
        --
        -- NOT `Mapped.isMappedDependency`: that one excludes Transpile
        -- mappings (they must still be acquired/solved), while pruning must
        -- keep ANY catalog-mapped edge, Transpile included.
        hasCatalogMapping name =
            MappingRegistry.mappingFor name registry /= Nothing
    in
    if Dict.isEmpty manifest.dependencies then
        Task.succeed manifest

    else
        rootImportedModules permissions.fileSystem rootSource
            |> Task.andThen
                (\imported ->
                    Dict.foldl
                        (\key dependency pending ->
                            pending
                                |> Task.andThen
                                    (\kept ->
                                        if hasCatalogMapping key then
                                            Task.succeed (Dict.set key dependency kept)

                                        else
                                            dependencyIsImported permissions acquireOptions imported dependency
                                                |> Task.map
                                                    (\used ->
                                                        if used then
                                                            Dict.set key dependency kept

                                                        else
                                                            kept
                                                    )
                                    )
                        )
                        (Task.succeed Dict.empty)
                        manifest.dependencies
                )
            |> Task.map (\kept -> { manifest | dependencies = kept })


{-| Every module name the root's own sources import. -}
rootImportedModules : FileSystem.Permission -> Acquire.PackageSource -> Task Error (Dict String {})
rootImportedModules fileSystem rootSource =
    rootSource.sourceFiles
        |> Array.foldl
            (\file pending ->
                pending
                    |> Task.andThen
                        (\found ->
                            System.File.readText fileSystem file
                                |> Task.onError (\_ -> Task.succeed "")
                                |> Task.map
                                    (\contents ->
                                        Dict.foldl (\name _ acc -> Dict.set name {} acc)
                                            found
                                            (Pipeline.sourceImportedModules contents)
                                    )
                        )
            )
            (Task.succeed Dict.empty)


{-| True when the root imports at least one module this dependency exposes. -}
dependencyIsImported : Permissions -> Acquire.Options -> Dict String {} -> Elm.Manifest.Dependency -> Task Error Bool
dependencyIsImported permissions acquireOptions imported dependency =
    Acquire.loadVersions permissions acquireOptions dependency.name
        |> Task.andThen
            (\versions ->
                when
                    versions
                        |> Array.keepIf (Semver.satisfies dependency.constraint)
                        |> Array.sortWith Semver.compare
                        |> Array.last
                is
                    Nothing ->
                        Task.succeed True

                    Just version ->
                        Acquire.loadManifest permissions acquireOptions dependency.name version
                            |> Task.map
                                (\depManifest ->
                                    Array.any
                                        (\name -> Dict.member name imported)
                                        depManifest.exposedModules
                                )
            )
        |> Task.onError (\_ -> Task.succeed True)


resolveFrom : Permissions -> Acquire.Options -> Registry -> Manifest -> Task Error Resolution
resolveFrom permissions acquireOptions registry rootManifest =
    let
        solverOptions =
            { isMapped = Mapped.isMappedDependency registry }
    in
    -- Mapped dependencies are omitted from the solver graph. When every direct
    -- root dependency is already mapped, no registry index is required.
    if Mapped.hasUnmappedDependencies registry rootManifest then
        -- Load /all-packages once for the whole search. Calling loadVersions
        -- per candidate package re-fetched the mutable index on every probe and
        -- could observe inconsistent snapshots mid-solve.
        Acquire.loadRegistry permissions acquireOptions
            |> Task.andThen
                (\elmRegistry ->
                    Resolve.Online.resolve solverOptions
                        { versionsFor = Mapped.versionsFor elmRegistry
                        , manifestFor = Acquire.loadManifest permissions acquireOptions
                        }
                        rootManifest
                )

    else
        Solver.solveWith solverOptions Dict.empty rootManifest
            |> Result.mapError Mapped.solverFailure
            |> System.Task.fromResult identity


acquireSources
    : Node.Platform
    -> Permissions
    -> Acquire.Options
    -> Acquire.PackageSource
    -> Resolution
    -> Task Error (Dict String Acquire.PackageSource)
acquireSources platform permissions options rootSource resolution =
    resolution.order
        |> Array.foldl
            (\name pending ->
                pending
                    |> Task.andThen
                        (\sources ->
                            let
                                key =
                                    PackageName.toString name
                            in
                            if key == PackageName.toString rootSource.manifest.name then
                                Task.succeed (Dict.set key rootSource sources)

                            else
                                when Dict.get key resolution.packages is
                                    Nothing ->
                                        Task.fail <|
                                            PortError.create "INTERNAL_ERROR"
                                                ("Resolved package " ++ key ++ " has no manifest.")

                                    Just resolved ->
                                        Acquire.acquire platform permissions options
                                            (Acquire.RegistryPackage
                                                { name = resolved.manifest.name
                                                , version = Just resolved.manifest.version
                                                }
                                            )
                                            |> Task.map (\source -> Dict.set key source sources)
                        )
            )
            (Task.succeed Dict.empty)


transformSources
    : Context
    -> Permissions
    -> Path
    -> Bool
    -> Bool
    -> Bool
    -> Bool
    -> String
    -> Assets
    -> Registry
    -> Resolution
    -> Bool
    -> Dict String Acquire.PackageSource
    -> Task Error (Dict String Draft)
transformSources context permissions cache offline namespaceModules extractCacheEnabled portedCacheEnabled platformLabel assets registry resolution withTests sources =
    let
        elmHome =
            Path.join [ cache, Path.fromPosixString "elm-home" ]

        -- One compiled elm-review app per rule version, shared by every package
        -- tree under this cache. Avoids recompiling ~1MB review JS per package.
        reviewAppCache =
            Path.join [ cache, Path.fromPosixString "review-app" ]

        rootName =
            PackageName.toString resolution.root
    in
    System.File.ensureDirectory permissions.fileSystem elmHome
        |> Task.andThen
            (\_ -> System.File.ensureDirectory permissions.fileSystem reviewAppCache)
        |> Task.andThen
            (\_ ->
                resolution.order
                    |> Array.foldl
                        (\name pending ->
                            pending
                                |> Task.andThen
                                    (\state ->
                                        let
                                            key =
                                                PackageName.toString name
                                        in
                                        when Dict.get key sources is
                                            Nothing ->
                                                Task.fail <|
                                                    PortError.create "INTERNAL_ERROR"
                                                        ("Acquired source set is missing " ++ key ++ ".")

                                            Just source ->
                                                -- D45: deps transform before dependents
                                                -- (resolution.order), so each package sees
                                                -- every prior package's ctor arities.
                                                transformOne context permissions cache elmHome reviewAppCache offline namespaceModules extractCacheEnabled portedCacheEnabled platformLabel assets registry state.dependencyMaps resolution source withTests (key == rootName)
                                                    |> Task.map
                                                        (\draft ->
                                                            { drafts = Dict.set key draft state.drafts
                                                            , dependencyMaps =
                                                                { ctorArities =
                                                                    Dict.foldl Dict.set state.dependencyMaps.ctorArities draft.depExports.ctorArities
                                                                , soleCtors =
                                                                    Dict.foldl Dict.set state.dependencyMaps.soleCtors draft.depExports.soleCtors
                                                                , recordAliases =
                                                                    Dict.foldl Dict.set state.dependencyMaps.recordAliases draft.depExports.recordAliases
                                                                , reservedExports =
                                                                    Dict.foldl Dict.set state.dependencyMaps.reservedExports draft.depExports.reservedExports
                                                                , ctorHomes =
                                                                    mergeCtorHomes state.dependencyMaps.ctorHomes
                                                                        draft.depExports.ctorHomes
                                                                , knownModules =
                                                                    Dict.foldl Dict.set state.dependencyMaps.knownModules
                                                                        draft.depExports.knownModules
                                                                }
                                                            }
                                                        )
                                    )
                        )
                        (Task.succeed { drafts = Dict.empty, dependencyMaps = Pipeline.emptyDependencyMaps })
                    |> Task.map .drafts
            )


transformOne
    : Context
    -> Permissions
    -> Path
    -> Path
    -> Path
    -> Bool
    -> Bool
    -> Bool
    -> Bool
    -> String
    -> Assets
    -> Registry
    -> Pipeline.DependencyMaps
    -> Resolution
    -> Acquire.PackageSource
    -> Bool
    -> Bool
    -> Task Error Draft
transformOne context permissions cacheRoot elmHome reviewAppCache offline namespaceModules extractCacheEnabled portedCacheEnabled platformLabel assets registry dependencyMaps resolution source withTests isRoot =
    let
        coordinate =
            { author = PackageName.author source.manifest.name
            , name = PackageName.project source.manifest.name
            , version = Semver.versionToString source.manifest.version
            }

        portedKey =
            PortedCache.keyFor portedCacheEnabled cacheRoot coordinate source.sourceUrl isRoot

        mappingsDirectory =
            Path.parentPath assets.mappings
                |> Maybe.withDefault assets.mappings
    in
    when portedKey is
        Nothing ->
            transformUncached context permissions cacheRoot elmHome reviewAppCache offline namespaceModules extractCacheEnabled assets registry dependencyMaps resolution source withTests isRoot Nothing

        Just key ->
            PortedCache.digestFor permissions.fileSystem mappingsDirectory context.toolVersion platformLabel namespaceModules
                |> Task.andThen
                    (\digestHex ->
                        if String.isEmpty digestHex then
                            transformUncached context permissions cacheRoot elmHome reviewAppCache offline namespaceModules extractCacheEnabled assets registry dependencyMaps resolution source withTests isRoot Nothing

                        else
                            let
                                entry =
                                    PortedCache.entryPath key.cacheRoot key.coordinate digestHex
                            in
                            PortedCache.load permissions.fileSystem entry digestHex
                                |> Task.andThen
                                    (\cached ->
                                        when cached is
                                            Just cachePath ->
                                                Task.succeed {}
                                                    |> Task.andThen
                                                        (\_ ->
                                                            -- D57/D70: an entry is a hit only if it
                                                            -- carries its OWN cross-package facts. The
                                                            -- extract cache is keyed on other
                                                            -- ingredients and drifts, so falling back
                                                            -- to it degraded silently to empty maps
                                                            -- (D57's TYPE MISMATCH storm); an entry
                                                            -- written before a fact joined the set
                                                            -- cannot supply it at all. Both cases are
                                                            -- the same answer: this entry is not
                                                            -- self-sufficient, so re-port and re-bank.
                                                            PortedCache.loadExports permissions.fileSystem entry
                                                                |> Task.andThen
                                                                    (\stored ->
                                                                        when stored is
                                                                            Just exports ->
                                                                                logPortedCached context coordinate
                                                                                    |> Task.andThen
                                                                                        (\_ ->
                                                                                            draftFromPortedCache permissions.fileSystem source cachePath digestHex
                                                                                        )
                                                                                    |> Task.map (\draft -> { draft | depExports = exports })

                                                                            Nothing ->
                                                                                Task.fail
                                                                                    (PortError.create "PORTED_CACHE_INCOMPLETE"
                                                                                        "Cached entry does not carry its own dependency facts."
                                                                                    )
                                                                    )
                                                                |> Task.onError
                                                                    (\_ ->
                                                                        -- Corrupt/incomplete entry: soft-miss and re-port.
                                                                        transformUncached context permissions cacheRoot elmHome reviewAppCache offline namespaceModules extractCacheEnabled assets registry dependencyMaps resolution source withTests isRoot
                                                                            (Just
                                                                                { cacheRoot = key.cacheRoot
                                                                                , coordinate = key.coordinate
                                                                                , digest = digestHex
                                                                                , exports = Pipeline.emptyDependencyMaps
                                                                                }
                                                                            )
                                                                    )
                                                        )

                                            Nothing ->
                                                transformUncached context permissions cacheRoot elmHome reviewAppCache offline namespaceModules extractCacheEnabled assets registry dependencyMaps resolution source withTests isRoot
                                                    (Just
                                                        { cacheRoot = key.cacheRoot
                                                        , coordinate = key.coordinate
                                                        , digest = digestHex
                                                        , exports = Pipeline.emptyDependencyMaps
                                                        }
                                                    )
                                    )
                    )


{-| Extract + transform without ported-cache. Staging elm.json is pin-locked to
the solver versions so elm-review docs match the port. `pendingStore` is set on
cache miss so we can write the verified tree after verify.
-}
transformUncached
    : Context
    -> Permissions
    -> Path
    -> Path
    -> Path
    -> Bool
    -> Bool
    -> Bool
    -> Assets
    -> Registry
    -> Pipeline.DependencyMaps
    -> Resolution
    -> Acquire.PackageSource
    -> Bool
    -> Bool
    -> Maybe PortedCache.Pending
    -> Task Error Draft
transformUncached context permissions cacheRoot elmHome reviewAppCache offline namespaceModules extractCacheEnabled assets registry dependencyMaps resolution source withTests isRoot pendingStore =
    let
        includeTests =
            withTests && isRoot && not (Array.isEmpty source.testFiles)

        reviewFiles =
            if includeTests then
                [ "src", "tests" ]

            else
                [ "src" ]

        pins =
            DependencyPins.fromResolution resolution

        pinsDigest =
            DependencyPins.digest pins

        -- Registry packages (sourceUrl = Just) are immutable and cacheable;
        -- local-path inputs (Nothing) are mutable and always bypass.
        extractCache =
            ExtractCache.keyFor
                extractCacheEnabled
                cacheRoot
                { author = PackageName.author source.manifest.name
                , name = PackageName.project source.manifest.name
                , version = Semver.versionToString source.manifest.version
                }
                source.sourceUrl

        runReviewAt packageRoot =
            -- D93: the extraction budget scales with how much source
            -- elm-review has to parse, so measure the staged tree first.
            Review.Runner.elmSourceBytes permissions.fileSystem
                packageRoot
                reviewFiles
                |> Task.onError (\_ -> Task.succeed 0)
                |> Task.andThen
                    (\sourceBytes ->
                        runReviewWith packageRoot sourceBytes
                    )

        runReviewWith packageRoot sourceBytes =
            Review.Runner.run context.platform permissions.childProcess
                { packageRoot = packageRoot
                , elmJson = Path.join [ packageRoot, Path.fromPosixString "elm.json" ]
                , reviewConfig = assets.review
                , executable = assets.elmReviewExecutable
                , elmCompiler = assets.elmExecutable
                , elmHome = Just elmHome
                , files = reviewFiles
                , offline = offline
                , reviewAppCache = Just reviewAppCache
                , extractCache = extractCache
                , dependencyPinsDigest = pinsDigest
                , logStream = context.logStream
                , fileSystem = permissions.fileSystem
                , sourceBytes = sourceBytes
                }

        -- Always stage: pin elm.json to solver versions (D82) and keep
        -- user-owned local trees / shared registry trees free of elm-stuff.
        runReview =
            FileSystem.makeTempDirectory permissions.fileSystem
                "elm-to-gren-extract-"
                |> Task.mapError
                    (FileSystem.errorToString
                        >> PortError.create "EXTRACT_STAGING_FAILED"
                    )
                |> Task.andThen
                    (\temporary ->
                        System.File.copyDirectoryContents
                            permissions.fileSystem
                            source.root
                            temporary
                            |> Task.andThen
                                (\_ ->
                                    pruneUnreachableModules permissions.fileSystem temporary
                                )
                            |> Task.andThen
                                (\_ ->
                                    pinStagedElmJson permissions.fileSystem pins temporary
                                )
                            |> Task.andThen (\_ -> runReviewAt temporary)
                            |> Task.map Ok
                            |> Task.onError (Err >> Task.succeed)
                            |> Task.andThen
                                (\reviewResult ->
                                    FileSystem.remove permissions.fileSystem
                                        { recursive = True }
                                        temporary
                                        |> Task.mapError
                                            (FileSystem.errorToString
                                                >> PortError.create "EXTRACT_STAGING_FAILED"
                                            )
                                        |> Task.andThen
                                            (\_ ->
                                                when reviewResult is
                                                    Ok extraction ->
                                                        Task.succeed extraction

                                                    Err error ->
                                                        Task.fail error
                                            )
                                )
                    )
    in
    Task.map2
        (\extraction sourceFiles -> { extraction = extraction, sourceFiles = sourceFiles })
        (announcePhase context "extract" (PackageName.toString source.manifest.name)
            |> Task.andThen (\_ -> runReview)
        )
        (readSources permissions.fileSystem source includeTests)
        |> Task.andThen
            (\inputs ->
                announcePhase context "transform" (PackageName.toString source.manifest.name)
                    |> Task.andThen
                        (\_ ->
                            let
                                live =
                                    dropUnreachableModules source.manifest
                                        includeTests
                                        inputs
                            in
                            Pipeline.transform registry dependencyMaps live.extraction live.sourceFiles
                                |> System.Task.fromResult identity
                        )
            )
        |> Task.andThen
            (\transformed ->
                let
                    hardErrors =
                        Array.keepIf (\diagnostic -> diagnostic.severity == "error") transformed.diagnostics
                in
                if not (Array.isEmpty hardErrors) then
                    Task.fail <|
                        PortError.create "UNSUPPORTED_FEATURE"
                            (hardErrors
                                |> Array.map .message
                                |> String.join "\n"
                            )

                else
                    Adapter.generateFromRequirements transformed.requiredAdapters
                        |> Result.mapError Mapped.adapterFailure
                        |> Result.andThen
                            (\adapters ->
                                Mapped.detectedPlatform transformed.detectedPlatform
                                    |> Result.map
                                        (\detectedPlatform ->
                                            let
                                                -- `add`: prefix only ported source modules with Elm.;
                                                -- Compat adapters stay unprefixed.
                                                portedModules =
                                                    if namespaceModules then
                                                        Array.map namespaceGeneratedModule transformed.modules

                                                    else
                                                        transformed.modules

                                                -- Partition test modules from source modules
                                                partitioned =
                                                    if includeTests then
                                                        Array.partition
                                                            (\m -> not (String.startsWith "tests/" m.relativePath))
                                                            portedModules

                                                    else
                                                        { trues = portedModules, falses = [] }

                                                allModules =
                                                    Array.append partitioned.trues adapters
                                            in
                                            { source = source
                                            , modules = allModules
                                            , testModules = partitioned.falses
                                            , diagnostics = transformed.diagnostics
                                            , detectedPlatform = detectedPlatform
                                            , portedCacheHit = Nothing
                                            , portedCachePending = pendingStore
                                            , depExports = transformed.depExports
                                            }
                                        )
                            )
                        |> System.Task.fromResult identity
            )


{-| D82: rewrite the staged package's elm.json so elm-review loads docs at the
solver-selected versions (first constraint token). Staging keeps the original
registry/local tree immutable.
-}
pinStagedElmJson : FileSystem.Permission -> DependencyPins.Pins -> Path -> Task Error {}
pinStagedElmJson fileSystem pins packageRoot =
    let
        elmJsonPath =
            Path.join [ packageRoot, Path.fromPosixString "elm.json" ]
    in
    System.File.readText fileSystem elmJsonPath
        |> Task.andThen
            (\original ->
                when DependencyPins.pinElmJson pins original is
                    Err message ->
                        Task.fail
                            (PortError.create "EXTRACT_PIN_FAILED"
                                ("Could not pin elm.json dependency versions for extract: " ++ message)
                            )

                    Ok pinned ->
                        if pinned == original then
                            Task.succeed {}

                        else
                            System.File.writeText fileSystem elmJsonPath pinned
                                |> Task.map (\_ -> {})
            )


{-| D51: the install stands; the consumer's own modules do not compile. Say so
loudly on the log stream — silence here would let a broken application look
like a broken port at the user's next build.
-}
logConsumerVerdict : Context -> Verify.Package.ConsumerVerdict -> Task x {}
logConsumerVerdict context verdict =
    when { stream = context.logStream, verdict = verdict } is
        { verdict = Verify.Package.ConsumerVerified } ->
            Task.succeed {}

        { stream = Nothing } ->
            Task.succeed {}

        { stream = Just stream, verdict = Verify.Package.ConsumerSourceErrors details } ->
            Stream.Log.line stream
                ("WARNING: the package was vendored and verified, but this application's own sources do not compile.\n"
                    ++ "The install was kept — fix the application, then build again.\n"
                    ++ details
                )


{-| Log `[phase] …` so external harnesses can see where a timed-out port died. -}
announcePhase : Context -> String -> String -> Task x {}
announcePhase context phase subject =
    when context.logStream is
        Nothing ->
            Task.succeed {}

        Just stream ->
            Stream.Log.line stream ("[phase] " ++ phase ++ " " ++ subject)


logPortedCached : Context -> PortedCache.Coordinate -> Task x {}
logPortedCached context coordinate =
    when context.logStream is
        Nothing ->
            Task.succeed {}

        Just stream ->
            Stream.Log.line stream (PortedCache.coordinateLabel coordinate ++ " (ported cached)")


{-| D48: overwrite a staged package's src/ with the ported-cache entry's
VERIFIED bytes. The entry passed gren verification exactly as stored;
byte-for-byte copy is the only faithful way to serve it (the module-record
route re-printed and corrupted).

D106: the entry is the package's STANDALONE port and therefore carries its own
compatibility adapters, which is what makes it restorable anywhere. A workspace
that hoisted one of those adapters into a shared shim removed it from the
package's module set, so the restore has to remove it again — otherwise the
package ends up with both its own copy and the shim's, and Gren rejects the
import as AMBIGUOUS. `stripped` is exactly what `Port.CompatShim` took out of
this package.
-}
replaceSrcFromEntry : Context -> Permissions -> Array Mapping.GeneratedModule -> Path -> Path -> Task Error {}
replaceSrcFromEntry context permissions stripped cachePath packageDir =
    let
        entrySrc =
            Path.join [ cachePath, Path.fromPosixString "src" ]

        destSrc =
            Path.join [ packageDir, Path.fromPosixString "src" ]
    in
    removePath permissions.fileSystem destSrc
        |> Task.andThen
            (\_ -> System.File.ensureDirectory permissions.fileSystem destSrc)
        |> Task.andThen
            (\_ ->
                System.Process.run permissions.childProcess
                    { program = "cp"
                    , arguments =
                        [ "-a"
                        , System.File.pathToString context.platform entrySrc ++ "/."
                        , System.File.pathToString context.platform destSrc
                        ]
                    , workingDirectory = System.File.pathToString context.platform packageDir
                    , environment = Dict.empty
                    , allowedExitCodes = [ 0 ]
                    , timeoutMilliseconds = 60 * 1000
                    , maximumOutputBytes = 1024 * 1024
                    }
                    |> Task.map (\_ -> {})
                    |> Task.mapError
                        (\error ->
                            PortError.create "PORTED_CACHE_INVALID"
                                ("Could not copy verified ported entry src: "
                                    ++ PortError.message error
                                )
                        )
            )
        |> Task.andThen
            (\_ -> removeHoistedModules permissions.fileSystem packageDir stripped)


removeHoistedModules : FileSystem.Permission -> Path -> Array Mapping.GeneratedModule -> Task Error {}
removeHoistedModules fileSystem packageDir modules =
    Array.foldl
        (\generated pending ->
            pending
                |> Task.andThen
                    (\_ ->
                        removePath fileSystem
                            (Path.join
                                [ packageDir
                                , Path.fromPosixString
                                    (if String.startsWith "src/" generated.relativePath then
                                        generated.relativePath

                                     else
                                        "src/" ++ generated.relativePath
                                    )
                                ]
                            )
                    )
        )
        (Task.succeed {})
        modules


{-| Rebuild a Draft from a previously verified ported src/ tree so planning and
emit can proceed without re-running extract/transform. gren.json is not read
from the cache: it is resolution-specific and re-planned for the current graph.
-}
draftFromPortedCache : FileSystem.Permission -> Acquire.PackageSource -> Path -> String -> Task Error Draft
draftFromPortedCache permission source cachePath expectedDigest =
    let
        srcRoot =
            Path.join [ cachePath, Path.fromPosixString "src" ]
    in
    PortedCache.loadPlatform permission cachePath expectedDigest
        |> Task.andThen
            (\maybePlatform ->
                when maybePlatform is
                    Nothing ->
                        Task.fail (PortError.create "PORTED_CACHE_INVALID" "Cached ported entry is missing a platform label.")

                    Just platformName ->
                        when parseCachedPlatform platformName is
                            Err error ->
                                Task.fail error

                            Ok detectedPlatform ->
                                System.File.listFilesRecursively permission srcRoot
                                    |> Task.andThen
                                        (\paths ->
                                            paths
                                                |> Array.keepIf (\path -> String.endsWith ".gren" (Path.toPosixString path))
                                                |> Array.sortBy Path.toPosixString
                                                |> readCachedModules permission srcRoot
                                        )
                                    |> Task.andThen
                                        (\modules ->
                                            if Array.isEmpty modules then
                                                Task.fail (PortError.create "PORTED_CACHE_INVALID" "Cached ported entry has no .gren modules.")

                                            else if not (Array.isEmpty (danglingCompatImports modules)) then
                                                -- D106: an entry whose sources import a compatibility
                                                -- adapter the entry does not carry cannot be restored.
                                                -- The caller soft-misses on this and re-ports, which
                                                -- also repairs the entry — the alternative is a hard
                                                -- MODULE NOT FOUND on every future run.
                                                Task.fail
                                                    (PortError.create "PORTED_CACHE_INVALID"
                                                        ("Cached ported entry is missing the compatibility modules it imports: "
                                                            ++ String.join ", " (danglingCompatImports modules)
                                                            ++ "."
                                                        )
                                                    )

                                            else
                                                Task.succeed
                                                    { source = source
                                                    , modules = modules
                                                    , testModules = []
                                                    , diagnostics = []
                                                    , detectedPlatform = detectedPlatform
                                                    , portedCacheHit = Just cachePath
                                                    , portedCachePending = Nothing
                                                    , -- caller overlays from the extract cache (D45)
                                                      depExports = Pipeline.emptyDependencyMaps
                                                    }
                                        )
            )


{-| D106: compatibility adapters a restored module set imports but does not
contain. Always empty for an entry written by a tool that carries D106's
`store` restore; non-empty only for entries banked by a build that stripped
adapters into a shared shim and forgot to put them back.
-}
danglingCompatImports : Array Mapping.GeneratedModule -> Array String
danglingCompatImports modules =
    let
        carried =
            Array.foldl
                (\generated found -> Dict.set generated.moduleName {} found)
                Dict.empty
                modules
    in
    Adapter.all
        |> Array.map Adapter.moduleName
        |> Array.keepIf
            (\adapterModule ->
                not (Dict.member adapterModule carried)
                    && Array.any
                        (\generated -> CompatShim.importsModule adapterModule generated.source)
                        modules
            )


parseCachedPlatform : String -> Result Error Mapping.Platform
parseCachedPlatform platformName =
    -- "pure" is the CLI/cache alias for Mapping.Common; canonical names go through platformFromName.
    when platformName is
        "pure" ->
            Ok Mapping.Common

        _ ->
            when Mapping.platformFromName platformName is
                Just platform ->
                    Ok platform

                Nothing ->
                    Err (PortError.create "PORTED_CACHE_INVALID" ("Cached entry has unknown platform " ++ platformName ++ "."))


readCachedModules : FileSystem.Permission -> Path -> Array Path -> Task Error (Array Mapping.GeneratedModule)
readCachedModules permission srcRoot paths =
    let
        srcPrefix =
            String.trimRight (Path.toPosixString srcRoot) ++ "/"
    in
    Array.foldl
        (\path pending ->
            pending
                |> Task.andThen
                    (\acc ->
                        System.File.readText permission path
                            |> Task.map
                                (\contents ->
                                    let
                                        absolute =
                                            Path.toPosixString path

                                        underSrc =
                                            if String.startsWith srcPrefix absolute then
                                                String.dropFirst (String.count srcPrefix) absolute

                                            else
                                                Path.filenameWithExtension path

                                        moduleName =
                                            underSrc
                                                |> String.dropLast (String.count ".gren")
                                                |> String.replace "/" "."
                                    in
                                    Array.pushLast
                                        { moduleName = moduleName
                                        , relativePath = "src/" ++ underSrc
                                        , source = contents
                                        }
                                        acc
                                )
                    )
        )
        (Task.succeed [])
        paths


cliPlatformLabel : Cli.PlatformChoice -> String
cliPlatformLabel choice =
    when choice is
        Cli.Auto ->
            PortedCache.platformLabel "auto"

        Cli.ExactPlatform GrenPlatform.Common ->
            PortedCache.platformLabel "pure"

        Cli.ExactPlatform GrenPlatform.Browser ->
            PortedCache.platformLabel "browser"

        Cli.ExactPlatform GrenPlatform.Node ->
            PortedCache.platformLabel "node"


readSources : FileSystem.Permission -> Acquire.PackageSource -> Bool -> Task Error (Array Pipeline.SourceFile)
readSources permission packageSource includeTests =
    let
        filesToRead =
            if includeTests then
                Array.append packageSource.sourceFiles packageSource.testFiles

            else
                packageSource.sourceFiles
    in
    filesToRead
        |> Array.foldl
            (\filename pending ->
                pending
                    |> Task.andThen
                        (\sources ->
                            relativeSourcePath packageSource.root filename
                                |> System.Task.fromResult identity
                                |> Task.andThen
                                    (\relative ->
                                        System.File.readText permission filename
                                            |> Task.map
                                                (\contents ->
                                                    -- D89: the pipeline must see exactly the
                                                    -- files elm-review extracted, so the same
                                                    -- reachability rule applies here.
                                                    if isReachableModule relative contents then
                                                        Array.pushLast
                                                            { path = relative
                                                            , source = contents
                                                            }
                                                            sources

                                                    else
                                                        sources
                                                )
                                    )
                        )
            )
            (Task.succeed [])


relativeSourcePath : Path -> Path -> Result Error String
relativeSourcePath root filename =
    let
        rootString =
            String.trimRight (Path.toPosixString root) ++ "/"

        filenameString =
            Path.toPosixString filename
    in
    if String.startsWith rootString filenameString then
        Ok (String.dropFirst (String.count rootString) filenameString)

    else
        Err <|
            PortError.create "SOURCE_INVALID"
                ("Elm source " ++ filenameString ++ " escapes " ++ rootString ++ ".")


planPackages : Cli.Options -> Registry -> Resolution -> Dict String Draft -> Result Error Planned
planPackages cliOptions registry resolution drafts =
    let
        -- Calculate total test modules from all drafts
        totalTestModules =
            drafts
                |> Dict.values
                |> Array.map (\draft -> Array.length draft.testModules)
                |> Array.foldl (\count sum -> sum + count) 0
    in
    resolution.order
        |> Array.foldl
            (\name accumulated ->
                accumulated
                    |> Result.andThen
                        (\state -> planOne cliOptions registry resolution drafts name state)
            )
            (Ok
                { identities = Dict.empty
                , targets = Dict.empty
                , packages = []
                , testModuleCount = totalTestModules
                , rootTestModules = []
                , diagnostics = []
                , portedCacheHits = Dict.empty
                , portedCachePending = Dict.empty
                , shimStripped = Dict.empty
                }
            )


planOne : Cli.Options -> Registry -> Resolution -> Dict String Draft -> Name -> Planned -> Result Error Planned
planOne cliOptions registry resolution drafts name state =
    let
        key =
            PackageName.toString name

        rootKey =
            PackageName.toString resolution.root

        isRoot =
            key == rootKey
    in
    when Dict.get key drafts is
        Nothing ->
            Err (PortError.create "INTERNAL_ERROR" ("Transformed source set is missing " ++ key ++ "."))

        Just draft ->
            let
                dependencyPlatforms =
                    draft.source.manifest.dependencies
                        |> Dict.keys
                        |> Array.mapAndKeepJust (\dependency -> Dict.get dependency state.identities)
                        |> Array.map .platform

                -- The Elm dependency graph of everything this port vendors;
                -- Plan.localClosure reads each package's own reach off it.
                portedManifests =
                    Dict.map (\_ other -> other.source.manifest) drafts
            in
            Result.map2
                (\grenName platform -> { grenName = grenName, platform = platform })
                (Plan.targetName registry draft.source.manifest)
                (Plan.inferPackagePlatform
                    cliOptions.platform
                    isRoot
                    registry
                    draft.source.manifest
                    dependencyPlatforms
                    draft.detectedPlatform
                )
                |> Result.andThen
                    (\plannedIdentity ->
                        let
                            identityRecord =
                                { elmName = key
                                , grenName = plannedIdentity.grenName
                                , version = Semver.versionToString draft.source.manifest.version
                                , platform = plannedIdentity.platform
                                }
                        in
                        when Dict.get plannedIdentity.grenName state.targets is
                            Just otherElmName ->
                                Err <|
                                    PortError.create "PACKAGE_NAME_COLLISION"
                                        (key ++ " and " ++ otherElmName ++ " map to " ++ plannedIdentity.grenName ++ ".")

                            Nothing ->
                                Plan.buildManifest
                                    { source = draft.source.manifest
                                    , identity = identityRecord
                                    , registry = registry
                                    , rootElmName = rootKey
                                    , portedManifests = portedManifests
                                    , plannedIdentities = state.identities
                                    }
                                    |> Result.map
                                        (\manifest ->
                                            let
                                                rootTests =
                                                    if isRoot then
                                                        draft.testModules

                                                    else
                                                        state.rootTestModules
                                            in
                                            { identities = Dict.set key identityRecord state.identities
                                            , targets = Dict.set plannedIdentity.grenName key state.targets
                                            , packages =
                                                Array.pushLast
                                                    { sourcePackage = key
                                                    , sourceRoot = draft.source.root
                                                    , manifest = manifest
                                                    , modules = draft.modules
                                                    }
                                                    state.packages
                                            , testModuleCount = state.testModuleCount
                                            , rootTestModules = rootTests
                                            , diagnostics = Array.append state.diagnostics draft.diagnostics
                                            , portedCacheHits =
                                                when draft.portedCacheHit is
                                                    Just hitPath ->
                                                        Dict.set key hitPath state.portedCacheHits

                                                    Nothing ->
                                                        state.portedCacheHits
                                            , portedCachePending =
                                                when draft.portedCachePending is
                                                    Just pending ->
                                                        Dict.set key
                                                            { pending | exports = draft.depExports }
                                                            state.portedCachePending

                                                    Nothing ->
                                                        state.portedCachePending
                                            , shimStripped = state.shimStripped
                                            }
                                        )
                    )


finalize
    : Context
    -> Permissions
    -> Cli.Options
    -> Path
    -> String
    -> Assets
    -> Registry
    -> Resolution
    -> Planned
    -> Task Error Outcome
finalize context permissions cliOptions output digest assets registry resolution planned =
    let
        rootKey =
            PackageName.toString resolution.root
    in
    when Dict.get rootKey planned.identities is
        Nothing ->
            Task.fail (PortError.create "INTERNAL_ERROR" "Root package identity was not planned.")

        Just rootIdentity ->
            compilerVersion context.platform permissions.childProcess assets.grenExecutable
                |> Task.andThen
                    (\resolvedCompilerVersion ->
                        let
                            metadata =
                                { compilerVersion = resolvedCompilerVersion
                                , mappingDigest = digest
                                }

                            report =
                                encodeReport context cliOptions output rootIdentity metadata.compilerVersion planned Nothing

                            lockfile =
                                encodeLock resolution rootIdentity metadata.compilerVersion metadata.mappingDigest planned

                            validate staging =
                                prepareStaging context permissions assets rootIdentity planned staging
                        in
                        Workspace.emit
                            { fileSystem = permissions.fileSystem }
                            { output = output
                            , rootPackage = rootIdentity.grenName
                            , packages = planned.packages
                            , lockfile = lockfile
                            , report = report
                            , validateBeforeCommit = validate
                            }
                            |> Task.andThen
                                (\_ ->
                                    if cliOptions.withTests && not (Array.isEmpty planned.rootTestModules) then
                                        let
                                            rootPackage =
                                                planned.packages
                                                    |> Array.keepIf (\pkg -> pkg.manifest.name == rootIdentity.grenName)
                                                    |> Array.popFirst
                                                    |> Maybe.map .first
                                        in
                                        when rootPackage is
                                            Just pkg ->
                                                let
                                                    behaviorTask =
                                                        if rootIdentity.platform == Mapping.Browser then
                                                            Task.succeed
                                                                { status = "browser-only"
                                                                , detail = "browser-platform package; node harness cannot compile browser imports"
                                                                }

                                                        else
                                                            let
                                                                analogueInfo =
                                                                    Plan.analogueRootByName registry rootKey
                                                            in
                                                            emitBehaviorHarness
                                                                context.platform
                                                                permissions.fileSystem
                                                                output
                                                                rootIdentity.grenName
                                                                planned.rootTestModules
                                                                pkg.manifest.dependencies
                                                                analogueInfo
                                                                |> Task.andThen
                                                                    (\_ ->
                                                                        compileBehaviorHarness
                                                                            context.platform
                                                                            permissions.childProcess
                                                                            output
                                                                            assets.grenExecutable
                                                                            -- The verdict is recorded, never enforced: an
                                                                            -- infrastructure failure (timeout, abnormal exit)
                                                                            -- must not fail the port itself.
                                                                            |> Task.onError
                                                                                (\_ ->
                                                                                    Task.succeed
                                                                                        { status = "harness-error"
                                                                                        , detail = "harness compile/run aborted (timeout or abnormal exit)"
                                                                                        }
                                                                                )
                                                                    )
                                                in
                                                behaviorTask
                                                    |> Task.map (\verdict -> Just verdict)

                                            Nothing ->
                                                Task.succeed (Just
                                                    { status = "harness-error"
                                                    , detail = "root package not found in planned packages"
                                                    }
                                                )

                                    else
                                        Task.succeed Nothing
                                )
                            |> Task.andThen
                                (\behaviorVerdict ->
                                    let
                                        finalReport =
                                            encodeReport context cliOptions output rootIdentity metadata.compilerVersion planned behaviorVerdict

                                        behaviorMessage =
                                            when behaviorVerdict is
                                                Just verdict ->
                                                    Just ("Behavior: " ++ verdict.status ++ " — " ++ verdict.detail)

                                                Nothing ->
                                                    Nothing
                                    in
                                    -- Overwrite the report file with the final report that includes the behavior verdict
                                    if behaviorVerdict /= Nothing then
                                        System.File.writeText permissions.fileSystem
                                            (Path.join [ output, Path.fromPosixString "elm-to-gren.report.json" ])
                                            (finalReport ++ "\n")
                                            |> Task.map
                                                (\_ ->
                                                    { output = output
                                                    , rootPackage = rootIdentity.grenName
                                                    , packageCount = Array.length planned.packages
                                                    , testModuleCount = planned.testModuleCount
                                                    , report = finalReport
                                                    , behaviorMessage = behaviorMessage
                                                    }
                                                )

                                    else
                                        Task.succeed
                                            { output = output
                                            , rootPackage = rootIdentity.grenName
                                            , packageCount = Array.length planned.packages
                                            , testModuleCount = planned.testModuleCount
                                            , report = report
                                            , behaviorMessage = behaviorMessage
                                            }
                                )
                    )


{-| Pretty-print every emitted package (skip volume catalogs), then verify with Gren.
-}
prepareStaging
    : Context
    -> Permissions
    -> Assets
    -> Plan.Identity
    -> Planned
    -> Path
    -> Task Error {}
prepareStaging context permissions assets rootIdentity planned staging =
    -- D48 phase 1: land every cache-hit package's verified bytes BEFORE any
    -- verify runs (the root's verify builds the dep dirs, so copies must be
    -- complete first regardless of package iteration order).
    planned.packages
        |> Array.foldl
            (\package pending ->
                pending
                    |> Task.andThen
                        (\_ ->
                            when Dict.get package.sourcePackage planned.portedCacheHits is
                                Just cachePath ->
                                    replaceSrcFromEntry context
                                        permissions
                                        (Dict.get package.sourcePackage planned.shimStripped
                                            |> Maybe.withDefault []
                                        )
                                        cachePath
                                        (Workspace.packageDirectory rootIdentity.grenName staging package)

                                Nothing ->
                                    Task.succeed {}
                        )
            )
            (Task.succeed {})
        |> Task.andThen
            (\_ ->
                planned.packages
                    |> Array.foldl
                        (\package pending ->
                            pending
                                |> Task.andThen
                                    (\_ ->
                                        prepareOnePackage context permissions assets rootIdentity planned staging package
                                    )
                        )
                        (Task.succeed {})
            )


prepareOnePackage
    : Context
    -> Permissions
    -> Assets
    -> Plan.Identity
    -> Planned
    -> Path
    -> Workspace.Package
    -> Task Error {}
prepareOnePackage context permissions assets rootIdentity planned staging package =
    let
        dir =
            Workspace.packageDirectory rootIdentity.grenName staging package

        elmName =
            package.sourcePackage
    in
    when Dict.get elmName planned.portedCacheHits is
        Just _ ->
            -- Cache hit: verified bytes were copied in prepareStaging's D48
            -- phase 1; gren.json is re-planned. Nothing further to do.
            Task.succeed {}

        Nothing ->
            announcePhase context "format" package.manifest.name
                |> Task.andThen
                    (\_ ->
                        maybeFormatPackage context.platform permissions.fileSystem permissions.childProcess assets.formatExecutable dir
                    )
                |> Task.andThen
                    (\_ ->
                        announcePhase context "verify" package.manifest.name
                    )
                |> Task.andThen
                    (\_ ->
                        verifyStagedPackage context permissions assets rootIdentity planned staging package
                    )
                |> Task.andThen
                    (\_ ->
                        when Dict.get elmName planned.portedCachePending is
                            Nothing ->
                                Task.succeed {}

                            Just pending ->
                                let
                                    entry =
                                        PortedCache.entryPath pending.cacheRoot pending.coordinate pending.digest

                                    platformName =
                                        when package.manifest.platform is
                                            GrenPlatform.Common ->
                                                "common"

                                            GrenPlatform.Browser ->
                                                "browser"

                                            GrenPlatform.Node ->
                                                "node"
                                in
                                PortedCache.store context.platform
                                    permissions.childProcess
                                    permissions.fileSystem
                                    entry
                                    dir
                                    context.toolVersion
                                    pending.digest
                                    platformName
                                    pending.exports
                                    (Dict.get elmName planned.shimStripped
                                        |> Maybe.withDefault []
                                    )
                    )


{-| Format unless the package is a volume catalog (icon/CSS dumps).
-}
maybeFormatPackage
    : Node.Platform
    -> FileSystem.Permission
    -> ChildProcess.Permission
    -> String
    -> Path
    -> Task Error {}
maybeFormatPackage platform fileSystem permission formatExecutable packageDir =
    Volume.scanPackageDirectory fileSystem packageDir
        |> Task.andThen
            (\metrics ->
                if Volume.shouldSkipFormat metrics then
                    Task.succeed {}

                else
                    Format.formatPackage platform
                        fileSystem
                        permission
                        { packageDirectory = packageDir
                        , formatExecutable = formatExecutable
                        }
            )


{-| D69: verify one staged package, and never report a pointer to a diagnostic
we can produce ourselves.

`gren` compiles a package's dependencies before the package itself. When one of
those dependencies fails, gren reports `PROBLEM BUILDING DEPENDENCIES`, names
the dependency, and then elides the compiler error it just saw. Reported as-is
that says only "something under this tree does not compile" — the D64 failure
mode, a diagnostic that names neither the module nor the fault.

Every dependency is vendored in the same staging tree, so on that exact failure
we compile the blamed package directly and fail with ITS diagnostic. Verifying
the blame chain is bounded by the package count, and only ever runs on the
failure path, so a passing port pays nothing.

-}
verifyStagedPackage
    : Context
    -> Permissions
    -> Assets
    -> Plan.Identity
    -> Planned
    -> Path
    -> Workspace.Package
    -> Task Error {}
verifyStagedPackage context permissions assets rootIdentity planned staging package =
    verifyOne context permissions assets rootIdentity planned staging package
        |> Task.onError
            (\error ->
                escalateDependencyBlame context
                    permissions
                    assets
                    rootIdentity
                    planned
                    staging
                    (Array.length planned.packages)
                    [ package.manifest.name ]
                    error
            )


verifyOne
    : Context
    -> Permissions
    -> Assets
    -> Plan.Identity
    -> Planned
    -> Path
    -> Workspace.Package
    -> Task Error {}
verifyOne context permissions assets rootIdentity planned staging package =
    Verify.Package.verify context.platform
        permissions.childProcess
        { packageDirectory = Workspace.packageDirectory rootIdentity.grenName staging package
        , grenExecutable = assets.grenExecutable
        , label = package.manifest.name ++ " " ++ package.manifest.version
        , isApplication =
            when package.manifest.kind is
                Manifest.ApplicationKind ->
                    True

                Manifest.PackageKind ->
                    False
        }


escalateDependencyBlame
    : Context
    -> Permissions
    -> Assets
    -> Plan.Identity
    -> Planned
    -> Path
    -> Int
    -> Array String
    -> Error
    -> Task Error {}
escalateDependencyBlame context permissions assets rootIdentity planned staging fuel visited error =
    let
        blamed =
            if fuel <= 0 then
                Nothing

            else
                Verify.Package.buildingDependency (PortError.message error)

        target =
            blamed
                |> Maybe.andThen
                    (\blamedName ->
                        planned.packages
                            |> Array.findFirst
                                (\candidate ->
                                    candidate.manifest.name
                                        == blamedName
                                        && not (Array.member candidate.manifest.name visited)
                                )
                            |> Maybe.map .value
                    )
    in
    when target is
        Nothing ->
            Task.fail error

        Just candidate ->
            announcePhase context "verify (blamed dependency)" candidate.manifest.name
                |> Task.andThen
                    (\_ ->
                        verifyOne context permissions assets rootIdentity planned staging candidate
                    )
                |> Task.andThen
                    -- The blamed package compiles in isolation: gren saw
                    -- something we cannot reproduce, so the original report
                    -- stays the truth rather than being replaced by silence.
                    (\_ -> Task.fail error)
                |> Task.onError
                    (\deeper ->
                        escalateDependencyBlame context
                            permissions
                            assets
                            rootIdentity
                            planned
                            staging
                            (fuel - 1)
                            (Array.pushLast candidate.manifest.name visited)
                            deeper
                    )


locateAssets : Context -> FileSystem.Permission -> Task Error Assets
locateAssets context permission =
    let
        applicationRoot =
            context.applicationPath
                |> Path.parentPath
                |> Maybe.andThen Path.parentPath
                |> Maybe.withDefault context.workingDirectory

        candidates =
            [ applicationRoot, context.workingDirectory ]
    in
    findAssetRoot permission candidates
        |> Task.andThen
            (\root ->
                bundledBinary context.platform permission root "elm"
                    |> Task.andThen
                        (\elmExecutable ->
                            Task.map3
                                (\elmReviewExecutable grenExecutable formatExecutable ->
                                    { root = root
                                    , mappings = Path.join [ root, Path.fromPosixString "mappings/builtin.json" ]
                                    , review = Path.join [ root, Path.fromPosixString "review" ]
                                    , elmReviewExecutable = elmReviewExecutable
                                    , elmExecutable = elmExecutable
                                    , grenExecutable = grenExecutable
                                    , formatExecutable = formatExecutable
                                    }
                                )
                                (binary context.platform permission root "elm-review")
                                (binary context.platform permission root "gren")
                                (formatTool permission root)
                        )
            )


{-| Vendored gilramir/gren-format Node app under tools/gren-format/app.
-}
formatTool : FileSystem.Permission -> Path -> Task Error String
formatTool permission root =
    let
        candidate =
            Path.join [ root, Path.fromPosixString "tools/gren-format/app" ]
    in
    System.File.exists permission candidate
        |> Task.andThen
            (\exists ->
                if exists then
                    Task.succeed (Path.toPosixString candidate)

                else
                    Task.fail <|
                        PortError.create "ASSET_NOT_FOUND"
                            ("Could not locate tools/gren-format/app under " ++ Path.toPosixString root ++ ".")
            )


findAssetRoot : FileSystem.Permission -> Array Path -> Task Error Path
findAssetRoot permission candidates =
    when Array.popFirst candidates is
        Nothing ->
            Task.fail (PortError.create "ASSET_NOT_FOUND" "Could not locate bundled mappings and elm-review rules.")

        Just { first = candidate, rest } ->
            Task.map2 (&&)
                (System.File.exists permission (Path.join [ candidate, Path.fromPosixString "mappings/builtin.json" ]))
                (System.File.exists permission (Path.join [ candidate, Path.fromPosixString "review/elm.json" ]))
                |> Task.andThen
                    (\valid ->
                        if valid then
                            Task.succeed candidate

                        else
                            findAssetRoot permission rest
                    )


binary : Node.Platform -> FileSystem.Permission -> Path -> String -> Task error String
binary platform permission root name =
    bundledBinary platform permission root name
        |> Task.map (Maybe.withDefault name)


{-| The named executable as this tool installed it, or Nothing when it is not
there. Callers that can do something better than a PATH lookup — passing
elm-review an explicit `--compiler`, say — need to tell the two cases apart.
-}
bundledBinary : Node.Platform -> FileSystem.Permission -> Path -> String -> Task error (Maybe String)
bundledBinary platform permission root name =
    let
        binDirectory =
            Path.join [ root, Path.fromPosixString "node_modules/.bin" ]

        candidates =
            when platform is
                Node.Win32 ->
                    -- npm installs Windows cmd shims as name.cmd; prefer those so
                    -- ChildProcess.NoShell can spawn without a shell.
                    [ Path.join [ binDirectory, Path.fromPosixString (name ++ ".cmd") ]
                    , Path.join [ binDirectory, Path.fromPosixString name ]
                    ]

                _ ->
                    [ Path.join [ binDirectory, Path.fromPosixString name ] ]
    in
    firstExistingBinary platform permission candidates


firstExistingBinary : Node.Platform -> FileSystem.Permission -> Array Path -> Task error (Maybe String)
firstExistingBinary platform permission candidates =
    when Array.popFirst candidates is
        Nothing ->
            Task.succeed Nothing

        Just { first = candidate, rest } ->
            System.File.exists permission candidate
                |> Task.andThen
                    (\exists ->
                        if exists then
                            Task.succeed (Just (System.File.pathToString platform candidate))

                        else
                            firstExistingBinary platform permission rest
                    )


{-| The probe is bookkeeping, not verification: under full suite
concurrency `gren --version` gets starved and emits nothing (observed
live at -j5), so a single failed attempt must never kill a port.
Three attempts before giving up.
-}
compilerVersion : Node.Platform -> ChildProcess.Permission -> String -> Task Error String
compilerVersion platform permission executable =
    compilerVersionAttempt platform permission executable 3


compilerVersionAttempt : Node.Platform -> ChildProcess.Permission -> String -> Int -> Task Error String
compilerVersionAttempt platform permission executable attemptsLeft =
    System.Process.run permission
        { program = executable
        , arguments = [ "--version" ]
        , workingDirectory = "."
        , environment = Dict.empty
        , allowedExitCodes = [ 0 ]
        , timeoutMilliseconds = 30 * 1000
        , maximumOutputBytes = 1024 * 1024
        }
        |> Task.andThen
            (\output ->
                let
                    value =
                        String.trim output.stdout
                in
                when Semver.parseVersion value is
                    Ok _ ->
                        Task.succeed value

                    Err _ ->
                        Task.fail (PortError.create "GREN_VERIFY_FAILED" "Gren returned an invalid version string.")
            )
        |> Task.onError
            (\probeError ->
                if attemptsLeft > 1 then
                    compilerVersionAttempt platform permission executable (attemptsLeft - 1)

                else
                    Task.fail probeError
            )


{-| SHA-256 of mapping file texts already loaded by `Mapping.Load`. Content
only: absolute paths would make the lockfile digest machine-specific for
identical mapping files.
-}
mappingDigestFromTexts : Array String -> Task Error String
mappingDigestFromTexts texts =
    System.Hash.requireSha256Hex
        (String.join "\n---elm-to-gren-mapping---\n" texts)
        |> Task.mapError (\reason -> PortError.create "CRYPTO_FAILED" reason)


encodeReport context cliOptions output rootIdentity compiler planned behaviorVerdict =
    let
        baseObject =
            [ { key = "schemaVersion", value = Encode.int 1 }
            , { key = "root", value = Encode.string rootIdentity.grenName }
            , { key = "toolVersion", value = Encode.string context.toolVersion }
            , { key = "compilerVersion", value = Encode.string compiler }
            , { key = "output", value = Encode.string (Path.toPosixString output) }
            , { key = "verified", value = Encode.bool True }
            , { key = "packages", value = Encode.array encodePackage planned.packages }
            , { key = "diagnostics", value = Encode.array encodeDiagnostic planned.diagnostics }
            ]

        withBehavior =
            when behaviorVerdict is
                Just verdict ->
                    Array.pushLast
                        { key = "behavior"
                        , value =
                            Encode.object
                                [ { key = "status", value = Encode.string verdict.status }
                                , { key = "detail", value = Encode.string verdict.detail }
                                ]
                        }
                        baseObject

                Nothing ->
                    baseObject
    in
    Encode.object withBehavior
        |> Encode.encode 2


encodeLock resolution rootIdentity compiler digest planned =
    Encode.object
        [ { key = "schemaVersion", value = Encode.int 1 }
        , { key = "root", value = Encode.string (PackageName.toString resolution.root) }
        , { key = "grenRoot", value = Encode.string rootIdentity.grenName }
        , { key = "grenCompiler", value = Encode.string compiler }
        , { key = "mappingDigest", value = Encode.string digest }
        , { key = "packages", value = Encode.array (encodeLockPackage resolution planned) resolution.order }
        ]
        |> Encode.encode 2


encodePackage package =
    Encode.object
        [ { key = "elmName", value = Encode.string package.sourcePackage }
        , { key = "grenName", value = Encode.string package.manifest.name }
        , { key = "version", value = Encode.string package.manifest.version }
        , { key = "platform", value = GrenPlatform.toJson package.manifest.platform }
        , { key = "moduleCount", value = Encode.int (Array.length package.modules) }
        ]


encodeLockPackage resolution planned name =
    let
        key =
            PackageName.toString name

        identityRecord =
            Dict.get key planned.identities

        version =
            Dict.get key resolution.packages
                |> Maybe.map (.manifest >> .version >> Semver.versionToString)
                |> Maybe.withDefault ""
    in
    Encode.object
        [ { key = "elmName", value = Encode.string key }
        , { key = "elmVersion", value = Encode.string version }
        , { key = "grenName", value = Encode.string (identityRecord |> Maybe.map .grenName |> Maybe.withDefault "") }
        , { key = "strategy", value = Encode.string "transpile" }
        ]


encodeDiagnostic diagnostic =
    Encode.object
        [ { key = "code", value = Encode.string diagnostic.code }
        , { key = "severity", value = Encode.string diagnostic.severity }
        , { key = "message", value = Encode.string diagnostic.message }
        , { key = "file", value = JsonPairs.maybeString diagnostic.path }
        , { key = "module", value = JsonPairs.maybeString diagnostic.moduleName }
        ]


-- ELM. NAMESPACING (Feature 2)


{-| Prefix a ported module with `Elm.`: its declared name, its file path, and
the `module ...` header inside its source. Applied only to ported package
modules; compatibility adapters keep their own names.
-}
namespaceGeneratedModule : Mapping.GeneratedModule -> Mapping.GeneratedModule
namespaceGeneratedModule generated =
    { moduleName = "Elm." ++ generated.moduleName
    , relativePath = namespaceModulePath generated.relativePath
    , source = namespaceModuleDeclaration generated.moduleName generated.source
    }


namespaceModulePath : String -> String
namespaceModulePath path =
    if String.startsWith "src/" path then
        "src/Elm/" ++ String.dropFirst 4 path

    else
        "Elm/" ++ path


{-| Rewrite the `module Name` / `port module Name` / `effect module Name`
declaration to `Elm.Name` on the first source line that is an actual module
header. Line-based (not free-text) so a comment that happens to mention
`module Name` before the declaration is left alone.
-}
namespaceModuleDeclaration : String -> String -> String
namespaceModuleDeclaration moduleName source =
    let
        trailingNewline =
            String.endsWith "\n" source

        body =
            if trailingNewline then
                String.dropLast 1 source

            else
                source

        lines =
            String.lines body

        rewritten =
            when Array.findFirst (lineDeclaresModule moduleName) lines is
                Nothing ->
                    lines

                Just found ->
                    Array.set found.index
                        (String.replace
                            ("module " ++ moduleName)
                            ("module Elm." ++ moduleName)
                            found.value
                        )
                        lines
    in
    String.join "\n" rewritten
        ++ (if trailingNewline then
                "\n"

            else
                ""
           )


lineDeclaresModule : String -> String -> Bool
lineDeclaresModule moduleName line =
    let
        trimmed =
            String.trimLeft line

        prefixes =
            [ "port module " ++ moduleName
            , "effect module " ++ moduleName
            , "module " ++ moduleName
            ]
    in
    Array.any
        (\prefix ->
            if String.startsWith prefix trimmed then
                moduleNameBoundary (String.dropFirst (String.count prefix) trimmed)

            else
                False
        )
        prefixes


{-| True when the character after a candidate module name cannot extend that
name (`module Foo` must not match `module Foo.Bar` or `module FooBar`).
-}
moduleNameBoundary : String -> Bool
moduleNameBoundary rest =
    when String.popFirst rest is
        Nothing ->
            True

        Just { first } ->
            not (Char.isAlphaNum first || first == '_' || first == '.')


{-| Overlay a synthetic `M -> Elm.M` mapping for every module in every ported
package, so the transform pass rewrites cross-module imports and qualified
references to the namespaced names. Ported module names never collide with the
built-in stdlib mappings (Elm guarantees globally unique module names), so this
only ever adds entries.
-}
manifestDependencyRanges : Manifest -> Dict String Semver.Range
manifestDependencyRanges manifest =
    Dict.foldl
        (\name dependency found ->
            Dict.set name dependency.constraint found
        )
        (Dict.map (\_ dependency -> dependency.constraint) manifest.dependencies)
        manifest.testDependencies


overlayPortedModules : Dict String Acquire.PackageSource -> Registry -> Registry
overlayPortedModules sources registry =
    let
        modules =
            Dict.foldl
                (\_ source outer ->
                    Array.foldl
                        (\filename inner ->
                            when moduleNameFromSource source.root filename is
                                Just name ->
                                    Dict.set name
                                        { source = name
                                        , target = "Elm." ++ name
                                        , values = Dict.empty
                                        , types = Dict.empty
                                        , recordAliases = Dict.empty
                                        , constructorFields = Dict.empty
                                        }
                                        inner

                                Nothing ->
                                    inner
                        )
                        outer
                        source.sourceFiles
                )
                registry.modules
                sources
    in
    { registry | modules = modules }


moduleNameFromSource : Path -> Path -> Maybe String
moduleNameFromSource root filename =
    when relativeSourcePath root filename is
        Ok relative ->
            pathModuleName relative

        Err _ ->
            Nothing


namespaceExposedModules : Workspace.Package -> Workspace.Package
namespaceExposedModules package =
    let
        manifest =
            package.manifest

        exposed =
            when manifest.exposedModules is
                ExposedArray names ->
                    ExposedArray (Array.map (\name -> prefixIfNeeded name) names)

                ExposedDict groups ->
                    ExposedDict (Dict.map (\_ names -> Array.map (\name -> prefixIfNeeded name) names) groups)
    in
    { package | manifest = { manifest | exposedModules = exposed } }


prefixIfNeeded : String -> String
prefixIfNeeded name =
    if String.startsWith "Elm." name then
        name

    else
        "Elm." ++ name



-- ADD: VENDOR INTO AN EXISTING GREN PROJECT (Feature 1)


{-| Vendor the ported library and its transpiled dependencies as source under
`<project>/.elm-to-gren/packages/`, then add the library to the project's
`gren.json` as a local dependency. Idempotent: re-running overwrites the
vendored packages and updates the same dependency entry.
-}
finalizeAdd : Context -> Permissions -> Cli.Options -> Path -> Assets -> Resolution -> Planned -> Task Error Outcome
finalizeAdd context permissions cliOptions output assets resolution planned =
    let
        rootKey =
            PackageName.toString resolution.root
    in
    when Dict.get rootKey planned.identities is
        Nothing ->
            Task.fail (PortError.create "INTERNAL_ERROR" "Root package identity was not planned.")

        Just rootIdentity ->
            let
                packagesRoot =
                    Path.join [ output, Path.fromPosixString ".elm-to-gren/packages" ]

                -- The library is placed as a sibling of its dependencies, so its
                -- own `local:.elm-to-gren/packages/X` deps become `local:../X`.
                vendored =
                    Array.map
                        (\package ->
                            if package.manifest.name == rootIdentity.grenName then
                                { package | manifest = siblingRelativeManifest package.manifest }

                            else
                                package
                        )
                        planned.packages

                libDirectory =
                    Workspace.packageDirectoryName
                        { name = rootIdentity.grenName, version = rootIdentity.version }

                -- Transitive registry (mapped) deps the library needs. gren
                -- resolves local deps without re-solving, so it wants these in
                -- the app's `indirect` at the library's declared lower bound.
                -- When several packages pin the same dep, keep the highest lower
                -- bound so a looser sibling cannot regress a stricter one.
                indirectDependencies =
                    Array.foldl
                        (\package collected ->
                            Dict.foldl
                                (\name dependency inner ->
                                    when dependency is
                                        VersionRange range ->
                                            mergeLowerBound name (lowerBoundVersion range) inner

                                        LocalPath _ ->
                                            inner
                                )
                                collected
                                package.manifest.dependencies
                        )
                        Dict.empty
                        planned.packages

                -- The library's own transpiled dependencies, which are vendored
                -- beside it and which its manifest names `local:../X`.
                --
                -- Gren refuses a dependency that declares a local dependency of
                -- its own "unless they happen to point to the same local
                -- dependency as the root project" — so the app has to name them
                -- too, from its own vantage point. `local:../X` and
                -- `local:.elm-to-gren/packages/X` are the same directory read
                -- from the two places, which is exactly what the resolver
                -- checks. Leave these out and every add of a package with a
                -- transpiled dependency fails verification and rolls back.
                vendoredLocalDependencies =
                    Array.foldl
                        (\package collected ->
                            if package.manifest.name == rootIdentity.grenName then
                                collected

                            else
                                Dict.set package.manifest.name
                                    ("local:.elm-to-gren/packages/"
                                        ++ Workspace.packageDirectoryName
                                            { name = package.manifest.name
                                            , version = package.manifest.version
                                            }
                                    )
                                    collected
                        )
                        Dict.empty
                        planned.packages

                dependencyValue =
                    "local:.elm-to-gren/packages/" ++ libDirectory

                manifestPath =
                    Path.join [ output, Path.fromPosixString "gren.json" ]

            in
            -- Validate and build the updated gren.json *before* writing packages,
            -- so a non-application project fails without leaving vendor debris.
            System.File.readText permissions.fileSystem manifestPath
                |> Task.mapError
                    (\_ ->
                        PortError.create "ADD_FAILED"
                            ("Could not read " ++ Path.toPosixString manifestPath ++ ". Run `add` from a Gren application root.")
                    )
                |> Task.andThen
                    (\manifestText ->
                        when applyManifestChanges manifestText rootIdentity.grenName dependencyValue indirectDependencies vendoredLocalDependencies is
                            Err error ->
                                Task.fail error

                            Ok updatedManifest ->
                                generateStagingPath packagesRoot
                                    |> Task.andThen
                                        (\staging ->
                                            System.File.ensureDirectory permissions.fileSystem staging
                                                |> Task.andThen
                                                    (\_ ->
                                                        AddTransaction.seedStaging
                                                            permissions.fileSystem
                                                            packagesRoot
                                                            staging
                                                    )
                                                |> Task.andThen
                                                    (\_ ->
                                                        writeVendored context
                                                            permissions
                                                            assets
                                                            staging
                                                            planned
                                                            vendored
                                                    )
                                                |> Task.andThen
                                                    (\_ ->
                                                        AddTransaction.commit permissions.fileSystem
                                                            { destination = packagesRoot
                                                            , staging = staging
                                                            , manifestPath = manifestPath
                                                            , updatedManifest = updatedManifest
                                                            , validatePublished =
                                                                -- D51: the vendored tree is OURS — it must compile
                                                                -- as a package or the publication rolls back. The
                                                                -- consumer application is theirs: a pre-existing
                                                                -- error in it is reported, never fatal.
                                                                Verify.Package.verify context.platform
                                                                    permissions.childProcess
                                                                    { packageDirectory =
                                                                        Path.join
                                                                            [ packagesRoot
                                                                            , Path.fromPosixString libDirectory
                                                                            ]
                                                                    , grenExecutable = assets.grenExecutable
                                                                    , label = rootIdentity.grenName ++ " " ++ rootIdentity.version
                                                                    , isApplication = False
                                                                    }
                                                                    |> Task.andThen
                                                                        (\_ ->
                                                                            Verify.Package.verifyConsumer context.platform
                                                                                permissions.childProcess
                                                                                { applicationDirectory = output
                                                                                , grenExecutable = assets.grenExecutable
                                                                                , vendorDirectory = ".elm-to-gren/packages"
                                                                                }
                                                                        )
                                                            }
                                                    )
                                                |> Task.andThen
                                                    (\verdict ->
                                                        logConsumerVerdict context verdict
                                                            |> Task.map
                                                                (\_ ->
                                                                    { output = output
                                                                    , rootPackage = rootIdentity.grenName
                                                                    , packageCount = Array.length planned.packages
                                                                    , testModuleCount = planned.testModuleCount
                                                                    , report = addReport rootIdentity libDirectory planned
                                                                    , behaviorMessage = Nothing
                                                                    }
                                                                )
                                                    )
                                                |> Task.onError
                                                    (\error ->
                                                        removePath permissions.fileSystem staging
                                                            |> Task.onError (\_ -> Task.succeed {})
                                                            |> Task.andThen (\_ -> Task.fail error)
                                                    )
                                        )

                    )


writeVendored
    : Context
    -> Permissions
    -> Assets
    -> Path
    -> Planned
    -> Array Workspace.Package
    -> Task Error {}
writeVendored context permissions assets packagesRoot planned packages =
    Array.foldl
        (\package pending ->
            pending
                |> Task.andThen
                    (\_ ->
                        when PackageEmit.prepare package is
                            Err error ->
                                Task.fail error

                            Ok prepared ->
                                let
                                    directory =
                                        Path.join
                                            [ packagesRoot
                                            , Path.fromPosixString
                                                (Workspace.packageDirectoryName
                                                    { name = prepared.manifest.name
                                                    , version = prepared.manifest.version
                                                    }
                                                )
                                            ]

                                    elmName =
                                        package.sourcePackage
                                in
                                removePath permissions.fileSystem directory
                                    |> Task.andThen
                                        (\_ ->
                                            PackageEmit.write permissions.fileSystem directory prepared
                                                |> Task.andThen
                                                    (\_ ->
                                                        when Dict.get elmName planned.portedCacheHits is
                                                            Just cachePath ->
                                                                -- Hit: serve the entry's verified bytes (D48).
                                                                replaceSrcFromEntry context
                                                                    permissions
                                                                    (Dict.get elmName planned.shimStripped
                                                                        |> Maybe.withDefault []
                                                                    )
                                                                    cachePath
                                                                    directory

                                                            Nothing ->
                                                                maybeFormatPackage context.platform
                                                                    permissions.fileSystem
                                                                    permissions.childProcess
                                                                    assets.formatExecutable
                                                                    directory
                                                                    |> Task.andThen
                                                                        (\_ ->
                                                                            Verify.Package.verify context.platform
                                                                                permissions.childProcess
                                                                                { packageDirectory = directory
                                                                                , grenExecutable = assets.grenExecutable
                                                                                , label = prepared.manifest.name ++ " " ++ prepared.manifest.version
                                                                                , isApplication =
                                                                                    when package.manifest.kind is
                                                                                        Manifest.ApplicationKind ->
                                                                                            True

                                                                                        Manifest.PackageKind ->
                                                                                            False
                                                                                }
                                                                        )
                                                                    |> Task.andThen
                                                                        (\_ ->
                                                                            when Dict.get elmName planned.portedCachePending is
                                                                                Nothing ->
                                                                                    Task.succeed {}

                                                                                Just storePending ->
                                                                                    let
                                                                                        entry =
                                                                                            PortedCache.entryPath storePending.cacheRoot storePending.coordinate storePending.digest

                                                                                        platformName =
                                                                                            when package.manifest.platform is
                                                                                                GrenPlatform.Common ->
                                                                                                    "common"

                                                                                                GrenPlatform.Browser ->
                                                                                                    "browser"

                                                                                                GrenPlatform.Node ->
                                                                                                    "node"
                                                                                    in
                                                                                    PortedCache.store context.platform
                                                                                        permissions.childProcess
                                                                                        permissions.fileSystem
                                                                                        entry
                                                                                        directory
                                                                                        context.toolVersion
                                                                                        storePending.digest
                                                                                        platformName
                                                                                        storePending.exports
                                                                                        (Dict.get elmName planned.shimStripped
                                                                                            |> Maybe.withDefault []
                                                                                        )
                                                                        )
                                                    )
                                        )
                    )
        )
        (Task.succeed {})
        packages


siblingRelativeManifest : Manifest.Spec -> Manifest.Spec
siblingRelativeManifest spec =
    { spec | dependencies = Dict.map (\_ dependency -> siblingRelativeDependency dependency) spec.dependencies }


siblingRelativeDependency : Dependency -> Dependency
siblingRelativeDependency dependency =
    when dependency is
        LocalPath path ->
            if String.startsWith ".elm-to-gren/packages/" path then
                LocalPath ("../" ++ String.dropFirst (String.count ".elm-to-gren/packages/") path)

            else
                dependency

        VersionRange _ ->
            dependency


removePath : FileSystem.Permission -> Path -> Task Error {}
removePath permission path =
    System.File.removeIfExists permission "ADD_FAILED" path


generateStagingPath : Path -> Task Error Path
generateStagingPath destination =
    System.Hash.requireUuid
        |> Task.mapError
            (\_ ->
                PortError.create "ADD_FAILED"
                    "Secure randomness is unavailable for staging packages."
            )
        |> Task.map
            (\uuid ->
                System.File.tempSibling destination (".elm-to-gren-" ++ uuid)
            )


lowerBoundVersion : String -> String
lowerBoundVersion range =
    when Array.first (String.split " " (String.trim range)) is
        Just version ->
            version

        Nothing ->
            range


{-| Prefer the higher of two version pins. Unparseable values keep `existing`.
-}
preferHigherVersion : String -> String -> String
preferHigherVersion existing candidate =
    when Result.map2 Semver.compare (Semver.parseVersion existing) (Semver.parseVersion candidate) is
        Ok LT ->
            candidate

        Ok _ ->
            existing

        Err _ ->
            existing


mergeLowerBound : String -> String -> Dict String String -> Dict String String
mergeLowerBound name candidate deps =
    when Dict.get name deps is
        Nothing ->
            Dict.set name candidate deps

        Just existing ->
            Dict.set name (preferHigherVersion existing candidate) deps


{-| Add the library to `dependencies.direct` and everything the vendored tree
needs to `dependencies.indirect`, preserving every other field. The library is
removed from `indirect` if it was already there, so it is not listed twice.

`indirectDependencies` are registry packages, added only where the app is
silent — an existing pin is the project's business.
`vendoredLocalDependencies` are the sibling packages this tool just wrote, so
their paths are restated on every add: a stale one points at a directory that
no longer holds the version the library now asks for.
-}
applyManifestChanges : String -> String -> String -> Dict String String -> Dict String String -> Result Error String
applyManifestChanges manifestText name value indirectDependencies vendoredLocalDependencies =
    Decode.decodeString (Decode.keyValuePairs Decode.value) manifestText
        |> Result.mapError
            (\problem ->
                PortError.create "ADD_FAILED"
                    ("gren.json is not a JSON object: " ++ Decode.errorToString problem)
            )
        |> Result.andThen requireApplicationManifest
        |> Result.andThen
            (\topPairs ->
                requireObjectPairs "dependencies" topPairs
                    |> Result.andThen
                        (\dependencies ->
                            Result.map2
                                (\directBase indirectBase ->
                                    let
                                        direct =
                                            JsonPairs.setPair name (Encode.string value) directBase

                                        -- Drop the library from indirect if a previous
                                        -- install left it there; a package cannot live in
                                        -- both direct and indirect.
                                        indirectWithoutLibrary =
                                            JsonPairs.removePair name indirectBase

                                        withIndirect =
                                            Dict.foldl
                                                (\dependencyName dependencyVersion accumulated ->
                                                    if JsonPairs.hasPair dependencyName direct || JsonPairs.hasPair dependencyName accumulated then
                                                        accumulated

                                                    else
                                                        JsonPairs.setPair dependencyName (Encode.string dependencyVersion) accumulated
                                                )
                                                indirectWithoutLibrary
                                                indirectDependencies

                                        indirect =
                                            Dict.foldl
                                                (\dependencyName localValue accumulated ->
                                                    if JsonPairs.hasPair dependencyName direct then
                                                        accumulated

                                                    else
                                                        JsonPairs.setPair dependencyName (Encode.string localValue) accumulated
                                                )
                                                withIndirect
                                                vendoredLocalDependencies

                                        newDependencies =
                                            dependencies
                                                |> JsonPairs.setPair "direct" (JsonPairs.objectFromPairs direct)
                                                |> JsonPairs.setPair "indirect" (JsonPairs.objectFromPairs indirect)

                                        newTop =
                                            JsonPairs.setPair "dependencies" (JsonPairs.objectFromPairs newDependencies) topPairs
                                    in
                                    Encode.encode 4 (JsonPairs.objectFromPairs newTop) ++ "\n"
                                )
                                (requireObjectPairs "direct" dependencies)
                                (requireObjectPairs "indirect" dependencies)
                        )
            )


requireApplicationManifest : Array Pair -> Result Error (Array Pair)
requireApplicationManifest topPairs =
    when JsonPairs.pairString "type" topPairs is
        Just "application" ->
            Ok topPairs

        Just other ->
            Err <|
                PortError.create "ADD_FAILED"
                    ("gren.json type is \""
                        ++ other
                        ++ "\"; `add` requires a Gren application project."
                    )

        Nothing ->
            Err <|
                PortError.create "ADD_FAILED"
                    "gren.json is missing a type field; `add` requires a Gren application project."


requireObjectPairs : String -> Array Pair -> Result Error (Array Pair)
requireObjectPairs key pairs =
    JsonPairs.objectPairs key pairs
        |> Result.mapError
            (\problem ->
                PortError.create "ADD_FAILED" ("gren.json: " ++ problem)
            )


addReport : Plan.Identity -> String -> Planned -> String
addReport rootIdentity libDirectory planned =
    Encode.object
        [ { key = "schemaVersion", value = Encode.int 1 }
        , { key = "command", value = Encode.string "add" }
        , { key = "library", value = Encode.string rootIdentity.grenName }
        , { key = "vendorPath", value = Encode.string (".elm-to-gren/packages/" ++ libDirectory) }
        , { key = "packageCount", value = Encode.int (Array.length planned.packages) }
        ]
        |> Encode.encode 2


{-| Emit the behavior harness application under behavior-tests/.
-}
emitBehaviorHarness
    : Node.Platform
    -> FileSystem.Permission
    -> Path
    -> String
    -> Array Mapping.GeneratedModule
    -> Dict String Manifest.Dependency
    -> Maybe { grenPackage : String, grenVersion : String }
    -> Task Error {}
emitBehaviorHarness platform fileSystem output rootGrenName testModules rootDependencies analogueInfo =
    let
        harnessDirPath =
            Path.join [ output, Path.fromPosixString "behavior-tests" ]

        plan =
            Behavior.planBehaviorTests rootGrenName testModules rootDependencies analogueInfo
    in
    System.File.ensureDirectory fileSystem harnessDirPath
        |> Task.andThen
            (\_ ->
                plan.files
                    |> Array.foldl
                        (\filePlan pending ->
                            pending
                                |> Task.andThen
                                    (\_ ->
                                        let
                                            filePath =
                                                Path.join [ harnessDirPath, Path.fromPosixString filePlan.relativePath ]
                                        in
                                        System.File.writeText fileSystem filePath filePlan.contents
                                            |> Task.map (\_ -> {})
                                    )
                        )
                        (Task.succeed {})
            )


type alias BehaviorVerdict =
    { status : String
    , detail : String
    }


{-| Compile the behavior harness and run it, returning a verdict.
Verdict status: "tested" | "test-failures" | "tests-unportable"
-}
compileBehaviorHarness
    : Node.Platform
    -> ChildProcess.Permission
    -> Path
    -> String
    -> Task Error BehaviorVerdict
compileBehaviorHarness platform permission output grenExecutable =
    let
        harnessDirPath =
            Path.join [ output, Path.fromPosixString "behavior-tests" ]

        harnessDirStr =
            System.File.pathToString platform harnessDirPath
    in
    System.Process.run permission
        { program = grenExecutable
        , arguments = [ "make", "Main", "--output=harness.js" ]
        , workingDirectory = harnessDirStr
        , environment = Dict.empty
        , allowedExitCodes = [ 0, 1 ]
        , timeoutMilliseconds = 300 * 1000
        , maximumOutputBytes = 10 * 1024 * 1024
        }
        |> Task.andThen
            (\compileOutput ->
                if compileOutput.exitCode == 0 then
                    -- Compilation succeeded, now run the harness
                    runBehaviorHarness platform permission harnessDirPath
                        |> Task.map
                            (\runOutput ->
                                classifyRunVerdict runOutput
                            )

                else
                    -- Compilation failed, extract error lines
                    Task.succeed
                        { status = "tests-unportable"
                        , detail = extractCompileError compileOutput.stderr compileOutput.stdout
                        }
            )


{-| Run the behavior harness and return the process output.
-}
runBehaviorHarness
    : Node.Platform
    -> ChildProcess.Permission
    -> Path
    -> Task Error System.Process.Output
runBehaviorHarness platform permission harnessDirPath =
    let
        harnessDirStr =
            System.File.pathToString platform harnessDirPath

        absHarnessPath =
            harnessDirStr ++ "/harness.js"
    in
    System.Process.run permission
        { program = "node"
        , arguments = [ "-e", "require('" ++ absHarnessPath ++ "').Gren.Main.init()" ]
        , workingDirectory = harnessDirStr
        , environment = Dict.empty
        , allowedExitCodes = [ 0, 1 ]
        , timeoutMilliseconds = 120 * 1000
        , maximumOutputBytes = 5 * 1024 * 1024
        }


{-| Classify the behavior test verdict based on exit code and output.
-}
classifyRunVerdict : System.Process.Output -> BehaviorVerdict
classifyRunVerdict output =
    let
        allOutput =
            output.stdout ++ "\n" ++ output.stderr

        lines =
            String.split "\n" allOutput

        behaviorLine =
            findBehaviorLine lines
    in
    if output.exitCode == 0 && String.contains "BEHAVIOR PASS" behaviorLine then
        { status = "tested"
        , detail = String.trim behaviorLine
        }

    else if output.exitCode == 1 && String.contains "BEHAVIOR FAIL" behaviorLine then
        { status = "test-failures"
        , detail = String.trim behaviorLine
        }

    else
        { status = "test-failures"
        , detail =
            if String.isEmpty behaviorLine then
                "Harness exited with code "
                    ++ String.fromInt output.exitCode
                    ++ " but produced no test output."

            else
                String.trim behaviorLine
        }


findBehaviorLine : Array String -> String
findBehaviorLine lines =
    when Array.first lines is
        Nothing ->
            ""

        Just line ->
            if String.startsWith "BEHAVIOR" line then
                line

            else
                findBehaviorLine (Array.dropFirst 1 lines)


{-| Extract the first compile error from stderr/stdout (max 800 chars).
-}
extractCompileError : String -> String -> String
extractCompileError stderr stdout =
    let
        errorLines =
            if String.isEmpty stderr then
                stdout

            else
                stderr

        firstError =
            String.split "\n" errorLines
                |> Array.first
                |> Maybe.withDefault errorLines

        chars =
            String.split "" firstError

        truncated =
            if Array.length chars > 800 then
                String.slice 0 800 firstError ++ "..."

            else
                firstError
    in
    truncated


{-| D83: union ctor→modules maps when folding dependencies. Duplicates for
the same (ctor, module) pair are dropped so CtorHome's sole-home count stays
accurate.
-}
mergeCtorHomes :
    Dict String (Array String)
    -> Dict String (Array String)
    -> Dict String (Array String)
mergeCtorHomes left right =
    Dict.foldl
        (\ctor modules acc ->
            Dict.update ctor
                (\existing ->
                    when existing is
                        Just prev ->
                            Just (uniqueAppendModules prev modules)

                        Nothing ->
                            Just modules
                )
                acc
        )
        left
        right


uniqueAppendModules : Array String -> Array String -> Array String
uniqueAppendModules base extra =
    Array.foldl
        (\moduleName acc ->
            if Array.any (\m -> m == moduleName) acc then
                acc

            else
                Array.pushLast moduleName acc
        )
        base
        extra


{-| D89: the module name a file at `relative` would have to declare.

Elm resolves a module name to exactly one path under a source directory,
so `src/Eth/Sentry/Event.elm` can only ever be `Eth.Sentry.Event`.
Also used by `moduleNameFromSource` (overlay namespacing) so both paths
agree on `src/` and `tests/` layouts.
-}
pathModuleName : String -> Maybe String
pathModuleName relative =
    let
        segments =
            String.split "/" relative
    in
    when Array.popFirst segments is
        Just { first = root, rest = rest } ->
            if (root == "src" || root == "tests") && not (Array.isEmpty rest) then
                let
                    joined =
                        String.join "." rest
                in
                if String.endsWith ".elm" joined then
                    Just (String.dropLast 4 joined)

                else if String.endsWith ".gren" joined then
                    Just (String.dropLast 5 joined)

                else
                    Nothing

            else
                Nothing

        Nothing ->
            Nothing


{-| True if path and `module` declaration agree.

Elm never loads a file whose path does not match its module name; elm-review
does, and duplicate names break extract. Drop only clear mismatches.
-}
isReachableModule : String -> String -> Bool
isReachableModule relative source =
    when { path = pathModuleName relative, declared = Pipeline.declaredModuleName source } is
        { path = Just expected, declared = Just actual } ->
            expected == actual

        _ ->
            True


{-| Remove staged sources that would break elm-review (see `isReachableModule`). -}
pruneUnreachableModules : FileSystem.Permission -> Path -> Task Error {}
pruneUnreachableModules fileSystem stagedRoot =
    [ "src", "tests" ]
        |> Array.foldl
            (\directory pending ->
                pending
                    |> Task.andThen
                        (\_ ->
                            pruneUnreachableIn fileSystem stagedRoot
                                (Path.join [ stagedRoot, Path.fromPosixString directory ])
                        )
            )
            (Task.succeed {})


pruneUnreachableIn : FileSystem.Permission -> Path -> Path -> Task Error {}
pruneUnreachableIn fileSystem stagedRoot directory =
    System.File.listFilesRecursively fileSystem directory
        |> Task.onError (\_ -> Task.succeed [])
        |> Task.andThen
            (\allFiles ->
                allFiles
                    |> Array.keepIf (\file -> String.toLower file.extension == "elm")
                    |> Array.foldl
                        (\file pending ->
                            pending
                                |> Task.andThen
                                    (\_ ->
                                        when relativeSourcePath stagedRoot file is
                                            Err _ ->
                                                Task.succeed {}

                                            Ok relative ->
                                                System.File.readText fileSystem file
                                                    |> Task.onError (\_ -> Task.succeed "")
                                                    |> Task.andThen
                                                        (\contents ->
                                                            if
                                                                String.isEmpty contents
                                                                    || isReachableModule relative contents
                                                            then
                                                                Task.succeed {}

                                                            else
                                                                FileSystem.remove fileSystem
                                                                    { recursive = False }
                                                                    file
                                                                    |> Task.map (\_ -> {})
                                                                    |> Task.onError (\_ -> Task.succeed {})
                                                        )
                                    )
                        )
                        (Task.succeed {})
            )


{-| D105: drop the src modules the Elm compiler never builds.

Elm compiles a package's EXPOSED modules and whatever they transitively
import. Anything else under `src/` is dead code no `elm make` or
`elm publish` ever looks at — and because nothing checks it, it can be
outright uncompilable.

`NoRedInk/elm-debug-controls-without-datepicker` ships
`src/Controls/ComplexChoiceTest.elm`, a stray test file importing `Test`,
`Expect` and `Test.Html.*`. Those come from `elm-explorations/test`, which
the package declares as a TEST dependency — Elm rejects that import in
`src/`, which is the proof it never compiles the file. The package publishes
because nothing reaches it from `Debug.Control`. Our extractor reads every
file, so the port refused the whole package over a module Elm ignores.

D89 handled the neighbouring case (a file whose declared module name cannot
match its path). This is the same principle under the reachability rule Elm
actually uses, computed from evidence already in hand: the extraction states
every module's imports.

Modules are matched to source files by MODULE NAME, never by path: the
extractor reports a path into the staging directory it reviewed, while the
source files carry `src/…` relative to the package root. Matching those
strings against each other silently keeps nothing.

Applications are left alone — their entry is not `exposed-modules` — and so
are test modules, which are reachable by a rule of their own.
-}
dropUnreachableModules :
    Manifest
    -> Bool
    -> { extraction : Protocol.Extraction, sourceFiles : Array Pipeline.SourceFile }
    -> { extraction : Protocol.Extraction, sourceFiles : Array Pipeline.SourceFile }
dropUnreachableModules manifest includeTests inputs =
    if
        manifest.isApplication
            || includeTests
            || Array.isEmpty manifest.exposedModules
    then
        inputs

    else
        let
            byName =
                Array.foldl
                    (\one found -> Dict.set one.moduleName one found)
                    Dict.empty
                    inputs.extraction.modules

            reachable =
                reachableFrom byName manifest.exposedModules Dict.empty

            keptModules =
                Array.keepIf
                    (\one -> Dict.member one.moduleName reachable)
                    inputs.extraction.modules

            extraction =
                inputs.extraction
        in
        -- Refuse to act unless every exposed module was actually found: a
        -- reachability set that cannot see the package's own API is evidence
        -- the names do not line up, not evidence the modules are dead.
        if
            Array.length keptModules
                == Array.length inputs.extraction.modules
                || not (Array.all (\name -> Dict.member name byName) manifest.exposedModules)
        then
            inputs

        else
            { extraction = { extraction | modules = keptModules }
            , sourceFiles =
                Array.keepIf
                    (\file ->
                        when pathModuleName file.path is
                            Just name ->
                                Dict.member name reachable

                            Nothing ->
                                True
                    )
                    inputs.sourceFiles
            }


{-| Transitive closure of `pending` over the package's own import edges. -}
reachableFrom :
    Dict String Protocol.ModuleExtraction
    -> Array String
    -> Dict String {}
    -> Dict String {}
reachableFrom byName pending found =
    when Array.popFirst pending is
        Nothing ->
            found

        Just { first = name, rest = rest } ->
            if Dict.member name found then
                reachableFrom byName rest found

            else
                let
                    imports =
                        when Dict.get name byName is
                            Just one ->
                                Array.keepIf
                                    (\imported -> Dict.member imported byName)
                                    one.importedModules

                            Nothing ->
                                []
                in
                reachableFrom byName
                    (Array.append rest imports)
                    (Dict.set name {} found)
