module Verify.Package exposing (ConsumerVerdict(..), buildingDependency, verify, verifyConsumer)

import ChildProcess
import Dict
import FileSystem.Path exposing (Path)
import Node
import Port.Error as PortError exposing (Error)
import System.File
import System.Process
import Task exposing (Task)


{-| D69: a verify failure must say WHOSE compile failed.

`gren` is run from inside the package directory, so its `--report=json` blob
carries module paths but never the package the run was about. The wrapper used
to drop even the process detail's first line into `GREN_VERIFY_FAILED: gren
exited with code N.`, which names neither the package, its role in the port,
nor the compiler's own diagnostic. Every caller therefore states the package it
is verifying, and the message keeps the compiler's output verbatim underneath.

The `label` is the ported package's `name version`; the directory tells the
walk's signature extractor whether the failure sits in the root package or
under `.elm-to-gren/packages` (a dependency), which decides whether a fix is a
hub fix.

-}
verify
    : Node.Platform
    -> ChildProcess.Permission
    ->
        { packageDirectory : Path
        , grenExecutable : String
        , isApplication : Bool
        , label : String
        }
    -> Task Error {}
verify platform permission options =
    -- Applications verify via gren make (docs rejects them).
    -- Packages verify via gren docs (the definition of a valid package).
    let
        workingDir =
            System.File.pathToString platform options.packageDirectory

        makeArgs =
            [ "make", "Main", "--output=/dev/null", "--report=json" ]

        docsArgs =
            [ "docs", "--output=/dev/null", "--report=json" ]

        runGren args allowed =
            System.Process.run permission
                { program = options.grenExecutable
                , arguments = args
                , workingDirectory = workingDir
                , environment = Dict.empty
                , allowedExitCodes = allowed
                , timeoutMilliseconds = 10 * 60 * 1000
                , maximumOutputBytes = 64 * 1024 * 1024
                }
    in
    if options.isApplication then
        runGren makeArgs [ 0 ]
            |> Task.map (\_ -> {})
            |> Task.mapError (verifyFailed options.label "make" workingDir)

    else
        runGren docsArgs [ 0 ]
            |> Task.map (\_ -> {})
            |> Task.mapError (verifyFailed options.label "docs" workingDir)


{-| The `owner/name` of the package `gren` blamed in a `PROBLEM BUILDING
DEPENDENCIES` report, or `Nothing` when the failure is not of that shape.

The version gren prints alongside it is discarded on purpose: a `local:`
dependency has no registry version, so gren prints `1.0.0` for every one of
them regardless of what the vendored manifest says. Matching on it finds
nothing. Package names are unique within a port, so the name is the key.

gren reports this when a DEPENDENCY of the package under verification fails to
compile, and — this is the whole reason the function exists — it elides the
compiler error it just saw ("please report this ... along with the following
information:" followed by nothing). Every dependency we vendor is on disk next
to the package that failed, so the caller can compile the named one directly
and report a real diagnostic instead of a pointer to a missing one.

-}
buildingDependency : String -> Maybe String
buildingDependency errorText =
    if not (String.contains "PROBLEM BUILDING DEPENDENCIES" errorText) then
        Nothing

    else
        errorText
            |> String.split "trying to build the following package:"
            |> Array.dropFirst 1
            |> Array.mapAndKeepJust blamedName
            |> Array.first


{-| First `owner/name` token in a gren message tail. The tail is a JSON-escaped
block, so newlines arrive as the two characters `\n`.
-}
blamedName : String -> Maybe String
blamedName tail =
    tail
        |> String.replace "\\n" " "
        |> String.words
        |> Array.findFirst (\word -> String.contains "/" word)
        |> Maybe.map .value


{-| D51: what `add` is allowed to fail on.

An `add` is sound when the vendored tree compiles and the consumer's manifest
resolves. Whether the consumer's OWN modules compile is the consumer's
business: an application is very often mid-edit at exactly the moment a
dependency is added, and rolling the install back for an unrelated
pre-existing error makes the tool unusable when it is most needed.

So: errors implicating the manifest or the vendored tree stay fatal (they are
ours), and errors confined to the consumer's own modules are reported and
carried, never fatal.

-}
type ConsumerVerdict
    = ConsumerVerified
    | ConsumerSourceErrors String


{-| Compile the consumer application after publication. Distinguishes "our
install is broken" from "their code does not currently compile".

Discriminator: a `--report=json` run emits `{"type":"compile-errors"}` for
module-level problems and `{"type":"error"}` for manifest/dependency problems
(MISSING INDIRECT DEPENDENCIES, PROBLEM BUILDING DEPENDENCIES, corrupt
packages). Only the former, and only when no failing path lies inside the
vendored tree, is the consumer's own business.

-}
verifyConsumer
    : Node.Platform
    -> ChildProcess.Permission
    ->
        { applicationDirectory : Path
        , grenExecutable : String
        , vendorDirectory : String
        }
    -> Task Error ConsumerVerdict
verifyConsumer platform permission options =
    System.Process.run permission
        { program = options.grenExecutable
        , arguments = [ "make", "Main", "--output=/dev/null", "--report=json" ]
        , workingDirectory = System.File.pathToString platform options.applicationDirectory
        , environment = Dict.empty
        , allowedExitCodes = [ 0, 1 ]
        , timeoutMilliseconds = 10 * 60 * 1000
        , maximumOutputBytes = 64 * 1024 * 1024
        }
        |> Task.andThen
            (\output ->
                if output.exitCode == 0 then
                    Task.succeed ConsumerVerified

                else
                    let
                        text =
                            String.trim (output.stdout ++ "\n" ++ output.stderr)

                        isModuleLevel =
                            String.contains "\"type\":\"compile-errors\"" text

                        touchesVendoredTree =
                            String.contains options.vendorDirectory text
                    in
                    if isModuleLevel && not touchesVendoredTree then
                        Task.succeed (ConsumerSourceErrors text)

                    else if isModuleLevel then
                        Task.fail
                            (verifyFailed "the consumer application"
                                "make"
                                (System.File.pathToString platform options.applicationDirectory)
                                (PortError.create "GREN_VERIFY_FAILED" text)
                            )

                    else
                        -- Not a module-level report: the manifest itself does
                        -- not resolve. Frequently a gap that pre-dates the add
                        -- (a hand-edited gren.json missing indirects), so name
                        -- that possibility instead of implying a bad port.
                        Task.fail
                            (PortError.create "GREN_VERIFY_FAILED" text
                                |> PortError.withHint "The application manifest does not resolve. If gren.json was hand-edited, run `gren make` first to see what it is missing; the add was rolled back and changed nothing."
                            )
            )


verifyFailed : String -> String -> String -> Error -> Error
verifyFailed label command workingDir error =
    PortError.create "GREN_VERIFY_FAILED"
        (label
            ++ " failed `gren "
            ++ command
            ++ "` in "
            ++ workingDir
            ++ "\n"
            ++ PortError.message error
        )
        |> PortError.withHint "Inspect elm-to-gren.report.json for the transformed package diagnostics."
