      "grenPackage": "gren-lang/browser",
      "grenVersion": "6.0.2",
      "platform": "browser",
      "modules": [{
        "source": "Http",
        "target": "Http",
        "values": { "get": "ElmToGren.Compat.Http.get" }
      }]
    }
  }]
}
"""


