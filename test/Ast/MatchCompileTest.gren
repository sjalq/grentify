module Ast.MatchCompileTest exposing (tests)

{-| D38: consecutive tuple-case arms that bind the same pattern variables must
compile without Gren SHADOWING, while the self-recursive call in the final arm
stays in syntactic tail position (the D35 TCO receipt must hold).

D35 inlines the fallthrough continuation at each tuple-arm mismatch branch. When
two consecutive source arms bind the same names (e.g. `leftX`/`leftY`), the
duplicated continuation re-matches the scrutinee nested inside the previous
arm's binding scope, so the same names bind at two nested levels. Gren rejects
that as shadowing. `MatchCompile.freshenBinders` alpha-renames the nested copy's
binders; the fix must never move the recursion out of tail position.

D81: a let-destructure of a non-sole constructor must not survive as an
unguarded `LetDestructure` (Gren non-exhaustive). It lowers through the same
`matchPattern` totalizer as case peels. Sole-ctor let-destructures stay as
`let` (D45b: dead `_` on a sole ctor panics Gren).
-}

import Array exposing ( Array )
import Ast.CtorLaw as CtorLaw
import Ast.MatchCompile as MatchCompile
import Ast.Types exposing
    ( Declaration(..)
    , Expr(..)
    , File
    , LetDecl(..)
    , ModuleKind(..)
    , Exposing(..)
    , Pattern(..)
    )
import Dict exposing ( Dict )
import Maybe exposing ( Maybe(..) )


type alias Check =
    { name : String
    , passed : Bool
    , details : String
    }


tests : Array Check
tests =
    [ compilesWithoutShadowing
    , keepsSelfCallInTailPosition
    , duplicatesTheContinuation
    , ctorHeadNestedConsCompiles
    , ctorHeadNestedConsNoShadowing
    , nonFirstListColumnNoShadowing
    , nonFirstListColumnKeepsBothArms
    , nonSoleLetDestructureBecomesWhen
    , nonSoleLetDestructureHasFailArm
    , soleCtorLetDestructureStaysLet
    , bareNameSoleCollisionNotIrrefutable
    , aliasSoleCtorStillIrrefutable
    ]


ok : String -> Check
ok name =
    { name = name, passed = True, details = "" }


fail : String -> String -> Check
fail name details =
    { name = name, passed = False, details = details }



-- FIXTURE ---------------------------------------------------------------------


bare : String -> Expr
bare name =
    ExprVar { moduleName = Nothing, name = name }


{-| `step xs ys acc = case (xs, ys) of
        ( (leftX, leftY) :: rest, [] ) -> acc + leftX
        ( (leftX, leftY) :: rest, _ )  -> step rest ys (acc + leftX)
        _ -> acc`

Two consecutive tuple arms bind the same `leftX`/`leftY`/`rest`; the second arm
tail-calls `step`. This is the jinjor/elm-diff Wu-diff shape, reduced.
-}
fixtureFile : File
fixtureFile =
    let
        tupleColPattern col1 =
            PatTuple
                [ PatCons
                    { head = PatTuple [ PatVar "leftX", PatVar "leftY" ]
                    , tail = PatVar "rest"
                    }
                , col1
                ]

        selfCall =
            ExprApplication
                [ bare "step"
                , bare "rest"
                , bare "ys"
                , ExprBinop
                    { operator = "+", left = bare "acc", right = bare "leftX" }
                ]

        body =
            ExprCase
                { expression = ExprTuple [ bare "xs", bare "ys" ]
                , cases =
                    [ { pattern = tupleColPattern (PatList [])
                      , body =
                            ExprBinop
                                { operator = "+"
                                , left = bare "acc"
                                , right = bare "leftX"
                                }
                      }
                    , { pattern = tupleColPattern PatAll
                      , body = selfCall
                      }
                    , { pattern = PatAll
                      , body = bare "acc"
                      }
                    ]
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports = []
    , declarations =
        [ DeclFunction
            { name = "step"
            , documentation = Nothing
            , signature = Nothing
            , arguments = [ PatVar "xs", PatVar "ys", PatVar "acc" ]
            , expression = body
            }
        ]
    }


{-| Lower with the real CtorLaw prefix, then run MatchCompile — the pipeline
order — and return the compiled `step` body.
-}
compiledBody : Maybe Expr
compiledBody =
    let
        lowered =
            CtorLaw.apply (CtorLaw.collectFromFile fixtureFile) fixtureFile

        compiled =
            MatchCompile.compile Dict.empty lowered
    in
    when Array.get 0 compiled.declarations is
        Just (DeclFunction fn) ->
            Just fn.expression

        _ ->
            Nothing



{-| D41: cons arm whose HEAD is a ctor pattern with nested list/cons arguments
(the rtfeldman/elm-css `extendLastSelector` shape):

    case declarations of
        [] -> declarations
        (MediaRule mq ((StyleBlock only [] properties) :: [])) :: [] -> e1
        (MediaRule mq (first :: rest)) :: [] -> e2
        first :: rest -> e3

`finishLastHead` used to route the ctor head through `bindIrrefutable` →
`matchNamed`, which re-emits the ORIGINAL pattern into a raw two-arm case —
the nested list patterns inside the ctor arguments survive to Print
(AST_UNPORTED_LIST `case{named:MediaRule|_}`).
-}
d41Fixture : File
d41Fixture =
    let
        mediaRule args =
            PatNamed
                { ref = { moduleName = Nothing, name = "MediaRule" }
                , arguments = args
                }

        styleBlockPat =
            PatNamed
                { ref = { moduleName = Nothing, name = "StyleBlock" }
                , arguments = [ PatVar "only", PatList [], PatVar "properties" ]
                }

        consEnd head =
            PatCons { head = head, tail = PatList [] }

        body =
            ExprCase
                { expression = bare "declarations"
                , cases =
                    [ { pattern = PatList []
                      , body = bare "declarations"
                      }
                    , { pattern =
                            consEnd
                                (mediaRule
                                    [ PatVar "mq", consEnd styleBlockPat ])
                      , body = ExprApplication [ bare "e1", bare "only" ]
                      }
                    , { pattern =
                            consEnd
                                (mediaRule
                                    [ PatVar "mq"
                                    , PatCons
                                        { head = PatVar "first"
                                        , tail = PatVar "rest"
                                        }
                                    ])
                      , body =
                            ExprApplication
                                [ bare "e2", bare "first", bare "rest" ]
                      }
                    , { pattern =
                            PatCons
                                { head = PatVar "first", tail = PatVar "rest" }
                      , body =
                            ExprApplication
                                [ bare "e3", bare "first", bare "rest" ]
                      }
                    ]
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports = []
    , declarations =
        [ DeclFunction
            { name = "extendLast"
            , documentation = Nothing
            , signature = Nothing
            , arguments = [ PatVar "declarations" ]
            , expression = body
            }
        ]
    }


d41Compiled : File
d41Compiled =
    let
        lowered =
            CtorLaw.apply (CtorLaw.collectFromFile d41Fixture) d41Fixture
    in
    MatchCompile.compile Dict.empty lowered


d41CompiledBody : Maybe Expr
d41CompiledBody =
    when Array.get 0 d41Compiled.declarations is
        Just (DeclFunction fn) ->
            Just fn.expression

        _ ->
            Nothing



{-| D49: sole-ctor arms whose LIST column is not argument 0 (elm-css's
`Selector sequence [] pseudo` / `Selector first tuples pseudo`) must not
enter the ctor-embedded merge — its peer scan assumes the list lives in
slot 0 and made arm 1 its own fallback, re-emitting arm 1's body with a
shadowing rebind and dropping arm 2's body from the peel path.
-}
d49Fixture : File
d49Fixture =
    let
        selector args =
            PatNamed
                { ref = { moduleName = Nothing, name = "Selector" }
                , arguments = args
                }

        body =
            ExprCase
                { expression = bare "selector"
                , cases =
                    [ { pattern =
                            selector
                                [ PatVar "sequence", PatList [], PatVar "pseudo" ]
                      , body = ExprApplication [ bare "emptyArm", bare "sequence" ]
                      }
                    , { pattern =
                            selector
                                [ PatVar "firstSelector", PatVar "tuples", PatVar "pseudo" ]
                      , body =
                            ExprApplication
                                [ bare "consArm", bare "firstSelector", bare "tuples" ]
                      }
                    ]
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports = []
    , declarations =
        [ DeclCustomType
            { name = "Selector"
            , documentation = Nothing
            , generics = []
            , constructors =
                [ { name = "Selector", arguments = [] } ]
            }
        , DeclFunction
            { name = "append"
            , documentation = Nothing
            , signature = Nothing
            , arguments = [ PatVar "selector" ]
            , expression = body
            }
        ]
    }


d49CompiledBody : Maybe Expr
d49CompiledBody =
    let
        lowered =
            CtorLaw.apply (CtorLaw.collectFromFile d49Fixture) d49Fixture

        compiled =
            MatchCompile.compile
                (Dict.set "Selector" {} Dict.empty)
                lowered
    in
    when Array.get 1 compiled.declarations is
        Just (DeclFunction fn) ->
            Just fn.expression

        _ ->
            Nothing


exprMentions : String -> Expr -> Bool
exprMentions wanted expr =
    when expr is
        ExprVar { name = name } ->
            name == wanted

        ExprCase { expression = scrutinee, cases = arms } ->
            exprMentions wanted scrutinee
                || Array.any (\arm -> exprMentions wanted arm.body) arms

        ExprLet { declarations = decls, expression = inner } ->
            exprMentions wanted inner
                || Array.any
                    (\d ->
                        when d is
                            LetFunction fn ->
                                exprMentions wanted fn.expression

                            LetDestructure { expression = e } ->
                                exprMentions wanted e
                    )
                    decls

        _ ->
            Array.any (exprMentions wanted) (childExprs expr)



-- CHECKS ----------------------------------------------------------------------


compilesWithoutShadowing : Check
compilesWithoutShadowing =
    when compiledBody is
        Just body ->
            if hasNestedShadowing Dict.empty body then
                fail "compilesWithoutShadowing"
                    "a binder is rebound while already in scope (Gren SHADOWING)"

            else
                ok "compilesWithoutShadowing"

        Nothing ->
            fail "compilesWithoutShadowing" "no compiled `step` declaration"


keepsSelfCallInTailPosition : Check
keepsSelfCallInTailPosition =
    when compiledBody is
        Just body ->
            if tailHasSelfCall "step" body then
                ok "keepsSelfCallInTailPosition"

            else
                fail "keepsSelfCallInTailPosition"
                    "recursive `step` call is no longer in syntactic tail position"

        Nothing ->
            fail "keepsSelfCallInTailPosition" "no compiled `step` declaration"


{-| Guard against the test going vacuous: the tuple-list path must actually run
and duplicate the continuation, so the `leftX` binder family must appear more
than once (original + at least one freshened copy).
-}
ctorHeadNestedConsCompiles : Check
ctorHeadNestedConsCompiles =
    if MatchCompile.hasUnportedListPatterns d41Compiled then
        fail "ctorHeadNestedConsCompiles"
            ("nested list patterns inside ctor-arg heads survived MatchCompile: "
                ++ MatchCompile.unportedListSummary d41Compiled
            )

    else
        ok "ctorHeadNestedConsCompiles"


ctorHeadNestedConsNoShadowing : Check
ctorHeadNestedConsNoShadowing =
    when d41CompiledBody is
        Just body ->
            if hasNestedShadowing Dict.empty body then
                fail "ctorHeadNestedConsNoShadowing"
                    "D41 compile introduced Gren SHADOWING"

            else
                ok "ctorHeadNestedConsNoShadowing"

        Nothing ->
            fail "ctorHeadNestedConsNoShadowing"
                "no compiled `extendLast` declaration"


nonFirstListColumnNoShadowing : Check
nonFirstListColumnNoShadowing =
    when d49CompiledBody is
        Just body ->
            if hasNestedShadowing Dict.empty body then
                fail "nonFirstListColumnNoShadowing"
                    "compile introduced Gren SHADOWING (D49 merge misfire)"

            else
                ok "nonFirstListColumnNoShadowing"

        Nothing ->
            fail "nonFirstListColumnNoShadowing" "no compiled declaration"


nonFirstListColumnKeepsBothArms : Check
nonFirstListColumnKeepsBothArms =
    when d49CompiledBody is
        Just body ->
            if exprMentions "emptyArm" body && exprMentions "consArm" body then
                ok "nonFirstListColumnKeepsBothArms"

            else
                fail "nonFirstListColumnKeepsBothArms"
                    "an arm body was dropped by the ctor-embedded merge"

        Nothing ->
            fail "nonFirstListColumnKeepsBothArms" "no compiled declaration"


duplicatesTheContinuation : Check
duplicatesTheContinuation =
    when compiledBody is
        Just body ->
            let
                leftXBinders =
                    allBinders body
                        |> Array.keepIf (String.startsWith "leftX")
            in
            if Array.length leftXBinders >= 2 then
                ok "duplicatesTheContinuation"

            else
                fail "duplicatesTheContinuation"
                    ("expected >=2 `leftX*` binders, got "
                        ++ String.fromInt (Array.length leftXBinders)
                    )

        Nothing ->
            fail "duplicatesTheContinuation" "no compiled `step` declaration"



-- AST WALKERS -----------------------------------------------------------------


patternBinders : Pattern -> Array String
patternBinders pattern =
    when pattern is
        PatVar name ->
            [ name ]

        PatAs { pattern = inner, name = name } ->
            Array.pushLast name (patternBinders inner)

        PatNamed { arguments = args } ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p)) [] args

        PatTuple items ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p)) [] items

        PatList items ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p)) [] items

        PatCons { head = head, tail = tail } ->
            Array.append (patternBinders head) (patternBinders tail)

        PatRecordBind fields ->
            Array.foldl (\f acc -> Array.append acc (patternBinders f.pattern))
                [] fields

        PatRecord names ->
            names

        _ ->
            []


{-| True when any binder is introduced while a binder of the same name is
already in `scope` — i.e. the exact nesting Gren rejects as SHADOWING.
-}
hasNestedShadowing : Dict String {} -> Expr -> Bool
hasNestedShadowing scope expr =
    when expr is
        ExprCase { expression = scrutinee, cases = arms } ->
            hasNestedShadowing scope scrutinee
                || Array.any (armShadows scope) arms

        ExprLambda { arguments = arguments, expression = body } ->
            let
                binders =
                    Array.foldl (\p acc -> Array.append acc (patternBinders p))
                        [] arguments
            in
            clashes scope binders
                || hasNestedShadowing (occupy scope binders) body

        ExprLet { declarations = declarations, expression = body } ->
            let
                binders =
                    Array.foldl
                        (\decl acc ->
                            when decl is
                                LetFunction fn ->
                                    Array.pushLast fn.name acc

                                LetDestructure { pattern = pattern } ->
                                    Array.append acc (patternBinders pattern)
                        )
                        []
                        declarations

                inner =
                    occupy scope binders

                declShadows =
                    Array.any
                        (\decl ->
                            when decl is
                                LetFunction fn ->
                                    hasNestedShadowing inner fn.expression

                                LetDestructure { expression = e } ->
                                    hasNestedShadowing inner e
                        )
                        declarations
            in
            clashes scope binders
                || declShadows
                || hasNestedShadowing inner body

        _ ->
            Array.any (hasNestedShadowing scope) (childExprs expr)


armShadows : Dict String {} -> { pattern : Pattern, body : Expr } -> Bool
armShadows scope arm =
    let
        binders =
            patternBinders arm.pattern
    in
    clashes scope binders
        || hasNestedShadowing (occupy scope binders) arm.body


clashes : Dict String {} -> Array String -> Bool
clashes scope binders =
    Array.any (\b -> Dict.member b scope) binders


occupy : Dict String {} -> Array String -> Dict String {}
occupy scope binders =
    Array.foldl (\b acc -> Dict.set b {} acc) scope binders


{-| A self-call to `name` in syntactic tail position: the whole expression, or
the tail of every branch of a case / if / let.
-}
tailHasSelfCall : String -> Expr -> Bool
tailHasSelfCall name expr =
    when expr is
        ExprApplication parts ->
            when Array.get 0 parts is
                Just (ExprVar ref) ->
                    ref.moduleName == Nothing && ref.name == name

                _ ->
                    False

        ExprCase { cases = arms } ->
            Array.any (\arm -> tailHasSelfCall name arm.body) arms

        ExprIf { then_ = t, else_ = e } ->
            tailHasSelfCall name t || tailHasSelfCall name e

        ExprLet { expression = body } ->
            tailHasSelfCall name body

        _ ->
            False


allBinders : Expr -> Array String
allBinders expr =
    when expr is
        ExprCase { expression = scrutinee, cases = arms } ->
            Array.append (allBinders scrutinee)
                (Array.foldl
                    (\arm acc ->
                        acc
                            |> Array.append (patternBinders arm.pattern)
                            |> (\a -> Array.append a (allBinders arm.body))
                    )
                    []
                    arms
                )

        ExprLambda { arguments = arguments, expression = body } ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p))
                (allBinders body)
                arguments

        ExprLet { declarations = declarations, expression = body } ->
            Array.foldl
                (\decl acc ->
                    when decl is
                        LetFunction fn ->
                            acc
                                |> Array.pushLast fn.name
                                |> (\a -> Array.append a (allBinders fn.expression))

                        LetDestructure { pattern = pattern, expression = e } ->
                            acc
                                |> Array.append (patternBinders pattern)
                                |> (\a -> Array.append a (allBinders e))
                )
                (allBinders body)
                declarations

        _ ->
            Array.foldl (\c acc -> Array.append acc (allBinders c)) []
                (childExprs expr)


{-| Direct child expressions (no binder handling); used for the recursive fall
through in walkers that treat binding forms specially.
-}
childExprs : Expr -> Array Expr
childExprs expr =
    when expr is
        ExprApplication parts ->
            parts

        ExprBinop { left = left, right = right } ->
            [ left, right ]

        ExprIf { condition = c, then_ = t, else_ = e } ->
            [ c, t, e ]

        ExprNegation inner ->
            [ inner ]

        ExprTuple items ->
            items

        ExprList items ->
            items

        ExprRecord fields ->
            Array.map (\f -> f.value) fields

        ExprAccess { record = record } ->
            [ record ]

        ExprUpdate { fields = fields } ->
            Array.map (\f -> f.value) fields

        ExprCase { expression = scrutinee, cases = arms } ->
            Array.pushFirst scrutinee (Array.map (\a -> a.body) arms)

        ExprLambda { expression = body } ->
            [ body ]

        ExprLet { declarations = declarations, expression = body } ->
            Array.pushLast body
                (Array.map
                    (\decl ->
                        when decl is
                            LetFunction fn ->
                                fn.expression

                            LetDestructure d ->
                                d.expression
                    )
                    declarations
                )

        _ ->
            []



-- D81: non-sole let-destructure ----------------------------------------------


{-| `type M = A Int | B` and `let (A x) = A 7 in x` — the elm-markdown shape
(`let (RawBlock.Table t) = …`) reduced to two constructors.
-}
d81NonSoleFixture : File
d81NonSoleFixture =
    let
        justA =
            ExprApplication
                [ ExprVar { moduleName = Nothing, name = "A" }
                , ExprInt 7
                ]

        body =
            ExprLet
                { declarations =
                    [ LetDestructure
                        { pattern =
                            PatNamed
                                { ref = { moduleName = Nothing, name = "A" }
                                , arguments = [ PatVar "x" ]
                                }
                        , expression = justA
                        }
                    ]
                , expression = bare "x"
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports = []
    , declarations =
        [ DeclCustomType
            { name = "M"
            , documentation = Nothing
            , generics = []
            , constructors =
                [ { name = "A"
                  , arguments = [ Ast.Types.TypeGeneric "n" ]
                  }
                , { name = "B", arguments = [] }
                ]
            }
        , DeclFunction
            { name = "target"
            , documentation = Nothing
            , signature = Nothing
            , arguments = []
            , expression = body
            }
        ]
    }


{-| `type Only = Only Int` and `let (Only x) = Only 7 in x` — sole ctor must
remain an irrefutable let-destructure (D45b).
-}
d81SoleFixture : File
d81SoleFixture =
    let
        only =
            ExprApplication
                [ ExprVar { moduleName = Nothing, name = "Only" }
                , ExprInt 7
                ]

        body =
            ExprLet
                { declarations =
                    [ LetDestructure
                        { pattern =
                            PatNamed
                                { ref = { moduleName = Nothing, name = "Only" }
                                , arguments = [ PatVar "x" ]
                                }
                        , expression = only
                        }
                    ]
                , expression = bare "x"
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports = []
    , declarations =
        [ DeclCustomType
            { name = "Only"
            , documentation = Nothing
            , generics = []
            , constructors =
                [ { name = "Only"
                  , arguments = [ Ast.Types.TypeGeneric "n" ]
                  }
                ]
            }
        , DeclFunction
            { name = "target"
            , documentation = Nothing
            , signature = Nothing
            , arguments = []
            , expression = body
            }
        ]
    }


compileTargetBody : File -> Maybe Expr
compileTargetBody file =
    let
        lowered =
            CtorLaw.apply (CtorLaw.collectFromFile file) file

        compiled =
            MatchCompile.compile
                (MatchCompile.collectSoleCtorsFromFile lowered)
                lowered
    in
    compiled.declarations
        |> Array.mapAndKeepJust
            (\declaration ->
                when declaration is
                    DeclFunction fn ->
                        if fn.name == "target" then
                            Just fn.expression

                        else
                            Nothing

                    _ ->
                        Nothing
            )
        |> Array.first


{-| Any remaining `LetDestructure` whose pattern is a named constructor with a
known multi-ctor type is the defect: Gren will reject it as non-exhaustive.
-}
hasUnguardedNamedDestructure : Expr -> Bool
hasUnguardedNamedDestructure expr =
    when expr is
        ExprLet { declarations = declarations, expression = body } ->
            Array.any
                (\decl ->
                    when decl is
                        LetDestructure { pattern = pattern } ->
                            isNamedCtorPattern pattern

                        LetFunction fn ->
                            hasUnguardedNamedDestructure fn.expression
                )
                declarations
                || hasUnguardedNamedDestructure body

        _ ->
            Array.any hasUnguardedNamedDestructure (childExprs expr)


isNamedCtorPattern : Pattern -> Bool
isNamedCtorPattern pattern =
    when pattern is
        PatNamed _ ->
            True

        PatAs { pattern = inner } ->
            isNamedCtorPattern inner

        _ ->
            False


{-| Compiled form contains a two-arm case whose second arm is `_` (the fail
continuation matchNamed emits for a refutable ctor).
-}
hasCtorCaseWithFailArm : Expr -> Bool
hasCtorCaseWithFailArm expr =
    when expr is
        ExprCase { cases = arms } ->
            (Array.length arms == 2)
                && (when Array.get 0 arms is
                        Just first ->
                            isNamedCtorPattern first.pattern

                        Nothing ->
                            False
                   )
                && (when Array.get 1 arms is
                        Just second ->
                            second.pattern == PatAll

                        Nothing ->
                            False
                   )
                || Array.any (\arm -> hasCtorCaseWithFailArm arm.body) arms

        _ ->
            Array.any hasCtorCaseWithFailArm (childExprs expr)


{-| Sole-ctor let-destructure of `Only` still present (not expanded to a when).
-}
hasOnlyLetDestructure : Expr -> Bool
hasOnlyLetDestructure expr =
    when expr is
        ExprLet { declarations = declarations, expression = body } ->
            Array.any
                (\decl ->
                    when decl is
                        LetDestructure { pattern = pattern } ->
                            when pattern is
                                PatNamed { ref = ref } ->
                                    ref.name == "Only"

                                _ ->
                                    False

                        LetFunction fn ->
                            hasOnlyLetDestructure fn.expression
                )
                declarations
                || hasOnlyLetDestructure body

        _ ->
            Array.any hasOnlyLetDestructure (childExprs expr)


nonSoleLetDestructureBecomesWhen : Check
nonSoleLetDestructureBecomesWhen =
    when compileTargetBody d81NonSoleFixture is
        Just body ->
            if hasUnguardedNamedDestructure body then
                fail "D81 non-sole let-destructure becomes when"
                    "unguarded LetDestructure of named ctor still present"

            else
                ok "D81 non-sole let-destructure becomes when"

        Nothing ->
            fail "D81 non-sole let-destructure becomes when" "no target body"


nonSoleLetDestructureHasFailArm : Check
nonSoleLetDestructureHasFailArm =
    when compileTargetBody d81NonSoleFixture is
        Just body ->
            if hasCtorCaseWithFailArm body then
                ok "D81 non-sole let-destructure has fail arm"

            else
                fail "D81 non-sole let-destructure has fail arm"
                    "expected when Ctor -> …; _ -> fail"

        Nothing ->
            fail "D81 non-sole let-destructure has fail arm" "no target body"


soleCtorLetDestructureStaysLet : Check
soleCtorLetDestructureStaysLet =
    when compileTargetBody d81SoleFixture is
        Just body ->
            if hasOnlyLetDestructure body && not (hasCtorCaseWithFailArm body) then
                ok "D81 sole-ctor let-destructure stays let"

            else
                fail "D81 sole-ctor let-destructure stays let"
                    "sole ctor was totalized or lost its let-destructure"

        Nothing ->
            fail "D81 sole-ctor let-destructure stays let" "no target body"


{-| elm-markdown shape: sole `Markdown.Table.Table` registers bare `"Table"`,
while multi-ctor `RawBlock.Table` shares the bare name. A list peel whose head
is `RawBlock.Table` must NOT become an unguarded let-destructure (the path that
calls `matchNamed` / `isSoleCtor`).
-}
d81CollisionFixture : File
d81CollisionFixture =
    let
        body =
            ExprCase
                { expression = bare "blocks"
                , cases =
                    [ { pattern =
                            PatCons
                                { head =
                                    PatNamed
                                        { ref =
                                            { moduleName = Just "RawBlock"
                                            , name = "Table"
                                            }
                                        , arguments = [ PatVar "table" ]
                                        }
                                , tail = PatVar "rest"
                                }
                      , body = bare "table"
                      }
                    , { pattern = PatAll
                      , body = ExprInt 0
                      }
                    ]
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports =
        [ { moduleName = "Markdown.RawBlock"
          , alias = Just "RawBlock"
          , exposing_ = Nothing
          }
        , { moduleName = "Markdown.Table"
          , alias = Nothing
          , exposing_ = Nothing
          }
        ]
    , declarations =
        -- Multi-ctor type is NOT declared here: package sole supplies the
        -- colliding bare `"Table"` from Markdown.Table.Table only. Local
        -- RawBlock is absent so collectSoleCtors cannot mark anything sole
        -- under RawBlock — the bug is pure bare-name fallback on the package
        -- sole key.
        [ DeclFunction
            { name = "target"
            , documentation = Nothing
            , signature = Nothing
            , arguments = []
            , expression = body
            }
        ]
    }


{-| D45b alias form: sole ctor living at `Home.Node`, imported `as Node`.
A list peel of `Node.Node` must stay irrefutable (let-destructure, no dead `_`).
-}
d81AliasSoleFixture : File
d81AliasSoleFixture =
    let
        body =
            ExprCase
                { expression = bare "hs"
                , cases =
                    [ { pattern =
                            PatCons
                                { head =
                                    PatNamed
                                        { ref =
                                            { moduleName = Just "Node"
                                            , name = "Node"
                                            }
                                        , arguments = [ PatVar "inner" ]
                                        }
                                , tail = PatVar "rest"
                                }
                      , body = bare "inner"
                      }
                    , { pattern = PatAll
                      , body = ExprInt 0
                      }
                    ]
                }
    in
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports =
        [ { moduleName = "Home"
          , alias = Just "Node"
          , exposing_ = Nothing
          }
        ]
    , declarations =
        [ DeclFunction
            { name = "target"
            , documentation = Nothing
            , signature = Nothing
            , arguments = []
            , expression = body
            }
        ]
    }


{-| Compile with package sole pre-loaded under the HOME module key — the shape
dep maps carry after D45b — so alias expansion is the only path that can make
`Node.Node` look sole.
-}
compileWithPackageSole : Dict String {} -> File -> Maybe Expr
compileWithPackageSole packageSole file =
    let
        lowered =
            CtorLaw.apply (CtorLaw.collectFromFile file) file

        compiled =
            MatchCompile.compile packageSole lowered
    in
    compiled.declarations
        |> Array.mapAndKeepJust
            (\declaration ->
                when declaration is
                    DeclFunction fn ->
                        if fn.name == "target" then
                            Just fn.expression

                        else
                            Nothing

                    _ ->
                        Nothing
            )
        |> Array.first


{-| True when a LetDestructure binds a constructor whose bare name is `name`.
-}
hasLetDestructureNamed : String -> Expr -> Bool
hasLetDestructureNamed name expr =
    when expr is
        ExprLet { declarations = declarations, expression = body } ->
            Array.any
                (\decl ->
                    when decl is
                        LetDestructure { pattern = pattern } ->
                            when pattern is
                                PatNamed { ref = ref } ->
                                    ref.name == name

                                _ ->
                                    False

                        LetFunction fn ->
                            hasLetDestructureNamed name fn.expression
                )
                declarations
                || hasLetDestructureNamed name body

        _ ->
            Array.any (hasLetDestructureNamed name) (childExprs expr)


{-| True when a two-arm case matches constructor `name` then `_`.
-}
hasNamedCaseWithFailArm : String -> Expr -> Bool
hasNamedCaseWithFailArm name expr =
    when expr is
        ExprCase { cases = arms } ->
            let
                here =
                    (Array.length arms == 2)
                        && (when Array.get 0 arms is
                                Just first ->
                                    when first.pattern is
                                        PatNamed { ref = ref } ->
                                            ref.name == name

                                        _ ->
                                            False

                                Nothing ->
                                    False
                           )
                        && (when Array.get 1 arms is
                                Just second ->
                                    second.pattern == PatAll

                                Nothing ->
                                    False
                           )
            in
            here
                || Array.any (\arm -> hasNamedCaseWithFailArm name arm.body)
                    arms

        _ ->
            Array.any (hasNamedCaseWithFailArm name) (childExprs expr)


bareNameSoleCollisionNotIrrefutable : Check
bareNameSoleCollisionNotIrrefutable =
    -- Package sole has Markdown.Table.Table (and bare Table).
    -- A peel of RawBlock.Table must totalize, not let-destructure.
    let
        packageSole =
            Dict.empty
                |> Dict.set "Markdown.Table.Table" {}
                |> Dict.set "Table" {}
    in
    when compileWithPackageSole packageSole d81CollisionFixture is
        Just body ->
            if hasLetDestructureNamed "Table" body then
                fail "D81 bare-name sole collision not irrefutable"
                    "RawBlock.Table became unguarded LetDestructure"

            else if hasNamedCaseWithFailArm "Table" body then
                ok "D81 bare-name sole collision not irrefutable"

            else
                fail "D81 bare-name sole collision not irrefutable"
                    "expected when RawBlock.Table -> …; _ -> fail"

        Nothing ->
            fail "D81 bare-name sole collision not irrefutable" "no target body"


aliasSoleCtorStillIrrefutable : Check
aliasSoleCtorStillIrrefutable =
    -- Sole registered under home only; pattern uses import alias Node.
    let
        packageSole =
            Dict.singleton "Home.Node" {}
    in
    when compileWithPackageSole packageSole d81AliasSoleFixture is
        Just body ->
            if hasLetDestructureNamed "Node" body
                && not (hasNamedCaseWithFailArm "Node" body)
            then
                ok "D81 alias sole ctor still irrefutable"

            else
                fail "D81 alias sole ctor still irrefutable"
                    "Node.Node should stay irrefutable let after alias expand"

        Nothing ->
            fail "D81 alias sole ctor still irrefutable" "no target body"
