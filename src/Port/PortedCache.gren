module Port.PortedCache exposing
    ( Coordinate
    , Exports
    , Key
    , Pending
    , canonicalInput
    , coordinateLabel
    , decodeExports
    , digest12
    , digestFor
    , loadExports
    , entryPath
    , keyFor
    , load
    , loadPlatform
    , platformLabel
    , store
    )

{-| Content-addressed cache of verified ported trees for registry coordinates.

Key = package id + digest(tool, mappings, platform, namespace). Local roots are
never cached. Store only after successful gren verify.
-}

import ChildProcess
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Json.Decode as Decode
import Json.Encode as Encode
import Mapping.Types exposing (GeneratedModule)
import Node
import Port.Error as PortError
import System.File
import System.Hash
import System.Process
import Task exposing (Task)


{-| The immutable package identity a ported tree belongs to.
-}
type alias Coordinate =
    { author : String
    , name : String
    , version : String
    }


{-| Everything needed to locate a cached ported package. `cacheRoot` is the
tool's top-level cache directory; ported trees live under its `ported/`
subdirectory.
-}
type alias Key =
    { cacheRoot : Path
    , coordinate : Coordinate
    }


{-| Remembered after a cache miss so the verified package directory can be
stored once gren verification succeeds.
-}
type alias Pending =
    { cacheRoot : Path
    , coordinate : Coordinate
    , digest : String
    , -- D57: the constructor facts to bank alongside the tree, so a future hit
      -- is self-sufficient and never has to consult the extract cache.
      -- D70 added `recordAliases` to the same banked set.
      exports : Exports
    }


{-| The cross-package facts an entry banks for its dependents. Keys are
`"Module.Name"` after name substitution.

D83 added `ctorHomes` (ctor name → declaring modules) and `knownModules`
(modules fully surveyed for constructors) so CtorHome can re-point value
refs wrongly homed to a dependency type-alias module.
-}
type alias Exports =
    { ctorArities : Dict String Int
    , soleCtors : Dict String {}
    , recordAliases : Dict String (Array String)
    , reservedExports : Dict String String
    , ctorHomes : Dict String (Array String)
    , knownModules : Dict String {}
    }


{-| Build a cache key. Returns `Nothing` when caching is disabled
(`--no-ported-cache`), when the source is a local path (`sourceUrl` is
`Nothing`), or when the package is the port root: local sources are mutable
and the root is always freshly ported.
-}
keyFor : Bool -> Path -> Coordinate -> Maybe String -> Bool -> Maybe Key
keyFor enabled cacheRoot coordinate sourceUrl isRoot =
    if not enabled then
        Nothing

    else if isRoot then
        Nothing

    else
        when sourceUrl is
            Nothing ->
                Nothing

            Just _ ->
                Just
                    { cacheRoot = cacheRoot
                    , coordinate = coordinate
                    }


{-| Human-readable `author/name@version` for progress notes.
-}
coordinateLabel : Coordinate -> String
coordinateLabel coordinate =
    coordinate.author ++ "/" ++ coordinate.name ++ "@" ++ coordinate.version


{-| Map a CLI platform choice onto the digest vocabulary: "pure", "browser",
or "node". `Auto` is treated as pure (the Gren default host) so an explicit
`--platform` selection always changes the digest.
-}
platformLabel : String -> String
platformLabel platform =
    when String.toLower platform is
        "common" ->
            "pure"

        "auto" ->
            "pure"

        "browser" ->
            "browser"

        "node" ->
            "node"

        "pure" ->
            "pure"

        other ->
            other


{-| First 12 hex characters of a full digest; used in entry directory names.
-}
digest12 : String -> String
digest12 fullDigest =
    String.slice 0 12 fullDigest


{-| `<cacheRoot>/ported/<author>__<name>__<version>__<digest12>/`.
-}
entryPath : Path -> Coordinate -> String -> Path
entryPath cacheRoot coordinate fullDigest =
    Path.join
        [ cacheRoot
        , Path.fromPosixString "ported"
        , Path.fromPosixString (entryDirectoryName coordinate fullDigest)
        ]


entryDirectoryName : Coordinate -> String -> String
entryDirectoryName coordinate fullDigest =
    coordinate.author
        ++ "__"
        ++ coordinate.name
        ++ "__"
        ++ coordinate.version
        ++ "__"
        ++ digest12 fullDigest


{-| Canonical digest payload. Order is fixed and documented:

1. tool version string
2. sha256 of every `mappings/*.json` file (sorted by filename), one line each
3. platform string (`pure` / `browser` / `node`)
4. namespacing flag

Any transform-relevant drift in these ingredients must change the digest.
-}
canonicalInput : String -> Array { filename : String, contentSha256 : String } -> String -> Bool -> String
canonicalInput toolVersion mappingFiles platform namespacing =
    let
        mappingLines =
            mappingFiles
                |> Array.sortBy .filename
                |> Array.map (\file -> file.filename ++ ":" ++ file.contentSha256)
                |> String.join "\n"

        namespaceLine =
            if namespacing then
                "namespace:true"

            else
                "namespace:false"
    in
    String.join "\n---ported-cache---\n"
        [ "tool:" ++ toolVersion
        , "mappings:\n" ++ mappingLines
        , "platform:" ++ platform
        , namespaceLine
        ]


{-| SHA-256 hex digest over the fixed ingredient set. Returns `""` when any
ingredient is unreadable so the caller falls back to a fresh port rather than
reuse a possibly-stale entry.
-}
digestFor : FileSystem.Permission -> Path -> String -> String -> Bool -> Task x String
digestFor permission mappingsDirectory toolVersion platform namespacing =
    System.File.listFilesRecursively permission mappingsDirectory
        |> Task.andThen
            (\paths ->
                paths
                    |> Array.keepIf isMappingJson
                    |> Array.sortBy Path.toPosixString
                    |> hashMappingFiles permission
            )
        |> Task.andThen
            (\mappingFiles ->
                System.Hash.sha256Hex (canonicalInput toolVersion mappingFiles platform namespacing)
            )
        |> Task.onError (\_ -> Task.succeed "")


isMappingJson : Path -> Bool
isMappingJson path =
    let
        text =
            Path.toPosixString path
    in
    String.endsWith ".json" text


hashMappingFiles : FileSystem.Permission -> Array Path -> Task PortError.Error (Array { filename : String, contentSha256 : String })
hashMappingFiles permission paths =
    Array.foldl
        (\path pending ->
            pending
                |> Task.andThen
                    (\acc ->
                        System.File.readText permission path
                            |> Task.andThen
                                (\contents ->
                                    System.Hash.sha256Hex contents
                                        |> Task.map
                                            (\contentSha ->
                                                Array.pushLast
                                                    { filename = Path.filenameWithExtension path
                                                    , contentSha256 = contentSha
                                                    }
                                                    acc
                                            )
                                )
                    )
        )
        (Task.succeed [])
        paths


{-| Read a cached ported package. Returns `Nothing` on a miss, missing
manifest, or digest mismatch: the caller re-ports. The entry path already
embeds `digest12`; the full digest in `manifest.json` is checked against the
current computation so a truncated-name collision cannot serve wrong content.
-}
load : FileSystem.Permission -> Path -> String -> Task x (Maybe Path)
load permission entry expectedDigest =
    let
        manifestPath =
            Path.join [ entry, Path.fromPosixString "manifest.json" ]
    in
    System.File.exists permission entry
        |> Task.andThen
            (\present ->
                if not present then
                    Task.succeed Nothing

                else
                    System.File.readText permission manifestPath
                        |> Task.map
                            (\contents ->
                                when Decode.decodeString manifestDecoder contents is
                                    Ok manifest ->
                                        if manifest.digest == expectedDigest then
                                            Just entry

                                        else
                                            Nothing

                                    Err _ ->
                                        Nothing
                            )
                        |> Task.onError (\_ -> Task.succeed Nothing)
            )
        |> Task.onError (\_ -> Task.succeed Nothing)


type alias Manifest =
    { toolVersion : String
    , digest : String
    , platform : String
    }


manifestDecoder : Decode.Decoder Manifest
manifestDecoder =
    Decode.map3
        (\toolVersion digest platform ->
            { toolVersion = toolVersion
            , digest = digest
            , platform = platform
            }
        )
        (Decode.field "toolVersion" Decode.string)
        (Decode.field "digest" Decode.string)
        (Decode.oneOf
            [ Decode.field "platform" Decode.string
            , Decode.succeed "common"
            ]
        )


{-| Read the cached package platform label from manifest.json (common/browser/node).
Returns Nothing when the entry is missing or the digest does not match.
-}
loadPlatform : FileSystem.Permission -> Path -> String -> Task x (Maybe String)
loadPlatform permission entry expectedDigest =
    let
        manifestPath =
            Path.join [ entry, Path.fromPosixString "manifest.json" ]
    in
    System.File.readText permission manifestPath
        |> Task.map
            (\contents ->
                when Decode.decodeString manifestDecoder contents is
                    Ok manifest ->
                        if manifest.digest == expectedDigest then
                            Just manifest.platform

                        else
                            Nothing

                    Err _ ->
                        Nothing
            )
        |> Task.onError (\_ -> Task.succeed Nothing)


{-| D57: read the constructor facts an entry stored for itself. `Nothing` when
the entry predates ANY field of this set, in which case the caller falls back to
the extract cache exactly as before. The decoder requires every field on
purpose: an entry written before D70 knows nothing about record aliases, and
answering `Just` with an empty map would look self-sufficient while hiding the
defect it was written under.
-}
loadExports :
    FileSystem.Permission
    -> Path
    -> Task x (Maybe Exports)
loadExports permission entry =
    System.File.readText permission
        (Path.join [ entry, Path.fromPosixString "manifest.json" ])
        |> Task.map decodeExports
        |> Task.onError (\_ -> Task.succeed Nothing)


{-| The pure half of `loadExports`: manifest text → banked facts, or `Nothing`
when the entry cannot supply the full set.
-}
decodeExports : String -> Maybe Exports
decodeExports text =
    when Decode.decodeString exportsDecoder text is
        Ok exports ->
            Just exports

        Err _ ->
            Nothing


exportsDecoder : Decode.Decoder Exports
exportsDecoder =
    Decode.map6
        (\arities soles aliases reserved homes modules ->
            { ctorArities = arities
            , soleCtors =
                Array.foldl (\name acc -> Dict.set name {} acc) Dict.empty soles
            , recordAliases = aliases
            , reservedExports = reserved
            , ctorHomes = homes
            , knownModules =
                Array.foldl (\name acc -> Dict.set name {} acc) Dict.empty modules
            }
        )
        (Decode.field "ctorArities" (Decode.dict Decode.int))
        (Decode.field "soleCtors" (Decode.array Decode.string))
        (Decode.field "recordAliases" (Decode.dict (Decode.array Decode.string)))
        (Decode.field "reservedExports" (Decode.dict Decode.string))
        (Decode.field "ctorHomes" (Decode.dict (Decode.array Decode.string)))
        (Decode.field "knownModules" (Decode.array Decode.string))


{-| Persist a verified package tree under the content-addressed entry path.
Copies only the transform surface (src/, LICENSE*), never gren.json (which is
resolution-specific), never `elm-stuff` / `.gren` build litter. Writes to a
unique sibling temp directory then renames it into place (adopt-the-winner on
conflict). I/O failures are swallowed: the cache is an optimization, not a
correctness dependency.

D106: `restore` carries the modules `Port.CompatShim` lifted out of this
package into a shared shim. They are no longer in `sourcePackageDir`, but the
package's own sources still import them, so an entry written without them can
never be restored — a later hit yields MODULE NOT FOUND for a module the tool
itself removed, and the damage outlives the run that caused it. The entry is
the package's STANDALONE port; the hoist is a property of the workspace, not
of the package, so it must not reach the cache.
-}
store :
    Node.Platform
    -> ChildProcess.Permission
    -> FileSystem.Permission
    -> Path
    -> Path
    -> String
    -> String
    -> String
    -> Exports
    -> Array GeneratedModule
    -> Task x {}
store platform childProcess permission entry sourcePackageDir toolVersion digest platformName exports restore =
    System.Hash.freshUuid
        |> Task.andThen
            (\maybeUuid ->
                when maybeUuid is
                    Nothing ->
                        Task.succeed {}

                    Just uuid ->
                        let
                            tempPath =
                                System.File.tempSibling entry (".tmp-" ++ uuid)

                            -- Store only the transform surface (src/ + LICENSE*).
                            -- gren.json is resolution-specific (local: dep versions)
                            -- and is always re-planned on the hit path; caching it
                            -- would serve the wrong dep graph across projects.
                            -- D57: the entry carries its OWN constructor facts.
                            -- A dependency served from here never re-extracts,
                            -- and the extract cache is keyed on different
                            -- ingredients (review config + elm-review version),
                            -- so the two drift. When they did, `cachedDepExports`
                            -- silently returned EMPTY and the dependent compiled
                            -- as if this package declared no constructors —
                            -- proven to flip jfmengels/elm-review from PASS to
                            -- a TYPE MISMATCH storm with no code change. A hit
                            -- must be self-sufficient.
                            manifestText =
                                Encode.object
                                    [ { key = "toolVersion", value = Encode.string toolVersion }
                                    , { key = "digest", value = Encode.string digest }
                                    , { key = "platform", value = Encode.string platformName }
                                    , { key = "ctorArities"
                                      , value =
                                            Encode.object
                                                (Dict.foldl
                                                    (\name arity acc ->
                                                        Array.pushLast { key = name, value = Encode.int arity } acc
                                                    )
                                                    []
                                                    exports.ctorArities
                                                )
                                      }
                                    , { key = "soleCtors"
                                      , value =
                                            Encode.array Encode.string (Dict.keys exports.soleCtors)
                                      }
                                    , { key = "recordAliases"
                                      , value =
                                            Encode.object
                                                (Dict.foldl
                                                    (\name fields acc ->
                                                        Array.pushLast
                                                            { key = name
                                                            , value = Encode.array Encode.string fields
                                                            }
                                                            acc
                                                    )
                                                    []
                                                    exports.recordAliases
                                                )
                                      }
                                    , { key = "reservedExports"
                                      , value =
                                            Encode.object
                                                (Dict.foldl
                                                    (\name escaped acc ->
                                                        Array.pushLast
                                                            { key = name
                                                            , value = Encode.string escaped
                                                            }
                                                            acc
                                                    )
                                                    []
                                                    exports.reservedExports
                                                )
                                      }
                                    , { key = "ctorHomes"
                                      , value =
                                            Encode.object
                                                (Dict.foldl
                                                    (\name modules acc ->
                                                        Array.pushLast
                                                            { key = name
                                                            , value =
                                                                Encode.array Encode.string
                                                                    modules
                                                            }
                                                            acc
                                                    )
                                                    []
                                                    exports.ctorHomes
                                                )
                                      }
                                    , { key = "knownModules"
                                      , value =
                                            Encode.array Encode.string
                                                (Dict.keys exports.knownModules)
                                      }
                                    ]
                                    |> Encode.encode 0
                        in
                        System.File.ensureDirectory permission
                            (Path.parentPath entry |> Maybe.withDefault Path.empty)
                            |> Task.andThen (\_ -> System.File.ensureDirectory permission tempPath)
                            |> Task.andThen
                                (\_ ->
                                    copyPackageSurface platform childProcess sourcePackageDir tempPath
                                )
                            |> Task.andThen
                                (\_ ->
                                    writeRestoredModules permission tempPath restore
                                )
                            |> Task.andThen
                                (\_ ->
                                    System.File.writeText permission
                                        (Path.join [ tempPath, Path.fromPosixString "manifest.json" ])
                                        manifestText
                                        |> Task.map (\_ -> {})
                                )
                            |> Task.andThen
                                (\_ ->
                                    renameInto permission entry tempPath
                                )
                            |> Task.onError (\_ -> System.File.removeIfExistsBestEffort permission tempPath)
            )
        |> Task.onError (\_ -> Task.succeed {})


{-| D106: put the hoisted-out modules back into the entry being written, so
the entry is a standalone port of its package. Paths are the generated
`relativePath`, which already starts at `src/`.
-}
writeRestoredModules : FileSystem.Permission -> Path -> Array GeneratedModule -> Task x {}
writeRestoredModules permission tempPath modules =
    Array.foldl
        (\generated pending ->
            pending
                |> Task.andThen
                    (\_ ->
                        System.File.writeText permission
                            (Path.join
                                [ tempPath
                                , Path.fromPosixString (entryRelativePath generated.relativePath)
                                ]
                            )
                            generated.source
                            |> Task.map (\_ -> {})
                    )
        )
        (Task.succeed {})
        modules
        |> Task.onError (\_ -> Task.succeed {})


entryRelativePath : String -> String
entryRelativePath relativePath =
    if String.startsWith "src/" relativePath then
        relativePath

    else
        "src/" ++ relativePath


{-| Best-effort native recursive copy of the transform surface (src/ + LICENSE*)
into `destination`, excluding build caches and gren.json (resolution-specific).
Failures are swallowed by `store`.
-}
copyPackageSurface : Node.Platform -> ChildProcess.Permission -> Path -> Path -> Task PortError.Error {}
copyPackageSurface platform childProcess source destination =
    let
        src =
            System.File.pathToString platform source

        dest =
            System.File.pathToString platform destination
    in
    System.Process.run childProcess
        { program = "bash"
        , arguments =
            [ "-c"
            , "set -e; "
                ++ "if [ -d '"
                ++ src
                ++ "/src' ]; then cp -a '"
                ++ src
                ++ "/src' '"
                ++ dest
                ++ "/'; fi; "
                ++ "for f in LICENSE LICENSE.txt LICENSE.adoc; do "
                ++ "if [ -f '"
                ++ src
                ++ "/'$f ]; then cp -a '"
                ++ src
                ++ "/'$f '"
                ++ dest
                ++ "/'; fi; done"
            ]
        , workingDirectory = "."
        , environment = Dict.empty
        , allowedExitCodes = [ 0 ]
        , timeoutMilliseconds = 60 * 1000
        , maximumOutputBytes = 1024 * 1024
        }
        |> Task.map (\_ -> {})
        |> Task.mapError
            (\_ ->
                PortError.create "PORTED_CACHE_COPY_FAILED"
                    ("Could not copy package surface from " ++ src ++ " to " ++ dest ++ ".")
            )


renameInto : FileSystem.Permission -> Path -> Path -> Task x {}
renameInto permission destination tempPath =
    -- Replace any existing entry, then `move dest temp` renames temp -> dest
    -- (atomic on POSIX). D70/D83 soft-miss re-ports when a banked fact is
    -- missing from an older manifest at the same digest path; without
    -- replacing the incomplete entry, every subsequent hit soft-misses forever
    -- and the new facts never land. Concurrent writers that both finish both
    -- publish a valid entry (last writer wins).
    System.File.removeIfExistsBestEffort permission destination
        |> Task.andThen
            (\_ ->
                FileSystem.move permission destination tempPath
                    |> Task.map (\_ -> {})
            )
        |> Task.onError (\_ -> System.File.removeIfExistsBestEffort permission tempPath)
