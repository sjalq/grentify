module Ast.MatchCompile exposing
    ( collectSoleCtorsFromFile
    , compile
    , hasUnportedListPatterns
    , unportedListSummary
    )

{-| Binder-preserving pattern-matrix compiler for Elm list semantics.

List columns lower to shared `Array.popFirst` decision nodes. Tuple columns are
decomposed into record fields, exposing nested list columns to the same matrix.
Synthetic names are used only for intermediate subjects and continuations.

Law: free variables of each arm body stay bound by the compiled pattern tree.

Gren forbids shadowing, so every pattern binder is α-renamed against an
occupied-name scope before placement; free occurrences in the arm body are
renamed to match. Outer `as` names on cons arms bind the whole list.

Sole-constructor custom types (package-wide) are irrefutable when their nested
patterns are irrefutable — peel matches must not emit a dead `_` arm (Gren
REDUNDANT PATTERN).
-}

import Array exposing ( Array )
import Ast.Types exposing
    ( CaseArm
    , Declaration(..)
    , Expr(..)
    , File
    , LetDecl(..)
    , NamedRef
    , Pattern(..)
    )
import Ast.Walk as Walk
import Dict exposing ( Dict )
import Maybe exposing ( Maybe(..) )

-- SCOPE / α-RENAME ------------------------------------------------------------


type alias Scope =
    { occupied : Dict String {} }


emptyScope : Scope
emptyScope =
    { occupied = Dict.empty }


occupy : String -> Scope -> Scope
occupy name scope =
    { occupied = Dict.set name {} scope.occupied }


occupyAll : Array String -> Scope -> Scope
occupyAll names scope =
    Array.foldl occupy scope names


freshName : String -> Scope -> String
freshName base scope =
    if not (Dict.member base scope.occupied) then
        base

    else
        freshNameHelp base 1 scope


freshNameHelp : String -> Int -> Scope -> String
freshNameHelp base n scope =
    let
        candidate =
            base ++ "_" ++ String.fromInt n
    in
    if Dict.member candidate scope.occupied then
        freshNameHelp base (n + 1) scope

    else
        candidate


{-| Bind one name: keep if free, else freshen. Returns subst old→new when renamed.
-}
bindName :
    String
    -> Scope
    -> { name : String, scope : Scope, subst : Dict String String }
bindName name scope =
    let
        newName =
            freshName name scope
    in
    { name = newName
    , scope = occupy newName scope
    , subst =
        if newName == name then
            Dict.empty

        else
            Dict.singleton name newName
    }


mergeSubst : Dict String String -> Dict String String -> Dict String String
mergeSubst left right =
    Array.foldl
        (\key acc ->
            when Dict.get key right is
                Just value ->
                    Dict.set key value acc

                Nothing ->
                    acc) left (Dict.keys right)


type alias BindResult =
    { pattern : Pattern
    , scope : Scope
    , subst : Dict String String
    }


bindPattern : Pattern -> Scope -> BindResult
bindPattern pattern scope =
    when pattern is
        PatVar name ->
            let
                bound =
                    bindName name scope
            in
            { pattern = PatVar bound.name
            , scope = bound.scope
            , subst = bound.subst
            }

        PatAll ->
            { pattern = PatAll, scope = scope, subst = Dict.empty }

        PatAs { pattern = inner, name = name } ->
            let
                innerR =
                    bindPattern inner scope

                bound =
                    bindName name innerR.scope
            in
            { pattern = PatAs { pattern = innerR.pattern, name = bound.name }
            , scope = bound.scope
            , subst = mergeSubst innerR.subst bound.subst
            }

        PatNamed { ref = ref, arguments = args } ->
            let
                folded =
                    bindPatternList args scope
            in
            { pattern = PatNamed { ref = ref, arguments = folded.patterns }
            , scope = folded.scope
            , subst = folded.subst
            }

        PatTuple items ->
            let
                folded =
                    bindPatternList items scope
            in
            { pattern = PatTuple folded.patterns
            , scope = folded.scope
            , subst = folded.subst
            }

        PatList items ->
            let
                folded =
                    bindPatternList items scope
            in
            { pattern = PatList folded.patterns
            , scope = folded.scope
            , subst = folded.subst
            }

        PatCons { head = head, tail = tail } ->
            let
                headR =
                    bindPattern head scope

                tailR =
                    bindPattern tail headR.scope
            in
            { pattern = PatCons { head = headR.pattern, tail = tailR.pattern }
            , scope = tailR.scope
            , subst = mergeSubst headR.subst tailR.subst
            }

        PatRecordBind fields ->
            let
                folded =
                    Array.foldl
                        (\field acc ->
                            let
                                r =
                                    bindPattern field.pattern acc.scope
                            in
                            { patterns =
                                Array.pushLast
                                    { name = field.name, pattern = r.pattern }
                                    acc.patterns
                            , scope = r.scope
                            , subst = mergeSubst acc.subst r.subst
                            })
                        { patterns = [], scope = scope, subst = Dict.empty }
                        fields
            in
            { pattern = PatRecordBind folded.patterns
            , scope = folded.scope
            , subst = folded.subst
            }

        PatRecord names ->
            { pattern = PatRecord names, scope = scope, subst = Dict.empty }

        _ ->
            { pattern = pattern, scope = scope, subst = Dict.empty }


bindPatternList :
    Array Pattern
    -> Scope
    -> { patterns : Array Pattern, scope : Scope, subst : Dict String String }
bindPatternList patterns scope =
    Array.foldl
        (\pat acc ->
            let
                r =
                    bindPattern pat acc.scope
            in
            { patterns = Array.pushLast r.pattern acc.patterns
            , scope = r.scope
            , subst = mergeSubst acc.subst r.subst
            }) { patterns = [], scope = scope, subst = Dict.empty } patterns


patternBinders : Pattern -> Array String
patternBinders pattern =
    when pattern is
        PatVar name ->
            [ name ]

        PatAs { pattern = inner, name = name } ->
            Array.pushLast name (patternBinders inner)

        PatNamed { arguments = args } ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p)) [] args

        PatTuple items ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p)) []
                items

        PatList items ->
            Array.foldl (\p acc -> Array.append acc (patternBinders p)) []
                items

        PatCons { head = head, tail = tail } ->
            Array.append (patternBinders head) (patternBinders tail)

        PatRecordBind fields ->
            Array.foldl (\f acc -> Array.append acc (patternBinders f.pattern))
                [] fields

        _ ->
            []


{-| Rename free variables according to subst. Binders shadow subst entries.
-}
renameExpr : Dict String String -> Expr -> Expr
renameExpr subst expr =
    if Array.isEmpty (Dict.keys subst) then
        expr

    else
        renameExprHelp subst expr


renameExprHelp : Dict String String -> Expr -> Expr
renameExprHelp subst expr =
    when expr is
        ExprVar ref ->
            when ref.moduleName is
                Just _ ->
                    expr

                Nothing ->
                    when Dict.get ref.name subst is
                        Just newName ->
                            ExprVar { moduleName = Nothing, name = newName }

                        Nothing ->
                            expr

        ExprApplication parts ->
            ExprApplication (Array.map (renameExprHelp subst) parts)

        ExprBinop { operator = op, left = left, right = right } ->
            ExprBinop
                { operator = op
                , left = renameExprHelp subst left
                , right = renameExprHelp subst right
                }

        ExprIf { condition = c, then_ = t, else_ = e } ->
            ExprIf
                { condition = renameExprHelp subst c
                , then_ = renameExprHelp subst t
                , else_ = renameExprHelp subst e
                }

        ExprNegation inner ->
            ExprNegation (renameExprHelp subst inner)

        ExprTuple items ->
            ExprTuple (Array.map (renameExprHelp subst) items)

        ExprList items ->
            ExprList (Array.map (renameExprHelp subst) items)

        ExprRecord fields ->
            ExprRecord
                (Array.map
                    (\f ->
                        { name = f.name, value = renameExprHelp subst f.value })
                    fields)

        ExprAccess { record = record, field = field } ->
            ExprAccess { record = renameExprHelp subst record, field = field }

        ExprUpdate { name = name, fields = fields } ->
            let
                newName =
                    when Dict.get name subst is
                        Just n ->
                            n

                        Nothing ->
                            name
            in
            ExprUpdate
                { name = newName
                , fields =
                    Array.map
                        (\f ->
                            { name = f.name
                            , value = renameExprHelp subst f.value
                            }) fields
                }

        ExprLambda { arguments = arguments, expression = body } ->
            let
                binders =
                    Array.foldl (\p acc -> Array.append acc (patternBinders p))
                        [] arguments

                bodySubst =
                    dropKeys binders subst
            in
            ExprLambda
                { arguments = arguments
                , expression = renameExprHelp bodySubst body
                }

        ExprLet { declarations = declarations, expression = body } ->
            renameLet subst declarations body

        ExprCase { expression = scrutinee, cases = arms } ->
            ExprCase
                { expression = renameExprHelp subst scrutinee
                , cases =
                    Array.map
                        (\arm ->
                            let
                                binders =
                                    patternBinders arm.pattern

                                bodySubst =
                                    dropKeys binders subst
                            in
                            { pattern = arm.pattern
                            , body = renameExprHelp bodySubst arm.body
                            }) arms
                }

        _ ->
            expr


dropKeys : Array String -> Dict String String -> Dict String String
dropKeys keys dict =
    let
        dropSet =
            Array.foldl (\k s -> Dict.set k {} s) Dict.empty keys
    in
    Array.foldl
        (\k acc ->
            if Dict.member k dropSet then
                acc

            else
                when Dict.get k dict is
                    Just v ->
                        Dict.set k v acc

                    Nothing ->
                        acc) Dict.empty (Dict.keys dict)


renameLet : Dict String String -> Array LetDecl -> Expr -> Expr
renameLet subst declarations body =
    let
        step =
            Array.foldl
                (\decl acc ->
                    when decl is
                        LetFunction fn ->
                            let
                                argBinders =
                                    Array.foldl
                                        (\p a ->
                                            Array.append a (patternBinders p))
                                        [] fn.arguments

                                -- Name + args shadow free renames inside the fn body.
                                fnBodySubst =
                                    dropKeys (Array.pushLast fn.name argBinders)
                                        acc.subst

                                newDecl =
                                    LetFunction
                                        { fn | expression =
                                            renameExprHelp fnBodySubst
                                                fn.expression
                                        }
                            in
                            { decls = Array.pushLast newDecl acc.decls
                            , subst = dropKeys [ fn.name ] acc.subst
                            }

                        LetDestructure
                            { pattern = pattern, expression = expression } ->
                            let
                                binders =
                                    patternBinders pattern

                                newDecl =
                                    LetDestructure
                                        { pattern = pattern
                                        , expression =
                                            renameExprHelp acc.subst expression
                                        }
                            in
                            { decls = Array.pushLast newDecl acc.decls
                            , subst = dropKeys binders acc.subst
                            }) { decls = [], subst = subst } declarations
    in
    ExprLet
        { declarations = step.decls
        , expression = renameExprHelp step.subst body
        }


{-| `"Module.Ctor"` (and short names) for custom types with exactly one constructor.
-}
collectSoleCtorsFromFile : File -> Dict String {}
collectSoleCtorsFromFile file =
    let
        moduleName =
            file.moduleDefinition.moduleName
    in
    Array.foldl
        (\declaration acc ->
            when declaration is
                DeclCustomType custom ->
                    if Array.length custom.constructors == 1 then
                        when Array.first custom.constructors is
                            Just ctor ->
                                acc
                                    |> Dict.set (moduleName ++ "." ++ ctor.name)
                                        {}
                                    |> Dict.set ctor.name {}

                            Nothing ->
                                acc

                    else
                        acc

                _ ->
                    acc) Dict.empty file.declarations


type alias SoleCtors =
    Dict String {}


{-| A normalized pattern matrix.

Every source `when` contributes one subject column and one row per arm. Nested
tuple, constructor, record, and list patterns are decomposed recursively by
`matchPattern`; they do not select separate top-level compilers.
-}
type alias PatternMatrix =
    { columns : Array Expr
    , rows : Array PatternRow
    }


type alias PatternRow =
    { patterns : Array Pattern
    , body : Expr
    }


compile : SoleCtors -> File -> File
compile packageSole file =
    let
        sole =
            mergeSoleCtors packageSole (collectSoleCtorsFromFile file)
    in
    { file | declarations =
        Array.indexedMap (\i d -> compileDeclaration sole (i * 100003) d)
            file.declarations
    }


mergeSoleCtors : SoleCtors -> SoleCtors -> SoleCtors
mergeSoleCtors package local =
    Dict.foldl Dict.set package local


hasUnportedListPatterns : File -> Bool
hasUnportedListPatterns file =
    Array.any declarationHasUnported file.declarations


{-| Diagnostic: where residual list/cons patterns remain after compile.
-}
unportedListSummary : File -> String
unportedListSummary file =
    file.declarations
        |> Array.indexedMap
            (\i declaration ->
                if declarationHasUnported declaration then
                    Just
                        ("decl#"
                            ++ String.fromInt i
                            ++ " "
                            ++ declarationLabel declaration
                            ++ ": "
                            ++ String.join ", "
                                (declarationUnportedSites declaration))

                else
                    Nothing)
        |> Array.mapAndKeepJust (\m -> m)
        |> String.join "; "


declarationLabel : Declaration -> String
declarationLabel declaration =
    when declaration is
        DeclFunction fn ->
            fn.name

        DeclDestructure _ ->
            "<destructure>"

        DeclAlias a ->
            a.name

        DeclCustomType c ->
            c.name

        DeclPort s ->
            s.name

        DeclInfix ->
            "<infix>"


declarationUnportedSites : Declaration -> Array String
declarationUnportedSites declaration =
    when declaration is
        DeclFunction fn ->
            let
                argHits =
                    if Array.any patternHasUnportedList fn.arguments then
                        [ "args" ]

                    else
                        []
            in
            Array.foldl Array.pushLast argHits
                (exprUnportedSites fn.expression)

        DeclDestructure { pattern = pattern, expression = expression } ->
            let
                p =
                    if patternHasUnportedList pattern then
                        [ "destructure-pat" ]

                    else
                        []
            in
            Array.foldl Array.pushLast p (exprUnportedSites expression)

        _ ->
            []


exprUnportedSites : Expr -> Array String
exprUnportedSites expr =
    let
        here =
            when expr is
                ExprCase { cases = arms } ->
                    if
                        Array.any (\a -> patternHasUnportedList a.pattern) arms
                    then
                        [ "case{"
                            ++ String.join "|"
                                (Array.map (\a -> patternKind a.pattern) arms)
                            ++ "}"
                        ]

                    else
                        []

                ExprLambda { arguments = arguments } ->
                    if Array.any patternHasUnportedList arguments then
                        [ "lambda-args" ]

                    else
                        []

                ExprLet { declarations = declarations } ->
                    if Array.any letPatternsUnported declarations then
                        [ "let-pat" ]

                    else
                        []

                _ ->
                    []
    in
    Walk.foldExprChildren
        (\child acc -> Array.foldl Array.pushLast acc (exprUnportedSites child))
        here expr


patternKind : Pattern -> String
patternKind pattern =
    when pattern is
        PatCons _ ->
            "cons"

        PatList items ->
            "list" ++ String.fromInt (Array.length items)

        PatAll ->
            "_"

        PatVar _ ->
            "var"

        PatNamed { ref = ref } ->
            "named:" ++ ref.name

        PatTuple items ->
            "tuple" ++ String.fromInt (Array.length items)

        PatAs { pattern = inner } ->
            "as(" ++ patternKind inner ++ ")"

        PatRecordBind _ ->
            "recbind"

        _ ->
            "other"

-- TREE WALK ------------------------------------------------------------------


compileDeclaration : SoleCtors -> Int -> Declaration -> Declaration
compileDeclaration sole seed declaration =
    when declaration is
        DeclFunction fn ->
            let
                body =
                    compileExpr sole (Just fn.name) (seed + 1) fn.expression

                rewritten =
                    rewriteConsArgs sole (seed + 2) fn.arguments body
            in
            DeclFunction
                { fn
                    | arguments = rewritten.arguments
                    , expression = rewritten.expression
                }

        DeclDestructure { pattern = pattern, expression = expression } ->
            let
                body =
                    compileExpr sole Nothing (seed + 1) expression

                rewritten =
                    rewriteConsArgs sole (seed + 2) [ pattern ] body
            in
            when Array.first rewritten.arguments is
                Just p ->
                    DeclDestructure
                        { pattern = p, expression = rewritten.expression }

                Nothing ->
                    DeclDestructure { pattern = pattern, expression = body }

        _ ->
            declaration


compileExpr : SoleCtors -> Maybe String -> Int -> Expr -> Expr
compileExpr sole currentFunction seed expr =
    when expr is
        ExprCase { expression = scrutinee, cases = arms } ->
            let
                compiledScrut =
                    compileExpr sole currentFunction (seed + 1) scrutinee

                compiledArms =
                    Array.indexedMap
                        (\i arm ->
                            { pattern = arm.pattern
                            , body =
                                compileExpr sole currentFunction
                                    (seed + 10 + i * 97) arm.body
                            }) arms

            in
            if Array.any (\a -> patternHasUnportedList a.pattern) compiledArms then
                compilePatternMatrix sole currentFunction (seed + 5)
                    { columns = [ compiledScrut ]
                    , rows =
                        Array.map
                            (\arm ->
                                { patterns = [ arm.pattern ], body = arm.body }
                            )
                            compiledArms
                    }

            else
                ExprCase { expression = compiledScrut, cases = compiledArms }

        ExprLambda { arguments = arguments, expression = body } ->
            let
                compiledBody =
                    compileExpr sole currentFunction (seed + 1) body

                rewritten =
                    rewriteConsArgs sole (seed + 2) arguments compiledBody
            in
            ExprLambda
                { arguments = rewritten.arguments
                , expression = rewritten.expression
                }

        ExprLet { declarations = declarations, expression = body } ->
            let
                compiledBody =
                    compileExpr sole currentFunction (seed + 1) body

                -- Elm/Gren lets are mutually recursive in one block. Nesting
                -- each decl as `let a = … in let b = …` breaks forward refs
                -- (e.g. `ts = map t …` before `t i = …`). Only peel-fold when
                -- a destructure needs list/cons totalization.
                needsListPeel =
                    Array.any letDeclNeedsListPeel declarations
            in
            if needsListPeel then
                Array.indexedFoldr
                    (\i declaration currentBody ->
                        compileLetDeclInto sole (seed + 20 + i * 31) declaration
                            currentFunction currentBody) compiledBody declarations

            else
                ExprLet
                    { declarations =
                        Array.indexedMap
                            (\i declaration ->
                                compileLetDeclKeep sole (seed + 20 + i * 31)
                                    currentFunction declaration) declarations
                    , expression = compiledBody
                    }

        -- Seeded uniqueness only matters for case/lambda peels above.
        _ ->
            Walk.mapExprChildren
                (compileExpr sole currentFunction (seed + 1))
                expr


{-| True when a let bind must become a list/cons peel (cannot stay in one block).
-}
letDeclNeedsListPeel : LetDecl -> Bool
letDeclNeedsListPeel declaration =
    when declaration is
        LetDestructure { pattern = pattern } ->
            patternHasUnportedList pattern

        LetFunction _ ->
            False


{-| Compile one let declaration in place (same mutual block).
-}
compileLetDeclKeep : SoleCtors -> Int -> Maybe String -> LetDecl -> LetDecl
compileLetDeclKeep sole seed currentFunction declaration =
    when declaration is
        LetFunction fn ->
            let
                fnBody =
                    compileExpr sole (Just fn.name) (seed + 1) fn.expression

                rewritten =
                    rewriteConsArgs sole (seed + 2) fn.arguments fnBody
            in
            LetFunction
                { fn
                    | arguments = rewritten.arguments
                    , expression = rewritten.expression
                }

        LetDestructure { pattern = pattern, expression = expression } ->
            LetDestructure
                { pattern = pattern
                , expression =
                    compileExpr sole currentFunction (seed + 1) expression
                }


{-| Turn one let declaration into a binding wrapped around `body`.
List patterns in the bind become peels (same law as case/lambda).
Only used when the block needs list peels (see `letDeclNeedsListPeel`).
-}
compileLetDeclInto : SoleCtors -> Int -> LetDecl -> Maybe String -> Expr -> Expr
compileLetDeclInto sole seed declaration currentFunction body =
    when declaration is
        LetFunction fn ->
            let
                fnBody =
                    compileExpr sole (Just fn.name) (seed + 1) fn.expression

                rewritten =
                    rewriteConsArgs sole (seed + 2) fn.arguments fnBody
            in
            ExprLet
                { declarations =
                    [ LetFunction
                        { fn
                            | arguments = rewritten.arguments
                            , expression = rewritten.expression
                        }
                    ]
                , expression = body
                }

        LetDestructure { pattern = pattern, expression = expression } ->
            let
                value =
                    compileExpr sole currentFunction (seed + 1) expression
            in
            if patternHasUnportedList pattern then
                matchPattern sole (seed + 2) emptyScope pattern value body
                    (todo "elm-to-gren: let list pattern mismatch")

            else
                ExprLet
                    { declarations =
                        [ LetDestructure
                            { pattern = pattern, expression = value }
                        ]
                    , expression = body
                    }


-- PATTERN MATRIX -------------------------------------------------------------


{-| Compile a normalized pattern matrix. Rows retain source order, so the first
matching row wins. List and tuple columns share decision nodes; remaining
nested patterns use the same recursive matcher for wrappers, records, and
custom constructors.
-}
compilePatternMatrix : SoleCtors -> Maybe String -> Int -> PatternMatrix -> Expr
compilePatternMatrix sole currentFunction seed matrix =
    let
        columnNames =
            Array.indexedMap
                (\index _ ->
                    "pm_"
                        ++ String.fromInt seed
                        ++ "_"
                        ++ String.fromInt index
                )
                matrix.columns

        failEnd =
            todo "elm-to-gren: non-exhaustive pattern match"

        occupiedColumns =
            occupyAll columnNames emptyScope

        compiledRows =
            compileMatrixDecision sole currentFunction (seed + 1)
                occupiedColumns
                columnNames matrix.rows failEnd

        declarations =
            Array.map2
                (\name expression ->
                    LetDestructure
                        { pattern = PatVar name, expression = expression }
                )
                columnNames matrix.columns
    in
    ExprLet { declarations = declarations, expression = compiledRows }


type ListColumnPattern
    = EmptyListColumn
    | ConsListColumn { head : Pattern, tail : Pattern }
    | DefaultListColumn Pattern


type TupleColumnPattern
    = TupleParts (Array Pattern)
    | DefaultTupleColumn Pattern


type LiteralColumnPattern
    = LiteralValue { key : String, pattern : Pattern }
    | DefaultLiteralColumn Pattern


type NamedColumnPattern
    = NamedConstructor
        { key : String
        , ref : NamedRef
        , arguments : Array Pattern
        }
    | DefaultNamedColumn Pattern


{-| Choose and split one list column before falling back to ordered row
matching. A list is peeled once per decision node, and both branches receive
specialized matrices. This shares prefixes across arms and keeps output linear
for fixed-length and recursive list cases.
-}
compileMatrixDecision :
    SoleCtors
    -> Maybe String
    -> Int
    -> Scope
    -> Array String
    -> Array PatternRow
    -> Expr
    -> Expr
compileMatrixDecision sole currentFunction seed scope columnNames rows terminalFail =
    when firstListColumnInMatrix rows is
        Nothing ->
            when firstTupleColumnInMatrix rows is
                Nothing ->
                    when firstNamedColumnInMatrix sole rows is
                        Nothing ->
                            when firstLiteralColumnInMatrix rows is
                                Nothing ->
                                    compileMatrixRows sole currentFunction seed
                                        scope columnNames rows terminalFail

                                Just literalColumn ->
                                    compileLiteralColumn sole currentFunction seed
                                        scope columnNames rows terminalFail
                                        literalColumn

                        Just namedColumn ->
                            compileNamedColumn sole currentFunction seed scope
                                columnNames rows terminalFail namedColumn

                Just tupleColumn ->
                    compileTupleColumn sole currentFunction seed scope
                        columnNames rows terminalFail tupleColumn

        Just columnIndex ->
            when Array.get columnIndex columnNames is
                Nothing ->
                    terminalFail

                Just wholeName ->
                    let
                        headName =
                            "pc_h_"
                                ++ String.fromInt seed
                                ++ "_"
                                ++ String.fromInt columnIndex

                        tailName =
                            "pc_t_"
                                ++ String.fromInt seed
                                ++ "_"
                                ++ String.fromInt columnIndex

                        emptyRows =
                            Array.mapAndKeepJust
                                (specializeEmptyRow columnIndex wholeName)
                                rows

                        consRows =
                            Array.mapAndKeepJust
                                (specializeConsRow columnIndex wholeName)
                                rows

                        consColumns =
                            replaceColumn columnIndex
                                [ headName, tailName, wholeName ]
                                columnNames

                        consScope =
                            occupy headName (occupy tailName scope)
                    in
                    ExprCase
                        { expression = popFirst (var wholeName)
                        , cases =
                            [ { pattern = nothingPat
                              , body =
                                    compileMatrixDecision sole currentFunction
                                        (seed + 1) scope columnNames emptyRows
                                        terminalFail
                              }
                            , { pattern =
                                    justRecord (PatVar headName)
                                        (PatVar tailName)
                              , body =
                                    compileMatrixDecision sole currentFunction
                                        (seed + 1009) consScope consColumns
                                        consRows terminalFail
                              }
                            ]
                        }


compileTupleColumn :
    SoleCtors
    -> Maybe String
    -> Int
    -> Scope
    -> Array String
    -> Array PatternRow
    -> Expr
    -> { index : Int, arity : Int }
    -> Expr
compileTupleColumn sole currentFunction seed scope columnNames rows terminalFail tupleColumn =
    when Array.get tupleColumn.index columnNames is
        Nothing ->
            terminalFail

        Just wholeName ->
            let
                componentNames =
                    Array.initialize tupleColumn.arity 0
                        (\index ->
                            "pc_c_"
                                ++ String.fromInt seed
                                ++ "_"
                                ++ String.fromInt tupleColumn.index
                                ++ "_"
                                ++ String.fromInt index
                        )

                expandedColumns =
                    replaceColumn tupleColumn.index
                        (componentNames ++ [ wholeName ])
                        columnNames

                expandedRows =
                    Array.mapAndKeepJust
                        (specializeTupleRow tupleColumn.index wholeName
                            tupleColumn.arity)
                        rows

                declarations =
                    Array.indexedMap
                        (\index componentName ->
                            LetDestructure
                                { pattern = PatVar componentName
                                , expression =
                                    ExprAccess
                                        { record = var wholeName
                                        , field = fieldBindLabel index
                                        }
                                }
                        )
                        componentNames
            in
            ExprLet
                { declarations = declarations
                , expression =
                    compileMatrixDecision sole currentFunction (seed + 1009)
                        (occupyAll componentNames scope) expandedColumns
                        expandedRows terminalFail
                }


firstTupleColumnInMatrix :
    Array PatternRow
    -> Maybe { index : Int, arity : Int }
firstTupleColumnInMatrix rows =
    let
        width =
            when Array.first rows is
                Just row ->
                    Array.length row.patterns

                Nothing ->
                    0
    in
    Array.initialize width 0 identity
        |> Array.mapAndKeepJust
            (\columnIndex ->
                let
                    classified =
                        Array.mapAndKeepJust
                            (\row ->
                                Array.get columnIndex row.patterns
                                    |> Maybe.andThen tupleColumnPattern
                            )
                            rows

                    arities =
                        classified
                            |> Array.mapAndKeepJust
                                (\shape ->
                                    when shape is
                                        TupleParts items ->
                                            Just (Array.length items)

                                        DefaultTupleColumn _ ->
                                            Nothing
                                )
                in
                when Array.first arities is
                    Nothing ->
                        Nothing

                    Just arity ->
                        if
                            Array.length classified == Array.length rows
                                && Array.all (\found -> found == arity) arities
                        then
                            Just { index = columnIndex, arity = arity }

                        else
                            Nothing
            )
        |> Array.first


tupleColumnPattern : Pattern -> Maybe TupleColumnPattern
tupleColumnPattern pattern =
    when pattern is
        PatAs { pattern = inner } ->
            tupleColumnPattern inner

        PatTuple items ->
            Just (TupleParts items)

        PatVar _ ->
            Just (DefaultTupleColumn pattern)

        PatAll ->
            Just (DefaultTupleColumn pattern)

        _ ->
            Nothing


specializeTupleRow :
    Int
    -> String
    -> Int
    -> PatternRow
    -> Maybe PatternRow
specializeTupleRow columnIndex wholeName arity row =
    when Array.get columnIndex row.patterns is
        Nothing ->
            Nothing

        Just original ->
            let
                prepared =
                    peelTopAs wholeName original row.body
            in
            when tupleColumnPattern prepared.pattern is
                Just (TupleParts items) ->
                    Just
                        { patterns =
                            replaceColumn columnIndex (items ++ [ PatAll ])
                                row.patterns
                        , body = prepared.body
                        }

                Just (DefaultTupleColumn defaultPattern) ->
                    Just
                        { patterns =
                            replaceColumn columnIndex
                                (Array.repeat arity PatAll
                                    ++ [ defaultPattern ])
                                row.patterns
                        , body = prepared.body
                        }

                Nothing ->
                    Nothing


compileNamedColumn :
    SoleCtors
    -> Maybe String
    -> Int
    -> Scope
    -> Array String
    -> Array PatternRow
    -> Expr
    -> { index : Int, constructor : { key : String, ref : NamedRef, arity : Int } }
    -> Expr
compileNamedColumn sole currentFunction seed scope columnNames rows terminalFail namedColumn =
    when Array.get namedColumn.index columnNames is
        Nothing ->
            terminalFail

        Just wholeName ->
            let
                argumentNames =
                    Array.initialize namedColumn.constructor.arity 0
                        (\index ->
                            "pc_a_"
                                ++ String.fromInt seed
                                ++ "_"
                                ++ String.fromInt namedColumn.index
                                ++ "_"
                                ++ String.fromInt index
                        )

                branchColumns =
                    replaceColumn namedColumn.index
                        (argumentNames ++ [ wholeName ])
                        columnNames

                branchRows =
                    specializeNamedRows namedColumn.index wholeName
                        namedColumn.constructor.key
                        namedColumn.constructor.arity True rows

                remainingRows =
                    specializeNamedRows namedColumn.index wholeName
                        namedColumn.constructor.key
                        namedColumn.constructor.arity False rows

                branchPattern =
                    PatNamed
                        { ref = namedColumn.constructor.ref
                        , arguments = Array.map PatVar argumentNames
                        }
            in
            ExprCase
                { expression = var wholeName
                , cases =
                    [ { pattern = branchPattern
                      , body =
                            compileMatrixDecision sole currentFunction
                                (seed + 1009)
                                (occupyAll argumentNames scope)
                                branchColumns branchRows terminalFail
                      }
                    , { pattern = PatAll
                      , body =
                            compileMatrixDecision sole currentFunction
                                (seed + 1) scope columnNames remainingRows
                                terminalFail
                      }
                    ]
                }


firstNamedColumnInMatrix :
    SoleCtors
    -> Array PatternRow
    -> Maybe
        { index : Int
        , constructor : { key : String, ref : NamedRef, arity : Int }
        }
firstNamedColumnInMatrix sole rows =
    let
        width =
            when Array.first rows is
                Just row ->
                    Array.length row.patterns

                Nothing ->
                    0
    in
    Array.initialize width 0 identity
        |> Array.mapAndKeepJust
            (\columnIndex ->
                let
                    classified =
                        Array.mapAndKeepJust
                            (\row ->
                                Array.get columnIndex row.patterns
                                    |> Maybe.andThen namedColumnPattern
                            )
                            rows

                    firstConstructor =
                        Array.findFirst
                            (\shape ->
                                when shape is
                                    NamedConstructor details ->
                                        not (isSoleCtor sole details.ref)

                                    DefaultNamedColumn _ ->
                                        False
                            )
                            classified
                in
                if
                    Array.length classified /= Array.length rows
                        || Array.any
                            (\shape ->
                                when shape is
                                    DefaultNamedColumn _ ->
                                        True

                                    NamedConstructor _ ->
                                        False
                            )
                            classified
                then
                    Nothing

                else
                    when firstConstructor is
                        Just found ->
                            when found.value is
                                NamedConstructor details ->
                                    Just
                                        { index = columnIndex
                                        , constructor =
                                            { key = details.key
                                            , ref = details.ref
                                            , arity =
                                                Array.length details.arguments
                                            }
                                        }

                                DefaultNamedColumn _ ->
                                    Nothing

                        Nothing ->
                            Nothing
            )
        |> Array.first


namedColumnPattern : Pattern -> Maybe NamedColumnPattern
namedColumnPattern pattern =
    when pattern is
        PatAs { pattern = inner } ->
            namedColumnPattern inner

        PatNamed details ->
            Just
                (NamedConstructor
                    { key = namedRefKey details.ref
                    , ref = details.ref
                    , arguments = details.arguments
                    }
                )

        PatVar _ ->
            Just (DefaultNamedColumn pattern)

        PatAll ->
            Just (DefaultNamedColumn pattern)

        _ ->
            Nothing


namedRefKey : NamedRef -> String
namedRefKey ref =
    Maybe.withDefault "" ref.moduleName ++ "." ++ ref.name


specializeNamedRows :
    Int
    -> String
    -> String
    -> Int
    -> Bool
    -> Array PatternRow
    -> Array PatternRow
specializeNamedRows columnIndex wholeName selectedKey arity matchingBranch rows =
    Array.mapAndKeepJust
        (\row ->
            when Array.get columnIndex row.patterns is
                Nothing ->
                    Nothing

                Just original ->
                    let
                        prepared =
                            peelTopAs wholeName original row.body
                    in
                    when namedColumnPattern prepared.pattern is
                        Just (NamedConstructor details) ->
                            if matchingBranch && details.key == selectedKey then
                                Just
                                    { patterns =
                                        replaceColumn columnIndex
                                            (details.arguments ++ [ PatAll ])
                                            row.patterns
                                    , body = prepared.body
                                    }

                            else if
                                not matchingBranch
                                    && details.key
                                    /= selectedKey
                            then
                                Just row

                            else
                                Nothing

                        Just (DefaultNamedColumn defaultPattern) ->
                            if matchingBranch then
                                Just
                                    { patterns =
                                        replaceColumn columnIndex
                                            (Array.repeat arity PatAll
                                                ++ [ defaultPattern ])
                                            row.patterns
                                    , body = prepared.body
                                    }

                            else
                                Just
                                    { patterns =
                                        replaceColumn columnIndex
                                            [ defaultPattern ]
                                            row.patterns
                                    , body = prepared.body
                                    }

                        Nothing ->
                            Nothing
        )
        rows


compileLiteralColumn :
    SoleCtors
    -> Maybe String
    -> Int
    -> Scope
    -> Array String
    -> Array PatternRow
    -> Expr
    -> { index : Int, literals : Array { key : String, pattern : Pattern } }
    -> Expr
compileLiteralColumn sole currentFunction seed scope columnNames rows terminalFail literalColumn =
    when Array.get literalColumn.index columnNames is
        Nothing ->
            terminalFail

        Just wholeName ->
            let
                literalArms =
                    Array.indexedMap
                        (\branchIndex literal ->
                            { pattern = literal.pattern
                            , body =
                                compileMatrixDecision sole currentFunction
                                    (seed + 1 + branchIndex * 1009)
                                    scope columnNames
                                    (specializeLiteralRows literalColumn.index
                                        wholeName (Just literal.key) rows)
                                    terminalFail
                            }
                        )
                        literalColumn.literals

                defaultArm =
                    { pattern = PatAll
                    , body =
                        compileMatrixDecision sole currentFunction
                            (seed + 1 + Array.length literalArms * 1009)
                            scope columnNames
                            (specializeLiteralRows literalColumn.index wholeName
                                Nothing rows)
                            terminalFail
                    }
            in
            ExprCase
                { expression = var wholeName
                , cases = Array.pushLast defaultArm literalArms
                }


firstLiteralColumnInMatrix :
    Array PatternRow
    -> Maybe
        { index : Int
        , literals : Array { key : String, pattern : Pattern }
        }
firstLiteralColumnInMatrix rows =
    let
        width =
            when Array.first rows is
                Just row ->
                    Array.length row.patterns

                Nothing ->
                    0
    in
    Array.initialize width 0 identity
        |> Array.mapAndKeepJust
            (\columnIndex ->
                let
                    classified =
                        Array.mapAndKeepJust
                            (\row ->
                                Array.get columnIndex row.patterns
                                    |> Maybe.andThen literalColumnPattern
                            )
                            rows

                    literals =
                        Array.foldl
                            (\shape found ->
                                when shape is
                                    LiteralValue literal ->
                                        if
                                            Array.any
                                                (\existing ->
                                                    existing.key == literal.key
                                                )
                                                found
                                        then
                                            found

                                        else
                                            Array.pushLast literal found

                                    DefaultLiteralColumn _ ->
                                        found
                            )
                            []
                            classified
                in
                if
                    Array.length classified == Array.length rows
                        && Array.all
                            (\shape ->
                                when shape is
                                    LiteralValue _ ->
                                        True

                                    DefaultLiteralColumn _ ->
                                        False
                            )
                            classified
                        && not (Array.isEmpty literals)
                then
                    Just { index = columnIndex, literals = literals }

                else
                    Nothing
            )
        |> Array.first


literalColumnPattern : Pattern -> Maybe LiteralColumnPattern
literalColumnPattern pattern =
    when pattern is
        PatAs { pattern = inner } ->
            literalColumnPattern inner

        PatChar value ->
            Just
                (LiteralValue
                    { key = "char:" ++ value, pattern = pattern }
                )

        PatString value ->
            Just
                (LiteralValue
                    { key = "string:" ++ value, pattern = pattern }
                )

        PatInt value ->
            Just
                (LiteralValue
                    { key = "number:" ++ String.fromInt value
                    , pattern = pattern
                    }
                )

        PatHex value ->
            Just
                (LiteralValue
                    { key = "number:" ++ String.fromInt value
                    , pattern = pattern
                    }
                )

        PatFloat value ->
            Just
                (LiteralValue
                    { key = "float:" ++ String.fromFloat value
                    , pattern = pattern
                    }
                )

        PatVar _ ->
            Just (DefaultLiteralColumn pattern)

        PatAll ->
            Just (DefaultLiteralColumn pattern)

        _ ->
            Nothing


specializeLiteralRows :
    Int
    -> String
    -> Maybe String
    -> Array PatternRow
    -> Array PatternRow
specializeLiteralRows columnIndex wholeName selectedKey rows =
    Array.mapAndKeepJust
        (\row ->
            when Array.get columnIndex row.patterns is
                Nothing ->
                    Nothing

                Just original ->
                    let
                        prepared =
                            peelTopAs wholeName original row.body
                    in
                    when literalColumnPattern prepared.pattern is
                        Just (LiteralValue literal) ->
                            if selectedKey == Just literal.key then
                                Just
                                    { patterns =
                                        replaceColumn columnIndex [ PatAll ]
                                            row.patterns
                                    , body = prepared.body
                                    }

                            else
                                Nothing

                        Just (DefaultLiteralColumn defaultPattern) ->
                            Just
                                { patterns =
                                    replaceColumn columnIndex [ defaultPattern ]
                                        row.patterns
                                , body = prepared.body
                                }

                        Nothing ->
                            Nothing
        )
        rows


firstListColumnInMatrix : Array PatternRow -> Maybe Int
firstListColumnInMatrix rows =
    let
        width =
            when Array.first rows is
                Just row ->
                    Array.length row.patterns

                Nothing ->
                    0
    in
    Array.initialize width 0 identity
        |> Array.findFirst
            (\columnIndex ->
                let
                    classified =
                        Array.mapAndKeepJust
                            (\row ->
                                Array.get columnIndex row.patterns
                                    |> Maybe.andThen listColumnPattern
                            )
                            rows
                in
                Array.length classified == Array.length rows
                    && Array.any
                        (\shape ->
                            when shape is
                                DefaultListColumn _ ->
                                    False

                                _ ->
                                    True
                        )
                        classified
            )
        |> Maybe.map .value


listColumnPattern : Pattern -> Maybe ListColumnPattern
listColumnPattern pattern =
    when pattern is
        PatAs { pattern = inner } ->
            listColumnPattern inner

        PatList members ->
            when Array.popFirst members is
                Nothing ->
                    Just EmptyListColumn

                Just { first = head, rest = tail } ->
                    Just
                        (ConsListColumn
                            { head = head, tail = PatList tail }
                        )

        PatCons { head = head, tail = tail } ->
            Just (ConsListColumn { head = head, tail = tail })

        PatVar _ ->
            Just (DefaultListColumn pattern)

        PatAll ->
            Just (DefaultListColumn pattern)

        _ ->
            Nothing


specializeEmptyRow : Int -> String -> PatternRow -> Maybe PatternRow
specializeEmptyRow columnIndex wholeName row =
    when Array.get columnIndex row.patterns is
        Nothing ->
            Nothing

        Just original ->
            let
                prepared =
                    peelTopAs wholeName original row.body
            in
            when listColumnPattern prepared.pattern is
                Just EmptyListColumn ->
                    Just
                        { patterns =
                            replaceColumn columnIndex [ PatAll ] row.patterns
                        , body = prepared.body
                        }

                Just (DefaultListColumn defaultPattern) ->
                    Just
                        { patterns =
                            replaceColumn columnIndex [ defaultPattern ]
                                row.patterns
                        , body = prepared.body
                        }

                _ ->
                    Nothing


specializeConsRow : Int -> String -> PatternRow -> Maybe PatternRow
specializeConsRow columnIndex wholeName row =
    when Array.get columnIndex row.patterns is
        Nothing ->
            Nothing

        Just original ->
            let
                prepared =
                    peelTopAs wholeName original row.body
            in
            when listColumnPattern prepared.pattern is
                Just (ConsListColumn parts) ->
                    Just
                        { patterns =
                            replaceColumn columnIndex
                                [ parts.head, parts.tail, PatAll ]
                                row.patterns
                        , body = prepared.body
                        }

                Just (DefaultListColumn defaultPattern) ->
                    Just
                        { patterns =
                            replaceColumn columnIndex
                                [ PatAll, PatAll, defaultPattern ]
                                row.patterns
                        , body = prepared.body
                        }

                _ ->
                    Nothing


peelTopAs : String -> Pattern -> Expr -> { pattern : Pattern, body : Expr }
peelTopAs wholeName pattern body =
    when pattern is
        PatAs { pattern = inner, name = name } ->
            peelTopAs wholeName inner (wrapLet name (var wholeName) body)

        _ ->
            { pattern = pattern, body = body }


replaceColumn : Int -> Array a -> Array a -> Array a
replaceColumn columnIndex replacements values =
    Array.slice 0 columnIndex values
        ++ replacements
        ++ Array.slice (columnIndex + 1) (Array.length values) values


compileMatrixRows :
    SoleCtors
    -> Maybe String
    -> Int
    -> Scope
    -> Array String
    -> Array PatternRow
    -> Expr
    -> Expr
compileMatrixRows sole currentFunction seed scope columnNames rows terminalFail =
    when Array.popFirst rows is
        Nothing ->
            terminalFail

        Just { first = row, rest = remainingRows } ->
            let
                nextRow =
                    compileMatrixRows sole currentFunction (seed + 100003) scope
                        columnNames remainingRows terminalFail

                rowBinders =
                    Array.foldl
                        (\pattern found ->
                            Array.append found (patternBinders pattern)
                        )
                        []
                        row.patterns

                -- D60: inlining the fallthrough duplicates the ENTIRE remaining
                -- match into this row, so an N-row match nests N copies of its
                -- own tail. `ktonon/elm-word`'s `case ( wordSize, bytes )` (5
                -- rows, cons patterns up to 8 deep) never finished a port.
                -- D35 needs the inline only so a self-call stays in syntactic
                -- tail position for Gren's TCO; that pays off on the small
                -- recursive matches it was written for (list-extra's
                -- isPrefixOf and friends) and is worthless on a match whose
                -- tail is enormous. Above the budget, fall back to the shared
                -- thunk: a deep-recursion risk beats never terminating.
                mustInline =
                    when currentFunction is
                        Just functionName ->
                            tailHasSelfCall functionName nextRow
                                && withinInlineBudget nextRow

                        Nothing ->
                            False
            in
            if mustInline then
                compileMatrixRow sole (seed + 1) scope columnNames row.patterns
                    row.body
                    (freshenBinders (occupyAll rowBinders scope) nextRow)

            else
                let
                    failName =
                        "pf_" ++ String.fromInt seed

                    failCall =
                        ExprApplication [ var failName, ExprUnit ]

                    rowExpr =
                        compileMatrixRow sole (seed + 1)
                            (occupy failName scope) columnNames row.patterns
                            row.body failCall
                in
                ExprLet
                    { declarations =
                        [ LetFunction
                            { name = failName
                            , arguments = [ PatAll ]
                            , expression = nextRow
                            }
                        ]
                    , expression = rowExpr
                    }


compileMatrixRow :
    SoleCtors
    -> Int
    -> Scope
    -> Array String
    -> Array Pattern
    -> Expr
    -> Expr
    -> Expr
compileMatrixRow sole seed scope columnNames patterns body fail =
    let
        pairs =
            Array.map2
                (\columnName pattern ->
                    { columnName = columnName, pattern = pattern }
                )
                columnNames patterns
    in
    Array.indexedFoldr
        (\index pair success ->
            matchPattern sole (seed + index * 97) scope pair.pattern
                (var pair.columnName) success fail
        )
        body
        pairs


{-| Node budget for duplicating a fallthrough continuation (D60).

Counting stops as soon as the budget is exceeded, so a pathological tail costs
`inlineBudget` steps to reject, not a full traversal.
-}
inlineBudget : Int
inlineBudget =
    400


withinInlineBudget : Expr -> Bool
withinInlineBudget expression =
    countNodesUpTo inlineBudget expression <= inlineBudget


countNodesUpTo : Int -> Expr -> Int
countNodesUpTo budget expression =
    if budget <= 0 then
        1

    else
        Walk.foldExprChildren
            (\child total ->
                if total > budget then
                    total

                else
                    total + countNodesUpTo (budget - total) child
            )
            1
            expression


{-| Whether the current function calls itself in a syntactic tail position.
Such a continuation stays inline so Gren can perform tail-call elimination;
other continuations are shared through a local thunk to keep matrix output
linear in the number and depth of rows.
-}
tailHasSelfCall : String -> Expr -> Bool
tailHasSelfCall functionName expression =
    when expression is
        ExprApplication parts ->
            when Array.first parts is
                Just (ExprVar ref) ->
                    ref.moduleName == Nothing && ref.name == functionName

                _ ->
                    False

        ExprCase { cases = arms } ->
            Array.any (\arm -> tailHasSelfCall functionName arm.body) arms

        ExprIf { then_ = then_, else_ = else_ } ->
            tailHasSelfCall functionName then_
                || tailHasSelfCall functionName else_

        ExprLet { expression = body } ->
            tailHasSelfCall functionName body

        _ ->
            False


{-| Match `pattern` against `value`. On success run `body`; on failure `fail`.
Recursively peels list/cons patterns at any depth (tuple fields, ctor args, …).
-}
matchPattern :
    SoleCtors
    -> Int
    -> Scope
    -> Pattern
    -> Expr
    -> Expr
    -> Expr
    -> Expr
matchPattern sole seed scope pattern value body fail =
    when pattern is
        PatAll ->
            body

        PatVar name ->
            wrapLet name value body

        PatAs { pattern = inner, name = name } ->
            let
                bound =
                    bindName name scope
            in
            wrapLet bound.name value
                (matchPattern sole (seed + 1) bound.scope inner (var bound.name)
                    (renameExpr bound.subst body) fail)

        PatUnit ->
            body

        PatChar _ ->
            matchLiteral pattern value body fail

        PatString _ ->
            matchLiteral pattern value body fail

        PatInt _ ->
            matchLiteral pattern value body fail

        PatHex _ ->
            matchLiteral pattern value body fail

        PatFloat _ ->
            matchLiteral pattern value body fail

        PatList members ->
            if Array.isEmpty members then
                ExprCase
                    { expression = popFirst value
                    , cases =
                        [ { pattern = nothingPat, body = body }
                        , { pattern = PatAll, body = fail }
                        ]
                    }

            else
                matchListShape sole seed scope members (PatList []) value body
                    fail

        PatCons _ ->
            when consHeadsRest pattern is
                Just { heads = heads, rest = rest } ->
                    matchListShape sole seed scope heads rest value body fail

                Nothing ->
                    fail

        PatTuple items ->
            let
                labels =
                    tupleBindLabels (Array.length items)

                fields =
                    Array.map2 (\label item -> { name = label, pattern = item })
                        labels items
            in
            matchRecordFields sole seed scope fields value body fail

        PatRecord names ->
            -- Shallow record pattern `{ a, b }` — bind whole value, fields are names.
            wrapDestructure pattern value body

        PatRecordBind fields ->
            matchRecordFields sole seed scope fields value body fail

        PatNamed { ref = ref, arguments = args } ->
            matchNamedPattern sole seed scope ref args value body fail


matchLiteral : Pattern -> Expr -> Expr -> Expr -> Expr
matchLiteral pattern value body fail =
    ExprCase
        { expression = value
        , cases =
            [ { pattern = pattern, body = body }
            , { pattern = PatAll, body = fail }
            ]
        }


matchListShape :
    SoleCtors
    -> Int
    -> Scope
    -> Array Pattern
    -> Pattern
    -> Expr
    -> Expr
    -> Expr
    -> Expr
matchListShape sole seed scope heads rest value body fail =
    let
        listB =
            bindName ("ml_" ++ String.fromInt seed) scope
    in
    wrapLet listB.name value
        (matchListHeads sole (seed + 1) listB.scope listB.name heads rest body
            fail)


{-| Peel `listName` for heads/rest, desugaring nested list patterns in heads.
-}
matchListHeads :
    SoleCtors
    -> Int
    -> Scope
    -> String
    -> Array Pattern
    -> Pattern
    -> Expr
    -> Expr
    -> Expr
matchListHeads sole seed scope listName heads rest body fail =
    when Array.popFirst heads is
        Nothing ->
            -- No heads: only rest (open list or exact empty).
            when rest is
                PatVar restName ->
                    wrapLet restName (var listName) body

                PatAll ->
                    body

                PatList members ->
                    if Array.isEmpty members then
                        ExprCase
                            { expression = popFirst (var listName)
                            , cases =
                                [ { pattern = nothingPat, body = body }
                                , { pattern = PatAll, body = fail }
                                ]
                            }

                    else
                        matchListShape sole seed scope members (PatList [])
                            (var listName) body fail

                _ ->
                    if isEmptyList rest then
                        ExprCase
                            { expression = popFirst (var listName)
                            , cases =
                                [ { pattern = nothingPat, body = body }
                                , { pattern = PatAll, body = fail }
                                ]
                            }

                    else
                        matchPattern sole seed scope rest (var listName) body
                            fail

        Just { first = headPat, rest = moreHeads } ->
            let
                hB =
                    bindName ("mh_" ++ String.fromInt seed) scope

                tB =
                    bindName ("mt_" ++ String.fromInt seed) hB.scope

                afterHead =
                    matchPattern sole (seed + 1) tB.scope headPat (var hB.name)
                        (matchListHeads sole (seed + 2) tB.scope tB.name
                            moreHeads rest body fail) fail
            in
            ExprCase
                { expression = popFirst (var listName)
                , cases =
                    [ { pattern = nothingPat
                      , body = fail
                      }
                    , { pattern = justRecord (PatVar hB.name) (PatVar tB.name)
                      , body = afterHead
                      }
                    ]
                }


matchRecordFields :
    SoleCtors
    -> Int
    -> Scope
    -> Array { name : String, pattern : Pattern }
    -> Expr
    -> Expr
    -> Expr
    -> Expr
matchRecordFields sole seed scope fields value body fail =
    let
        tempB =
            bindName ("rf_" ++ String.fromInt seed) scope

        -- Refutable fields first so fail-continuations are NOT nested under
        -- irrefutable binders (`let first = …` wrapping the next case arm).
        refutable =
            Array.keepIf (\f -> not (isIrrefutable sole f.pattern)) fields

        irrefutable =
            Array.keepIf (\f -> isIrrefutable sole f.pattern) fields

        peelField i field cont =
            matchPattern sole (seed + 3 + i * 97) tempB.scope field.pattern
                (ExprAccess { record = var tempB.name, field = field.name })
                cont fail

        afterIrref =
            Array.indexedFoldr peelField body irrefutable

        peeled =
            Array.indexedFoldr
                (\i field cont ->
                    peelField (i + Array.length irrefutable) field cont)
                afterIrref refutable
    in
    wrapLet tempB.name value peeled


matchNamedPattern :
    SoleCtors
    -> Int
    -> Scope
    -> NamedRef
    -> Array Pattern
    -> Expr
    -> Expr
    -> Expr
    -> Expr
matchNamedPattern sole seed scope ref args value body fail =
    if Array.isEmpty args then
        if isIrrefutable sole (PatNamed { ref = ref, arguments = [] }) then
            body

        else
            ExprCase
                { expression = value
                , cases =
                    [ { pattern = PatNamed { ref = ref, arguments = [] }
                      , body = body
                      }
                    , { pattern = PatAll
                      , body = fail
                      }
                    ]
                }

    else if Array.any patternHasUnportedList args || Array.length args > 1 then
        -- Bind ctor payload args to temps (Gren multi-arg → one record, or 1-arg).
        let
            temps =
                Array.indexedMap
                    (\i _ ->
                        "na_" ++ String.fromInt seed ++ "_" ++ String.fromInt i)
                    args

            argPats =
                Array.map PatVar temps

            namedPat =
                PatNamed { ref = ref, arguments = argPats }

            afterMatch =
                Array.indexedFoldr
                    (\i argPat cont ->
                        when Array.get i temps is
                            Just t ->
                                matchPattern sole (seed + 1 + i)
                                    (occupyAll temps scope) argPat (var t) cont
                                    fail

                            Nothing ->
                                cont) body args

            matchExpr =
                if
                    -- `namedPat` binds every payload slot as a plain `PatVar`
                    -- temp (never the caller's original, possibly-refutable
                    -- sub-pattern), so it is *always* structurally irrefutable
                    -- once the ctor itself is sole — soleness alone is the
                    -- right test here, not `isIrrefutable` on the original
                    -- `args`. The real refutability testing on those original
                    -- args (list peels, literals, …) happens inside
                    -- `afterMatch`, which threads `fail` itself. Requiring the
                    -- original args to also be irrefutable falls through to
                    -- the `ExprCase [..., PatAll]` branch below for a sole
                    -- ctor with a refutable payload (e.g. `Fifo [] []`) — a
                    -- provably-unreachable wildcard on a single-constructor
                    -- type that trips a real Gren 0.6.6 compiler crash
                    -- ("Map.!: given key is not an element in the map") for
                    -- record-payload sole ctors, rather than the ordinary
                    -- "redundant pattern" diagnostic it gives for plain ones.
                    isSoleCtor sole ref
                then
                    wrapDestructure namedPat value afterMatch

                else
                    ExprCase
                        { expression = value
                        , cases =
                            [ { pattern = namedPat, body = afterMatch }
                            , { pattern = PatAll, body = fail }
                            ]
                        }
        in
        matchExpr

    else
        -- Single arg, no nested lists: keep prior sole-ctor / when behaviour.
        matchNamed sole (PatNamed { ref = ref, arguments = args }) value body
            fail

{-| Named / other structural patterns: add `_` only when the pattern is refutable.

Irrefutable sole-ctors use `let` destructure — a single-arm `when` (or a dead
`_` on a sole ctor) has crashed Gren (`Map.!`) on packages like tree-with-zipper.
-}
matchNamed : SoleCtors -> Pattern -> Expr -> Expr -> Expr -> Expr
matchNamed sole pattern value body fail =
    if isIrrefutable sole pattern then
        wrapDestructure pattern value body

    else
        ExprCase
            { expression = value
            , cases =
                [ { pattern = pattern, body = body }
                , { pattern = PatAll, body = fail }
                ]
            }


tupleBindLabels : Int -> Array String
tupleBindLabels count =
    Array.initialize count 0 fieldBindLabel


fieldBindLabel : Int -> String
fieldBindLabel index =
    when index is
        0 ->
            "first"

        1 ->
            "second"

        2 ->
            "third"

        3 ->
            "fourth"

        4 ->
            "fifth"

        5 ->
            "sixth"

        6 ->
            "seventh"

        7 ->
            "eighth"

        _ ->
            "field" ++ String.fromInt (index + 1)


wrapDestructure : Pattern -> Expr -> Expr -> Expr
wrapDestructure pattern value body =
    ExprLet
        { declarations =
            [ LetDestructure { pattern = pattern, expression = value } ]
        , expression = body
        }


{-| Irrefutable when any value of the scrutinee type matching this shape needs
no residual `_` arm. Sole-constructor custom types are irrefutable when their
nested argument patterns are irrefutable (package-wide sole-ctor set).
-}
isIrrefutable : SoleCtors -> Pattern -> Bool
isIrrefutable sole pattern =
    when pattern is
        PatVar _ ->
            True

        PatAll ->
            True

        PatAs { pattern = inner } ->
            isIrrefutable sole inner

        PatTuple items ->
            Array.all (isIrrefutable sole) items

        PatRecord _ ->
            -- Shorthand `{ left, parent, right }` is always a pure bind.
            True

        PatRecordBind fields ->
            Array.all (\f -> isIrrefutable sole f.pattern) fields

        PatNamed { ref = ref, arguments = args } ->
            isSoleCtor sole ref && Array.all (isIrrefutable sole) args

        _ ->
            False


isSoleCtor : SoleCtors -> NamedRef -> Bool
isSoleCtor sole ref =
    when ref.moduleName is
        Just moduleName ->
            Dict.member (moduleName ++ "." ++ ref.name) sole
                || Dict.member ref.name sole

        Nothing ->
            Dict.member ref.name sole

{-| Alpha-rename every binder in `expr` that collides with `scope`, threading
the growing occupied set through nested binding constructs so no two nested
binders share a name. Only binders that clash are renamed (via `bindPattern`/
`bindName`); free occurrences are rewritten to follow their binder through
`renameExpr`, and names free in `expr` (list temps, self-recursive calls) are
never touched. Used to give a duplicated fallthrough continuation its own
binder scope so D35's inlining cannot produce Gren SHADOWING (D38).
-}
freshenBinders : Scope -> Expr -> Expr
freshenBinders scope expr =
    when expr is
        ExprCase { expression = scrutinee, cases = arms } ->
            ExprCase
                { expression = freshenBinders scope scrutinee
                , cases =
                    Array.map
                        (\arm ->
                            let
                                bound =
                                    bindPattern arm.pattern scope
                            in
                            { pattern = bound.pattern
                            , body =
                                freshenBinders bound.scope
                                    (renameExpr bound.subst arm.body)
                            })
                        arms
                }

        ExprLambda { arguments = arguments, expression = body } ->
            let
                bound =
                    bindPatternList arguments scope
            in
            ExprLambda
                { arguments = bound.patterns
                , expression =
                    freshenBinders bound.scope (renameExpr bound.subst body)
                }

        ExprLet { declarations = declarations, expression = body } ->
            freshenLet scope declarations body

        _ ->
            Walk.mapExprChildren (freshenBinders scope) expr


{-| Alpha-rename the binders of a `let` block. Gren `let` bindings are mutually
recursive, so every binder is occupied first, then each right-hand side and the
body are rewritten under the merged substitution.
-}
freshenLet : Scope -> Array LetDecl -> Expr -> Expr
freshenLet scope declarations body =
    let
        collected =
            Array.foldl
                (\decl acc ->
                    when decl is
                        LetFunction fn ->
                            let
                                bound =
                                    bindName fn.name acc.scope
                            in
                            { scope = bound.scope
                            , subst = mergeSubst acc.subst bound.subst
                            , decls =
                                Array.pushLast
                                    (LetFunction { fn | name = bound.name })
                                    acc.decls
                            }

                        LetDestructure
                            { pattern = pattern, expression = expression } ->
                            let
                                bound =
                                    bindPattern pattern acc.scope
                            in
                            { scope = bound.scope
                            , subst = mergeSubst acc.subst bound.subst
                            , decls =
                                Array.pushLast
                                    (LetDestructure
                                        { pattern = bound.pattern
                                        , expression = expression
                                        })
                                    acc.decls
                            })
                { scope = scope, subst = Dict.empty, decls = [] }
                declarations

        newDecls =
            Array.map
                (\decl ->
                    when decl is
                        LetFunction fn ->
                            let
                                argBound =
                                    bindPatternList fn.arguments collected.scope
                            in
                            LetFunction
                                { fn
                                    | arguments = argBound.patterns
                                    , expression =
                                        freshenBinders argBound.scope
                                            (renameExpr
                                                (mergeSubst collected.subst
                                                    argBound.subst)
                                                fn.expression)
                                }

                        LetDestructure d ->
                            LetDestructure
                                { d
                                    | expression =
                                        freshenBinders collected.scope
                                            (renameExpr collected.subst
                                                d.expression)
                                })
                collected.decls
    in
    ExprLet
        { declarations = newDecls
        , expression =
            freshenBinders collected.scope (renameExpr collected.subst body)
        }


-- CONS IN ARGS ---------------------------------------------------------------


rewriteConsArgs :
    SoleCtors
    -> Int
    -> Array Pattern
    -> Expr
    -> { arguments : Array Pattern, expression : Expr }
rewriteConsArgs sole seed arguments body =
    Array.indexedFoldl
        (\index arg current ->
            if patternHasCons arg || isEmptyList arg then
                let
                    listName =
                        "al_"
                            ++ String.fromInt seed
                            ++ "_"
                            ++ String.fromInt index

                    -- Occupy prior arg binders so peels cannot shadow them.
                    scope0 =
                        Array.foldl
                            (\p s -> occupyAll (patternBinders p) s)
                            emptyScope current.arguments
                            |> occupy listName

                    peeled =
                        matchPattern sole (seed + index * 97) scope0 arg
                            (var listName) current.expression
                            (todo "elm-to-gren: argument pattern mismatch")
                in
                { arguments =
                    Array.pushLast (PatVar listName) current.arguments
                , expression = peeled
                }

            else
                { arguments = Array.pushLast arg current.arguments
                , expression = current.expression
                }) { arguments = [], expression = body } arguments

-- PATTERN HELPERS ------------------------------------------------------------


consHeadsRest : Pattern -> Maybe { heads : Array Pattern, rest : Pattern }
consHeadsRest pattern =
    when pattern is
        PatCons { head = head, tail = tail } ->
            when consHeadsRest tail is
                Just chain ->
                    Just
                        { heads = Array.pushFirst head chain.heads
                        , rest = chain.rest
                        }

                Nothing ->
                    Just { heads = [ head ], rest = tail }

        PatAs { pattern = inner } ->
            consHeadsRest inner

        _ ->
            Nothing


listShapeToHeadsRest :
    Pattern
    -> Maybe { heads : Array Pattern, rest : Pattern }
listShapeToHeadsRest pattern =
    when pattern is
        PatList members ->
            if Array.isEmpty members then
                Nothing

            else
                Just { heads = members, rest = PatList [] }

        PatCons _ ->
            consHeadsRest pattern

        PatAs { pattern = inner } ->
            listShapeToHeadsRest inner

        _ ->
            Nothing


stripAs : Pattern -> Pattern
stripAs pattern =
    when pattern is
        PatAs { pattern = inner } ->
            stripAs inner

        _ ->
            pattern


isEmptyList : Pattern -> Bool
isEmptyList pattern =
    when pattern is
        PatList members ->
            Array.isEmpty members

        PatAs { pattern = inner } ->
            isEmptyList inner

        _ ->
            False


justRecord : Pattern -> Pattern -> Pattern
justRecord firstPat restPat =
    PatNamed
        { ref = { moduleName = Nothing, name = "Just" }
        , arguments =
            [ PatRecordBind
                [ { name = "first", pattern = firstPat }
                , { name = "rest", pattern = restPat }
                ]
            ]
        }


nothingPat : Pattern
nothingPat =
    PatNamed
        { ref = { moduleName = Nothing, name = "Nothing" }
        , arguments = []
        }


popFirst : Expr -> Expr
popFirst scrut =
    ExprApplication
        [ ExprVar { moduleName = Just "Array", name = "popFirst" }
        , scrut
        ]


var : String -> Expr
var name =
    ExprVar { moduleName = Nothing, name = name }


wrapLet : String -> Expr -> Expr -> Expr
wrapLet name value body =
    ExprLet
        { declarations =
            [ LetFunction
                { name = name
                , arguments = []
                , expression = value
                }
            ]
        , expression = body
        }


todo : String -> Expr
todo message =
    ExprApplication
        [ ExprVar { moduleName = Just "Debug", name = "todo" }
        , ExprString message
        ]

-- UNPORTED SCAN --------------------------------------------------------------


declarationHasUnported : Declaration -> Bool
declarationHasUnported declaration =
    when declaration is
        DeclFunction fn ->
            Array.any patternHasUnportedList fn.arguments
                || exprHasUnported fn.expression

        DeclDestructure { pattern = pattern, expression = expression } ->
            patternHasUnportedList pattern || exprHasUnported expression

        _ ->
            False


exprHasUnported : Expr -> Bool
exprHasUnported expr =
    let
        here =
            when expr is
                ExprCase { cases = arms } ->
                    Array.any (\a -> patternHasUnportedList a.pattern) arms

                ExprLambda { arguments = arguments } ->
                    Array.any patternHasUnportedList arguments

                ExprLet { declarations = declarations } ->
                    Array.any letPatternsUnported declarations

                _ ->
                    False
    in
    if here then
        True

    else
        -- fold short-circuits poorly; any-child via fold flag.
        Walk.foldExprChildren
            (\child acc ->
                if acc then
                    True

                else
                    exprHasUnported child) False expr


letPatternsUnported : LetDecl -> Bool
letPatternsUnported declaration =
    when declaration is
        LetFunction fn ->
            Array.any patternHasUnportedList fn.arguments

        LetDestructure { pattern = pattern } ->
            patternHasUnportedList pattern


{-| Residual patterns Print cannot emit as valid Gren.

Gren accepts fixed array patterns (`[a, b, c]`, even nested). It does **not**
accept Elm cons patterns (`x :: xs`); those must be peeled to `Array.popFirst`.
-}
patternHasUnportedList : Pattern -> Bool
patternHasUnportedList pattern =
    when pattern is
        PatCons _ ->
            True

        PatList items ->
            -- Fixed lists print as Gren array patterns; only dig for nested cons.
            Array.any patternHasUnportedList items

        PatTuple items ->
            Array.any patternHasUnportedList items

        PatNamed { arguments = args } ->
            Array.any patternHasUnportedList args

        PatRecordBind fields ->
            Array.any (\f -> patternHasUnportedList f.pattern) fields

        PatAs { pattern = inner } ->
            patternHasUnportedList inner

        _ ->
            False


patternHasCons : Pattern -> Bool
patternHasCons pattern =
    when pattern is
        PatCons _ ->
            True

        PatTuple items ->
            Array.any patternHasCons items

        PatList items ->
            Array.any patternHasCons items

        PatNamed { arguments = args } ->
            Array.any patternHasCons args

        PatRecordBind fields ->
            Array.any (\f -> patternHasCons f.pattern) fields

        PatAs { pattern = inner } ->
            patternHasCons inner

        _ ->
            False
