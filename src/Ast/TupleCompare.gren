module Ast.TupleCompare exposing
    ( apply
    , ElemShape(..)
    , PackageReturns
    , comparatorFor
    , flippedComparator
    , listElementShape
    , noPackageReturns
    , returnListShape
    , returnTupleShape
    , shapeOfTypeAnn
    )

{-| D24 / D81: Elm tuples are `comparable`; the port lowers them to records
and Gren records are not. Any comparison-requiring call on tuple values
therefore type-errors after the port. This pass rewrites those calls to
explicit lexicographic comparators BEFORE NameSub, while Elm names,
tuples, and signatures are still intact.

Evidence law — rewrite ONLY on positive evidence of tuple-ness, never on
guesses (a wrong rewrite is worse than a missing one):

  - a literal `ExprTuple` argument, or a list literal containing one
  - a `::` cons whose head is a proven tuple (D81: flate's heap rebuild)
  - a variable whose type is known from the enclosing declaration's
    signature (arguments unified positionally with the type spine)
  - a let-bound function's signature, unified the same way for its body
    (D72: same evidence law as top-level, nested)
  - a `sortBy`/`minimum`/`maximum` projection lambda whose body is a
    tuple literal
  - a package-indexed function whose signature returns a list of tuples
    (frequencies-class, including through pipes)

This pass does not rewrite type annotations (no Elm/Gren type-name risk);
it only *reads* signatures for evidence. Let signatures are therefore
carried for env seeding, not transformed.

Rewrites:

  - `List.sort` → `sortWith` + generated lexicographic comparator
  - `sortBy` → `sortWith` composed with the projection
  - `minimum`/`maximum` → head of (flipped) sortWith
  - bare `compare` / order binops → comparator
  - `List.sortWith` whose comparator is compare-shaped
    (`compare`, `\a b -> compare a b`, `\a b -> compare b a`)
    AND whose list argument is proven list-of-tuples (D81 residual:
    source already used sortWith, so the earlier sort→sortWith law never
    fired; flate's `List.sortWith (\a b -> compare b a) (tuple :: rest)`)

Soundness of element comparison: the Elm source only compiled if every
tuple element was itself `comparable`, so elementwise `compare` is correct
for all non-tuple elements; nested tuples recurse into generated
comparators. Type variables instantiated with tuples remain unsupported
(same compile error as before this pass — no behavior change) and stay
ledgerable under D24.

Out of scope (D24b): tuple-typed Dict keys / Set members — those change
types, not call sites, and need an encoding law.
-}

import Array exposing ( Array )
import Ast.Types exposing
    ( Declaration(..)
    , Expr(..)
    , File
    , LetDecl(..)
    , Pattern(..)
    , TypeAnn(..)
    )
import Ast.Walk as Walk
import Dict exposing ( Dict )
import Maybe exposing ( Maybe(..) )


{-| Shape of a tuple element: opaque comparable, or a nested tuple. -}
type ElemShape
    = Prim
    | Nested (Array ElemShape)


type alias Env =
    { -- variable name -> its tuple shape
      tupleVars : Dict String (Array ElemShape)
    , -- variable name -> element shape of the list-of-tuples it holds
      listVars : Dict String (Array ElemShape)
    , -- function key ("Module.fn" or bare local "fn") -> element shape of
      -- the list-of-tuples it RETURNS (frequencies-class evidence)
      returns : Dict String (Array ElemShape)
    , -- D87: same key -> shape of the BARE tuple it returns
      -- (`Time.Date.toTuple : Date -> ( Int, Int, Int )`)
      bareReturns : Dict String (Array ElemShape)
    , -- D96: package type aliases, for seeing a tuple through its alias
      aliases : Dict String TypeAnn
    }


{-| Cross-module return-shape evidence, keyed by Elm-qualified function name
("List.Extra.frequencies"). `lists` holds functions returning a LIST of
tuples; `tuples` holds functions returning a bare tuple.
-}
type alias PackageReturns =
    { lists : Dict String (Array ElemShape)
    , tuples : Dict String (Array ElemShape)
    , -- D96: package type aliases by bare name, so a tuple hiding behind an
      -- alias is still a tuple. Ambiguous names are dropped before they get
      -- here — see `Transform.Evidence.collectTupleAliases`.
      aliases : Dict String TypeAnn
    }


noPackageReturns : PackageReturns
noPackageReturns =
    { lists = Dict.empty, tuples = Dict.empty, aliases = Dict.empty }


{-| `packageReturns` carries cross-module return-shape evidence keyed by the
Elm-qualified function name ("List.Extra.frequencies"); same-file functions
are indexed here from the file's own signatures (bare and self-qualified).
-}
apply : PackageReturns -> File -> File
apply packageReturns file =
    let
        indexOwn shapeOf seed =
            Array.foldl
                (\declaration acc ->
                    when declaration is
                        DeclFunction { name = name, signature = Just sig } ->
                            when shapeOf sig.typeAnnotation is
                                Just shape ->
                                    acc
                                        |> Dict.set name shape
                                        |> Dict.set (file.moduleDefinition.moduleName ++ "." ++ name) shape

                                Nothing ->
                                    acc

                        _ ->
                            acc
                )
                seed
                file.declarations

        resolve =
            resolveAlias packageReturns.aliases

        returns =
            { lists = indexOwn (returnListShapeVia resolve) packageReturns.lists
            , tuples = indexOwn (returnTupleShapeVia resolve) packageReturns.tuples
            , aliases = packageReturns.aliases
            }
    in
    { file
        | declarations = Array.map (applyDeclaration returns) file.declarations
    }


{-| D96: expand a package type alias by bare name, bounded so an alias
cycle cannot loop. Elm rejects cyclic aliases, but this pass reads whatever
the extractor hands it and must terminate on anything.
-}
resolveAlias : Dict String TypeAnn -> TypeAnn -> TypeAnn
resolveAlias aliases annotation =
    resolveAliasWithin 8 aliases annotation


resolveAliasWithin : Int -> Dict String TypeAnn -> TypeAnn -> TypeAnn
resolveAliasWithin fuel aliases annotation =
    if fuel <= 0 then
        annotation

    else
        when annotation is
            TypeTyped { ref = ref, arguments = [] } ->
                when Dict.get ref.name aliases is
                    Just body ->
                        resolveAliasWithin (fuel - 1) aliases body

                    Nothing ->
                        annotation

            _ ->
                annotation


{-| Element shape of the list-of-tuples at the END of a signature's spine. -}
returnListShape : TypeAnn -> Maybe (Array ElemShape)
returnListShape annotation =
    returnListShapeVia identity annotation


returnListShapeVia : (TypeAnn -> TypeAnn) -> TypeAnn -> Maybe (Array ElemShape)
returnListShapeVia resolve annotation =
    when annotation is
        TypeFunction { right = right } ->
            returnListShapeVia resolve right

        _ ->
            listElementShapeVia resolve annotation


{-| D87: shape of the BARE tuple at the END of a signature's spine, the
counterpart of `returnListShape`. Evidence of the same kind and the same
strength: the Elm source declared the return type, so a call to the
function is a tuple, full stop.
-}
returnTupleShape : TypeAnn -> Maybe (Array ElemShape)
returnTupleShape annotation =
    returnTupleShapeVia identity annotation


returnTupleShapeVia : (TypeAnn -> TypeAnn) -> TypeAnn -> Maybe (Array ElemShape)
returnTupleShapeVia resolve annotation =
    when annotation is
        TypeFunction { right = right } ->
            returnTupleShapeVia resolve right

        _ ->
            shapeOfTypeAnnVia resolve annotation


applyDeclaration : PackageReturns -> Declaration -> Declaration
applyDeclaration returns declaration =
    when declaration is
        DeclFunction fn ->
            let
                env =
                    envFromSignature returns fn.signature fn.arguments

                -- D96: the declaration's own return annotation types its TAIL
                -- expressions. `fplSymbols : FormulaPL -> List PSymb` whose
                -- body is `List.sort <| Set.toList <| fplSymbolsAux f` has no
                -- other evidence anywhere: the argument of the sort is a
                -- stdlib call the pass cannot type. Applied to tails only, so
                -- a `List.sort` buried in a sub-expression is untouched.
                tailShape =
                    when fn.signature is
                        Just sig ->
                            returnListShapeVia (resolveAlias env.aliases)
                                sig.typeAnnotation

                        Nothing ->
                            Nothing
            in
            DeclFunction
                { fn
                    | expression =
                        rewrite env (rewriteTails env tailShape fn.expression)
                }

        _ ->
            declaration


{-| D96: rewrite the list-sorting calls that SIT IN TAIL POSITION of a body
whose return type is a known list-of-tuples.

Only the tail is touched, and only when the ordinary evidence law found
nothing — a rewrite the normal rules already make is left to them, so this
adds cases and never changes existing ones.
-}
rewriteTails : Env -> Maybe (Array ElemShape) -> Expr -> Expr
rewriteTails env tailShape expr =
    when tailShape is
        Nothing ->
            expr

        Just shape ->
            rewriteTailWith env shape expr


rewriteTailWith : Env -> Array ElemShape -> Expr -> Expr
rewriteTailWith env shape expr =
    when expr is
        ExprCase details ->
            ExprCase
                { details
                    | cases =
                        Array.map
                            (\arm -> { arm | body = rewriteTailWith env shape arm.body })
                            details.cases
                }

        ExprIf details ->
            ExprIf
                { details
                    | then_ = rewriteTailWith env shape details.then_
                    , else_ = rewriteTailWith env shape details.else_
                }

        ExprLet details ->
            ExprLet
                { details | expression = rewriteTailWith env shape details.expression }

        _ ->
            sortInTail env shape expr


{-| The tail itself: `List.sort xs`, `xs |> List.sort`, `List.sort <| xs`. -}
sortInTail : Env -> Array ElemShape -> Expr -> Expr
sortInTail env shape expr =
    let
        sortWithShape listArg =
            ExprApplication [ listVar "sortWith", comparatorFor shape 0, listArg ]

        unproven listArg =
            listShapeOfExpr env listArg == Nothing
    in
    when expr is
        ExprApplication [ ExprVar ref, listArg ] ->
            if isListFn ref "sort" && unproven listArg then
                sortWithShape listArg

            else
                expr

        ExprBinop { operator = "|>", left = left, right = ExprVar ref } ->
            if isListFn ref "sort" && unproven left then
                sortWithShape left

            else
                expr

        ExprBinop { operator = "<|", left = ExprVar ref, right = right } ->
            if isListFn ref "sort" && unproven right then
                sortWithShape right

            else
                expr

        _ ->
            expr


{-| Unify the signature's function-type spine with the argument patterns:
each `PatVar` whose positional type is a tuple (or list of tuples) enters
the evidence environment. Elm forbids shadowing, so one name maps to one
binding for the whole declaration.
-}
envFromSignature : PackageReturns -> Maybe { name : String, typeAnnotation : TypeAnn } -> Array Pattern -> Env
envFromSignature returns signature arguments =
    let
        empty =
            { tupleVars = Dict.empty
            , listVars = Dict.empty
            , returns = returns.lists
            , bareReturns = returns.tuples
            , aliases = returns.aliases
            }
    in
    when signature is
        Nothing ->
            empty

        Just sig ->
            Array.foldl
                (\arg state ->
                    when state.spine is
                        TypeFunction { left = left, right = right } ->
                            { spine = right
                            , env = bindPattern arg left state.env
                            }

                        _ ->
                            state
                )
                { spine = sig.typeAnnotation, env = empty }
                arguments
                |> .env


bindPattern : Pattern -> TypeAnn -> Env -> Env
bindPattern pattern annotation env =
    let
        resolve =
            resolveAlias env.aliases
    in
    when pattern is
        PatVar name ->
            when shapeOfTypeAnnVia resolve annotation is
                Just shape ->
                    { env | tupleVars = Dict.set name shape env.tupleVars }

                Nothing ->
                    when listElementShapeVia resolve annotation is
                        Just shape ->
                            { env | listVars = Dict.set name shape env.listVars }

                        Nothing ->
                            env

        _ ->
            env


shapeOfTypeAnn : TypeAnn -> Maybe (Array ElemShape)
shapeOfTypeAnn annotation =
    shapeOfTypeAnnVia identity annotation


shapeOfTypeAnnVia : (TypeAnn -> TypeAnn) -> TypeAnn -> Maybe (Array ElemShape)
shapeOfTypeAnnVia resolve annotation =
    when resolve annotation is
        TypeTuple elements ->
            Just
                (Array.map
                    (\element ->
                        when shapeOfTypeAnnVia resolve element is
                            Just nested ->
                                Nested nested

                            Nothing ->
                                Prim
                    )
                    elements
                )

        _ ->
            Nothing


listElementShape : TypeAnn -> Maybe (Array ElemShape)
listElementShape annotation =
    listElementShapeVia identity annotation


listElementShapeVia : (TypeAnn -> TypeAnn) -> TypeAnn -> Maybe (Array ElemShape)
listElementShapeVia resolve annotation =
    when resolve annotation is
        TypeTyped { ref = ref, arguments = arguments } ->
            if ref.name == "List" && (ref.moduleName == Nothing || ref.moduleName == Just "List") then
                when Array.get 0 arguments is
                    Just element ->
                        shapeOfTypeAnnVia resolve element

                    Nothing ->
                        Nothing

            else
                Nothing

        _ ->
            Nothing

-- EVIDENCE ON EXPRESSIONS -----------------------------------------------------


shapeOfExpr : Env -> Expr -> Maybe (Array ElemShape)
shapeOfExpr env expr =
    when expr is
        ExprTuple items ->
            Just
                (Array.map
                    (\item ->
                        when shapeOfExpr env item is
                            Just nested ->
                                Nested nested

                            Nothing ->
                                Prim
                    )
                    items
                )

        ExprVar { moduleName = Nothing, name = name } ->
            Dict.get name env.tupleVars

        -- D87: a saturated call to a package function whose signature returns
        -- a bare tuple. `Time.Date.compare d1 d2 = compare (toTuple d1)
        -- (toTuple d2)` gives the comparison no other evidence to stand on.
        ExprApplication parts ->
            when Array.get 0 parts is
                Just (ExprVar ref) ->
                    if Array.length parts >= 2 then
                        Dict.get (refKey ref) env.bareReturns

                    else
                        Nothing

                _ ->
                    Nothing

        ExprBinop { operator = "|>", left = left, right = right } ->
            shapeOfExpr env (pipeAsApplication right left)

        ExprBinop { operator = "<|", left = left, right = right } ->
            shapeOfExpr env (pipeAsApplication left right)

        _ ->
            Nothing


listShapeOfExpr : Env -> Expr -> Maybe (Array ElemShape)
listShapeOfExpr env expr =
    when expr is
        ExprList items ->
            Array.foldl
                (\item found ->
                    when found is
                        Just _ ->
                            found

                        Nothing ->
                            shapeOfExpr env item
                )
                Nothing
                items

        ExprVar { moduleName = Nothing, name = name } ->
            Dict.get name env.listVars

        ExprApplication parts ->
            -- frequencies-class: a saturated call to a function whose
            -- signature returns a list of tuples.
            when Array.get 0 parts is
                Just (ExprVar ref) ->
                    if Array.length parts >= 2 then
                        Dict.get (refKey ref) env.returns

                    else
                        Nothing

                _ ->
                    Nothing

        -- D81: `tuple :: rest` carries the head's shape as the list element.
        ExprBinop { operator = "::", left = left, right = _ } ->
            shapeOfExpr env left

        ExprBinop { operator = "|>", left = left, right = right } ->
            listShapeOfExpr env (pipeAsApplication right left)

        ExprBinop { operator = "<|", left = left, right = right } ->
            listShapeOfExpr env (pipeAsApplication left right)

        _ ->
            Nothing


{-| View `arg |> fn` (or `fn <| arg`) as the application it denotes. -}
pipeAsApplication : Expr -> Expr -> Expr
pipeAsApplication fn arg =
    when fn is
        ExprApplication parts ->
            ExprApplication (Array.pushLast arg parts)

        _ ->
            ExprApplication [ fn, arg ]


refKey : { moduleName : Maybe String, name : String } -> String
refKey ref =
    when ref.moduleName is
        Just moduleName ->
            moduleName ++ "." ++ ref.name

        Nothing ->
            ref.name


{-| A projection function whose result is provably a tuple:
`\x -> ( ..., ... )` (possibly through nothing else — MVP).
-}
projectionShape : Env -> Expr -> Maybe (Array ElemShape)
projectionShape env expr =
    when expr is
        ExprLambda { expression = body } ->
            tailShapeOfExpr env body

        _ ->
            Nothing


{-| D87: shape of an expression read through its TAIL positions.

A sort key is rarely a bare tuple literal. `Csv.Decode`'s projection is a
`when` over the error type whose every arm yields a triple, and Elm's own
typing forces all arms to the same type — so if every arm is provably a
tuple of the same shape, the expression is that tuple, with no guessing.

Branches that disagree, or any branch with no tuple evidence, yield
nothing: an unprovable arm means the whole projection stays untouched.
-}
tailShapeOfExpr : Env -> Expr -> Maybe (Array ElemShape)
tailShapeOfExpr env expr =
    when expr is
        ExprCase { cases = cases } ->
            agreeingShape
                (Array.map (\arm -> tailShapeOfExpr env arm.body) cases)

        ExprIf { then_ = then_, else_ = else_ } ->
            agreeingShape
                [ tailShapeOfExpr env then_, tailShapeOfExpr env else_ ]

        ExprLet { expression = body } ->
            tailShapeOfExpr env body

        _ ->
            shapeOfExpr env expr


{-| The single shape every branch agrees on, or nothing. An empty branch
set proves nothing and is refused too.
-}
agreeingShape : Array (Maybe (Array ElemShape)) -> Maybe (Array ElemShape)
agreeingShape branches =
    when Array.popFirst branches is
        Nothing ->
            Nothing

        Just { first = Nothing } ->
            Nothing

        Just { first = Just shape, rest = rest } ->
            if Array.all (\branch -> branch == Just shape) rest then
                Just shape

            else
                Nothing

-- REWRITE ---------------------------------------------------------------------


rewrite : Env -> Expr -> Expr
rewrite env expr =
    when expr is
        -- D72: a let function's signature seeds the same env as a top-level
        -- DeclFunction for that binding's body; sibling binds share the
        -- outer env (Elm let is mutually recursive for values).
        ExprLet { declarations = declarations, expression = body } ->
            ExprLet
                { declarations = Array.map (rewriteLetDecl env) declarations
                , expression = rewrite env body
                }

        _ ->
            let
                rewritten =
                    rewriteNode env expr
            in
            Walk.mapExprChildren (rewrite env) rewritten


rewriteLetDecl : Env -> LetDecl -> LetDecl
rewriteLetDecl env declaration =
    when declaration is
        LetFunction fn ->
            let
                bodyEnv =
                    mergeEnv env
                        (envFromSignature
                            { lists = env.returns
                            , tuples = env.bareReturns
                            , aliases = env.aliases
                            }
                            fn.signature
                            fn.arguments
                        )
            in
            LetFunction
                { fn
                    | arguments = fn.arguments
                    , expression = rewrite bodyEnv fn.expression
                }

        LetDestructure { pattern = pattern, expression = expression } ->
            LetDestructure
                { pattern = pattern
                , expression = rewrite env expression
                }


{-| Overlay inner env bindings on outer; returns maps are shared. -}
mergeEnv : Env -> Env -> Env
mergeEnv outer inner =
    { tupleVars = Dict.foldl Dict.set outer.tupleVars inner.tupleVars
    , listVars = Dict.foldl Dict.set outer.listVars inner.listVars
    , returns = outer.returns
    , bareReturns = outer.bareReturns
    , aliases = outer.aliases
    }


rewriteNode : Env -> Expr -> Expr
rewriteNode env expr =
    when expr is
        ExprApplication parts ->
            when { fn = Array.get 0 parts, arity = Array.length parts } is
                { fn = Just (ExprVar ref), arity = 2 } ->
                    rewriteUnaryListCall env ref parts expr

                { fn = Just (ExprVar ref), arity = 3 } ->
                    rewriteBinaryCall env ref parts expr

                _ ->
                    expr

        ExprBinop { operator = "|>", left = left, right = ExprVar ref } ->
            when pipedListRewrite env ref left is
                Just rewritten ->
                    rewritten

                Nothing ->
                    expr

        ExprBinop { operator = "<|", left = ExprVar ref, right = right } ->
            when pipedListRewrite env ref right is
                Just rewritten ->
                    rewritten

                Nothing ->
                    expr

        -- D87: the PARTIALLY APPLIED pipe, `xs |> List.sortBy f`. Only the
        -- bare-reference form above was routed to the rewriter, so every
        -- sortBy written in pipe style went unexamined however plain its
        -- projection was (elm-review-mini's key is a literal tuple).
        ExprBinop { operator = "|>", left = left, right = ExprApplication parts } ->
            pipedPartialRewrite env parts left expr

        ExprBinop { operator = "<|", left = ExprApplication parts, right = right } ->
            pipedPartialRewrite env parts right expr

        ExprBinop { operator = operator, left = left, right = right } ->
            when orderBinop operator is
                Nothing ->
                    expr

                Just wanted ->
                    when firstShape [ shapeOfExpr env left, shapeOfExpr env right ] is
                        Nothing ->
                            expr

                        Just shape ->
                            -- (a, b) < (c, d)  ==>  cmp a b == LT   (etc.)
                            orderTest wanted (applyComparator shape 0 left right)

        _ ->
            expr


{-| D87: saturate a piped partial application and offer it to the ordinary
call rewriters. The pipe is only unwound when a rewrite actually fires —
an untouched call keeps the author's pipe style.
-}
pipedPartialRewrite : Env -> Array Expr -> Expr -> Expr -> Expr
pipedPartialRewrite env parts argument original =
    let
        saturatedParts =
            Array.pushLast argument parts

        saturated =
            ExprApplication saturatedParts

        keepIfRewritten rewritten =
            if rewritten == saturated then
                original

            else
                rewritten
    in
    when { fn = Array.get 0 parts, arity = Array.length saturatedParts } is
        { fn = Just (ExprVar ref), arity = 2 } ->
            keepIfRewritten (rewriteUnaryListCall env ref saturatedParts saturated)

        { fn = Just (ExprVar ref), arity = 3 } ->
            keepIfRewritten (rewriteBinaryCall env ref saturatedParts saturated)

        _ ->
            original


{-| `xs |> List.sort` / `List.sort <| xs` family. The rewrite result is the
plain application form — pipe style is not preserved, correctness is.
-}
pipedListRewrite : Env -> Ast.Types.NamedRef -> Expr -> Maybe Expr
pipedListRewrite env ref listArg =
    if isListFn ref "sort" || isListFn ref "minimum" || isListFn ref "maximum" then
        when listShapeOfExpr env listArg is
            Nothing ->
                Nothing

            Just shape ->
                if isListFn ref "sort" then
                    Just (ExprApplication [ listVar "sortWith", comparatorFor shape 0, listArg ])

                else if isListFn ref "minimum" then
                    Just
                        (ExprApplication
                            [ listVar "head"
                            , ExprApplication [ listVar "sortWith", comparatorFor shape 0, listArg ]
                            ]
                        )

                else
                    Just
                        (ExprApplication
                            [ listVar "head"
                            , ExprApplication [ listVar "sortWith", flippedComparator shape, listArg ]
                            ]
                        )

    else
        Nothing


{-| `List.sort xs` family — one list argument. -}
rewriteUnaryListCall : Env -> Ast.Types.NamedRef -> Array Expr -> Expr -> Expr
rewriteUnaryListCall env ref parts original =
    when Array.get 1 parts is
        Nothing ->
            original

        Just listArg ->
            if isListFn ref "sortBy" then
                -- D87: `List.sortBy f` UNSATURATED. elm-csv composes it with
                -- `>>` and never applies a list, so the saturated rewriter
                -- below never sees it. `sortWith cmp` has the same
                -- `List a -> List a` type as `sortBy f`, so the partial form
                -- substitutes cleanly wherever the author used it.
                when projectionShape env listArg is
                    Nothing ->
                        original

                    Just shape ->
                        ExprApplication
                            [ listVar "sortWith"
                            , ExprLambda
                                { arguments = [ PatVar "d24ByL", PatVar "d24ByR" ]
                                , expression =
                                    applyComparator shape
                                        0
                                        (ExprApplication [ listArg, bareVar "d24ByL" ])
                                        (ExprApplication [ listArg, bareVar "d24ByR" ])
                                }
                            ]

            else
                when listShapeOfExpr env listArg is
                Nothing ->
                    original

                Just shape ->
                    if isListFn ref "sort" then
                        ExprApplication
                            [ listVar "sortWith"
                            , comparatorFor shape 0
                            , listArg
                            ]

                    else if isListFn ref "minimum" then
                        -- head of an ascending sortWith = the minimum
                        ExprApplication
                            [ listVar "head"
                            , ExprApplication [ listVar "sortWith", comparatorFor shape 0, listArg ]
                            ]

                    else if isListFn ref "maximum" then
                        ExprApplication
                            [ listVar "head"
                            , ExprApplication [ listVar "sortWith", flippedComparator shape, listArg ]
                            ]

                    else
                        original


{-| `List.sortBy f xs` / `compare a b` / `List.sortWith cmp xs` — two
list-related arguments (plus the head).
-}
rewriteBinaryCall : Env -> Ast.Types.NamedRef -> Array Expr -> Expr -> Expr
rewriteBinaryCall env ref parts original =
    when { a = Array.get 1 parts, b = Array.get 2 parts } is
        { a = Just first, b = Just second } ->
            if isListFn ref "sortBy" then
                when projectionShape env first is
                    Nothing ->
                        original

                    Just shape ->
                        -- sortBy f ==> sortWith (\x y -> cmp (f x) (f y))
                        ExprApplication
                            [ listVar "sortWith"
                            , ExprLambda
                                { arguments = [ PatVar "d24ByL", PatVar "d24ByR" ]
                                , expression =
                                    applyComparator shape
                                        0
                                        (ExprApplication [ first, bareVar "d24ByL" ])
                                        (ExprApplication [ first, bareVar "d24ByR" ])
                                }
                            , second
                            ]

            else if isListFn ref "sortWith" then
                -- D81: source already used sortWith with a compare-shaped
                -- comparator. Only fire when the LIST is proven tuple-y;
                -- an unproven list keeps the source comparator untouched.
                when listShapeOfExpr env second is
                    Nothing ->
                        original

                    Just shape ->
                        when compareShaped first is
                            Nothing ->
                                original

                            Just flip_ ->
                                ExprApplication
                                    [ listVar "sortWith"
                                    , if flip_ then
                                        flippedComparator shape

                                      else
                                        comparatorFor shape 0
                                    , second
                                    ]

            else if isBasicsFn ref "compare" then
                when firstShape [ shapeOfExpr env first, shapeOfExpr env second ] is
                    Nothing ->
                        original

                    Just shape ->
                        applyComparator shape 0 first second

            else
                original

        _ ->
            original


{-| Positive evidence that a comparator is Elm's default `compare`, possibly
flipped. Returns `Just True` when flipped (`compare b a`), `Just False`
when unflipped, `Nothing` when the body does anything else (then we leave
the site alone — a custom comparator is not ours to rewrite).
-}
compareShaped : Expr -> Maybe Bool
compareShaped expr =
    when expr is
        ExprVar ref ->
            if isBasicsFn ref "compare" then
                Just False

            else
                Nothing

        ExprLambda { arguments = arguments, expression = body } ->
            when binderPair arguments is
                Just { left = leftName, right = rightName } ->
                    when compareArgs body is
                        Just { ref = ref, first = xName, second = yName } ->
                            if isBasicsFn ref "compare" then
                                if xName == leftName && yName == rightName then
                                    Just False

                                else if xName == rightName && yName == leftName then
                                    Just True

                                else
                                    Nothing

                            else
                                Nothing

                        Nothing ->
                            Nothing

                Nothing ->
                    Nothing

        _ ->
            Nothing


binderPair : Array Pattern -> Maybe { left : String, right : String }
binderPair arguments =
    when Array.get 0 arguments is
        Just (PatVar leftName) ->
            when Array.get 1 arguments is
                Just (PatVar rightName) ->
                    Just { left = leftName, right = rightName }

                _ ->
                    Nothing

        _ ->
            Nothing


compareArgs :
    Expr
    -> Maybe { ref : Ast.Types.NamedRef, first : String, second : String }
compareArgs body =
    when body is
        ExprApplication parts ->
            when Array.get 0 parts is
                Just (ExprVar ref) ->
                    when Array.get 1 parts is
                        Just (ExprVar { moduleName = Nothing, name = xName }) ->
                            when Array.get 2 parts is
                                Just (ExprVar { moduleName = Nothing, name = yName }) ->
                                    Just { ref = ref, first = xName, second = yName }

                                _ ->
                                    Nothing

                        _ ->
                            Nothing

                _ ->
                    Nothing

        _ ->
            Nothing

-- COMPARATOR GENERATION -------------------------------------------------------


{-| Lexicographic comparator lambda for a tuple shape, lowered-field aware:
element i is read through `.first` / `.second` / … (the record lowering the
printer applies to tuples). `depth` uniquifies binder names for nested
tuple recursion (Gren forbids shadowing).

    \d24L0 d24R0 ->
        when compare d24L0.first d24R0.first is
            EQ -> compare d24L0.second d24R0.second
            d24O0_0 -> d24O0_0
-}
comparatorFor : Array ElemShape -> Int -> Expr
comparatorFor shape depth =
    let
        leftName =
            "d24L" ++ String.fromInt depth

        rightName =
            "d24R" ++ String.fromInt depth
    in
    ExprLambda
        { arguments = [ PatVar leftName, PatVar rightName ]
        , expression = comparatorBody shape depth (bareVar leftName) (bareVar rightName)
        }


{-| The comparator body applied to two already-named tuple values. -}
comparatorBody : Array ElemShape -> Int -> Expr -> Expr -> Expr
comparatorBody shape depth left right =
    let
        elementCompare index element =
            let
                access value =
                    ExprAccess { record = value, field = fieldLabel index }
            in
            when element is
                Prim ->
                    -- Qualified for the same reason as IndexClamp's Basics.max
                    -- (D39): a module-local `compare` would capture the bare name.
                    ExprApplication
                        [ ExprVar { moduleName = Just "Basics", name = "compare" }
                        , access left
                        , access right
                        ]

                Nested nested ->
                    applyComparator nested (depth + 1) (access left) (access right)

        indexed =
            Array.indexedMap (\index element -> { index = index, element = element }) shape
    in
    when Array.popLast indexed is
        Nothing ->
            bareVar "EQ"

        Just { last = last, initial = initial } ->
            Array.foldr
                (\entry deeper ->
                    ExprCase
                        { expression = elementCompare entry.index entry.element
                        , cases =
                            [ { pattern = PatNamed { ref = { moduleName = Nothing, name = "EQ" }, arguments = [] }
                              , body = deeper
                              }
                            , { pattern = PatVar (orderName depth entry.index)
                              , body = bareVar (orderName depth entry.index)
                              }
                            ]
                        }
                )
                (elementCompare last.index last.element)
                initial


{-| Compare two tuple expressions with the generated comparator, inline. -}
applyComparator : Array ElemShape -> Int -> Expr -> Expr -> Expr
applyComparator shape depth left right =
    ExprApplication [ comparatorFor shape depth, left, right ]


flippedComparator : Array ElemShape -> Expr
flippedComparator shape =
    ExprLambda
        { arguments = [ PatVar "d24FL", PatVar "d24FR" ]
        , expression =
            ExprApplication
                [ comparatorFor shape 0
                , bareVar "d24FR"
                , bareVar "d24FL"
                ]
        }


{-| `cmp a b == LT` (and friends) for the order binops. -}
orderTest : String -> Expr -> Expr
orderTest operator comparison =
    let
        equalTo ctor =
            ExprBinop { operator = "==", left = comparison, right = bareVar ctor }

        notEqualTo ctor =
            ExprBinop { operator = "/=", left = comparison, right = bareVar ctor }
    in
    when operator is
        "<" ->
            equalTo "LT"

        ">" ->
            equalTo "GT"

        "<=" ->
            notEqualTo "GT"

        _ ->
            -- ">=" — the only remaining orderBinop
            notEqualTo "LT"


orderBinop : String -> Maybe String
orderBinop operator =
    if operator == "<" || operator == ">" || operator == "<=" || operator == ">=" then
        Just operator

    else
        Nothing

-- SMALL HELPERS ---------------------------------------------------------------


isListFn : Ast.Types.NamedRef -> String -> Bool
isListFn ref name =
    ref.name == name && ref.moduleName == Just "List"


isBasicsFn : Ast.Types.NamedRef -> String -> Bool
isBasicsFn ref name =
    ref.name == name && (ref.moduleName == Nothing || ref.moduleName == Just "Basics")


firstShape : Array (Maybe (Array ElemShape)) -> Maybe (Array ElemShape)
firstShape candidates =
    Array.foldl
        (\candidate found ->
            when found is
                Just _ ->
                    found

                Nothing ->
                    candidate
        )
        Nothing
        candidates


orderName : Int -> Int -> String
orderName depth index =
    "d24O" ++ String.fromInt depth ++ "_" ++ String.fromInt index


fieldLabel : Int -> String
fieldLabel index =
    when index is
        0 ->
            "first"

        1 ->
            "second"

        2 ->
            "third"

        _ ->
            "field" ++ String.fromInt index


bareVar : String -> Expr
bareVar name =
    ExprVar { moduleName = Nothing, name = name }


listVar : String -> Expr
listVar name =
    ExprVar { moduleName = Just "List", name = name }
