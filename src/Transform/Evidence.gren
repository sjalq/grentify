module Transform.Evidence exposing
    ( DependencyEvidence
    , PackageEvidence
    , collect
    , collectConstructorArities
    , collectRecordAliases
    , collectSoleConstructors
    , mappedConstructorFields
    , mappedRecordAliases
    )

{-| Package-wide semantic evidence collection.

ASTs are decoded once, then kept in two explicitly named universes:
`resolvedFiles` retain Elm names for pre-substitution evidence, while
`namedFiles` use final mapped names for representation lowering.
-}

import Array exposing (Array)
import Ast.BareResolve as BareResolve
import Ast.CtorHome as CtorHome
import Ast.CtorLaw as CtorLaw
import Ast.Decode as AstDecode
import Ast.KeyEncode as KeyEncode
import Ast.MatchCompile as MatchCompile
import Ast.NameSub as NameSub
import Ast.RecordAlias as RecordAlias
import Ast.TupleCompare as TupleCompare
import Ast.Types exposing (Declaration(..), File, TypeAnn)
import Dict exposing (Dict)
import Mapping.Registry as Registry
import Mapping.Types exposing (Registry)
import Review.Protocol as Protocol
import Transform.AstPipeline as AstPipeline


type alias DependencyEvidence =
    { constructorArities : Dict String Int
    , soleConstructors : Dict String {}
    , recordAliases : Dict String (Array String)
    , reservedExports : Dict String String
    , -- D83: ctor→modules and surveyed modules for CtorHome across packages
      constructorHomes : CtorHome.Homes
    }


type alias PackageEvidence =
    { tupleReturns : TupleCompare.PackageReturns
    , constructorHomes : CtorHome.Homes
    , keyEvidence : KeyEncode.Evidence
    , recordAliases : Dict String (Array String)
    , constructorFields : Dict String (Array String)
    , constructorArities : Dict String Int
    , soleConstructors : Dict String {}
    , reservedExports : Dict String String
    , prepared : Dict String AstPipeline.Prepared
    , exports : DependencyEvidence
    }


collect :
    Registry
    -> DependencyEvidence
    -> Array Protocol.ModuleExtraction
    -> PackageEvidence
collect registry dependencies modules =
    let
        decodedFiles =
            decodeFiles modules

        resolvedFiles =
            Array.map BareResolve.apply decodedFiles

        namedFiles =
            Array.map (NameSub.apply registry) resolvedFiles

        ownRecordAliases =
            mergeFileMaps RecordAlias.collectFromFile namedFiles

        ownConstructorArities =
            mergeFileMaps CtorLaw.collectFromFile namedFiles

        constructorArities =
            Dict.foldl Dict.set dependencies.constructorArities
                ownConstructorArities

        -- Three layers, weakest first (D71 + D70d, landed independently).
        --
        -- Mapped platform packages (elm/parser → gren-lang/parser …) are never
        -- transpiled, so no port ever reads their alias declarations; the
        -- registry states those shapes and seeds the table underneath
        -- everything real, so evidence always beats the hint (D12).
        -- A record alias applied like a constructor is then lowered from the
        -- DEFINING module's field names, so transpiled dependency aliases must
        -- be in scope too or the application is left standing for `CtorLaw` to
        -- mis-recordify. Own modules win every clash.
        recordAliases =
            Dict.foldl Dict.set
                (Dict.foldl Dict.set
                    (mappedRecordAliases registry namedFiles constructorArities)
                    dependencies.recordAliases
                )
                ownRecordAliases

        -- Same story for the mapped packages' CONSTRUCTORS: the port emits no
        -- declaration for them, so their Gren payload field names are stated by
        -- the registry or known nowhere. Nothing this package declares can be
        -- overwritten — the filter already dropped every name it owns.
        constructorFields =
            mappedConstructorFields registry namedFiles constructorArities

        ownSoleConstructors =
            mergeFileMaps MatchCompile.collectSoleCtorsFromFile namedFiles

        soleConstructors =
            Dict.foldl Dict.set dependencies.soleConstructors
                ownSoleConstructors

        ownConstructorHomes =
            CtorHome.collectHomes resolvedFiles

        -- D83: CtorHome's evidence law needs both the declaring modules of
        -- every constructor AND the set of modules fully surveyed for ctors.
        -- Dependencies bank both; merge so a value ref wrongly homed to a
        -- dependency type-alias module (N.Down) can re-point to the sole
        -- importable declaring module (Linear.Down). Record type aliases
        -- (Graph.Node) also create value-level names and must block re-point
        -- — protect them from the merged recordAliases table.
        constructorHomes =
            CtorHome.merge dependencies.constructorHomes ownConstructorHomes
                |> CtorHome.protectRecordAliases recordAliases

        prepEvidence =
            { tupleReturns = collectTupleReturns resolvedFiles
            , constructorHomes = constructorHomes
            , keyEvidence = KeyEncode.collectEvidence resolvedFiles
            , recordAliases = recordAliases
            , constructorFields = constructorFields
            , constructorArities = constructorArities
            , soleConstructors = soleConstructors

            -- Not read by `prepare`; the table it would hold is what the
            -- prepared modules are about to produce.
            , reservedExports = Dict.empty
            }

        -- The lowering prefix runs ONCE per module here. The final pass
        -- resumes from these values instead of redoing all five passes.
        preparedFiles =
            Array.map (AstPipeline.prepare registry prepEvidence) decodedFiles

        prepared =
            Array.foldl
                (\one found ->
                    Dict.set (AstPipeline.moduleNameOf one) one found
                )
                Dict.empty
                preparedFiles

        ownReservedExports =
            Array.foldl
                (\one found ->
                    Dict.foldl Dict.set found (AstPipeline.reservedExportsOf one)
                )
                Dict.empty
                preparedFiles

        -- D70: `Ast.Reserved` reads a reference's escape from the DEFINING
        -- module's decision, never the caller's occupancy. A dependency's
        -- modules are just as defining as our own, so their decisions belong in
        -- the same map or every cross-package reference to an escaped name
        -- (`Elm.Annotation.alias` → `alias_`) is emitted unescaped.
        reservedExports =
            Dict.foldl Dict.set dependencies.reservedExports ownReservedExports
    in
    { tupleReturns = prepEvidence.tupleReturns
    , constructorHomes = prepEvidence.constructorHomes
    , keyEvidence = prepEvidence.keyEvidence
    , recordAliases = recordAliases
    , constructorFields = constructorFields
    , constructorArities = constructorArities
    , soleConstructors = soleConstructors
    , reservedExports = reservedExports
    , prepared = prepared
    , exports =
        { constructorArities = ownConstructorArities
        , soleConstructors = ownSoleConstructors
        , recordAliases = ownRecordAliases
        , reservedExports = ownReservedExports
        , constructorHomes = ownConstructorHomes
        }
    }


collectConstructorArities :
    Registry
    -> Array Protocol.ModuleExtraction
    -> Dict String Int
collectConstructorArities registry modules =
    modules
        |> decodeFiles
        |> Array.map (BareResolve.apply >> NameSub.apply registry)
        |> mergeFileMaps CtorLaw.collectFromFile


collectRecordAliases :
    Registry
    -> Array Protocol.ModuleExtraction
    -> Dict String (Array String)
collectRecordAliases registry modules =
    modules
        |> decodeFiles
        |> Array.map (BareResolve.apply >> NameSub.apply registry)
        |> mergeFileMaps RecordAlias.collectFromFile


collectSoleConstructors :
    Registry
    -> Array Protocol.ModuleExtraction
    -> Dict String {}
collectSoleConstructors registry modules =
    modules
        |> decodeFiles
        |> Array.map (BareResolve.apply >> NameSub.apply registry)
        |> mergeFileMaps MatchCompile.collectSoleCtorsFromFile


decodeFiles : Array Protocol.ModuleExtraction -> Array File
decodeFiles modules =
    Array.mapAndKeepJust
        (\moduleExtraction ->
            moduleExtraction.ast
                |> Maybe.andThen
                    (\astValue ->
                        when AstDecode.decode astValue is
                            Ok file ->
                                Just file

                            Err _ ->
                                Nothing
                    )
        )
        modules


collectTupleReturns : Array File -> TupleCompare.PackageReturns
collectTupleReturns files =
    { lists = collectReturnShapes TupleCompare.returnListShape files
    , tuples = collectReturnShapes TupleCompare.returnTupleShape files
    , aliases = collectTupleAliases files
    }


{-| D96: package type aliases by BARE name, for seeing a tuple through its
alias.

`logicUSLIB/logicus-pl` declares `type alias PSymb = ( String, List Int )`
and then types everything `PSymb`, so `List.sort` over a `List PSymb` had
no tuple in sight and was left to fail against Gren's `comparable`.

Only zero-argument aliases are indexed: a parameterised alias needs its
arguments substituted, which is a different job. Bare-name matching demands
the name mean one thing package-wide, so a duplicate poisons the entry
rather than picking a winner — the same discipline `Ast.KeyEncode.Evidence`
uses for its alias indexes.
-}
collectTupleAliases : Array File -> Dict String TypeAnn
collectTupleAliases files =
    Array.foldl
        (\file found ->
            Array.foldl
                (\declaration current ->
                    when declaration is
                        DeclAlias { name = name, generics = [], typeAnnotation = body } ->
                            Dict.update name
                                (\existing ->
                                    when existing is
                                        Nothing ->
                                            Just (Just body)

                                        Just _ ->
                                            -- duplicate bare name: poison
                                            Just Nothing
                                )
                                current

                        _ ->
                            current
                )
                found
                file.declarations
        )
        Dict.empty
        files
        |> Dict.foldl
            (\name entry acc ->
                when entry is
                    Just body ->
                        Dict.set name body acc

                    Nothing ->
                        acc
            )
            Dict.empty


collectReturnShapes :
    (TypeAnn -> Maybe (Array TupleCompare.ElemShape))
    -> Array File
    -> Dict String (Array TupleCompare.ElemShape)
collectReturnShapes shapeOf files =
    Array.foldl
        (\file found ->
            Array.foldl
                (\declaration current ->
                    when declaration is
                        DeclFunction { name = name, signature = Just signature } ->
                            when shapeOf signature.typeAnnotation is
                                Just shape ->
                                    Dict.set
                                        (file.moduleDefinition.moduleName
                                            ++ "."
                                            ++ name)
                                        shape current

                                Nothing ->
                                    current

                        _ ->
                            current
                )
                found
                file.declarations
        )
        Dict.empty
        files


{-| Registry-declared record-alias shapes for *mapped* modules, minus every
name the package graph can speak about itself.
-}
mappedRecordAliases : Registry -> Array File -> Dict String Int -> Dict String (Array String)
mappedRecordAliases registry namedFiles constructorArities =
    unclaimedMappedShapes (Registry.recordAliasShapes registry) namedFiles
        constructorArities


{-| Registry-declared constructor payload shapes for *mapped* modules, filtered
the same way. Same fact class, same disqualifiers, one filter.
-}
mappedConstructorFields : Registry -> Array File -> Dict String Int -> Dict String (Array String)
mappedConstructorFields registry namedFiles constructorArities =
    unclaimedMappedShapes (Registry.constructorFieldShapes registry) namedFiles
        constructorArities


{-| Drop every mapped shape the package graph can speak about itself.

Two things disqualify a hint, both of them positive evidence that the name in
question is not the mapped one:

  - the package declares a module of that (post-substitution) name, so
    `Some.Module.Name` refers to its own declaration, not the platform one;
  - the name is a known multi-argument constructor here or in a transpiled
    dependency, so this port emitted its type declaration and therefore owns
    its payload spelling (`CtorLaw` / positional labels).

Everything else falls through to real resolution exactly as before (D12).
-}
unclaimedMappedShapes :
    Dict String (Array String)
    -> Array File
    -> Dict String Int
    -> Dict String (Array String)
unclaimedMappedShapes shapes namedFiles constructorArities =
    let
        ownModules =
            Array.foldl
                (\file found ->
                    Dict.set file.moduleDefinition.moduleName {} found
                )
                Dict.empty
                namedFiles
    in
    shapes
        |> Dict.keepIf
            (\key _ ->
                not (Dict.member key constructorArities)
                    && not (Dict.member (moduleOfKey key) ownModules)
            )


{-| `"Parser.Advanced.DeadEnd"` → `"Parser.Advanced"`.
-}
moduleOfKey : String -> String
moduleOfKey key =
    String.split "." key
        |> Array.dropLast 1
        |> String.join "."


mergeFileMaps : (File -> Dict String a) -> Array File -> Dict String a
mergeFileMaps collectFromFile files =
    Array.foldl
        (\file found ->
            Dict.foldl Dict.set found (collectFromFile file)
        )
        Dict.empty
        files
