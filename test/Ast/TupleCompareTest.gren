module Ast.TupleCompareTest exposing (tests)

{-| D24: tuple-comparability typed rewrite.

Structural checks prove the pass rewrites exactly on positive evidence and
never without it; Eval checks prove the GENERATED comparators implement
Elm's lexicographic tuple ordering (the behavior D24 lost).
-}

import Array exposing ( Array )
import Ast.Eval as Eval exposing ( Outcome(..), Value(..) )
import Ast.TupleCompare as TupleCompare exposing ( ElemShape(..), noPackageReturns )
import Ast.Types exposing
    ( Declaration(..)
    , Expr(..)
    , File
    , ModuleKind(..)
    , Exposing(..)
    , Pattern(..)
    , TypeAnn(..)
    )
import Dict


type alias Check =
    { name : String
    , passed : Bool
    , details : String
    }


tests : Array Check
tests =
    [ rewritesAnnotatedSort
    , noRewriteWithoutEvidence
    , rewritesSortByProjection
    , rewritesOrderBinop
    , comparatorFirstElementDecides
    , comparatorTieBreaksOnSecond
    , comparatorEqualTuples
    , comparatorNestedTuple
    , rewritesPipedSortViaReturnShape
    , rewritesSortWithFlippedCompareOnCons
    , sortWithCustomComparatorUntouched
    , flippedComparatorOrdersLikeFlipCompare
    , rewritesCompareOnBareTupleReturn
    , rewritesSortByWhoseArmsAllYieldTuples
    , noRewriteWhenOneArmIsUnproven
    , rewritesUnsaturatedSortBy
    , rewritesPipedPartialSortBy
    ]


ok : String -> Check
ok name =
    { name = name, passed = True, details = "" }


fail : String -> String -> Check
fail name details =
    { name = name, passed = False, details = details }

-- FIXTURE BUILDERS ------------------------------------------------------------


fileWith : Maybe TypeAnn -> Array Pattern -> Expr -> File
fileWith annotation arguments body =
    { schemaVersion = 1
    , moduleDefinition =
        { kind = NormalModule
        , moduleName = "Fixture"
        , exposing_ = ExposeAll
        }
    , comments = []
    , imports = []
    , declarations =
        [ DeclFunction
            { name = "subject"
            , documentation = Nothing
            , signature =
                Maybe.map (\ann -> { name = "subject", typeAnnotation = ann }) annotation
            , arguments = arguments
            , expression = body
            }
        ]
    }


subjectBody : File -> Maybe Expr
subjectBody file =
    when Array.get 0 file.declarations is
        Just (DeclFunction fn) ->
            Just fn.expression

        _ ->
            Nothing


listOfTuple : TypeAnn
listOfTuple =
    TypeTyped
        { ref = { moduleName = Nothing, name = "List" }
        , arguments = [ TypeTuple [ intType, intType ] ]
        }


intType : TypeAnn
intType =
    TypeTyped { ref = { moduleName = Nothing, name = "Int" }, arguments = [] }


listSort : Expr -> Expr
listSort argument =
    ExprApplication
        [ ExprVar { moduleName = Just "List", name = "sort" }
        , argument
        ]


pairsVar : Expr
pairsVar =
    ExprVar { moduleName = Nothing, name = "pairs" }

-- STRUCTURAL ------------------------------------------------------------------


{-| `subject : List (Int, Int) -> x ; subject pairs = List.sort pairs`
must become `List.sortWith <comparator> pairs`.
-}
rewritesAnnotatedSort : Check
rewritesAnnotatedSort =
    let
        file =
            fileWith
                (Just (TypeFunction { left = listOfTuple, right = listOfTuple }))
                [ PatVar "pairs" ]
                (listSort pairsVar)
    in
    when subjectBody (TupleCompare.apply TupleCompare.noPackageReturns file) is
        Just (ExprApplication [ ExprVar { moduleName = Just "List", name = "sortWith" }, ExprLambda _, ExprVar { name = "pairs" } ]) ->
            ok "rewritesAnnotatedSort"

        other ->
            fail "rewritesAnnotatedSort" ("got: " ++ Debug.toString other)


{-| No annotation, no literal — `List.sort xs` must be left alone. -}
noRewriteWithoutEvidence : Check
noRewriteWithoutEvidence =
    let
        body =
            listSort (ExprVar { moduleName = Nothing, name = "xs" })

        file =
            fileWith Nothing [ PatVar "xs" ] body
    in
    when subjectBody (TupleCompare.apply TupleCompare.noPackageReturns file) is
        Just (ExprApplication [ ExprVar { name = "sort" }, ExprVar { name = "xs" } ]) ->
            ok "noRewriteWithoutEvidence"

        other ->
            fail "noRewriteWithoutEvidence" ("got: " ++ Debug.toString other)


{-| `List.sortBy (\r -> (r.a, r.b)) xs` becomes sortWith over the projection. -}
rewritesSortByProjection : Check
rewritesSortByProjection =
    let
        projection =
            ExprLambda
                { arguments = [ PatVar "r" ]
                , expression =
                    ExprTuple
                        [ ExprAccess { record = ExprVar { moduleName = Nothing, name = "r" }, field = "a" }
                        , ExprAccess { record = ExprVar { moduleName = Nothing, name = "r" }, field = "b" }
                        ]
                }

        file =
            fileWith Nothing
                [ PatVar "xs" ]
                (ExprApplication
                    [ ExprVar { moduleName = Just "List", name = "sortBy" }
                    , projection
                    , ExprVar { moduleName = Nothing, name = "xs" }
                    ]
                )
    in
    when subjectBody (TupleCompare.apply TupleCompare.noPackageReturns file) is
        Just (ExprApplication [ ExprVar { name = "sortWith" }, ExprLambda _, ExprVar { name = "xs" } ]) ->
            ok "rewritesSortByProjection"

        other ->
            fail "rewritesSortByProjection" ("got: " ++ Debug.toString other)


{-| `x < y` on annotated tuple args becomes `cmp x y == LT`. -}
rewritesOrderBinop : Check
rewritesOrderBinop =
    let
        tupleType =
            TypeTuple [ intType, intType ]

        boolType =
            TypeTyped { ref = { moduleName = Nothing, name = "Bool" }, arguments = [] }

        file =
            fileWith
                (Just
                    (TypeFunction
                        { left = tupleType
                        , right = TypeFunction { left = tupleType, right = boolType }
                        }
                    )
                )
                [ PatVar "x", PatVar "y" ]
                (ExprBinop
                    { operator = "<"
                    , left = ExprVar { moduleName = Nothing, name = "x" }
                    , right = ExprVar { moduleName = Nothing, name = "y" }
                    }
                )
    in
    when subjectBody (TupleCompare.apply TupleCompare.noPackageReturns file) is
        Just (ExprBinop { operator = "==", left = ExprApplication _, right = ExprVar { name = "LT" } }) ->
            ok "rewritesOrderBinop"

        other ->
            fail "rewritesOrderBinop" ("got: " ++ Debug.toString other)

{-| The frequencies class: `xs |> Module.freq |> List.sort` where tuple-ness
comes only from freq's RETURN type in the package index, through a pipe.
-}
rewritesPipedSortViaReturnShape : Check
rewritesPipedSortViaReturnShape =
    let
        index =
            { noPackageReturns
                | lists = Dict.set "Helpers.freq" [ Prim, Prim ] Dict.empty
            }

        body =
            ExprBinop
                { operator = "|>"
                , left =
                    ExprBinop
                        { operator = "|>"
                        , left = ExprVar { moduleName = Nothing, name = "xs" }
                        , right = ExprVar { moduleName = Just "Helpers", name = "freq" }
                        }
                , right = ExprVar { moduleName = Just "List", name = "sort" }
                }

        file =
            fileWith Nothing [ PatVar "xs" ] body
    in
    when subjectBody (TupleCompare.apply index file) is
        Just (ExprApplication [ ExprVar { name = "sortWith" }, ExprLambda _, ExprBinop _ ]) ->
            ok "rewritesPipedSortViaReturnShape"

        other ->
            fail "rewritesPipedSortViaReturnShape" ("got: " ++ Debug.toString other)


{-| D81 flate residual: `List.sortWith (\a b -> compare b a) (tuple :: rest)`
becomes sortWith with the generated flipped comparator (list shape from `::`).
-}
rewritesSortWithFlippedCompareOnCons : Check
rewritesSortWithFlippedCompareOnCons =
    let
        flippedCompare =
            ExprLambda
                { arguments = [ PatVar "a", PatVar "b" ]
                , expression =
                    ExprApplication
                        [ ExprVar { moduleName = Just "Basics", name = "compare" }
                        , ExprVar { moduleName = Nothing, name = "b" }
                        , ExprVar { moduleName = Nothing, name = "a" }
                        ]
                }

        consList =
            ExprBinop
                { operator = "::"
                , left = ExprTuple [ ExprInt 1, ExprInt 2 ]
                , right = ExprVar { moduleName = Nothing, name = "rest" }
                }

        file =
            fileWith Nothing
                [ PatVar "rest" ]
                (ExprApplication
                    [ ExprVar { moduleName = Just "List", name = "sortWith" }
                    , flippedCompare
                    , consList
                    ]
                )
    in
    when subjectBody (TupleCompare.apply TupleCompare.noPackageReturns file) is
        Just
            (ExprApplication
                [ ExprVar { name = "sortWith" }
                , ExprLambda { arguments = [ PatVar "d24FL", PatVar "d24FR" ], expression = _ }
                , _
                ]
            ) ->
            ok "rewritesSortWithFlippedCompareOnCons"

        other ->
            fail "rewritesSortWithFlippedCompareOnCons" ("got: " ++ Debug.toString other)


{-| A custom comparator is never rewritten even when the list is proven. -}
sortWithCustomComparatorUntouched : Check
sortWithCustomComparatorUntouched =
    let
        custom =
            ExprLambda
                { arguments = [ PatVar "a", PatVar "b" ]
                , expression =
                    ExprApplication
                        [ ExprVar { moduleName = Just "Basics", name = "compare" }
                        , ExprAccess
                            { record = ExprVar { moduleName = Nothing, name = "a" }
                            , field = "first"
                            }
                        , ExprAccess
                            { record = ExprVar { moduleName = Nothing, name = "b" }
                            , field = "first"
                            }
                        ]
                }

        consList =
            ExprBinop
                { operator = "::"
                , left = ExprTuple [ ExprInt 1, ExprInt 2 ]
                , right = ExprVar { moduleName = Nothing, name = "rest" }
                }

        file =
            fileWith Nothing
                [ PatVar "rest" ]
                (ExprApplication
                    [ ExprVar { moduleName = Just "List", name = "sortWith" }
                    , custom
                    , consList
                    ]
                )
    in
    when subjectBody (TupleCompare.apply TupleCompare.noPackageReturns file) is
        Just (ExprApplication [ _, ExprLambda { expression = ExprApplication [ _, ExprAccess _, _ ] }, _ ]) ->
            ok "sortWithCustomComparatorUntouched"

        other ->
            fail "sortWithCustomComparatorUntouched" ("got: " ++ Debug.toString other)


-- BEHAVIOR (Eval oracle on generated comparators) -----------------------------


tuple2 : Int -> Int -> Expr
tuple2 a b =
    ExprTuple [ ExprInt a, ExprInt b ]


{-| PROPERTY (D81): the flipped comparator is Elm's `compare b a` on pairs —
first element of the larger first-component wins when flipped. -}
flippedComparatorOrdersLikeFlipCompare : Check
flippedComparatorOrdersLikeFlipCompare =
    let
        -- (2,0) vs (1,9): unflipped is GT; flipped is LT
        expr =
            ExprApplication
                [ TupleCompare.flippedComparator pairShape
                , tuple2 2 0
                , tuple2 1 9
                ]
    in
    evalToOrder "flippedComparatorOrdersLikeFlipCompare" expr "LT"


evalToOrder : String -> Expr -> String -> Check
evalToOrder name expr expected =
    when Eval.run Eval.emptyContext 10000 expr is
        Done (VCtor { name = got }) ->
            if got == expected then
                ok name

            else
                fail name ("got " ++ got ++ ", want " ++ expected)

        Done _ ->
            fail name "non-ctor result"

        Crashed message ->
            fail name ("crashed: " ++ message)

        Stuck reason ->
            fail name ("stuck: " ++ reason)


pairShape : Array ElemShape
pairShape =
    [ Prim, Prim ]


compareWith : Array ElemShape -> Expr -> Expr -> Expr
compareWith shape left right =
    ExprApplication [ TupleCompare.comparatorFor shape 0, left, right ]


comparatorFirstElementDecides : Check
comparatorFirstElementDecides =
    evalToOrder "comparatorFirstElementDecides"
        (compareWith pairShape (tuple2 2 0) (tuple2 1 9))
        "GT"


comparatorTieBreaksOnSecond : Check
comparatorTieBreaksOnSecond =
    evalToOrder "comparatorTieBreaksOnSecond"
        (compareWith pairShape (tuple2 1 2) (tuple2 1 3))
        "LT"


comparatorEqualTuples : Check
comparatorEqualTuples =
    evalToOrder "comparatorEqualTuples"
        (compareWith pairShape (tuple2 4 4) (tuple2 4 4))
        "EQ"


{-| (1, (2, "a")) vs (1, (2, "b")) — recursion into the nested comparator. -}
comparatorNestedTuple : Check
comparatorNestedTuple =
    let
        nestedShape =
            [ Prim, Nested [ Prim, Prim ] ]

        value inner =
            ExprTuple
                [ ExprInt 1
                , ExprTuple [ ExprInt 2, ExprString inner ]
                ]
    in
    evalToOrder "comparatorNestedTuple"
        (compareWith nestedShape (value "a") (value "b"))
        "LT"


-- D87 -------------------------------------------------------------------------


{-| `compare (toTuple a) (toTuple b)` where the only evidence is that the
package function `toTuple` is annotated to return a bare tuple.
-}
rewritesCompareOnBareTupleReturn : Check
rewritesCompareOnBareTupleReturn =
    let
        index =
            { noPackageReturns
                | tuples = Dict.set "Time.Date.toTuple" [ Prim, Prim, Prim ] Dict.empty
            }

        call name =
            ExprApplication
                [ ExprVar { moduleName = Just "Time.Date", name = "toTuple" }
                , ExprVar { moduleName = Nothing, name = name }
                ]

        file =
            fileWith Nothing
                [ PatVar "d1", PatVar "d2" ]
                (ExprApplication
                    [ ExprVar { moduleName = Just "Basics", name = "compare" }
                    , call "d1"
                    , call "d2"
                    ]
                )
    in
    when subjectBody (TupleCompare.apply index file) is
        Just (ExprApplication [ ExprLambda _, ExprApplication _, ExprApplication _ ]) ->
            ok "rewritesCompareOnBareTupleReturn"

        other ->
            fail "rewritesCompareOnBareTupleReturn" ("got: " ++ Debug.toString other)


caseProjection : Array Expr -> Expr
caseProjection arms =
    ExprLambda
        { arguments = [ PatVar "err" ]
        , expression =
            ExprCase
                { expression = ExprVar { moduleName = Nothing, name = "err" }
                , cases =
                    Array.indexedMap
                        (\index body -> { pattern = PatVar ("a" ++ String.fromInt index), body = body })
                        arms
                }
        }


{-| elm-csv: a sortBy key whose every `when` arm is a tuple of one shape. -}
rewritesSortByWhoseArmsAllYieldTuples : Check
rewritesSortByWhoseArmsAllYieldTuples =
    let
        file =
            fileWith Nothing
                [ PatVar "xs" ]
                (ExprApplication
                    [ ExprVar { moduleName = Just "List", name = "sortBy" }
                    , caseProjection
                        [ ExprTuple [ ExprInt 1, ExprString "" ]
                        , ExprTuple [ ExprInt 2, ExprString "b" ]
                        ]
                    , ExprVar { moduleName = Nothing, name = "xs" }
                    ]
                )
    in
    when subjectBody (TupleCompare.apply noPackageReturns file) is
        Just (ExprApplication [ ExprVar { name = "sortWith" }, ExprLambda _, ExprVar { name = "xs" } ]) ->
            ok "rewritesSortByWhoseArmsAllYieldTuples"

        other ->
            fail "rewritesSortByWhoseArmsAllYieldTuples" ("got: " ++ Debug.toString other)


{-| One arm with no tuple evidence refuses the whole projection. -}
noRewriteWhenOneArmIsUnproven : Check
noRewriteWhenOneArmIsUnproven =
    let
        file =
            fileWith Nothing
                [ PatVar "xs" ]
                (ExprApplication
                    [ ExprVar { moduleName = Just "List", name = "sortBy" }
                    , caseProjection
                        [ ExprTuple [ ExprInt 1, ExprString "" ]
                        , ExprVar { moduleName = Nothing, name = "unknown" }
                        ]
                    , ExprVar { moduleName = Nothing, name = "xs" }
                    ]
                )
    in
    when subjectBody (TupleCompare.apply noPackageReturns file) is
        Just (ExprApplication [ ExprVar { name = "sortBy" }, ExprLambda _, ExprVar { name = "xs" } ]) ->
            ok "noRewriteWhenOneArmIsUnproven"

        other ->
            fail "noRewriteWhenOneArmIsUnproven" ("got: " ++ Debug.toString other)


tupleKeyLambda : Expr
tupleKeyLambda =
    ExprLambda
        { arguments = [ PatVar "r" ]
        , expression =
            ExprTuple
                [ ExprAccess { record = ExprVar { moduleName = Nothing, name = "r" }, field = "a" }
                , ExprAccess { record = ExprVar { moduleName = Nothing, name = "r" }, field = "b" }
                ]
        }


{-| `List.sortBy f` with no list applied (elm-csv composes it with `>>`). -}
rewritesUnsaturatedSortBy : Check
rewritesUnsaturatedSortBy =
    let
        file =
            fileWith Nothing
                []
                (ExprApplication
                    [ ExprVar { moduleName = Just "List", name = "sortBy" }
                    , tupleKeyLambda
                    ]
                )
    in
    when subjectBody (TupleCompare.apply noPackageReturns file) is
        Just (ExprApplication [ ExprVar { name = "sortWith" }, ExprLambda _ ]) ->
            ok "rewritesUnsaturatedSortBy"

        other ->
            fail "rewritesUnsaturatedSortBy" ("got: " ++ Debug.toString other)


{-| `xs |> List.sortBy f` — the piped partial application. -}
rewritesPipedPartialSortBy : Check
rewritesPipedPartialSortBy =
    let
        file =
            fileWith Nothing
                [ PatVar "xs" ]
                (ExprBinop
                    { operator = "|>"
                    , left = ExprVar { moduleName = Nothing, name = "xs" }
                    , right =
                        ExprApplication
                            [ ExprVar { moduleName = Just "List", name = "sortBy" }
                            , tupleKeyLambda
                            ]
                    }
                )
    in
    when subjectBody (TupleCompare.apply noPackageReturns file) is
        Just (ExprApplication [ ExprVar { name = "sortWith" }, ExprLambda _, ExprVar { name = "xs" } ]) ->
            ok "rewritesPipedPartialSortBy"

        other ->
            fail "rewritesPipedPartialSortBy" ("got: " ++ Debug.toString other)
