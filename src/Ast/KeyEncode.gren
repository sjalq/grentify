module Ast.KeyEncode exposing
    ( Evidence
    , apply
    , collectEvidence
    , emptyEvidence
    )

{-| D24b/D65/D81: Elm tuples are `comparable` so they serve as Dict keys /
Set members; the port lowers tuples to records and Gren records are not
comparable, so every tuple-keyed Dict/Set type-errors after the port.

This pass rewrites PROVEN tuple keys to the comparable array
representation defined by `Ast.KeyEncode.Codec` (read its law first), and
DECODES them back wherever the source reads a key out again. It runs
right after TupleCompare (pre-NameSub: Elm names, tuples intact). The
evidence it acts on is collected once per package by
`Ast.KeyEncode.Evidence`.

Evidence law — rewrite ONLY on positive evidence, never on a guess:

R1 (alias law): a `type alias K = ( enc, enc )` where EVERY occurrence of
K in the package is either a Dict/Set KEY position or the RETURN position
of a function whose tail expressions are all tuple literals. Then the
alias body becomes the key type and each constructing tail is encoded.
Every Dict/Set over K follows through the alias with zero call-site
rewrites (jfmengels/elm-review's RangeLike).

R2 (inline law): `Dict ( enc, enc ) v` / `Set ( enc, enc )` written
inline in a signature or record-alias field becomes a key-typed
container, and key arguments at call sites whose container argument is
PROVEN (a signature-typed variable, a proven record field access, or a
call to a package function whose signature returns such a container) are
encoded (elm-review's `suppressions` field).

R2b / R3 seed (D81 alias-key law): `Dict Alias v` / `Set Alias` where
Alias is a PACKAGE type alias of an encodable tuple is treated exactly
like the inline form, WITHOUT rewriting the alias itself. Specimens
like goyalarchit/elm-dagre's `type alias Edge = ( NodeId, NodeId )` have
non-key uses (`List Edge`, function arguments), so R1 refuses them; the
Dict/Set KEY SLOT still rewrites, and R3 seeds from the signature. The
alias body stays a tuple so non-key uses keep working. Opaque named
leaves (`NodeId`) are identity-encoded into `Array NodeId` (Codec
`KOpaque`) — Gren expands the alias and the array is comparable.

R3 (declaration law, D65): R1 and R2 can only serve keys that are never
read back, and they cannot see a container that never appears in an
annotation. R3 closes both gaps at the granularity of ONE TOP-LEVEL
DECLARATION, all-or-nothing:

  * SEED. The declaration's Dict world (resp. Set world) has key shape S
    when S is witnessed by: an inline OR alias-keyed `Dict … v` / `Set …`
    anywhere in its signature; a proven container expression in its body;
    or a KEY-position argument that is an application of a package
    function whose signature returns `( enc, … )`. Elm's own typing makes
    that last one conclusive — `Set.insert : comparable -> Set comparable
    -> Set comparable`, so a tuple key means a tuple-keyed set. Witnesses
    that disagree on S cancel: no seed, no rewrite.
  * TOTALITY. Every `Set.`/`Dict.` reference in the declaration must be a
    saturated call this pass knows how to carry (`operationFor`), or the
    kind is dropped whole. A key may never leave the declaration
    unencoded or arrive undecoded, so partial coverage is refused rather
    than half-applied.
  * REWRITE. All key arguments encode, all key results decode, all
    key-taking callbacks are wrapped. The declaration is rewritten
    consistently or not at all.

R3 cannot regress a package that ports today: a seed requires either a
tuple key in a comparable position (which Gren rejects today) or an
inline/alias tuple-keyed annotation (which R2/R2b already rewrote today).
Where the seed is wrong the shapes cannot unify and the site fails at
gren-verify — encoded arrays and lowered tuple records never unify, so a
mis-seeded site is always loud, never silently wrong.

Encodable element types: Int, Float, Char, String, nested tuples thereof,
and homogeneous opaque named leaves (type aliases of comparable prims) —
concrete names required (type variables / records / mixed opaque-prim
tuples are never encodable; those sites stay untouched and fail
gren-verify exactly as before this pass).
-}

import Array exposing ( Array )
import Ast.KeyEncode.Codec as Codec exposing ( KeyShape(..) )
import Ast.KeyEncode.Evidence as Evidence exposing ( Kind(..), Slot )
import Ast.Types exposing
    ( Declaration(..)
    , Expr(..)
    , File
    , NamedRef
    , Pattern(..)
    , Signature
    , TypeAnn(..)
    )
import Ast.Walk as Walk
import Dict exposing ( Dict )


type alias Evidence =
    Evidence.Evidence


collectEvidence : Array File -> Evidence
collectEvidence =
    Evidence.collect


emptyEvidence : Evidence
emptyEvidence =
    Evidence.empty


-- APPLY -----------------------------------------------------------------------


apply : Evidence -> File -> File
apply evidence file =
    { file
        | declarations =
            Array.map (applyDeclaration evidence file.moduleDefinition.moduleName)
                file.declarations
    }


applyDeclaration : Evidence -> String -> Declaration -> Declaration
applyDeclaration evidence moduleName declaration =
    when declaration is
        DeclAlias alias ->
            DeclAlias
                { alias
                    | typeAnnotation =
                        rewriteAliasBody evidence moduleName alias
                }

        DeclFunction fn ->
            let
                rewrittenSignature =
                    Maybe.map
                        (\sig ->
                            { sig
                                | typeAnnotation =
                                    rewriteAnn evidence sig.typeAnnotation
                            }
                        )
                        fn.signature

                signatureSeeds =
                    when fn.signature is
                        Just sig ->
                            annotationSeeds evidence sig.typeAnnotation noSeeds

                        Nothing ->
                            noSeeds
            in
            -- Every witness this pass can find comes either from the package
            -- indexes or from an inline/alias container in THIS signature.
            -- With neither, no rule can fire, so the body is not walked at all.
            if Evidence.isEmpty evidence && signatureSeeds == noSeeds then
                DeclFunction { fn | signature = rewrittenSignature }

            else
                let
                    returnShapes =
                        fn.signature
                            |> Maybe.andThen
                                (\sig -> Evidence.returnedAliasName evidence.aliases sig.typeAnnotation)
                            |> Maybe.andThen
                                (\name -> Dict.get name evidence.aliases)
                            |> Maybe.map .shapes

                    withTails =
                        when returnShapes is
                            Just shapes ->
                                rewriteTails (Codec.encodeKey 0 shapes) fn.expression

                            Nothing ->
                                fn.expression

                    env =
                        envFromSignature evidence fn.signature fn.arguments

                    foreign =
                        when fn.signature is
                            Just sig ->
                                foreignKinds evidence sig.typeAnnotation noForeign

                            Nothing ->
                                noForeign

                    scope =
                        declarationScope env signatureSeeds foreign withTails
                in
                DeclFunction
                    { fn
                        | signature = rewrittenSignature
                        , expression = rewriteExpr { env = env, scope = scope } 0 withTails
                    }

        DeclCustomType custom ->
            DeclCustomType
                { custom
                    | constructors =
                        Array.map
                            (\ctor ->
                                { ctor
                                    | arguments =
                                        Array.map (rewriteAnn evidence) ctor.arguments
                                }
                            )
                            custom.constructors
                }

        _ ->
            declaration


{-| R1: the eligible alias's own body (in its home module) becomes the
key type.
-}
rewriteAliasBody :
    Evidence
    -> String
    -> { name : String
       , documentation : Maybe String
       , generics : Array String
       , typeAnnotation : TypeAnn
       }
    -> TypeAnn
rewriteAliasBody evidence moduleName alias =
    when Dict.get alias.name evidence.aliases is
        Just info ->
            if info.homeModule == moduleName then
                Codec.keyAnn info.shapes

            else
                rewriteAnn evidence alias.typeAnnotation

        Nothing ->
            rewriteAnn evidence alias.typeAnnotation


{-| R2 / R2b: inline OR package-alias tuple keys of Dict/Set become the
key type, everywhere in the annotation tree.
-}
rewriteAnn : Evidence -> TypeAnn -> TypeAnn
rewriteAnn evidence annotation =
    when annotation is
        TypeTyped { ref = ref, arguments = arguments } ->
            let
                rewritten =
                    Array.map (rewriteAnn evidence) arguments

                keyed =
                    when
                        Evidence.resolvedKeySlot evidence.tupleAliases
                            evidence.aliases
                            annotation
                    is
                        Just slot ->
                            Array.indexedMap
                                (\index argument ->
                                    if index == 0 then
                                        Codec.keyAnn slot.shapes

                                    else
                                        argument
                                )
                                rewritten

                        Nothing ->
                            rewritten
            in
            TypeTyped { ref = ref, arguments = keyed }

        TypeTuple elements ->
            TypeTuple (Array.map (rewriteAnn evidence) elements)

        TypeRecord fields ->
            TypeRecord
                (Array.map
                    (\field ->
                        { field
                            | typeAnnotation = rewriteAnn evidence field.typeAnnotation
                        }
                    )
                    fields
                )

        TypeGenericRecord generic ->
            TypeGenericRecord
                { generic
                    | fields =
                        Array.map
                            (\field ->
                                { field
                                    | typeAnnotation =
                                        rewriteAnn evidence field.typeAnnotation
                                }
                            )
                            generic.fields
                }

        TypeFunction { left = left, right = right } ->
            TypeFunction
                { left = rewriteAnn evidence left
                , right = rewriteAnn evidence right
                }

        _ ->
            annotation


{-| Rewrite the tail positions of a body (through let / if / case). -}
rewriteTails : (Expr -> Expr) -> Expr -> Expr
rewriteTails f expr =
    when expr is
        ExprLet inner ->
            ExprLet { inner | expression = rewriteTails f inner.expression }

        ExprIf { condition = condition, then_ = then_, else_ = else_ } ->
            ExprIf
                { condition = condition
                , then_ = rewriteTails f then_
                , else_ = rewriteTails f else_
                }

        ExprCase { expression = scrutinee, cases = arms } ->
            ExprCase
                { expression = scrutinee
                , cases =
                    Array.map
                        (\arm -> { arm | body = rewriteTails f arm.body })
                        arms
                }

        _ ->
            f expr



-- CALL NORMALIZATION ----------------------------------------------------------


{-| A saturated call in head-first form. `x |> f a` and `f a <| x` are the
same call as `f a x`; every scan and every rewrite reads calls through
this one lens so the two forms can never disagree.
-}
type alias Call =
    { ref : NamedRef
    , parts : Array Expr
    }


normalizeCall : Expr -> Maybe Call
normalizeCall expr =
    when expr is
        ExprApplication parts ->
            headedCall parts

        ExprBinop { operator = "|>", left = left, right = right } ->
            appliedTo right left

        ExprBinop { operator = "<|", left = left, right = right } ->
            appliedTo left right

        _ ->
            Nothing


appliedTo : Expr -> Expr -> Maybe Call
appliedTo fnExpr argument =
    when fnExpr is
        ExprApplication parts ->
            headedCall (Array.pushLast argument parts)

        ExprVar ref ->
            Just { ref = ref, parts = [ ExprVar ref, argument ] }

        _ ->
            Nothing


headedCall : Array Expr -> Maybe Call
headedCall parts =
    when Array.first parts is
        Just (ExprVar ref) ->
            Just { ref = ref, parts = parts }

        _ ->
            Nothing


argCount : Call -> Int
argCount call =
    Array.length call.parts - 1



-- OPERATION TABLE -------------------------------------------------------------


{-| What a keyed-container call does with keys. `operationFor` returning
`Nothing` is the totality refusal: the pass cannot carry that call, so
the declaration's whole kind is left alone.
-}
type Operation
    = OpNeutral
    | OpEncodeKey Int
    | OpEncodeElements { index : Int, paired : Bool }
    | OpDecodeResult { paired : Bool }
    | OpDecodeCallback { index : Int, arity : Int }


operationFor : Kind -> String -> Int -> Maybe Operation
operationFor kind name args =
    when kind is
        SetKind ->
            setOperation name args

        DictKind ->
            dictOperation name args


setOperation : String -> Int -> Maybe Operation
setOperation name args =
    when { name = name, args = args } is
        { name = "empty", args = 0 } ->
            Just OpNeutral

        { name = "isEmpty", args = 1 } ->
            Just OpNeutral

        { name = "size", args = 1 } ->
            Just OpNeutral

        { name = "union", args = 2 } ->
            Just OpNeutral

        { name = "intersect", args = 2 } ->
            Just OpNeutral

        { name = "diff", args = 2 } ->
            Just OpNeutral

        { name = "singleton", args = 1 } ->
            Just (OpEncodeKey 1)

        { name = "insert", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "remove", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "member", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "toList", args = 1 } ->
            Just (OpDecodeResult { paired = False })

        { name = "fromList", args = 1 } ->
            Just (OpEncodeElements { index = 1, paired = False })

        { name = "foldl", args = 3 } ->
            Just (OpDecodeCallback { index = 1, arity = 2 })

        { name = "foldr", args = 3 } ->
            Just (OpDecodeCallback { index = 1, arity = 2 })

        { name = "filter", args = 2 } ->
            Just (OpDecodeCallback { index = 1, arity = 1 })

        _ ->
            Nothing


dictOperation : String -> Int -> Maybe Operation
dictOperation name args =
    when { name = name, args = args } is
        { name = "empty", args = 0 } ->
            Just OpNeutral

        { name = "isEmpty", args = 1 } ->
            Just OpNeutral

        { name = "size", args = 1 } ->
            Just OpNeutral

        { name = "values", args = 1 } ->
            Just OpNeutral

        { name = "union", args = 2 } ->
            Just OpNeutral

        { name = "intersect", args = 2 } ->
            Just OpNeutral

        { name = "diff", args = 2 } ->
            Just OpNeutral

        { name = "singleton", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "insert", args = 3 } ->
            Just (OpEncodeKey 1)

        { name = "update", args = 3 } ->
            Just (OpEncodeKey 1)

        { name = "get", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "member", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "remove", args = 2 } ->
            Just (OpEncodeKey 1)

        { name = "keys", args = 1 } ->
            Just (OpDecodeResult { paired = False })

        { name = "toList", args = 1 } ->
            Just (OpDecodeResult { paired = True })

        { name = "fromList", args = 1 } ->
            Just (OpEncodeElements { index = 1, paired = True })

        { name = "foldl", args = 3 } ->
            Just (OpDecodeCallback { index = 1, arity = 3 })

        { name = "foldr", args = 3 } ->
            Just (OpDecodeCallback { index = 1, arity = 3 })

        { name = "map", args = 2 } ->
            Just (OpDecodeCallback { index = 1, arity = 2 })

        { name = "filter", args = 2 } ->
            Just (OpDecodeCallback { index = 1, arity = 2 })

        _ ->
            Nothing



-- DECLARATION SCOPE (R3) ------------------------------------------------------


type alias Env =
    { -- signature-typed variables holding a keyed container
      containerVars : Dict String Slot
    , keyFields : Dict String Slot
    , containerReturns : Dict String Slot
    , tupleReturns : Dict String (Array KeyShape)
    }


type alias Scope =
    { set : Maybe (Array KeyShape)
    , dict : Maybe (Array KeyShape)
    , -- D81: when the declaration also types a Dict/Set whose key is NOT
      -- an encodable tuple (e.g. `Dict NodeId v` next to `Dict Edge v`),
      -- R3 must not rewrite every Dict/Set call — only those whose
      -- container is proven at the seeded shape. Full-declaration rewrite
      -- would encode NodeId keys as Edge arrays (Render.edgeDrawing).
      setProvenOnly : Bool
    , dictProvenOnly : Bool
    }


type Seed
    = SeedNone
    | SeedShape (Array KeyShape)
    | SeedConflict


addSeed : Array KeyShape -> Seed -> Seed
addSeed shapes seed =
    when seed is
        SeedNone ->
            SeedShape shapes

        SeedShape previous ->
            if previous == shapes then
                seed

            else
                SeedConflict

        SeedConflict ->
            SeedConflict


envFromSignature : Evidence -> Maybe Signature -> Array Pattern -> Env
envFromSignature evidence signature arguments =
    let
        empty =
            { containerVars = Dict.empty
            , keyFields = evidence.keyFields
            , containerReturns = evidence.containerReturns
            , tupleReturns = evidence.tupleReturns
            }
    in
    when signature is
        Nothing ->
            empty

        Just sig ->
            Array.foldl
                (\argument state ->
                    when state.spine is
                        TypeFunction { left = left, right = right } ->
                            { spine = right
                            , env =
                                bindContainerPattern evidence argument left state.env
                            }

                        _ ->
                            state
                )
                { spine = sig.typeAnnotation, env = empty }
                arguments
                |> .env


bindContainerPattern : Evidence -> Pattern -> TypeAnn -> Env -> Env
bindContainerPattern evidence pattern annotation env =
    when pattern is
        PatVar name ->
            when
                Evidence.resolvedKeySlot evidence.tupleAliases
                    evidence.aliases
                    annotation
            is
                Just slot ->
                    { env | containerVars = Dict.set name slot env.containerVars }

                Nothing ->
                    env

        _ ->
            env


type alias Foreign =
    { set : Bool, dict : Bool }


noForeign : Foreign
noForeign =
    { set = False, dict = False }


{-| A Dict/Set annotation whose key is not an encodable tuple: coexists
with a tuple-keyed container and forces proven-only rewrite for that kind.
-}
foreignKinds : Evidence -> TypeAnn -> Foreign -> Foreign
foreignKinds evidence annotation acc =
    let
        self =
            when isKeyedContainerAnn annotation is
                Just kind ->
                    when
                        Evidence.resolvedKeySlot evidence.tupleAliases
                            evidence.aliases
                            annotation
                    is
                        Just _ ->
                            acc

                        Nothing ->
                            markForeign kind acc

                Nothing ->
                    acc
    in
    when annotation is
        TypeTyped { arguments = arguments } ->
            Array.foldl (foreignKinds evidence) self arguments

        TypeTuple elements ->
            Array.foldl (foreignKinds evidence) self elements

        TypeRecord fields ->
            Array.foldl
                (\field inner -> foreignKinds evidence field.typeAnnotation inner)
                self
                fields

        TypeGenericRecord { fields = fields } ->
            Array.foldl
                (\field inner -> foreignKinds evidence field.typeAnnotation inner)
                self
                fields

        TypeFunction { left = left, right = right } ->
            foreignKinds evidence right (foreignKinds evidence left self)

        _ ->
            self


isKeyedContainerAnn : TypeAnn -> Maybe Kind
isKeyedContainerAnn annotation =
    when annotation is
        TypeTyped { ref = ref, arguments = arguments } ->
            if
                ref.name
                    == "Dict"
                    && (ref.moduleName == Nothing || ref.moduleName == Just "Dict")
                    && Array.length arguments
                    == 2
            then
                Just DictKind

            else if
                ref.name
                    == "Set"
                    && (ref.moduleName == Nothing || ref.moduleName == Just "Set")
                    && Array.length arguments
                    == 1
            then
                Just SetKind

            else
                Nothing

        _ ->
            Nothing


markForeign : Kind -> Foreign -> Foreign
markForeign kind foreign =
    when kind is
        SetKind ->
            { foreign | set = True }

        DictKind ->
            { foreign | dict = True }


{-| R3: seed the declaration's Set and Dict worlds, then refuse any kind
whose calls are not all carriable. A foreign (non-tuple-keyed) container
in the signature forces proven-only rewrite for that kind (D81).
-}
declarationScope : Env -> Seeds -> Foreign -> Expr -> Scope
declarationScope env fromSignature foreign body =
    let
        seeds =
            bodySeeds env body fromSignature

        total =
            coverage env body { set = True, dict = True }

        settle seed covered =
            when seed is
                SeedShape shapes ->
                    if covered then
                        Just shapes

                    else
                        Nothing

                _ ->
                    Nothing
    in
    { set = settle seeds.set total.set
    , dict = settle seeds.dict total.dict
    , setProvenOnly = foreign.set
    , dictProvenOnly = foreign.dict
    }


type alias Seeds =
    { set : Seed, dict : Seed }


noSeeds : Seeds
noSeeds =
    { set = SeedNone, dict = SeedNone }


addKindSeed : Slot -> Seeds -> Seeds
addKindSeed slot seeds =
    when slot.kind is
        SetKind ->
            { seeds | set = addSeed slot.shapes seeds.set }

        DictKind ->
            { seeds | dict = addSeed slot.shapes seeds.dict }


annotationSeeds : Evidence -> TypeAnn -> Seeds -> Seeds
annotationSeeds evidence annotation seeds =
    let
        self =
            when
                Evidence.resolvedKeySlot evidence.tupleAliases
                    evidence.aliases
                    annotation
            is
                Just slot ->
                    addKindSeed slot seeds

                Nothing ->
                    seeds
    in
    when annotation is
        TypeTyped { arguments = arguments } ->
            Array.foldl (annotationSeeds evidence) self arguments

        TypeTuple elements ->
            Array.foldl (annotationSeeds evidence) self elements

        TypeRecord fields ->
            Array.foldl
                (\field acc -> annotationSeeds evidence field.typeAnnotation acc)
                self
                fields

        TypeGenericRecord { fields = fields } ->
            Array.foldl
                (\field acc -> annotationSeeds evidence field.typeAnnotation acc)
                self
                fields

        TypeFunction { left = left, right = right } ->
            annotationSeeds evidence right (annotationSeeds evidence left self)

        _ ->
            self


bodySeeds : Env -> Expr -> Seeds -> Seeds
bodySeeds env expr seeds =
    let
        fromContainer =
            when provenContainer env expr is
                Just slot ->
                    addKindSeed slot seeds

                Nothing ->
                    seeds

        fromKey =
            when normalizeCall expr is
                Just call ->
                    when Evidence.kindOfRef call.ref is
                        Just kind ->
                            when operationFor kind call.ref.name (argCount call) is
                                Just (OpEncodeKey index) ->
                                    when
                                        Array.get index call.parts
                                            |> Maybe.andThen (provenKeyShapes env)
                                    is
                                        Just shapes ->
                                            addKindSeed
                                                { kind = kind, shapes = shapes }
                                                fromContainer

                                        Nothing ->
                                            fromContainer

                                _ ->
                                    fromContainer

                        Nothing ->
                            fromContainer

                Nothing ->
                    fromContainer
    in
    Walk.foldExprChildren (bodySeeds env) fromKey expr


{-| Positive evidence that an expression IS a keyed container. -}
provenContainer : Env -> Expr -> Maybe Slot
provenContainer env expr =
    when expr is
        ExprVar { moduleName = Nothing, name = name } ->
            when Dict.get name env.containerVars is
                Just slot ->
                    Just slot

                Nothing ->
                    Dict.get name env.containerReturns

        ExprAccess { field = field } ->
            Dict.get field env.keyFields

        ExprApplication parts ->
            when Array.first parts is
                Just (ExprVar ref) ->
                    Dict.get ref.name env.containerReturns

                _ ->
                    Nothing

        _ ->
            Nothing


{-| Positive evidence that an expression IS a concrete encodable tuple:
a call to a package function whose signature says so.
-}
provenKeyShapes : Env -> Expr -> Maybe (Array KeyShape)
provenKeyShapes env expr =
    when expr is
        ExprApplication parts ->
            when Array.first parts is
                Just (ExprVar ref) ->
                    Dict.get ref.name env.tupleReturns

                _ ->
                    Nothing

        ExprVar ref ->
            Dict.get ref.name env.tupleReturns

        _ ->
            Nothing


{-| Totality: every `Set.`/`Dict.` reference in the body must be a
saturated call the table knows. A reference the pass cannot carry drops
its whole kind — a key must never escape half-rewritten.
-}
coverage : Env -> Expr -> { set : Bool, dict : Bool } -> { set : Bool, dict : Bool }
coverage env expr covered =
    when normalizeCall expr is
        Just call ->
            when Evidence.kindOfRef call.ref is
                Just kind ->
                    let
                        next =
                            when operationFor kind call.ref.name (argCount call) is
                                Just _ ->
                                    covered

                                Nothing ->
                                    drop kind covered
                    in
                    -- the head is consumed; only the arguments carry on
                    Array.foldl (coverage env)
                        next
                        (Array.dropFirst 1 call.parts)

                Nothing ->
                    Walk.foldExprChildren (coverage env) covered expr

        Nothing ->
            when expr is
                ExprVar ref ->
                    when Evidence.kindOfRef ref is
                        Just kind ->
                            -- a bare reference is only safe when it needs no
                            -- arguments at all (`Set.empty`)
                            when operationFor kind ref.name 0 is
                                Just OpNeutral ->
                                    covered

                                _ ->
                                    drop kind covered

                        Nothing ->
                            covered

                _ ->
                    Walk.foldExprChildren (coverage env) covered expr


drop : Kind -> { set : Bool, dict : Bool } -> { set : Bool, dict : Bool }
drop kind covered =
    when kind is
        SetKind ->
            { covered | set = False }

        DictKind ->
            { covered | dict = False }



-- REWRITE ---------------------------------------------------------------------


type alias Context =
    { env : Env
    , scope : Scope
    }


scopeShapes : Scope -> Kind -> Maybe (Array KeyShape)
scopeShapes scope kind =
    when kind is
        SetKind ->
            scope.set

        DictKind ->
            scope.dict


provenOnly : Scope -> Kind -> Bool
provenOnly scope kind =
    when kind is
        SetKind ->
            scope.setProvenOnly

        DictKind ->
            scope.dictProvenOnly


{-| Bottom-up: children are rewritten before the node, so a rewrite that
wraps a call (`List.map decode (Set.toList s)`) is never revisited.
-}
rewriteExpr : Context -> Int -> Expr -> Expr
rewriteExpr context generation expr =
    Walk.mapExprChildren (rewriteExpr context (generation + 1)) expr
        |> rewriteNode context generation


rewriteNode : Context -> Int -> Expr -> Expr
rewriteNode context generation expr =
    when normalizeCall expr is
        Just call ->
            when Evidence.kindOfRef call.ref is
                Just kind ->
                    when scopeShapes context.scope kind is
                        Just shapes ->
                            when operationFor kind call.ref.name (argCount call) is
                                Just operation ->
                                    if provenOnly context.scope kind then
                                        -- D81 multi-dict: only rewrite when
                                        -- the container is proven at this shape.
                                        applyIfProvenContainer context
                                            generation
                                            shapes
                                            operation
                                            call
                                            expr

                                    else
                                        -- R3: the declaration's whole kind
                                        applyOperation generation shapes operation call expr

                                Nothing ->
                                    expr

                        Nothing ->
                            -- R2: only a call whose container is itself proven
                            encodeProvenCall context generation kind call expr

                Nothing ->
                    expr

        Nothing ->
            expr


{-| Proven-only gate: the container argument (last arg, or the sole arg of
a read) must be a proven container whose shapes match the seed. Unproven
sites and differently-keyed proven containers are left alone.
-}
applyIfProvenContainer :
    Context
    -> Int
    -> Array KeyShape
    -> Operation
    -> Call
    -> Expr
    -> Expr
applyIfProvenContainer context generation shapes operation call expr =
    let
        containerArg =
            when operation is
                OpEncodeKey _ ->
                    Array.last call.parts

                OpEncodeElements _ ->
                    -- fromList builds a fresh container; allow when we have
                    -- a seed and no other interpretation (caller already
                    -- gated on provenOnly, so only fire if shapes match a
                    -- known return — leave alone if ambiguous).
                    Nothing

                OpDecodeResult _ ->
                    Array.get 1 call.parts

                OpDecodeCallback _ ->
                    Array.last call.parts

                OpNeutral ->
                    Nothing
    in
    when containerArg is
        Just container ->
            when provenContainer context.env container is
                Just slot ->
                    if slot.shapes == shapes then
                        applyOperation generation shapes operation call expr

                    else
                        expr

                Nothing ->
                    expr

        Nothing ->
            expr


{-| R2 call-site rule: the key encodes when the CONTAINER argument (the
last one) is proven of the call's kind. -}
encodeProvenCall : Context -> Int -> Kind -> Call -> Expr -> Expr
encodeProvenCall context generation kind call expr =
    when operationFor kind call.ref.name (argCount call) is
        Just (OpEncodeKey index) ->
            when Array.last call.parts is
                Just container ->
                    when provenContainer context.env container is
                        Just slot ->
                            if slot.kind == kind && argCount call >= 2 then
                                ExprApplication
                                    (encodeAt generation slot.shapes index call.parts)

                            else
                                expr

                        Nothing ->
                            expr

                Nothing ->
                    expr

        _ ->
            expr


applyOperation : Int -> Array KeyShape -> Operation -> Call -> Expr -> Expr
applyOperation generation shapes operation call expr =
    when operation is
        OpNeutral ->
            expr

        OpEncodeKey index ->
            ExprApplication (encodeAt generation shapes index call.parts)

        OpEncodeElements { index = index, paired = paired } ->
            ExprApplication
                (replaceAt index
                    (\argument ->
                        ExprApplication
                            [ listMap
                            , if paired then
                                pairLambda generation
                                    (Codec.encodeKey generation shapes)

                              else
                                Codec.encoderLambda generation shapes
                            , argument
                            ]
                    )
                    call.parts
                )

        OpDecodeResult { paired = paired } ->
            ExprApplication
                [ listMap
                , if paired then
                    pairLambda generation (Codec.decodeKey generation shapes)

                  else
                    Codec.decoderLambda generation shapes
                , ExprApplication call.parts
                ]

        OpDecodeCallback { index = index, arity = arity } ->
            ExprApplication
                (replaceAt index
                    (\callback -> decodingCallback generation shapes arity callback)
                    call.parts
                )


encodeAt : Int -> Array KeyShape -> Int -> Array Expr -> Array Expr
encodeAt generation shapes index parts =
    replaceAt index (Codec.encodeKey generation shapes) parts


replaceAt : Int -> (Expr -> Expr) -> Array Expr -> Array Expr
replaceAt index f parts =
    Array.indexedMap
        (\position part ->
            if position == index then
                f part

            else
                part
        )
        parts


{-| `\( d65mk<g>, d65mv<g> ) -> ( f d65mk<g>, d65mv<g> )` — key/value
entries move through Dict.toList / Dict.fromList as pairs.

Every generated binder carries the rewrite GENERATION (the node's depth in
the declaration). A rewritten node can only ever sit inside a strictly
shallower one, so two generated binders can never collide and Gren can
never see the SHADOWING that D38 cost us.
-}
pairLambda : Int -> (Expr -> Expr) -> Expr
pairLambda generation f =
    let
        keyBinder =
            "d65mk" ++ String.fromInt generation

        valueBinder =
            "d65mv" ++ String.fromInt generation
    in
    ExprLambda
        { arguments = [ PatTuple [ PatVar keyBinder, PatVar valueBinder ] ]
        , expression =
            ExprTuple
                [ f (bareVar keyBinder)
                , bareVar valueBinder
                ]
        }


{-| `\d65c<g>_0 d65c<g>_1 … -> callback (decode d65c<g>_0) d65c<g>_1 …` —
the key is always the callback's first argument in both Dict and Set APIs.
-}
decodingCallback : Int -> Array KeyShape -> Int -> Expr -> Expr
decodingCallback generation shapes arity callback =
    let
        binders =
            Array.initialize arity
                0
                (\index ->
                    "d65c"
                        ++ String.fromInt generation
                        ++ "_"
                        ++ String.fromInt index
                )
    in
    ExprLambda
        { arguments = Array.map PatVar binders
        , expression =
            ExprApplication
                (Array.pushFirst callback
                    (Array.indexedMap
                        (\index name ->
                            if index == 0 then
                                Codec.decodeKey generation shapes (bareVar name)

                            else
                                bareVar name
                        )
                        binders
                    )
                )
        }


listMap : Expr
listMap =
    ExprVar { moduleName = Just "List", name = "map" }


bareVar : String -> Expr
bareVar name =
    ExprVar { moduleName = Nothing, name = name }
