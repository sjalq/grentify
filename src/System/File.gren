module System.File exposing
    ( copyDirectoryContents
    , ensureDirectory
    , exists
    , inDirectory
    , listFilesRecursively
    , move
    , pathFromString
    , pathToString
    , readText
    , removeIfExists
    , removeIfExistsBestEffort
    , resolve
    , tempSibling
    , writeText
    )

import Bytes
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Node
import Port.Error as PortError exposing (Error)
import Task exposing (Task)


pathFromString : Node.Platform -> String -> Path
pathFromString platform value =
    when platform is
        Node.Win32 ->
            Path.fromWin32String value

        _ ->
            Path.fromPosixString value


pathToString : Node.Platform -> Path -> String
pathToString platform path =
    when platform is
        Node.Win32 ->
            Path.toWin32String path

        _ ->
            Path.toPosixString path


resolve : Node.Platform -> Path -> String -> Path
resolve platform workingDirectory value =
    let
        candidate =
            pathFromString platform value
    in
    if String.isEmpty candidate.root then
        Path.prepend workingDirectory candidate

    else
        candidate


{-| Join a relative POSIX-style path under `directory` (e.g. `"src/Main.gren"`).
-}
inDirectory : String -> Path -> Path
inDirectory relative directory =
    Path.append (Path.fromPosixString relative) directory


readText : FileSystem.Permission -> Path -> Task Error String
readText permission path =
    FileSystem.readFile permission path
        |> Task.mapError
            (\error ->
                PortError.create "FILE_READ_FAILED"
                    ("Could not read " ++ Path.toPosixString path ++ ": " ++ FileSystem.errorToString error)
            )
        |> Task.andThen
            (\bytes ->
                when Bytes.toString bytes is
                    Just value ->
                        Task.succeed value

                    Nothing ->
                        Task.fail <|
                            PortError.create "FILE_READ_FAILED"
                                (Path.toPosixString path ++ " is not valid UTF-8.")
            )


ensureDirectory : FileSystem.Permission -> Path -> Task Error Path
ensureDirectory permission path =
    FileSystem.makeDirectory permission { recursive = True } path
        |> Task.onError
            (\error ->
                if FileSystem.errorIsFileExists error then
                    Task.succeed path

                else
                    Task.fail <|
                        PortError.create "DIRECTORY_CREATE_FAILED"
                            ("Could not create " ++ Path.toPosixString path ++ ": " ++ FileSystem.errorToString error)
            )


exists : FileSystem.Permission -> Path -> Task x Bool
exists permission path =
    FileSystem.metadata permission { resolveLink = True } path
        |> Task.map (\_ -> True)
        |> Task.onError (\_ -> Task.succeed False)


{-| Recursive remove; failures use caller-supplied `errorCode`. -}
removeIfExists : FileSystem.Permission -> String -> Path -> Task Error {}
removeIfExists permission errorCode path =
    exists permission path
        |> Task.andThen
            (\pathExists ->
                if pathExists then
                    FileSystem.remove permission { recursive = True } path
                        |> Task.map (\_ -> {})
                        |> Task.mapError
                            (\error ->
                                PortError.create errorCode
                                    ("Could not remove "
                                        ++ Path.toPosixString path
                                        ++ ": "
                                        ++ FileSystem.errorToString error
                                    )
                            )

                else
                    Task.succeed {}
            )


{-| Cache/temp cleanup; never fails. -}
removeIfExistsBestEffort : FileSystem.Permission -> Path -> Task x {}
removeIfExistsBestEffort permission path =
    exists permission path
        |> Task.andThen
            (\present ->
                if present then
                    FileSystem.remove permission { recursive = True } path
                        |> Task.map (\_ -> {})

                else
                    Task.succeed {}
            )
        |> Task.onError (\_ -> Task.succeed {})


{-| Path next to `path`: `.<filename><label>` (atomic writes / staging). -}
tempSibling : Path -> String -> Path
tempSibling path label =
    let
        parent =
            Path.parentPath path
                |> Maybe.withDefault Path.empty

        name =
            "." ++ Path.filenameWithExtension path ++ label
    in
    Path.join [ parent, Path.fromPosixString name ]


{-| Rename `source` → `destination` (Gren API is dest-first). -}
move : FileSystem.Permission -> String -> Path -> Path -> String -> Task Error {}
move permission errorCode destination source action =
    FileSystem.move permission destination source
        |> Task.map (\_ -> {})
        |> Task.mapError
            (\error ->
                PortError.create errorCode
                    ("Could not " ++ action ++ ": " ++ FileSystem.errorToString error)
            )


listFilesRecursively : FileSystem.Permission -> Path -> Task Error (Array Path)
listFilesRecursively permission root =
    FileSystem.listDirectory permission root
        |> Task.mapError
            (\error ->
                PortError.create "DIRECTORY_READ_FAILED"
                    ("Could not list " ++ Path.toPosixString root ++ ": " ++ FileSystem.errorToString error)
            )
        |> Task.andThen
            (\entries ->
                Array.foldl
                    (\entry pending ->
                        pending
                            |> Task.andThen
                                (\found ->
                                    let
                                        absolute =
                                            Path.prepend root entry.path
                                    in
                                    when entry.entityType is
                                        FileSystem.File ->
                                            Task.succeed (Array.pushLast absolute found)

                                        FileSystem.Directory ->
                                            -- Build/VCS litter is never source, and elm-stuff
                                            -- inside shared cached trees is rewritten by
                                            -- concurrent extraction — recursing into it races
                                            -- ENOENT mid-walk (gate v6 browser).
                                            if isTransientDirectory (Path.filenameWithExtension entry.path) then
                                                Task.succeed found

                                            else
                                                listFilesRecursively permission absolute
                                                    |> Task.map (Array.append found)

                                        _ ->
                                            Task.succeed found
                                )
                    )
                    (Task.succeed [])
                    entries
            )


{-| Directories that hold generated or VCS state, never package sources.
-}
isTransientDirectory : String -> Bool
isTransientDirectory name =
    name == "elm-stuff" || name == ".git" || name == "node_modules" || name == ".gren"


writeText : FileSystem.Permission -> Path -> String -> Task Error Path
writeText permission path contents =
    let
        ensureParent =
            when Path.parentPath path is
                Just parent ->
                    ensureDirectory permission parent
                        |> Task.map (\_ -> {})

                Nothing ->
                    Task.succeed {}
    in
    ensureParent
        |> Task.andThen
            (\_ ->
                FileSystem.writeFile permission (Bytes.fromString contents) path
                    |> Task.mapError
                        (\error ->
                            PortError.create "FILE_WRITE_FAILED"
                                ("Could not write " ++ Path.toPosixString path ++ ": " ++ FileSystem.errorToString error)
                        )
            )


{-| Copy every file under `source` into `destination`, creating directories.
Best-effort: failures on individual missing sources are not fatal for callers
that check `exists` first.
-}
copyDirectoryContents : FileSystem.Permission -> Path -> Path -> Task Error {}
copyDirectoryContents permission source destination =
    listFilesRecursively permission source
        |> Task.andThen
            (\files ->
                let
                    sourcePrefix =
                        String.trimRight (Path.toPosixString source) ++ "/"
                in
                files
                    |> Array.foldl
                        (\file pending ->
                            pending
                                |> Task.andThen
                                    (\_ ->
                                        let
                                            absolute =
                                                Path.toPosixString file

                                            relative =
                                                if String.startsWith sourcePrefix absolute then
                                                    String.dropFirst (String.count sourcePrefix) absolute

                                                else
                                                    -- Fallback: last path segment
                                                    absolute
                                                        |> String.split "/"
                                                        |> Array.last
                                                        |> Maybe.withDefault absolute

                                            target =
                                                Path.join
                                                    [ destination
                                                    , Path.fromPosixString relative
                                                    ]
                                        in
                                        ensureDirectory permission
                                            (when Path.parentPath target is
                                                Just parent ->
                                                    parent

                                                Nothing ->
                                                    destination
                                            )
                                            |> Task.andThen
                                                (\_ ->
                                                    FileSystem.copyFile permission target file
                                                        |> Task.mapError
                                                            (\error ->
                                                                PortError.create "FILE_COPY_FAILED"
                                                                    ("Could not copy "
                                                                        ++ absolute
                                                                        ++ " to "
                                                                        ++ Path.toPosixString target
                                                                        ++ ": "
                                                                        ++ FileSystem.errorToString error
                                                                    )
                                                            )
                                                        |> Task.map (\_ -> {})
                                                )
                                    )
                        )
                        (Task.succeed {})
            )
