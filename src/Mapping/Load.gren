module Mapping.Load exposing
    ( Loaded
    , load
    )

{-| Single entry point for loading the builtin mapping plus overlays.

Returns both the overlayed registry and the raw file texts (builtin first).
Lockfile digests and local-port fingerprints hash those texts so callers never
re-read the same JSON.
-}

import Array exposing (Array)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Mapping.Decode as Decode
import Mapping.Registry as Registry
import Mapping.Types exposing (MappingDocument, MappingError(..), Registry)
import Port.Error as PortError exposing (Error)
import System.File
import Task exposing (Task)


type alias Loaded =
    { registry : Registry
    , -- Raw file texts, builtin first then overlays (order stable for digests).
      texts : Array String
    }


load : FileSystem.Permission -> Path -> Array Path -> Task Error Loaded
load permission builtin overlays =
    readDocument permission builtin
        |> Task.andThen
            (\base ->
                overlays
                    |> Array.foldl
                        (\path pending ->
                            pending
                                |> Task.andThen
                                    (\rows ->
                                        readDocument permission path
                                            |> Task.map (\row -> Array.pushLast row rows)
                                    )
                        )
                        (Task.succeed [ base ])
            )
        |> Task.map
            (\rows ->
                { registry = Registry.overlayDocuments (Array.map .document rows)
                , texts = Array.map .contents rows
                }
            )


type alias DocumentRow =
    { document : MappingDocument
    , contents : String
    }


readDocument : FileSystem.Permission -> Path -> Task Error DocumentRow
readDocument permission path =
    System.File.readText permission path
        |> Task.andThen
            (\contents ->
                when Decode.decodeString (Path.toPosixString path) contents is
                    Ok document ->
                        Task.succeed { document = document, contents = contents }

                    Err (InvalidMapping details) ->
                        Task.fail <|
                            PortError.create "INVALID_MAPPING"
                                (details.source ++ " " ++ details.path ++ ": " ++ details.message)
            )
