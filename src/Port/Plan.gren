module Port.Plan exposing
    ( Identity
    , LocalDependency
    , buildManifest
    , localClosure
    , inferPackagePlatform
    , targetName
    , analogueRoot
    , analogueRootByName
    )

{-| Deterministic planning from resolved Elm package identities to Gren package
names, platforms, dependency requirements, and package manifests.

LAW (local dependencies): a package's manifest declares exactly the packages
in the transitive closure of its OWN declared Elm dependencies, intersected
with the set vendored by this port. Never "every package planned so far".
Every entry is derived from a declared dependency edge; membership in the
port's identity table is a filter, never a source.
-}

import Ast.ModuleName as ModuleName
import Cli
import Compiler.Platform as CompilerPlatform exposing (Platform)
import Dict exposing (Dict)
import Elm.Manifest exposing (Manifest)
import Elm.PackageName as PackageName
import Elm.Semver as Semver
import Emit.Manifest as GrenManifest exposing (Dependency(..), ExposedModules(..), Spec, SpecKind(..))
import Emit.Workspace
import Mapping.Registry as MappingRegistry
import Mapping.Types as Mapping exposing (MappingKind(..), PackageMapping(..), Registry)
import Port.Error as PortError exposing (Error)


type alias Identity =
    { elmName : String
    , grenName : String
    , version : String
    , platform : Mapping.Platform
    }


type alias LocalDependency =
    { identity : Identity
    , isRootDependency : Bool
    }


{-| What the manifest builders below need once the local closure is known.
-}
type alias Context =
    { source : Manifest
    , identity : Identity
    , registry : Registry
    , rootElmName : String
    , localDependencies : Dict String Identity
    }


{-| Gren package name: catalog mapping if present, else the Elm coordinate.
-}
targetName : Registry -> Manifest -> Result Error String
targetName registry manifest =
    let
        sourceName =
            PackageName.toString manifest.name
    in
    when MappingRegistry.mappingFor sourceName registry is
        Just mapping ->
            Ok (Mapping.mappingGrenPackage mapping)

        Nothing ->
            Ok sourceName


{-| If a package is analogue-mapped (gren-analogue kind), return its Gren package name and version.
Returns Nothing for transpiled or unmapped packages.
-}
analogueRoot : Registry -> Manifest -> Maybe { grenPackage : String, grenVersion : String }
analogueRoot registry manifest =
    analogueRootByName registry (PackageName.toString manifest.name)


{-| Same as analogueRoot but takes the package name as a string (e.g., "avh4/elm-color").
-}
analogueRootByName : Registry -> String -> Maybe { grenPackage : String, grenVersion : String }
analogueRootByName registry elmPackageName =
    when MappingRegistry.mappingFor elmPackageName registry is
        Just (GrenAnalogue details) ->
            Just
                { grenPackage = details.grenPackage
                , grenVersion = details.grenVersion
                }

        _ ->
            Nothing


inferPackagePlatform
    : Cli.PlatformChoice
    -> Bool
    -> Registry
    -> Manifest
    -> Array Mapping.Platform
    -> Mapping.Platform
    -> Result Error Mapping.Platform
inferPackagePlatform requested isRoot registry manifest dependencyPlatforms detected =
    MappingRegistry.inferPlatform
        registry
        (Dict.keys manifest.dependencies)
        (Array.pushLast detected dependencyPlatforms)
        |> Result.mapError
            (\_ ->
                PortError.create "PLATFORM_CONFLICT"
                    ("Elm package " ++ PackageName.toString manifest.name ++ " combines browser and node dependencies.")
            )
        |> Result.andThen
            (\inferred ->
                if not isRoot then
                    Ok inferred

                else
                    applyRequestedPlatform requested inferred
            )


applyRequestedPlatform : Cli.PlatformChoice -> Mapping.Platform -> Result Error Mapping.Platform
applyRequestedPlatform requested inferred =
    when requested is
        Cli.Auto ->
            Ok inferred

        Cli.ExactPlatform platform ->
            let
                exact =
                    fromCompilerPlatform platform
            in
            if inferred == Mapping.Common || inferred == exact then
                Ok exact

            else
                Err <|
                    PortError.create "PLATFORM_CONFLICT"
                        ("Requested "
                            ++ Mapping.platformName exact
                            ++ " cannot host "
                            ++ Mapping.platformName inferred
                            ++ " dependencies."
                        )


{-| `portedManifests` is the Elm dependency graph of everything this port
vendors (keyed by Elm coordinate); `plannedIdentities` is the Gren identity
of every package planned so far. The closure is read off the first and only
filtered by the second — see `localClosure`.
-}
buildManifest
    : { source : Manifest
      , identity : Identity
      , registry : Registry
      , rootElmName : String
      , portedManifests : Dict String Manifest
      , plannedIdentities : Dict String Identity
      }
    -> Result Error Spec
buildManifest options =
    let
        context =
            { source = options.source
            , identity = options.identity
            , registry = options.registry
            , rootElmName = options.rootElmName
            , localDependencies =
                localClosure options.portedManifests options.plannedIdentities options.source
            }
    in
    Dict.foldl
        (addDependency context)
        (Ok Dict.empty)
        context.source.dependencies
        |> Result.andThen (hoistTransitiveLocals context)
        |> Result.map
            (\dependencies ->
                { kind =
                    if context.source.isApplication then
                        ApplicationKind

                    else
                        PackageKind
                , platform = toCompilerPlatform context.identity.platform
                , name = context.identity.grenName
                , summary = context.source.summary
                , license = context.source.license
                , version = context.identity.version
                , exposedModules =
                    -- Same rename the emitted module headers carry (Ast.ModuleName).
                    ExposedArray (Array.map ModuleName.toGren context.source.exposedModules)
                , grenVersion =
                    if context.source.isApplication then
                        "0.6.6"

                    else
                        "0.6.0 <= v < 0.7.0"
                , dependencies = dependencies
                , sourceDirectories =
                    if Array.isEmpty context.source.sourceDirectories then
                        [ "src" ]

                    else
                        context.source.sourceDirectories
                }
            )


{-| The vendored packages `source` may legally see: every package reachable
from its OWN declared dependencies through the ported dependency graph.

D76: this used to be `state.identities` — every package planned so far — so
a package was handed siblings it never depended on. A hoisted sibling is a
real, importable dependency, and it collided two ways: by module name (two
unrelated siblings both exposing `Dict.Extra`) and by platform (a `common`
package handed a `browser` sibling is rejected outright).

D47 still holds. gren requires the VERIFYING ROOT to declare every
transitive local dep, and each vendored package verifies standalone as its
own root — hence the closure, not just the direct dependencies. The
workspace root still gets every vendored package for free: `Resolve.Solver`
derives the ported set by walking the root's own dependency edges, so the
root's closure IS the ported set.

Traversal stops at any name with no planned identity. Analogue and absorbed
mappings are not vendored, so no local package lies beyond them.
-}
localClosure : Dict String Manifest -> Dict String Identity -> Manifest -> Dict String Identity
localClosure portedManifests plannedIdentities source =
    reachLocals portedManifests plannedIdentities (Dict.keys source.dependencies) Dict.empty


reachLocals : Dict String Manifest -> Dict String Identity -> Array String -> Dict String Identity -> Dict String Identity
reachLocals portedManifests plannedIdentities frontier found =
    when Array.popFirst frontier is
        Nothing ->
            found

        Just { first, rest } ->
            if Dict.member first found then
                reachLocals portedManifests plannedIdentities rest found

            else
                when Dict.get first plannedIdentities is
                    Nothing ->
                        reachLocals portedManifests plannedIdentities rest found

                    Just identity ->
                        reachLocals portedManifests
                            plannedIdentities
                            (Array.append rest (elmDependencyNames portedManifests first))
                            (Dict.set first identity found)


elmDependencyNames : Dict String Manifest -> String -> Array String
elmDependencyNames portedManifests elmName =
    when Dict.get elmName portedManifests is
        Just manifest ->
            Dict.keys manifest.dependencies

        Nothing ->
            []


{-| Gren rejects nested `local:` deps unless the root also declares the same
local package. Every package manifest therefore surfaces the packages that
are only TRANSITIVE in its own Elm graph, not just its direct dependencies
(e.g. elm-review → elm-syntax → structured-writer).

D47: vendored packages verify standalone (`gren docs` in their own
directory), where each acts as its own root — so the hoist must apply to
all of them, not just the workspace root. A vendored elm-review whose
manifest omitted structured-writer failed the solver with INDIRECT LOCAL
DEPENDENCY even though every pointer was layout-consistent.

D76: the set hoisted is `localClosure`, i.e. what this package's declared
dependencies reach. It used to be every package planned so far.
-}
hoistTransitiveLocals : Context -> Dict String Dependency -> Result Error (Dict String Dependency)
hoistTransitiveLocals context dependencies =
    Dict.foldl
            (\_ local accumulated ->
                accumulated
                    |> Result.andThen
                        (\deps ->
                            if local.grenName == context.identity.grenName then
                                Ok deps

                            else
                                setDependency local.grenName
                                    (LocalPath (localPath context local))
                                    deps
                        )
            )
            (Ok dependencies)
            context.localDependencies


addDependency
    : Context
    -> String
    -> Elm.Manifest.Dependency
    -> Result Error (Dict String Dependency)
    -> Result Error (Dict String Dependency)
addDependency context elmName _ accumulated =
    accumulated
        |> Result.andThen
            (\dependencies ->
                when Dict.get elmName context.localDependencies is
                    Just local ->
                        if local.grenName == context.identity.grenName then
                            Ok dependencies

                        else
                            setDependency local.grenName
                                (LocalPath (localPath context local))
                                dependencies

                    Nothing ->
                        when MappingRegistry.mappingFor elmName context.registry is
                            Just (GrenAnalogue details) ->
                                addMapped context details dependencies

                            Just (Absorbed details) ->
                                addMapped context details dependencies

                            Just (Transpile _) ->
                                Err (missingLocal context elmName)

                            Nothing ->
                                Err (missingLocal context elmName)
            )


addMapped context details dependencies =
    if details.grenPackage == context.identity.grenName then
        Ok dependencies

    else
        mappedRange details.grenVersion
            |> Result.andThen
                (\range -> setDependency details.grenPackage (VersionRange range) dependencies)


setDependency : String -> Dependency -> Dict String Dependency -> Result Error (Dict String Dependency)
setDependency packageName requirement dependencies =
    when Dict.get packageName dependencies is
        Nothing ->
            Ok (Dict.set packageName requirement dependencies)

        Just existing ->
            if existing == requirement then
                Ok dependencies

            else
                Err <|
                    PortError.create "DEPENDENCY_MAPPING_CONFLICT"
                        ("Elm dependencies map to incompatible requirements for " ++ packageName ++ ".")


mappedRange : String -> Result Error String
mappedRange source =
    Semver.parseVersion source
        |> Result.map
            (\version ->
                source
                    ++ " <= v < "
                    ++ String.fromInt (version.major + 1)
                    ++ ".0.0"
            )
        |> Result.mapError
            (Semver.errorToString
                >> PortError.create "INVALID_MAPPING"
            )


localPath context dependency =
    let
        directory =
            Emit.Workspace.packageDirectoryName
                { name = dependency.grenName
                , version = dependency.version
                }
    in
    if context.identity.elmName == context.rootElmName then
        ".elm-to-gren/packages/" ++ directory

    else
        "../" ++ directory


missingLocal context dependencyName =
    PortError.create "GREN_MANIFEST_INVALID"
        ("Elm package "
            ++ context.identity.elmName
            ++ " depends on "
            ++ dependencyName
            ++ ", but no generated local package was supplied."
        )


toCompilerPlatform : Mapping.Platform -> Platform
toCompilerPlatform platform =
    when platform is
        Mapping.Common ->
            CompilerPlatform.Common

        Mapping.Browser ->
            CompilerPlatform.Browser

        Mapping.Node ->
            CompilerPlatform.Node


fromCompilerPlatform : Platform -> Mapping.Platform
fromCompilerPlatform platform =
    when platform is
        CompilerPlatform.Common ->
            Mapping.Common

        CompilerPlatform.Browser ->
            Mapping.Browser

        CompilerPlatform.Node ->
            Mapping.Node
