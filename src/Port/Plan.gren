module Port.Plan exposing
    ( Identity
    , LocalDependency
    , buildManifest
    , localClosure
    , inferPackagePlatform
    , mappedRange
    , setDependency
    , targetName
    , toCompilerPlatform
    , analogueRoot
    , analogueRootByName
    )

{-| Plan Gren package names, platforms, and manifests from a resolved Elm graph.

Laws worth knowing before editing:

- **Local deps**: a package only depends on the transitive closure of *its own*
  declared Elm edges, intersected with what this port vendors — never "everything
  planned so far".
- **Module name collisions**: Gren forbids two packages exposing the same module.
  We refuse (`AMBIGUOUS_MODULE_NAME`) rather than rename; a rename would either
  change public APIs or make the same package emit different Gren under different
  roots (breaking the ported-cache contract). The `Elm.` prefix on `add` does not
  fix two packages both becoming `Elm.Force`.
-}

import Ast.ModuleName as ModuleName
import Cli
import Compiler.Platform as CompilerPlatform exposing (Platform)
import Dict exposing (Dict)
import Elm.Manifest exposing (Manifest)
import Elm.PackageName as PackageName
import Elm.Semver as Semver
import Emit.Manifest as GrenManifest exposing (Dependency(..), ExposedModules(..), Spec, SpecKind(..))
import Emit.Workspace
import Mapping.Registry as MappingRegistry
import Mapping.Types as Mapping exposing (MappingKind(..), PackageMapping(..), Registry)
import Port.Error as PortError exposing (Error)


type alias Identity =
    { elmName : String
    , grenName : String
    , version : String
    , platform : Mapping.Platform
    }


type alias LocalDependency =
    { identity : Identity
    , isRootDependency : Bool
    }


type alias Context =
    { source : Manifest
    , identity : Identity
    , registry : Registry
    , rootElmName : String
    , localDependencies : Dict String Identity
    }


{-| Gren package name for planning (permissive).

Use catalog mapping if any, else the raw Elm coordinate — even when that is not
a legal Gren name yet (common during graph planning). For publish-time
validation use `Port.Names.targetName` instead.
-}
targetName : Registry -> Manifest -> Result Error String
targetName registry manifest =
    let
        sourceName =
            PackageName.toString manifest.name
    in
    when MappingRegistry.mappingFor sourceName registry is
        Just mapping ->
            Ok (Mapping.mappingGrenPackage mapping)

        Nothing ->
            Ok sourceName


{-| Gren analogue identity when this Elm package is catalog-mapped as one. -}
analogueRoot : Registry -> Manifest -> Maybe { grenPackage : String, grenVersion : String }
analogueRoot registry manifest =
    analogueRootByName registry (PackageName.toString manifest.name)


analogueRootByName : Registry -> String -> Maybe { grenPackage : String, grenVersion : String }
analogueRootByName registry elmPackageName =
    when MappingRegistry.mappingFor elmPackageName registry is
        Just (GrenAnalogue details) ->
            Just
                { grenPackage = details.grenPackage
                , grenVersion = details.grenVersion
                }

        _ ->
            Nothing


inferPackagePlatform
    : Cli.PlatformChoice
    -> Bool
    -> Registry
    -> Manifest
    -> Array Mapping.Platform
    -> Mapping.Platform
    -> Result Error Mapping.Platform
inferPackagePlatform requested isRoot registry manifest dependencyPlatforms detected =
    MappingRegistry.inferPlatform
        registry
        (Dict.keys manifest.dependencies)
        (Array.pushLast detected dependencyPlatforms)
        |> Result.mapError
            (\_ ->
                PortError.create "PLATFORM_CONFLICT"
                    ("Elm package " ++ PackageName.toString manifest.name ++ " combines browser and node dependencies.")
            )
        |> Result.andThen
            (\inferred ->
                if not isRoot then
                    Ok inferred

                else
                    applyRequestedPlatform requested inferred
            )


applyRequestedPlatform : Cli.PlatformChoice -> Mapping.Platform -> Result Error Mapping.Platform
applyRequestedPlatform requested inferred =
    when requested is
        Cli.Auto ->
            Ok inferred

        Cli.ExactPlatform platform ->
            let
                exact =
                    fromCompilerPlatform platform
            in
            if inferred == Mapping.Common || inferred == exact then
                Ok exact

            else
                Err <|
                    PortError.create "PLATFORM_CONFLICT"
                        ("Requested "
                            ++ Mapping.platformName exact
                            ++ " cannot host "
                            ++ Mapping.platformName inferred
                            ++ " dependencies."
                        )


{-| Build a Gren package/app spec. Local deps come from `localClosure`, not the full planned set. -}
buildManifest
    : { source : Manifest
      , identity : Identity
      , registry : Registry
      , rootElmName : String
      , portedManifests : Dict String Manifest
      , plannedIdentities : Dict String Identity
      }
    -> Result Error Spec
buildManifest options =
    let
        context =
            { source = options.source
            , identity = options.identity
            , registry = options.registry
            , rootElmName = options.rootElmName
            , localDependencies =
                localClosure options.portedManifests options.plannedIdentities options.source
            }
    in
    Dict.foldl
        (addDependency context)
        (Ok Dict.empty)
        context.source.dependencies
        |> Result.andThen (hoistTransitiveLocals context)
        |> Result.andThen
            (\dependencies ->
                checkExposedModuleCollisions context options.portedManifests
                    |> Result.andThen
                        (\_ ->
                            checkPlatformModuleCollisions context
                                options.portedManifests
                        )
                    |> Result.map (\_ -> dependencies)
            )
        |> Result.map
            (\dependencies ->
                { kind =
                    if context.source.isApplication then
                        ApplicationKind

                    else
                        PackageKind
                , platform = toCompilerPlatform context.identity.platform
                , name = context.identity.grenName
                , summary = context.source.summary
                , license = context.source.license
                , version = context.identity.version
                , exposedModules =
                    -- Same rename the emitted module headers carry (Ast.ModuleName).
                    ExposedArray (Array.map ModuleName.toGren context.source.exposedModules)
                , grenVersion =
                    if context.source.isApplication then
                        "0.6.6"

                    else
                        "0.6.0 <= v < 0.7.0"
                , dependencies = dependencies
                , sourceDirectories =
                    if Array.isEmpty context.source.sourceDirectories then
                        [ "src" ]

                    else
                        context.source.sourceDirectories
                }
            )


{-| Refuse if we expose a module name also exposed by a local vendored dep. -}
checkExposedModuleCollisions : Context -> Dict String Manifest -> Result Error {}
checkExposedModuleCollisions context portedManifests =
    let
        ours =
            Array.map ModuleName.toGren context.source.exposedModules
    in
    Dict.foldl
        (\elmName identity result ->
            result
                |> Result.andThen
                    (\_ ->
                        when Dict.get elmName portedManifests is
                            Nothing ->
                                Ok {}

                            Just depManifest ->
                                let
                                    theirs =
                                        Array.map ModuleName.toGren depManifest.exposedModules

                                    shared =
                                        Array.keepIf (\name -> Array.member name theirs) ours
                                in
                                when Array.first shared is
                                    Nothing ->
                                        Ok {}

                                    Just moduleName ->
                                        Err
                                            (PortError.create "AMBIGUOUS_MODULE_NAME"
                                                (ambiguousModuleMessage context.identity
                                                    moduleName
                                                    identity
                                                )
                                            )
                    )
        )
        (Ok {})
        context.localDependencies


ambiguousModuleMessage : Identity -> String -> Identity -> String
ambiguousModuleMessage self moduleName dependency =
    "Package "
        ++ self.elmName
        ++ " exposes the module `"
        ++ moduleName
        ++ "`, but its dependency "
        ++ dependency.elmName
        ++ " (as "
        ++ dependency.grenName
        ++ ") already exposes that name. "
        ++ "Elm allows two packages to share a module name when no single "
        ++ "module imports both; Gren forbids the collision at the package "
        ++ "graph (even when no module imports both). "
        ++ "This is a language-level difference, not a porting bug. "
        ++ "Automatic rename is refused: it would change a public API, is not "
        ++ "a pure function of the module name alone (both packages use the "
        ++ "same name, so D72 does not apply), and a graph-dependent rename "
        ++ "would make the same package emit different Gren under different "
        ++ "roots. The `add` command's Elm. module prefix does not help "
        ++ "(both sides become Elm."
        ++ moduleName
        ++ " and still collide). "
        ++ "What you can do: fork one of the two Elm packages and rename the "
        ++ "colliding module there (and its importers) so the exposed names no "
        ++ "longer clash, then port the fork; or drop a dependency only when "
        ++ "the edge is false (see D76). There is no namespacing flag that "
        ++ "resolves a same-name collision between two vendored packages."


{-| Vendored packages reachable from this package's *own* declared deps only.

Must not be "everything planned so far" (sibling pollution → module/platform
collisions). Gren still needs the full transitive *local* closure on each
package that verifies standalone as its own root.
-}
localClosure : Dict String Manifest -> Dict String Identity -> Manifest -> Dict String Identity
localClosure portedManifests plannedIdentities source =
    reachLocals portedManifests plannedIdentities (Dict.keys source.dependencies) Dict.empty


reachLocals : Dict String Manifest -> Dict String Identity -> Array String -> Dict String Identity -> Dict String Identity
reachLocals portedManifests plannedIdentities frontier found =
    when Array.popFirst frontier is
        Nothing ->
            found

        Just { first, rest } ->
            if Dict.member first found then
                reachLocals portedManifests plannedIdentities rest found

            else
                when Dict.get first plannedIdentities is
                    Nothing ->
                        reachLocals portedManifests plannedIdentities rest found

                    Just identity ->
                        reachLocals portedManifests
                            plannedIdentities
                            (Array.append rest (elmDependencyNames portedManifests first))
                            (Dict.set first identity found)


elmDependencyNames : Dict String Manifest -> String -> Array String
elmDependencyNames portedManifests elmName =
    when Dict.get elmName portedManifests is
        Just manifest ->
            Dict.keys manifest.dependencies

        Nothing ->
            []


{-| Hoist transitive local packages onto this package's manifest.

Gren forbids nested `local:` deps unless the verifying root also declares them;
each vendored package verifies as its own root, so hoist `localClosure` here.
-}
hoistTransitiveLocals : Context -> Dict String Dependency -> Result Error (Dict String Dependency)
hoistTransitiveLocals context dependencies =
    Dict.foldl
            (\_ local accumulated ->
                accumulated
                    |> Result.andThen
                        (\deps ->
                            if local.grenName == context.identity.grenName then
                                Ok deps

                            else
                                setDependency local.grenName
                                    (LocalPath (localPath context local))
                                    deps
                        )
            )
            (Ok dependencies)
            context.localDependencies


addDependency
    : Context
    -> String
    -> Elm.Manifest.Dependency
    -> Result Error (Dict String Dependency)
    -> Result Error (Dict String Dependency)
addDependency context elmName _ accumulated =
    accumulated
        |> Result.andThen
            (\dependencies ->
                when Dict.get elmName context.localDependencies is
                    Just local ->
                        if local.grenName == context.identity.grenName then
                            Ok dependencies

                        else
                            setDependency local.grenName
                                (LocalPath (localPath context local))
                                dependencies

                    Nothing ->
                        when MappingRegistry.mappingFor elmName context.registry is
                            Just (GrenAnalogue details) ->
                                addMapped context details dependencies

                            Just (Absorbed details) ->
                                addMapped context details dependencies

                            Just (Transpile _) ->
                                Err (missingLocal context elmName)

                            Nothing ->
                                Err (missingLocal context elmName)
            )


addMapped context details dependencies =
    if details.grenPackage == context.identity.grenName then
        Ok dependencies

    else
        mappedRange details.grenVersion
            |> Result.andThen
                (\range -> setDependency details.grenPackage (VersionRange range) dependencies)


setDependency : String -> Dependency -> Dict String Dependency -> Result Error (Dict String Dependency)
setDependency packageName requirement dependencies =
    when Dict.get packageName dependencies is
        Nothing ->
            Ok (Dict.set packageName requirement dependencies)

        Just existing ->
            if existing == requirement then
                Ok dependencies

            else
                Err <|
                    PortError.create "DEPENDENCY_MAPPING_CONFLICT"
                        ("Elm dependencies map to incompatible requirements for " ++ packageName ++ ".")


mappedRange : String -> Result Error String
mappedRange source =
    Semver.parseVersion source
        |> Result.map
            (\version ->
                source
                    ++ " <= v < "
                    ++ String.fromInt (version.major + 1)
                    ++ ".0.0"
            )
        |> Result.mapError
            (Semver.errorToString
                >> PortError.create "INVALID_MAPPING"
            )


localPath context dependency =
    let
        directory =
            Emit.Workspace.packageDirectoryName
                { name = dependency.grenName
                , version = dependency.version
                }
    in
    if context.identity.elmName == context.rootElmName then
        ".elm-to-gren/packages/" ++ directory

    else
        "../" ++ directory


missingLocal context dependencyName =
    PortError.create "GREN_MANIFEST_INVALID"
        ("Elm package "
            ++ context.identity.elmName
            ++ " depends on "
            ++ dependencyName
            ++ ", but no generated local package was supplied."
        )


toCompilerPlatform : Mapping.Platform -> Platform
toCompilerPlatform platform =
    when platform is
        Mapping.Common ->
            CompilerPlatform.Common

        Mapping.Browser ->
            CompilerPlatform.Browser

        Mapping.Node ->
            CompilerPlatform.Node


fromCompilerPlatform : Platform -> Mapping.Platform
fromCompilerPlatform platform =
    when platform is
        CompilerPlatform.Common ->
            Mapping.Common

        CompilerPlatform.Browser ->
            Mapping.Browser

        CompilerPlatform.Node ->
            Mapping.Node


{-| D91: refuse when an exposed module of this package is a module the MAPPED
Gren package it will sit beside already provides.

`arowM/html` is a drop-in replacement for `elm/html`: it exposes `Html`,
`Html.Attributes`, `Html.Events`, `Html.Keyed` and `Html.Lazy`, and it depends
on `elm/virtual-dom`, which maps to `gren-lang/browser` — the very package that
provides those five names in Gren. The port emitted a package that could not
coexist with its own platform dependency, and the collision only surfaced as a
`gren docs` AMBIGUOUS MODULE NAME far downstream.

Same law and same refusal as `checkExposedModuleCollisions`, one step further
out: the colliding neighbour is a mapped platform package rather than a
vendored one, so the module names come from the mapping catalog rather than a
manifest. Positive evidence only — a name collides only when a mapping that
targets a REACHABLE Gren package claims it.
-}
checkPlatformModuleCollisions : Context -> Dict String Manifest -> Result Error {}
checkPlatformModuleCollisions context portedManifests =
    let
        -- Every Elm package the graph declares: ours plus each vendored
        -- package's own edges. A mapped package is in the Gren graph exactly
        -- when something in that set maps to it.
        declaredElmPackages =
            Dict.foldl
                (\_ manifest found ->
                    Dict.foldl (\name _ acc -> Dict.set name {} acc)
                        found
                        manifest.dependencies
                )
                (Dict.foldl (\name _ acc -> Dict.set name {} acc)
                    Dict.empty
                    context.source.dependencies
                )
                portedManifests

        reachableGrenPackages =
            Dict.foldl
                (\elmName _ found ->
                    when MappingRegistry.mappingFor elmName context.registry is
                        Just mapping ->
                            Dict.set (Mapping.mappingGrenPackage mapping) {} found

                        Nothing ->
                            found
                )
                Dict.empty
                declaredElmPackages

        -- Which module names those Gren packages provide, gathered across
        -- EVERY mapping that targets them: `Html` belongs to
        -- gren-lang/browser through the elm/html mapping whether or not this
        -- package depends on elm/html.
        providedModules =
            Array.foldl
                (\mapping found ->
                    if Dict.member (Mapping.mappingGrenPackage mapping) reachableGrenPackages then
                        Array.foldl
                            (\moduleMapping acc ->
                                Dict.set moduleMapping.target
                                    (Mapping.mappingGrenPackage mapping)
                                    acc
                            )
                            found
                            (Mapping.mappingModules mapping)

                    else
                        found
                )
                Dict.empty
                (MappingRegistry.packagesInOrder context.registry)

        collision =
            context.source.exposedModules
                |> Array.map ModuleName.toGren
                |> Array.mapAndKeepJust
                    (\name ->
                        Dict.get name providedModules
                            |> Maybe.map (\owner -> { name = name, owner = owner })
                    )
                |> Array.first
    in
    when collision is
        Nothing ->
            Ok {}

        Just { name = moduleName, owner = owner } ->
            Err
                (PortError.create "AMBIGUOUS_MODULE_NAME"
                    (platformModuleMessage context.identity moduleName owner)
                )


platformModuleMessage : Identity -> String -> String -> String
platformModuleMessage self moduleName grenPackage =
    "Package "
        ++ self.elmName
        ++ " exposes the module `"
        ++ moduleName
        ++ "`, but the Gren package "
        ++ grenPackage
        ++ " already provides that name and is in this package's dependency "
        ++ "graph. Gren forbids two packages in one graph from exposing the "
        ++ "same module name, even when no module imports both. "
        ++ "This is a language-level difference, not a porting bug: "
        ++ self.elmName
        ++ " is an alternative implementation of a module Gren ships in its "
        ++ "platform packages, so the two cannot coexist. "
        ++ "Automatic rename is refused for the same reasons as any other "
        ++ "same-name collision — it would change a public API and is not a "
        ++ "pure function of the module name alone. "
        ++ "What you can do: use the Gren module directly instead of porting "
        ++ "this package, since it provides the same interface; or fork the "
        ++ "Elm package, rename the colliding modules there, and port the fork."
