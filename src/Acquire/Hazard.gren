module Acquire.Hazard exposing ( Hazard(..), detect, errorToString )

{-| Early detection for Elm constructs that **cannot** be ported as ordinary
Gren source. These hard-refuse acquisition:

- `Elm.Kernel` / native kernel imports
- `effect module` (runtime managers)
- GLSL shader blocks

**Not** a hazard: `port module` / `port` declarations. Those are kept for
application interop (syntax only; no JS kernel is generated). Protected
regions (comments/strings) are skipped; real `[glsl|…|]` blocks are not.
-}

import Array exposing ( Array )
import System.Text
import Transform.Scan as Scan exposing
    ( blockCommentStart
    , glslStart
    , isIdentifierStart
    , lineCommentStart
    , matchesAt
    , multilineQuote
    , scanQualifiedIdentifierEnd
    , skipBlockComment
    , skipGlsl
    , skipLineComment
    , skipMultilineString
    , skipQuoted
    )


type Hazard
    = ElmKernel
    | EffectModule
    | Glsl


type alias Scan =
    { tokens : Array String
    , glsl : Bool
    }


type alias Findings =
    { elmKernel : Bool
    , effectModule : Bool
    , glsl : Bool
    }


detect : String -> Array Hazard
detect source =
    let
        scan =
            scanFrom (System.Text.sourceCharacters source) 0 { tokens = [], glsl = False }

        findings =
            inspectTokens scan.tokens
                { elmKernel = False
                , effectModule = False
                , glsl = scan.glsl
                }
    in
    [ if findings.elmKernel then
            Just ElmKernel

        else
            Nothing
    , if findings.effectModule then
            Just EffectModule

        else
            Nothing
    , if findings.glsl then
            Just Glsl

        else
            Nothing
    ]
        |> Array.mapAndKeepJust identity


scanFrom : Array Char -> Int -> Scan -> Scan
scanFrom characters offset scan =
    when Array.get offset characters is
        Nothing ->
            scan

        Just character ->
            if matchesAt characters offset lineCommentStart then
                scanFrom characters (skipLineComment characters (offset + 2))
                    scan

            else if matchesAt characters offset blockCommentStart then
                scanFrom characters (skipBlockComment characters (offset + 2) 1)
                    scan

            else if matchesAt characters offset glslStart then
                scanFrom characters (skipGlsl characters (offset + 6))
                    { scan | glsl = True }

            else if matchesAt characters offset multilineQuote then
                scanFrom characters
                    (skipMultilineString characters (offset + 3)) scan

            else if character == '"' then
                scanFrom characters (skipQuoted characters '"' (offset + 1))
                    scan

            else if character == '\'' then
                scanFrom characters (skipQuoted characters '\'' (offset + 1))
                    scan

            else if isIdentifierStart character then
                let
                    tokenEnd =
                        scanQualifiedIdentifierEnd characters (offset + 1)

                    token =
                        characters
                            |> Array.slice offset tokenEnd
                            |> String.fromArray
                in
                scanFrom characters tokenEnd
                    { scan | tokens = Array.pushLast token scan.tokens }

            else
                scanFrom characters (offset + 1) scan


inspectTokens : Array String -> Findings -> Findings
inspectTokens tokens findings =
    when Array.popFirst tokens is
        Nothing ->
            findings

        Just { first, rest } ->
            let
                next =
                    Array.first rest

                updated =
                    { findings
                        | elmKernel =
                              findings.elmKernel
                                  || first == "Elm.Kernel"
                                  || String.startsWith "Elm.Kernel." first
                        , effectModule =
                              findings.effectModule
                                  || (first == "effect"
                                      && next == Just "module")
                    }
            in
            inspectTokens rest updated


errorToString : Hazard -> String
errorToString hazard =
    when hazard is
        ElmKernel ->
            "references Elm.Kernel, whose native Elm kernel code cannot be emitted as Gren package source"

        EffectModule ->
            "declares an Elm effect module, which is reserved for core/runtime packages"

        Glsl ->
            "contains an Elm [glsl|...|] shader block, which needs an explicit compatibility mapping"


