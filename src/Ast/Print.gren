module Ast.Print exposing ( print )

{-| Pretty-print a resolved, name-substituted AST as Gren source.

Phase 1 structural lowers:
- `case`/`of` → `when`/`is`
- unit `()` → `{}`
- N-tuples → `{ first, second, … }` records
- list cons already rewritten by NameSub to `Array.pushFirst`

**Law of multi-argument constructor payloads.** Gren gives every multi-argument
constructor ONE record payload, so N arguments must become N named fields. Whose
names, is decided by who declares the type:

  - this port declares it → this printer also emits the `type` declaration, so
    the labels are positional (`first`, `second`, …) and the two agree by
    construction;
  - a MAPPED package declares it (`Parser.Advanced.Token { str, expecting }`) →
    the port never sees that declaration and cannot invent the names; they are
    stated in `mappings/builtin.json` and arrive here as `constructorFields`.

Positional is the fallback, never a guess overruled: a mapped shape applies only
to a module-qualified reference whose resolved name is in the table AND whose
argument count equals the stated field count. Anything else prints positionally
(D12) — a bare name match never renames a payload.
-}

import Array exposing ( Array )
import Ast.ModuleName as ModuleName
import Ast.Ref as Ref
import Ast.Types as Types exposing
    ( CaseArm
    , Declaration(..)
    , Exposing(..)
    , Expr(..)
    , ExposedItem(..)
    , Field
    , File
    , Import
    , LetDecl(..)
    , ModuleDef
    , ModuleKind(..)
    , NamedRef
    , Pattern(..)
    , Signature
    , TypeAnn(..)
    )
import Char
import Dict exposing ( Dict )
import Math
import Maybe exposing ( Maybe(..) )
import System.Text


{-| What each printer needs besides the node it is printing.

`locals` are this module's own declared names (keep `Module.Name` when
shortening would clash). `constructorFields` is the mapped-constructor payload
table, indexed by every spelling that can reach a constructor FROM THIS FILE:
the qualified Gren name and, for each `import M as A`, `A.Name` too. Resolving
aliases here is the whole point — the printer sees `Advanced.Token`, never
`Parser.Advanced.Token`, and a table keyed only by real module names silently
misses every aliased import.

`aliases` are the local import qualifiers that are NOT the imported module's
own name (`import Calendar.Internal as Calendar_`). Those strings are free
identifiers, not module names: Gren accepts `_` in them (D68's `Bar_`, authors'
`Calendar_`), so `ModuleName.toGren` must never touch them. Applying the
module-name underscore rewrite to an alias collapses `Calendar_` onto
`Calendar` and produces AMBIGUOUS NAME against `import Calendar` (D82).
-}
type alias Context =
    { locals : Dict String {}
    , constructorFields : Dict String (Array String)
    , aliases : Dict String {}
    }


print : Dict String (Array String) -> File -> String
print constructorFields file =
    let
        ctx =
            { locals = localDeclaredNames file.declarations
            , constructorFields =
                Ref.addImportAliasKeys file.imports constructorFields
                    constructorFields
            , aliases = importAliasSet file.imports
            }

        -- Gren wants module docs *after* the module line (Elm often puts them
        -- before). Emit header first so the compiler never sees a doc block
        -- that looks like a free-floating comment before `module`.
        header =
            printModuleDef file.moduleDefinition

        moduleDocs =
            moduleDocumentation file.comments

        imports =
            file.imports
                |> Array.map printImport
                |> Array.keepIf (\line -> not (String.isEmpty line))
                |> String.join "\n"

        declarations =
            file.declarations
                |> Array.map (printDeclaration ctx)
                |> Array.keepIf (\block -> not (String.isEmpty block))
                |> String.join "\n\n"

        bodyParts =
            [ header
            , moduleDocs
            , imports
            , declarations
            ]
                |> Array.keepIf (\part -> not (String.isEmpty part))
    in
    String.join "\n\n" bodyParts ++ "\n"


{-| Names introduced by this module's declarations (types, aliases, values).
-}
localDeclaredNames : Array Declaration -> Dict String {}
localDeclaredNames declarations =
    Array.foldl
        (\declaration acc ->
            when declaration is
                DeclFunction fn ->
                    Dict.set fn.name {} acc

                DeclAlias aliasDecl ->
                    Dict.set aliasDecl.name {} acc

                DeclCustomType custom ->
                    let
                        withType =
                            Dict.set custom.name {} acc
                    in
                    Array.foldl (\ctor inner -> Dict.set ctor.name {} inner)
                        withType custom.constructors

                DeclPort signature ->
                    Dict.set signature.name {} acc

                DeclDestructure { pattern = pattern } ->
                    Array.foldl (\n inner -> Dict.set n {} inner) acc
                        (patternBoundNames pattern)

                DeclInfix ->
                    acc) Dict.empty declarations


patternBoundNames : Pattern -> Array String
patternBoundNames pattern =
    when pattern is
        PatVar name ->
            [ name ]

        PatAs { pattern = inner, name = name } ->
            Array.pushLast name (patternBoundNames inner)

        PatTuple items ->
            Array.foldl
                (\p acc -> Array.foldl Array.pushLast acc (patternBoundNames p))
                [] items

        PatList items ->
            Array.foldl
                (\p acc -> Array.foldl Array.pushLast acc (patternBoundNames p))
                [] items

        PatCons { head = head, tail = tail } ->
            Array.foldl Array.pushLast (patternBoundNames head)
                (patternBoundNames tail)

        PatNamed { arguments = args } ->
            Array.foldl
                (\p acc -> Array.foldl Array.pushLast acc (patternBoundNames p))
                [] args

        PatRecordBind fields ->
            Array.foldl
                (\f acc ->
                    Array.foldl Array.pushLast acc
                        (patternBoundNames f.pattern)) [] fields

        _ ->
            []


moduleDocumentation : Array String -> String
moduleDocumentation comments =
    comments
        |> Array.keepIf (\comment -> String.startsWith "{-|" comment)
        |> Array.first
        |> Maybe.withDefault ""


printModuleDef : ModuleDef -> String
printModuleDef moduleDef =
    let
        keyword =
            when moduleDef.kind is
                NormalModule ->
                    "module"

                PortModule ->
                    "port module"

                EffectModule ->
                    "effect module"

        exposingPart =
            printExposing moduleDef.exposing_
    in
    keyword ++ " " ++ ModuleName.toGren moduleDef.moduleName ++ " exposing " ++ exposingPart


{-| Local import aliases that differ from the module they stand for.

**Law (D82):** an alias is a free identifier chosen for this file, not a
module name. `ModuleName.toGren` rewrites *module* names Gren cannot parse
(`Extended_Pictographic` → `ExtendedPictographic`); it is illegal on aliases,
where a trailing `_` is load-bearing (`Calendar_`, D68's occupancy escape
`Bar_`). Gren accepts `_` in import aliases (probed 0.6.6).
-}
importAliasSet : Array Import -> Dict String {}
importAliasSet imports =
    Array.foldl
        (\import_ acc ->
            when import_.alias is
                Just aliasName ->
                    if aliasName == import_.moduleName then
                        acc

                    else
                        Dict.set aliasName {} acc

                Nothing ->
                    acc
        )
        Dict.empty
        imports


{-| Qualifier spelling for a reference.

Module names (and unaliased imports, whose qualifier IS the module name) go
through `ModuleName.toGren`. Import aliases print as written — see
`importAliasSet`.
-}
printQualifier : Context -> String -> String
printQualifier ctx moduleName =
    if Dict.member moduleName ctx.aliases then
        moduleName

    else
        ModuleName.toGren moduleName


printImport : Import -> String
printImport import_ =
    let
        aliasPart =
            when import_.alias is
                Just aliasName ->
                    -- Alias is a local identifier, never a module name (D82).
                    " as " ++ aliasName

                Nothing ->
                    ""

        exposingPart =
            when import_.exposing_ is
                Nothing ->
                    ""

                Just ExposeAll ->
                    " exposing (..)"

                Just (ExposeExplicit items) ->
                    if Array.isEmpty items then
                        ""

                    else
                        " exposing ("
                            ++ String.join ", "
                                (Array.map printExposedItem items)
                            ++ ")"
    in
    "import " ++ ModuleName.toGren import_.moduleName ++ aliasPart ++ exposingPart


printExposing : Exposing -> String
printExposing exposing_ =
    when exposing_ is
        ExposeAll ->
            "(..)"

        ExposeExplicit items ->
            "(" ++ String.join ", " (Array.map printExposedItem items) ++ ")"


printExposedItem : ExposedItem -> String
printExposedItem item =
    when item is
        ExposeInfix name ->
            "(" ++ name ++ ")"

        ExposeFunction name ->
            name

        ExposeTypeOrAlias name ->
            name

        ExposeType { name = name, open = open } ->
            if open then
                name ++ "(..)"

            else
                name


printDeclaration : Context -> Declaration -> String
printDeclaration ctx declaration =
    when declaration is
        DeclFunction fn ->
            let
                docs =
                    when fn.documentation is
                        Just text ->
                            text ++ "\n"

                        Nothing ->
                            ""

                signature =
                    when fn.signature is
                        Just sig ->
                            printSignature ctx sig ++ "\n"

                        Nothing ->
                            ""

                args =
                    if Array.isEmpty fn.arguments then
                        ""

                    else
                        " "
                            ++ String.join " "
                                (Array.map (printPattern ctx 1)
                                    fn.arguments)

                body =
                    when fn.expression is
                        ExprList items ->
                            let
                                inline =
                                    printExpr ctx 0 fn.expression
                            in
                            if Array.length items > 1 && String.count inline > maxInlineListWidth then
                                printMultilineList ctx items

                            else
                                inline

                        _ ->
                            printExpr ctx 0 fn.expression
            in
            docs
                ++ signature
                ++ fn.name
                ++ args
                ++ " =\n    "
                ++ indentBlock 1 body

        DeclAlias aliasDecl ->
            let
                docs =
                    when aliasDecl.documentation is
                        Just text ->
                            text ++ "\n"

                        Nothing ->
                            ""

                generics =
                    if Array.isEmpty aliasDecl.generics then
                        ""

                    else
                        " " ++ String.join " " aliasDecl.generics
            in
            docs
                ++ "type alias "
                ++ aliasDecl.name
                ++ generics
                ++ " =\n    "
                ++ printType ctx 0 aliasDecl.typeAnnotation

        DeclCustomType custom ->
            let
                docs =
                    when custom.documentation is
                        Just text ->
                            text ++ "\n"

                        Nothing ->
                            ""

                generics =
                    if Array.isEmpty custom.generics then
                        ""

                    else
                        " " ++ String.join " " custom.generics

                ctors =
                    custom.constructors
                        |> Array.map (printConstructor ctx)
                        |> String.join "\n    | "
            in
            docs
                ++ "type "
                ++ custom.name
                ++ generics
                ++ "\n    = "
                ++ ctors

        DeclPort signature ->
            "port " ++ printSignature ctx signature

        DeclInfix ->
            ""

        DeclDestructure { pattern = pattern, expression = expression } ->
            printPattern ctx 1 pattern
                ++ " =\n    "
                ++ printExpr ctx 0 expression


printConstructor :
    Context
    -> { name : String, arguments : Array TypeAnn }
    -> String
printConstructor ctx ctor =
    if Array.isEmpty ctor.arguments then
        ctor.name

    else if Array.length ctor.arguments == 1 then
        when Array.first ctor.arguments is
            Just arg ->
                ctor.name ++ " " ++ printType ctx 1 arg

            Nothing ->
                ctor.name

    else
        -- Gren multi-arg constructors take a single record payload.
        ctor.name
            ++ " { "
            ++ String.join ", "
                (Array.indexedMap
                    (\index arg ->
                        fieldLabel index ++ " : " ++ printType ctx 0 arg)
                    ctor.arguments)
            ++ " }"


printSignature : Context -> Signature -> String
printSignature ctx signature =
    signature.name ++ " : " ++ printType ctx 0 signature.typeAnnotation


printType : Context -> Int -> TypeAnn -> String
printType ctx prec typeAnn =
    when typeAnn is
        TypeGeneric name ->
            name

        TypeTyped { ref = ref, arguments = args } ->
            let
                head =
                    printNamedRef ctx True ref

                rendered =
                    if Array.isEmpty args then
                        head

                    else
                        head
                            ++ " "
                            ++ String.join " "
                                (Array.map (printType ctx 1) args)
            in
            if prec > 0 && not (Array.isEmpty args) then
                "(" ++ rendered ++ ")"

            else
                rendered

        TypeUnit ->
            "{}"

        TypeTuple items ->
            printTupleType ctx items

        TypeRecord fields ->
            if Array.isEmpty fields then
                "{}"

            else
                "{ "
                    ++ String.join ", "
                        (Array.map
                            (\field ->
                                field.name
                                    ++ " : "
                                    ++ printType ctx 0 field.typeAnnotation)
                            fields)
                    ++ " }"

        TypeGenericRecord { extension = ext, fields = fields } ->
            "{ "
                ++ ext
                ++ " | "
                ++ String.join ", "
                    (Array.map
                        (\field ->
                            field.name
                                ++ " : "
                                ++ printType ctx 0 field.typeAnnotation)
                        fields)
                ++ " }"

        TypeFunction { left = left, right = right } ->
            let
                rendered =
                    printType ctx 1 left
                        ++ " -> "
                        ++ printType ctx 0 right
            in
            if prec > 0 then
                "(" ++ rendered ++ ")"

            else
                rendered


printTupleType : Context -> Array TypeAnn -> String
printTupleType ctx items =
    let
        labels =
            tupleFieldLabels (Array.length items)
    in
    if Array.isEmpty items then
        "{}"

    else
        "{ "
            ++ String.join ", "
                (Array.map2
                    (\label item -> label ++ " : " ++ printType ctx 0 item)
                    labels items)
            ++ " }"


printPattern : Context -> Int -> Pattern -> String
printPattern ctx prec pattern =
    when pattern is
        PatAll ->
            "_"

        PatUnit ->
            "{}"

        PatChar value ->
            "'" ++ escapeChar value ++ "'"

        PatString value ->
            "\"" ++ escapeString value ++ "\""

        PatInt value ->
            String.fromInt value

        -- Hex and decimal are the same Int in Elm/Gren. Emitting
        -- ("0x" ++ String.fromInt n) is a fake codec (0x61 → "0x97" → 151).
        -- Always print the Int value in decimal.
        PatHex value ->
            String.fromInt value

        PatFloat value ->
            String.fromFloat value

        PatTuple items ->
            printTuplePattern ctx items

        PatRecord fields ->
            "{ " ++ String.join ", " fields ++ " }"

        PatRecordBind fields ->
            if Array.isEmpty fields then
                "{}"

            else
                "{ "
                    ++ String.join ", "
                        (Array.map
                            (\field ->
                                field.name
                                    ++ " = "
                                    ++ printPattern ctx 0 field.pattern)
                            fields)
                    ++ " }"

        PatCons { head = head, tail = tail } ->
            printConsPattern ctx head tail

        PatList items ->
            "["
                ++ String.join ", " (Array.map (printPattern ctx 0) items)
                ++ "]"

        PatVar name ->
            name

        PatNamed { ref = ref, arguments = args } ->
            let
                head =
                    printNamedRef ctx False ref

                rendered =
                    if Array.isEmpty args then
                        head

                    else if Array.length args == 1 then
                        when Array.first args is
                            Just arg ->
                                head ++ " " ++ printPattern ctx 1 arg

                            Nothing ->
                                head

                    else
                        -- Gren multi-arg constructors take one record payload.
                        -- Print as `Ctor ({ fields })` so a line break after the
                        -- name (gren-format) stays valid application syntax:
                        -- `Node\n    ({ first = … })` parses; `Node\n{ first` does not.
                        let
                            labels =
                                ctorFieldLabels ctx ref.moduleName ref.name
                                    (Array.length args)

                            record =
                                "{ "
                                    ++ String.join ", "
                                        (Array.map2
                                            (\label arg ->
                                                label
                                                    ++ " = "
                                                    ++ printPattern ctx 0
                                                        arg) labels args)
                                    ++ " }"
                        in
                        head ++ " (" ++ record ++ ")"
            in
            -- Multi-arg ctor patterns always need parens in application position.
            if prec > 0 && not (Array.isEmpty args) then
                "(" ++ rendered ++ ")"

            else if Array.length args > 1 then
                "(" ++ rendered ++ ")"

            else
                rendered

        PatAs { pattern = inner, name = name } ->
            let
                rendered =
                    printPattern ctx 1 inner ++ " as " ++ name
            in
            if prec > 0 then
                "(" ++ rendered ++ ")"

            else
                rendered


printConsPattern : Context -> Pattern -> Pattern -> String
printConsPattern ctx head tail =
    when head is
        PatVar h ->
            when tail is
                PatVar t ->
                    "{ first = " ++ h ++ ", rest = " ++ t ++ " }"

                PatList items ->
                    if Array.isEmpty items then
                        "{ first = " ++ h ++ ", rest = [] }"

                    else
                        "_ {- unported-cons-pattern -}"

                _ ->
                    "_ {- unported-cons-pattern -}"

        _ ->
            "_ {- unported-cons-pattern -}"


printTuplePattern : Context -> Array Pattern -> String
printTuplePattern ctx items =
    let
        labels =
            tupleFieldLabels (Array.length items)
    in
    if Array.isEmpty items then
        "{}"

    else
        "{ "
            ++ String.join ", "
                (Array.map2
                    (\label item ->
                        label ++ " = " ++ printPattern ctx 0 item) labels
                    items)
            ++ " }"


printExpr : Context -> Int -> Expr -> String
printExpr ctx prec expr =
    when expr is
        ExprUnit ->
            "{}"

        ExprApplication parts ->
            when Array.popFirst parts is
                Nothing ->
                    "()"

                Just { first = first, rest = rest } ->
                    let
                        rendered =
                            when multiArgCtorApplication ctx first rest is
                                Just text ->
                                    text

                                Nothing ->
                                    if Array.isEmpty rest then
                                        printExpr ctx 1 first

                                    else
                                        printExpr ctx 1 first
                                            ++ " "
                                            ++ String.join " "
                                                (Array.map (printExpr ctx 1)
                                                    rest)
                    in
                    if prec > 0 then
                        "(" ++ rendered ++ ")"

                    else
                        rendered

        ExprBinop { operator = op, left = left, right = right } ->
            -- Block RHS (`let` / `when` / multi-line `if`) cannot start mid-line
            -- after an operator. Parenthesizing (`|| (let`) still fails UNFINISHED LET
            -- (Gren needs the block at its own column; alt-core-elm Data.List).
            -- Only special-case true block expressions: other multiline RHS (e.g.
            -- `|= (var |> andThen …)`) must keep prec-1 parens for association
            -- (edn-parser String.stringHelp).
            let
                leftText =
                    printExpr ctx 1 left

                rendered =
                    if isBlockExpr right then
                        leftText
                            ++ " "
                            ++ op
                            ++ "\n    "
                            ++ indentBlock 1 (printExpr ctx 0 right)

                    else
                        leftText
                            ++ " "
                            ++ op
                            ++ " "
                            ++ printExpr ctx 1 right
            in
            if prec > 0 then
                "(" ++ rendered ++ ")"

            else
                rendered

        ExprVar ref ->
            printNamedRef ctx False ref

        ExprIf { condition = condition, then_ = ifTrue, else_ = ifFalse } ->
            let
                rendered =
                    "if "
                        ++ printExpr ctx 0 condition
                        ++ " then\n    "
                        ++ indentBlock 1 (printExpr ctx 0 ifTrue)
                        ++ "\n\nelse\n    "
                        ++ indentBlock 1 (printExpr ctx 0 ifFalse)
            in
            if prec > 0 then
                "(" ++ rendered ++ ")"

            else
                rendered

        ExprPrefix op ->
            "(" ++ op ++ ")"

        ExprOperator op ->
            if String.isEmpty op then
                "()"

            else
                "(" ++ op ++ ")"

        ExprInt value ->
            String.fromInt value

        -- See PatHex: decimal-only. AST holds the Int value, not a spelling.
        ExprHex value ->
            String.fromInt value

        ExprFloat value ->
            String.fromFloat value

        ExprNegation inner ->
            "-" ++ printExpr ctx 1 inner

        ExprString value ->
            "\"" ++ escapeString value ++ "\""

        ExprChar value ->
            "'" ++ escapeChar value ++ "'"

        ExprTuple items ->
            printTupleExpr ctx items

        ExprLet { declarations = declarations, expression = body } ->
            let
                decls =
                    declarations
                        |> Array.map (printLetDecl ctx)
                        |> String.join "\n\n    "

                rendered =
                    "let\n    "
                        ++ decls
                        ++ "\nin\n"
                        ++ printExpr ctx 0 body
            in
            if prec > 0 then
                "(\n    " ++ indentBlock 1 rendered ++ "\n)"

            else
                rendered

        ExprCase { expression = scrutinee, cases = arms } ->
            let
                armText =
                    arms
                        |> Array.map (printCaseArm ctx)
                        |> String.join "\n\n    "

                rendered =
                    "when "
                        ++ printExpr ctx 0 scrutinee
                        ++ " is\n    "
                        ++ armText
            in
            if prec > 0 then
                "(" ++ rendered ++ ")"

            else
                rendered

        ExprLambda { arguments = arguments, expression = body } ->
            -- Block bodies (let / when / if) already contain newlines. Gren
            -- rejects `-> let` on one line (UNFINISHED LET); break after `->`
            -- the same way case arms do.
            let
                argsText =
                    String.join " "
                        (Array.map (printPattern ctx 1) arguments)

                bodyText =
                    printExpr ctx 0 body

                rendered =
                    if String.contains "\n" bodyText then
                        "\\"
                            ++ argsText
                            ++ " ->\n    "
                            ++ indentBlock 1 bodyText

                    else
                        "\\"
                            ++ argsText
                            ++ " -> "
                            ++ bodyText
            in
            if prec > 0 then
                "(" ++ rendered ++ ")"

            else
                rendered

        ExprRecord fields ->
            if Array.isEmpty fields then
                "{}"

            else
                "{ "
                    ++ String.join ", "
                        (Array.map
                            (\field ->
                                printRecordField ctx field.name field.value)
                            fields)
                    ++ " }"

        ExprList items ->
            let
                inline =
                    "["
                        ++ String.join ", " (Array.map (printEmbeddedExpr ctx) items)
                        ++ "]"
            in
            -- D99: the same width guard the declaration-body case has used all
            -- along, extended to a list ANYWHERE in an expression.
            -- `SiriusStarr/elm-password-strength` writes its 30,000-entry
            -- frequency table as `Dict.fromList [ ... ]` — an application, not
            -- a bare list — so the body rule never saw it and the printer
            -- emitted one line of 1,195,944 characters. Gren's parser tracks
            -- columns in 16 bits: it saturates at 65,535 and loses its place,
            -- reporting UNFINISHED RECORD against a record that is perfectly
            -- well formed. A printer must not emit lines the compiler cannot
            -- address.
            if Array.length items > 1 && String.count inline > maxInlineListWidth then
                printMultilineList ctx items

            else
                inline

        ExprAccess { record = record, field = field } ->
            printExpr ctx 1 record ++ "." ++ field

        ExprAccessFunction field ->
            "." ++ field

        ExprUpdate { name = name, fields = fields } ->
            "{ "
                ++ name
                ++ " | "
                ++ String.join ", "
                    (Array.map
                        (\field ->
                            printRecordField ctx field.name field.value)
                        fields)
                ++ " }"

        ExprGlsl code ->
            "[glsl| " ++ code ++ " |]"


printTupleExpr : Context -> Array Expr -> String
printTupleExpr ctx items =
    let
        labels =
            tupleFieldLabels (Array.length items)
    in
    if Array.isEmpty items then
        "{}"

    else
        "{ "
            ++ String.join ", "
                (Array.map2
                    (\label item -> label ++ " = " ++ printExpr ctx 0 item)
                    labels items)
            ++ " }"


printCaseArm : Context -> CaseArm -> String
printCaseArm ctx arm =
    printPattern ctx 0 arm.pattern
        ++ " ->\n        "
        ++ indentBlock 2 (printExpr ctx 0 arm.body)


printLetDecl : Context -> LetDecl -> String
printLetDecl ctx declaration =
    when declaration is
        LetFunction fn ->
            let
                -- D72: let-level type annotation. ExprLet joins decls with
                -- `"let\n    "` / `"\n\n    "` so only the FIRST line of each
                -- decl inherits the let-column indent; later lines must carry
                -- the same 4-space base themselves. Signature + binder share
                -- that column (Gren requires equal indent); body stays at +8.
                signature =
                    when fn.signature is
                        Just sig ->
                            printSignature ctx sig ++ "\n    "

                        Nothing ->
                            ""

                args =
                    if Array.isEmpty fn.arguments then
                        ""

                    else
                        " "
                            ++ String.join " "
                                (Array.map (printPattern ctx 1) fn.arguments)
            in
            signature
                ++ fn.name
                ++ args
                ++ " =\n        "
                ++ indentBlock 2 (printExpr ctx 0 fn.expression)

        LetDestructure { pattern = pattern, expression = expression } ->
            -- Constructor / record / tuple patterns must be parenthesized on the
            -- left of `=`; bare `RD first =` is parsed as a function definition.
            printPattern ctx 1 pattern
                ++ " =\n        "
                ++ indentBlock 2 (printExpr ctx 0 expression)


{-| Uppercase head applied to 2+ args → Gren multi-arg ctor record form.
Mapped-package ctors keep the target's own payload fields (see ctorFieldLabels).
-}
multiArgCtorApplication : Context -> Expr -> Array Expr -> Maybe String
multiArgCtorApplication ctx head args =
    if Array.length args < 2 then
        Nothing

    else
        when head is
            ExprVar ref ->
                if startsUpper ref.name then
                    let
                        labels =
                            ctorFieldLabels ctx ref.moduleName ref.name
                                (Array.length args)

                        record =
                            "{ "
                                ++ String.join ", "
                                    (Array.map2
                                        (\label arg ->
                                            label
                                                ++ " = "
                                                ++ printEmbeddedExpr ctx arg)
                                        labels args)
                                ++ " }"
                    in
                    -- `Ctor ({ fields })` — format-safe if the name wraps alone.
                    Just
                        (printNamedRef ctx False ref
                            ++ " ("
                            ++ record
                            ++ ")")

                else
                    Nothing

            _ ->
                Nothing


printNamedRef : Context -> Bool -> NamedRef -> String
printNamedRef ctx isType ref =
    when ref.moduleName is
        Nothing ->
            ref.name

        Just moduleName ->
            let
                short =
                    ref.name

                -- Qualifier may be a local import alias (`Calendar_`) or a real
                -- module name (`Calendar.Internal` / `Extended_Pictographic`).
                -- Only the latter is rewritten by ModuleName.toGren (D82 / D72).
                long =
                    printQualifier ctx moduleName ++ "." ++ ref.name

                sameModuleType =
                    moduleName == ref.name
                        || String.endsWith ("." ++ ref.name) moduleName

                -- Local declaration shadows the short name (e.g. this file defines `Dict`).
                clashes =
                    Dict.member short ctx.locals
            in
            if isType then
                if sameModuleType then
                    -- Prefer `Dict.Dict` over bare `Dict`: `import Dict` does not
                    -- expose the type, and bare `Dict` also collides with local types.
                    if isDefaultTypeModule moduleName && not clashes then
                        short

                    else
                        long

                else
                    long

            else if isDefaultCtor moduleName ref.name then
                -- `Basics.False` must stay qualified when this module defines
                -- its own `False` ctor (postgrest Value, etc.).
                if clashes then
                    long

                else
                    short

            else if clashes && sameModuleType then
                long

            else
                long


{-| Types commonly written unqualified after `import X exposing (..)` / defaults.
-}
isDefaultTypeModule : String -> Bool
isDefaultTypeModule moduleName =
    Array.member moduleName
        [ "Maybe"
        , "Result"
        , "Order"
        , "Basics"
        , "Cmd"
        , "Sub"
        ]


isDefaultCtor : String -> String -> Bool
isDefaultCtor moduleName name =
    startsUpper name
        && Array.member moduleName
            [ "Maybe"
            , "Result"
            , "Order"
            , "Basics"
            , "Cmd"
            , "Sub"
            ]


startsUpper : String -> Bool
startsUpper =
    System.Text.startsUpper


tupleFieldLabels : Int -> Array String
tupleFieldLabels count =
    Array.initialize count 0 fieldLabel


{-| Field names for a multi-arg ctor record payload.

Positional `first`/`second`/… unless the reference resolves, module qualifier
and all, to a constructor a MAPPED package declares — see this module's header.
The stated field count must equal the argument count: a same-named constructor
of a different arity is a different constructor, and mislabelling it would be
silent wrong output rather than a compile error.

An unqualified reference is never looked up. It is either local to this file or
restored by `Ast.BareResolve`, and a local ctor that happens to share a mapped
name (a local `BadPayload` in an Http shim) must stay positional — this printer
emits its type declaration too, and the two have to agree.
-}
ctorFieldLabels : Context -> Maybe String -> String -> Int -> Array String
ctorFieldLabels ctx moduleName name arity =
    when moduleName is
        Nothing ->
            tupleFieldLabels arity

        Just qualifier ->
            when Dict.get (qualifier ++ "." ++ name) ctx.constructorFields is
                Just fields ->
                    if Array.length fields == arity then
                        fields

                    else
                        tupleFieldLabels arity

                Nothing ->
                    tupleFieldLabels arity


fieldLabel : Int -> String
fieldLabel index =
    when index is
        0 ->
            "first"

        1 ->
            "second"

        2 ->
            "third"

        3 ->
            "fourth"

        4 ->
            "fifth"

        5 ->
            "sixth"

        6 ->
            "seventh"

        7 ->
            "eighth"

        8 ->
            "ninth"

        _ ->
            "field" ++ String.fromInt (index + 1)


indentBlock : Int -> String -> String
indentBlock levels text =
    let
        pad =
            String.repeat (levels * 4) " "
    in
    text
        |> String.split "\n"
        |> Array.indexedMap
            (\index line ->
                if index == 0 then
                    line

                else if String.isEmpty line then
                    line

                else
                    pad ++ line)
        |> String.join "\n"


{-| Record / update field layout.

Block expressions (`let` / `when` / multi-line `if`) cannot start mid-line after
`field =` — Gren reports UNFINISHED LET even when parenthesized, because the
absolute indents inside the let no longer line up under the `let` keyword.

Break after `=` and indent the value so the block owns its own column:
`{ class =\n        let … in … }`.
-}
printRecordField : Context -> String -> Expr -> String
printRecordField ctx name value =
    name ++ " = " ++ printEmbeddedExpr ctx value


{-| True for expressions whose printed form is a multi-line block that cannot
start mid-line after `=` / operators without breaking layout.
-}
isBlockExpr : Expr -> Bool
isBlockExpr expr =
    when expr is
        ExprLet _ ->
            True

        ExprCase _ ->
            True

        ExprIf _ ->
            True

        _ ->
            False


{-| Embed an expression in a mid-line context (record field, list element).
Multi-line values move to the next line and are indented one level.
-}
printEmbeddedExpr : Context -> Expr -> String
printEmbeddedExpr ctx value =
    let
        rendered =
            printExpr ctx 0 value
    in
    if String.contains "\n" rendered then
        "\n        " ++ indentBlock 2 rendered

    else
        rendered


{-| Gren 0.6.6's parser rejects a record/list literal once a single physical line
accumulates too many record fields (empirically a few thousand): it aborts with
`UNFINISHED RECORD` pointing at the outermost record. The embedded-docs specimens
(e.g. elm/core's ElmCore) render the whole `[ { .. }, { .. }, .. ]` module table
inline, blowing past that ceiling.

Records must still stay single-line (a raw newline INSIDE record braces is a
separate UNFINISHED RECORD), so the safe relief is to break the OUTER list only:
each element (one module record) keeps its interior inline but lands on its own
physical line. This width guards the decision; it sits far below the parser's
breaking point yet above any ordinary top-level list, so normal output is
unchanged and only oversized doc tables wrap.
-}
maxInlineListWidth : Int
maxInlineListWidth =
    4000


{-| Comma-leading multi-line list. Elements render inline (single-line records),
so only the list-level separators are newlines. Valid Gren, and each element line
stays under the single-line parser ceiling. Continuation lines are aligned by the
caller's `indentBlock`.
-}
printMultilineList : Context -> Array Expr -> String
printMultilineList ctx items =
    "[ "
        ++ String.join "\n, " (Array.map (printEmbeddedExpr ctx) items)
        ++ "\n]"


escapeString : String -> String
escapeString value =
    value
        |> String.split ""
        |> Array.map escapeCharForString
        |> String.join ""


escapeCharForString : String -> String
escapeCharForString ch =
    when ch is
        "\\" ->
            "\\\\"

        "\"" ->
            "\\\""

        "\n" ->
            "\\n"

        "\t" ->
            "\\t"

        "\r" ->
            "\\r"

        _ ->
            when String.popFirst ch is
                Just { first = charVal } ->
                    let
                        code = Char.toCode charVal
                    in
                    if code < 32 || code == 127 then
                        "\\u{" ++ String.padLeft 4 '0' (intToHex code) ++ "}"

                    else
                        ch

                Nothing ->
                    ch


escapeChar : String -> String
escapeChar value =
    when value is
        "\\" ->
            "\\\\"

        "'" ->
            "\\'"

        "\n" ->
            "\\n"

        "\t" ->
            "\\t"

        "\r" ->
            "\\r"

        _ ->
            when String.popFirst value is
                Just { first = charVal } ->
                    let
                        code = Char.toCode charVal
                    in
                    if code < 32 || code == 127 then
                        "\\u{" ++ String.padLeft 4 '0' (intToHex code) ++ "}"

                    else
                        value

                Nothing ->
                    value


intToHex : Int -> String
intToHex n =
    if n < 16 then
        toHexDigit n

    else
        intToHex (n // 16) ++ toHexDigit (Math.modBy 16 n)


toHexDigit : Int -> String
toHexDigit d =
    if d < 10 then
        String.fromInt d

    else
        when d is
            10 ->
                "A"

            11 ->
                "B"

            12 ->
                "C"

            13 ->
                "D"

            14 ->
                "E"

            15 ->
                "F"

            _ ->
                "?"
