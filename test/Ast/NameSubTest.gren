module Ast.NameSubTest exposing (tests)

{-| Regression: `Ast.NameSub`'s bare-remap rewrite (`collectBareRemaps` /
`rewriteBareRemaps`) is a second, independent bare-name qualifier — sibling to
`Ast.BareResolve`'s D23 repair — and used to have NO scope tracking at all, so
it blindly requalified locally-bound shadows of an exposed import name.

Concretely: `import Html.Attributes exposing (classList)` where
`withClassList classList (DialogState state) = DialogState { state |
classList = classList }` had its own `classList` PARAMETER rewritten to the
`ElmToGren.Compat.Html.Attributes.classList` adapter target — a function
value substituted where a bare array was expected, a TYPE MISMATCH. NameSub
must respect the same scope law `Ast.BareResolve` does (shared via
`Ast.Scope`): a local binding always wins over an import.

Also D68 (unique qualifiers): Elm lets several imports share one qualifier
(`import Array` + `import Array.Extra as Array` + `import ArrayExtra as
Array`) and picks the module that actually exposes each name; Gren calls that
AMBIGUOUS NAME. Since every ref carries its resolved home module,
`qualifyByImports` hands each import a qualifier nobody else holds and prints
each ref under its own home module's qualifier.
-}

import Array exposing (Array)
import Ast.NameSub as NameSub
import Ast.Print as Print
import Ast.Types as T exposing (Expr(..), LetDecl(..), Pattern(..))
import Dict
import Mapping.Types exposing (Registry)


type alias TestResult =
    { name : String
    , passed : Bool
    , details : String
    }


{-| Minimal registry: `Html.Attributes`' `classList` remaps to the
multi-segment Compat adapter target — the exact shape `collectBareRemaps`
looks for (a bare exposed name whose catalog target contains a ".").
-}
htmlAttributesRegistry : Registry
htmlAttributesRegistry =
    { packageOrder = []
    , packages = Dict.empty
    , versionedPackages = []
    , modules =
        Dict.singleton "Html.Attributes"
            { source = "Html.Attributes"
            , target = "Html.Attributes"
            , values = Dict.singleton "classList" "ElmToGren.Compat.Html.Attributes.classList"
            , types = Dict.empty
            , recordAliases = Dict.empty
            }
    }


htmlAttributesImport : T.Import
htmlAttributesImport =
    { moduleName = "Html.Attributes"
    , alias = Just "Attrs"
    , exposing_ = Just (T.ExposeExplicit [ T.ExposeFunction "classList" ])
    }


fileWith : Array T.Declaration -> T.File
fileWith declarations =
    { schemaVersion = 1
    , moduleDefinition =
        { kind = T.NormalModule
        , moduleName = "Repro"
        , exposing_ = T.ExposeAll
        }
    , comments = []
    , imports = [ htmlAttributesImport ]
    , declarations = declarations
    }


bare : String -> Expr
bare name =
    ExprVar { moduleName = Nothing, name = name }


qualified : String -> String -> Expr
qualified moduleName name =
    ExprVar { moduleName = Just moduleName, name = name }


expressionOfNamed : String -> T.File -> Maybe Expr
expressionOfNamed name file =
    file.declarations
        |> Array.keepIf
            (\declaration ->
                when declaration is
                    T.DeclFunction function ->
                        function.name == name

                    _ ->
                        False
            )
        |> Array.first
        |> Maybe.andThen
            (\declaration ->
                when declaration is
                    T.DeclFunction function ->
                        Just function.expression

                    _ ->
                        Nothing
            )


{-| The exact `withClassList` shape: a function parameter shadowing the
`classList` exposed from `Html.Attributes`, used bare in a record update.
-}
withClassListDecl : T.Declaration
withClassListDecl =
    T.DeclFunction
        { name = "withClassList"
        , documentation = Nothing
        , signature = Nothing
        , arguments =
            [ PatVar "classList"
            , PatNamed
                { ref = { moduleName = Nothing, name = "DialogState" }
                , arguments = [ PatVar "state" ]
                }
            ]
        , expression =
            ExprApplication
                [ bare "DialogState"
                , ExprUpdate
                    { name = "state"
                    , fields = [ { name = "classList", value = bare "classList" } ]
                    }
                ]
        }


{-| A genuinely-unbound bare `classList` — no local binding shadows it, so it
must resolve to the adapter target.
-}
unboundUseDecl : T.Declaration
unboundUseDecl =
    T.DeclFunction
        { name = "unboundUse"
        , documentation = Nothing
        , signature = Nothing
        , arguments = []
        , expression = bare "classList"
        }


{-| A let-bound `classList` shadowing the import inside its own function. -}
letShadowDecl : T.Declaration
letShadowDecl =
    T.DeclFunction
        { name = "letShadow"
        , documentation = Nothing
        , signature = Nothing
        , arguments = []
        , expression =
            ExprLet
                { declarations =
                    [ LetFunction { name = "classList", arguments = [], expression = ExprList [] }
                    , LetFunction { name = "keptLocal", arguments = [], expression = bare "classList" }
                    ]
                , expression = bare "keptLocal"
                }
        }


{-| A sibling top-level function with no local binding at all — must still be
remapped, proving the fix is scoped per-declaration, not disabled module-wide.
-}
siblingUnboundDecl : T.Declaration
siblingUnboundDecl =
    T.DeclFunction
        { name = "siblingUnbound"
        , documentation = Nothing
        , signature = Nothing
        , arguments = []
        , expression = bare "classList"
        }


tests : Array TestResult
tests =
    [ paramShadowStaysLocal
    , unboundBareIsRemapped
    , letBoundStaysLocalSiblingRemapped
    , collidingAliasFallsBackToOwnModule
    , fourWayCollisionGetsFourQualifiers
    , freeAliasesAreLeftAlone
    , exhaustedCollisionTakesOccupancyEscape
    , siblingModuleKeepsItsOwnAlias
    ]


-- D68: UNIQUE IMPORT QUALIFIERS -----------------------------------------------


emptyRegistry : Registry
emptyRegistry =
    { packageOrder = []
    , packages = Dict.empty
    , versionedPackages = []
    , modules = Dict.empty
    }


importOf : String -> Maybe String -> T.Import
importOf moduleName alias =
    { moduleName = moduleName, alias = alias, exposing_ = Nothing }


{-| A module named `Repro` whose single declaration `use` applies every ref in
`refs`, so both the import list and the resolved refs can be inspected after
`NameSub.apply`.
-}
moduleUsing : Array T.Import -> Array Expr -> T.File
moduleUsing imports refs =
    { schemaVersion = 1
    , moduleDefinition =
        { kind = T.NormalModule
        , moduleName = "Repro"
        , exposing_ = T.ExposeAll
        }
    , comments = []
    , imports = imports
    , declarations =
        [ T.DeclFunction
            { name = "use"
            , documentation = Nothing
            , signature = Nothing
            , arguments = []
            , expression = ExprApplication refs
            }
        ]
    }


{-| `moduleName` → printed qualifier, for every import of the file. -}
qualifiersOf : T.File -> Array { moduleName : String, qualifier : String }
qualifiersOf file =
    Array.map
        (\import_ ->
            { moduleName = import_.moduleName
            , qualifier = Maybe.withDefault import_.moduleName import_.alias
            }
        )
        file.imports


refsOf : T.File -> Array Expr
refsOf file =
    file.declarations
        |> Array.first
        |> Maybe.map
            (\declaration ->
                when declaration is
                    T.DeclFunction function ->
                        when function.expression is
                            ExprApplication parts ->
                                parts

                            _ ->
                                []

                    _ ->
                        []
            )
        |> Maybe.withDefault []


{-| The `maca/elm-rose-tree` shape: `Array.update` was emitted for both the
`Array` and the `Array.Extra as Array` import, and gren rejected the file with
AMBIGUOUS NAME. The alias must give way, leaving `Array.Extra.update`.
-}
collidingAliasFallsBackToOwnModule : TestResult
collidingAliasFallsBackToOwnModule =
    let
        result =
            NameSub.apply emptyRegistry
                (moduleUsing
                    [ importOf "Array" Nothing
                    , importOf "Array.Extra" (Just "Array")
                    ]
                    [ qualified "Array" "get", qualified "Array.Extra" "update" ]
                )

        printed =
            Print.print result
    in
    { name = "rose-tree: `import Array.Extra as Array` drops its alias next to `import Array`"
    , passed =
        qualifiersOf result
            == [ { moduleName = "Array", qualifier = "Array" }
               , { moduleName = "Array.Extra", qualifier = "Array.Extra" }
               ]
            && refsOf result
            == [ qualified "Array" "get", qualified "Array.Extra" "update" ]
            && String.contains "import Array.Extra\n" printed
            && String.contains "Array.Extra.update" printed
    , details = "each ref carries its resolved home module, so the qualifier is ours to choose"
    }


{-| The `lue-bird/elm-typesafe-array` shape: three imports competing for
`Array` plus an unaliased `Array.Linear`. Four imports, four qualifiers.
-}
fourWayCollisionGetsFourQualifiers : TestResult
fourWayCollisionGetsFourQualifiers =
    let
        result =
            NameSub.apply emptyRegistry
                (moduleUsing
                    [ importOf "Array" Nothing
                    , importOf "Array.Extra" (Just "Array")
                    , importOf "Array.Linear" Nothing
                    , importOf "ArrayExtra" (Just "Array")
                    ]
                    [ qualified "Array" "length"
                    , qualified "Array.Extra" "reverse"
                    , qualified "Array.Linear" "element"
                    , qualified "ArrayExtra" "allOk"
                    ]
                )

        qualifiers =
            Array.map .qualifier (qualifiersOf result)
    in
    { name = "typesafe-array: four imports sharing `Array` end up with four distinct qualifiers"
    , passed =
        qualifiers == [ "Array", "Array.Extra", "Array.Linear", "ArrayExtra" ]
            && refsOf result
            == [ qualified "Array" "length"
               , qualified "Array.Extra" "reverse"
               , qualified "Array.Linear" "element"
               , qualified "ArrayExtra" "allOk"
               ]
    , details = "unaliased imports anchor their module name; colliding aliases fall back to theirs"
    }


{-| An alias nobody else wants is untouched — the pass must not requalify the
whole world just because one file happens to collide.
-}
freeAliasesAreLeftAlone : TestResult
freeAliasesAreLeftAlone =
    let
        result =
            NameSub.apply emptyRegistry
                (moduleUsing
                    [ importOf "Json.Decode" (Just "Decode")
                    , importOf "Json.Encode" (Just "Encode")
                    ]
                    [ qualified "Json.Decode" "field" ]
                )
    in
    { name = "non-colliding aliases survive untouched"
    , passed =
        qualifiersOf result
            == [ { moduleName = "Json.Decode", qualifier = "Decode" }
               , { moduleName = "Json.Encode", qualifier = "Encode" }
               ]
            && refsOf result
            == [ qualified "Decode" "field" ]
    , details = "`import Json.Decode as Decode` still forbids `Json.Decode.field` in Gren"
    }


{-| Aliases naming each other's modules: `Zed as Bar` finds both its alias and
its own module name taken, so it takes `Ast.Reserved.pickFree`'s escape — the
host's single free-name scheme, not a second one.
-}
exhaustedCollisionTakesOccupancyEscape : TestResult
exhaustedCollisionTakesOccupancyEscape =
    let
        result =
            NameSub.apply emptyRegistry
                (moduleUsing
                    [ importOf "Q" (Just "Zed")
                    , importOf "Foo" (Just "Bar")
                    , importOf "Zed" (Just "Bar")
                    ]
                    [ qualified "Zed" "value" ]
                )
    in
    { name = "alias and own module both taken: falls through to the occupancy escape"
    , passed =
        Array.map .qualifier (qualifiersOf result) == [ "Zed", "Bar", "Bar_" ]
            && refsOf result == [ qualified "Bar_" "value" ]
    , details = "`Ast.Reserved.pickFree` mints the name; qualifiers stay pairwise distinct"
    }


{-| The multi-module dimension: a sibling module importing the same modules
without a collision keeps its own alias. Qualifier choice is per-file, and the
refs (which carry home modules, not qualifiers) stay portable between them.
-}
siblingModuleKeepsItsOwnAlias : TestResult
siblingModuleKeepsItsOwnAlias =
    let
        colliding =
            NameSub.apply emptyRegistry
                (moduleUsing
                    [ importOf "Array" Nothing
                    , importOf "Array.Extra" (Just "Array")
                    ]
                    [ qualified "Array.Extra" "reverse" ]
                )

        sibling =
            NameSub.apply emptyRegistry
                (moduleUsing
                    [ importOf "Array.Extra" (Just "Arr") ]
                    [ qualified "Array.Extra" "reverse" ]
                )
    in
    { name = "a sibling module without the collision keeps `Array.Extra as Arr`"
    , passed =
        Array.map .qualifier (qualifiersOf colliding) == [ "Array", "Array.Extra" ]
            && refsOf colliding == [ qualified "Array.Extra" "reverse" ]
            && Array.map .qualifier (qualifiersOf sibling) == [ "Arr" ]
            && refsOf sibling == [ qualified "Arr" "reverse" ]
    , details = "the rename is a local print choice; no cross-module rename to desync (cf. D18)"
    }


paramShadowStaysLocal : TestResult
paramShadowStaysLocal =
    let
        result =
            NameSub.apply htmlAttributesRegistry (fileWith [ withClassListDecl ])
                |> expressionOfNamed "withClassList"

        stillLocal =
            when result is
                Just (ExprApplication parts) ->
                    Array.get 1 parts
                        == Just
                            (ExprUpdate
                                { name = "state"
                                , fields = [ { name = "classList", value = bare "classList" } ]
                                }
                            )

                _ ->
                    False
    in
    { name = "withClassList: param-bound `classList` stays local in the record-update RHS"
    , passed = stillLocal
    , details = "DialogState { state | classList = classList } must not requalify the parameter"
    }


unboundBareIsRemapped : TestResult
unboundBareIsRemapped =
    let
        result =
            NameSub.apply htmlAttributesRegistry (fileWith [ unboundUseDecl ])
                |> expressionOfNamed "unboundUse"
    in
    { name = "a genuinely-unbound bare `classList` is remapped to the adapter"
    , passed = result == Just (qualified "ElmToGren.Compat.Html.Attributes" "classList")
    , details = "no local binding shadows it; the catalog's multi-segment remap applies"
    }


letBoundStaysLocalSiblingRemapped : TestResult
letBoundStaysLocalSiblingRemapped =
    let
        transformed =
            NameSub.apply htmlAttributesRegistry (fileWith [ letShadowDecl, siblingUnboundDecl ])

        letBody =
            expressionOfNamed "letShadow" transformed

        siblingBody =
            expressionOfNamed "siblingUnbound" transformed

        letStillLocal =
            when letBody is
                Just (ExprLet letBlock) ->
                    Array.get 1 letBlock.declarations
                        == Just (LetFunction { name = "keptLocal", arguments = [], expression = bare "classList" })

                _ ->
                    False

        siblingRemapped =
            siblingBody == Just (qualified "ElmToGren.Compat.Html.Attributes" "classList")
    in
    { name = "let-bound `classList` stays local while a sibling unbound use is remapped"
    , passed = letStillLocal && siblingRemapped
    , details = "scope is per-declaration: one function's let binding doesn't leak into another's"
    }
