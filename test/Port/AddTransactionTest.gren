module Port.AddTransactionTest exposing (tests)

{-| Hermetic filesystem checks for the `add` publication boundary.
-}

import FileSystem
import FileSystem.Path as Path exposing (Path)
import Port.AddTransaction as AddTransaction
import Port.Error as PortError exposing (Error)
import System.File
import Task exposing (Task)


type alias TestResult =
    { name : String
    , passed : Bool
    , details : String
    }


tests : FileSystem.Permission -> Task Never (Array TestResult)
tests permission =
    FileSystem.makeTempDirectory permission "elm-to-gren-add-transaction-test-"
        |> Task.mapError fileError
        |> Task.andThen
            (\temporary ->
                scenario permission temporary
                    |> Task.map
                        (\_ ->
                            outcome
                                "add preserves prior packages and rolls back a failed host validation"
                                True
                                ""
                        )
                    |> Task.onError
                        (\error ->
                            Task.succeed <|
                                outcome
                                    "add preserves prior packages and rolls back a failed host validation"
                                    False
                                    (PortError.toString error)
                        )
                    |> Task.andThen
                        (\check ->
                            FileSystem.remove permission { recursive = True } temporary
                                |> Task.map (\_ -> [ check ])
                                |> Task.onError (\_ -> Task.succeed [ check ])
                        )
            )
        |> Task.onError
            (\error ->
                Task.succeed
                    [ outcome
                        "add preserves prior packages and rolls back a failed host validation"
                        False
                        (PortError.toString error)
                    ]
            )


scenario : FileSystem.Permission -> Path -> Task Error {}
scenario permission temporary =
    let
        application =
            inDirectory "application" temporary

        packages =
            inDirectory ".elm-to-gren/packages" application

        manifest =
            inDirectory "gren.json" application

        firstStaging =
            inDirectory ".packages-first-staging" application

        rejectedStaging =
            inDirectory ".packages-rejected-staging" application

        originalManifest =
            "{\"type\":\"application\",\"revision\":1}\n"

        acceptedManifest =
            "{\"type\":\"application\",\"revision\":2}\n"

        rejectedManifest =
            "{\"type\":\"application\",\"revision\":3}\n"

        oldPackage =
            inDirectory "old__1_0_0/src/Old.gren" packages

        newPackage =
            inDirectory "new__1_0_0/src/New.gren" packages

        rejectedPackage =
            inDirectory "rejected__1_0_0/src/Rejected.gren" packages

    in
    System.File.ensureDirectory permission firstStaging
        |> Task.andThen (\_ -> System.File.writeText permission manifest originalManifest)
        |> Task.andThen (\_ -> System.File.writeText permission oldPackage "module Old exposing (old)\n\nold = 1\n")
        |> Task.andThen
            (\_ ->
                AddTransaction.seedStaging permission packages firstStaging
            )
        |> Task.andThen
            (\_ ->
                System.File.writeText permission
                    (inDirectory "new__1_0_0/src/New.gren" firstStaging)
                    "module New exposing (new)\n\nnew = 2\n"
            )
        |> Task.andThen
            (\_ ->
                AddTransaction.commit permission
                    { destination = packages
                    , staging = firstStaging
                    , manifestPath = manifest
                    , updatedManifest = acceptedManifest
                    , validatePublished =
                        expectState permission
                            { manifest = manifest
                            , expectedManifest = acceptedManifest
                            , required = [ oldPackage, newPackage ]
                            , absent = [ rejectedPackage ]
                            }
                    }
            )
        |> Task.andThen
            (\_ ->
                expectState permission
                    { manifest = manifest
                    , expectedManifest = acceptedManifest
                    , required = [ oldPackage, newPackage ]
                    , absent = [ rejectedPackage ]
                    }
            )
        |> Task.andThen
            (\_ ->
                System.File.ensureDirectory permission rejectedStaging
            )
        |> Task.andThen
            (\_ ->
                AddTransaction.seedStaging permission packages rejectedStaging
            )
        |> Task.andThen
            (\_ ->
                System.File.writeText permission
                    (inDirectory "rejected__1_0_0/src/Rejected.gren" rejectedStaging)
                    "module Rejected exposing (rejected)\n\nrejected = 3\n"
            )
        |> Task.andThen
            (\_ ->
                expectRejected <|
                    AddTransaction.commit permission
                        { destination = packages
                        , staging = rejectedStaging
                        , manifestPath = manifest
                        , updatedManifest = rejectedManifest
                        , validatePublished =
                            expectState permission
                                { manifest = manifest
                                , expectedManifest = rejectedManifest
                                , required = [ oldPackage, newPackage, rejectedPackage ]
                                , absent = []
                                }
                                |> Task.andThen
                                    (\_ ->
                                        Task.fail <|
                                            PortError.create "EXPECTED_HOST_REJECTION"
                                                "The proposed application did not verify."
                                    )
                        }
            )
        |> Task.andThen
            (\_ ->
                expectState permission
                    { manifest = manifest
                    , expectedManifest = acceptedManifest
                    , required = [ oldPackage, newPackage ]
                    , absent = [ rejectedPackage ]
                    }
            )


expectState
    : FileSystem.Permission
    ->
        { manifest : Path
        , expectedManifest : String
        , required : Array Path
        , absent : Array Path
        }
    -> Task Error {}
expectState permission expected =
    System.File.readText permission expected.manifest
        |> Task.andThen
            (\manifest ->
                if manifest /= expected.expectedManifest then
                    failure
                        ("Expected manifest "
                            ++ expected.expectedManifest
                            ++ ", got "
                            ++ manifest
                        )

                else
                    checkPaths permission True expected.required
            )
        |> Task.andThen (\_ -> checkPaths permission False expected.absent)


checkPaths : FileSystem.Permission -> Bool -> Array Path -> Task Error {}
checkPaths permission expected paths =
    paths
        |> Array.foldl
            (\path pending ->
                pending
                    |> Task.andThen
                        (\_ ->
                            System.File.exists permission path
                                |> Task.andThen
                                    (\actual ->
                                        if actual == expected then
                                            Task.succeed {}

                                        else if expected then
                                            failure ("Expected path to exist: " ++ Path.toPosixString path)

                                        else
                                            failure ("Expected path to be absent: " ++ Path.toPosixString path)
                                    )
                        )
            )
            (Task.succeed {})


expectRejected : Task Error a -> Task Error {}
expectRejected task =
    task
        |> Task.map (\_ -> False)
        |> Task.onError (\_ -> Task.succeed True)
        |> Task.andThen
            (\rejected ->
                if rejected then
                    Task.succeed {}

                else
                    failure "A failed host validation still committed the proposed add state."
            )


fileError : FileSystem.Error -> Error
fileError error =
    PortError.create "TEST_FAILED" (FileSystem.errorToString error)


failure : String -> Task Error a
failure message =
    Task.fail (PortError.create "TEST_FAILED" message)


inDirectory : String -> Path -> Path
inDirectory relative directory =
    Path.append (Path.fromPosixString relative) directory


outcome : String -> Bool -> String -> TestResult
outcome name passed details =
    { name = name
    , passed = passed
    , details = details
    }
