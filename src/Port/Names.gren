module Port.Names exposing (targetName)

import Elm.Manifest exposing (Manifest)
import Elm.PackageName
import Mapping.Decode
import Mapping.Registry
import Mapping.Types exposing (PackageMapping(..), Registry)
import Port.Error as PortError exposing (Error)


{-| Gren package name for publish (strict).

Always runs `isValidGrenPackageName`. For planning unmapped Elm coordinates
through the graph, use permissive `Port.Plan.targetName`.
-}
targetName : Registry -> Manifest -> Result Error String
targetName registry manifest =
    let
        sourceName =
            Elm.PackageName.toString manifest.name
    in
    when Mapping.Registry.mappingFor sourceName registry is
        Just (Transpile details) ->
            requireValidGrenPackageName details.grenPackage

        Just (GrenAnalogue details) ->
            requireValidGrenPackageName details.grenPackage

        Just (Absorbed details) ->
            requireValidGrenPackageName details.grenPackage

        Nothing ->
            requireValidGrenPackageName sourceName


requireValidGrenPackageName : String -> Result Error String
requireValidGrenPackageName candidate =
    if Mapping.Decode.isValidGrenPackageName candidate then
        Ok candidate

    else
        Err <|
            PortError.create "INVALID_GREN_PACKAGE_NAME"
                ("Cannot derive a valid Gren package name from " ++ candidate ++ ".")
