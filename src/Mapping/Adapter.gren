module Mapping.Adapter exposing
    ( AdapterError(..)
    , adapterIdForTarget
    , adapterModuleForTarget
    , all
    , generate
    , generateFromRequirements
    , guarantee
    , guaranteeForModule
    , guaranteeForTarget
    , moduleName
    , normalize
    , requiredForModules
    , sourceFor
    )

import Array
import Dict exposing (Dict)
import Mapping.Adapter.Source.Array as ArraySource
import Mapping.Adapter.Source.Basics as BasicsSource
import Mapping.Adapter.Source.Browser as BrowserSource
import Mapping.Adapter.Source.BytesEncode as BytesEncodeSource
import Mapping.Adapter.Source.Char as CharSource
import Mapping.Adapter.Source.Dict as DictSource
import Mapping.Adapter.Source.Expect as ExpectSource
import Mapping.Adapter.Source.HtmlAttributes as HtmlAttributesSource
import Mapping.Adapter.Source.HtmlEvents as HtmlEventsSource
import Mapping.Adapter.Source.HtmlKeyed as HtmlKeyedSource
import Mapping.Adapter.Source.Http as HttpSource
import Mapping.Adapter.Source.JsonDecode as JsonDecodeSource
import Mapping.Adapter.Source.JsonEncode as JsonEncodeSource
import Mapping.Adapter.Source.List as ListSource
import Mapping.Adapter.Source.Markdown as MarkdownSource
import Mapping.Adapter.Source.Maybe as MaybeSource
import Mapping.Adapter.Source.Random as RandomSource
import Mapping.Adapter.Source.Result as ResultSource
import Mapping.Adapter.Source.Set as SetSource
import Mapping.Adapter.Source.String as StringSource
import Mapping.Adapter.Source.SvgKeyed as SvgKeyedSource
import Mapping.Adapter.Source.Task as TaskSource
import Mapping.Adapter.Source.Tuple as TupleSource
import Mapping.Adapter.Source.VirtualDomHandler as VirtualDomHandlerSource
import Mapping.Adapter.Source.VirtualDomKeyed as VirtualDomKeyedSource
import Mapping.Types exposing (AdapterId(..), GeneratedModule, ModuleMapping, TranslationGuarantee(..), adapterIdName, weakestGuarantee)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))


type AdapterError
    = UnknownAdapter
        { requirement : String
        , available : Array String
        }


prefix : String
prefix =
    "ElmToGren.Compat."


all : Array AdapterId
all =
    [ ArrayAdapter
    , BasicsAdapter
    , BrowserAdapter
    , BytesEncodeAdapter
    , CharAdapter
    , DictAdapter
    , ExpectAdapter
    , HtmlAttributesAdapter
    , HtmlEventsAdapter
    , HtmlKeyedAdapter
    , HttpAdapter
    , JsonDecodeAdapter
    , JsonEncodeAdapter
    , ListAdapter
    , MarkdownAdapter
    , MaybeAdapter
    , RandomAdapter
    , ResultAdapter
    , SetAdapter
    , StringAdapter
    , SvgKeyedAdapter
    , TaskAdapter
    , TupleAdapter
    , VirtualDomHandlerAdapter
    , VirtualDomKeyedAdapter
    ]


moduleName : AdapterId -> String
moduleName adapterId =
    prefix ++ adapterIdName adapterId


adapterModuleForTarget : String -> Maybe String
adapterModuleForTarget target =
    all
        |> Array.map moduleName
        |> Array.findFirst
            (\candidate ->
                target == candidate
                    || String.startsWith (candidate ++ ".") target
            )
        |> Maybe.map .value


adapterIdForTarget : String -> Maybe AdapterId
adapterIdForTarget target =
    adapterModuleForTarget target
        |> Maybe.andThen
            (\foundModule ->
                all
                    |> Array.findFirst (\adapterId -> moduleName adapterId == foundModule)
                    |> Maybe.map .value
            )


{-| Semantic guarantee for generating an adapter module as a whole.

Most adapters preserve behavior while reshaping Elm values to Gren values.
Markdown is intentionally incomplete and therefore approximate.
-}
guarantee : AdapterId -> TranslationGuarantee
guarantee adapterId =
    when adapterId is
        MarkdownAdapter ->
            Approximate

        ArrayAdapter ->
            RepresentationChange

        BasicsAdapter ->
            RepresentationChange

        BrowserAdapter ->
            RepresentationChange

        BytesEncodeAdapter ->
            RepresentationChange

        CharAdapter ->
            RepresentationChange

        DictAdapter ->
            RepresentationChange

        ExpectAdapter ->
            RepresentationChange

        HtmlAttributesAdapter ->
            RepresentationChange

        HtmlEventsAdapter ->
            RepresentationChange

        HtmlKeyedAdapter ->
            RepresentationChange

        HttpAdapter ->
            RepresentationChange

        JsonDecodeAdapter ->
            RepresentationChange

        JsonEncodeAdapter ->
            RepresentationChange

        ListAdapter ->
            RepresentationChange

        MaybeAdapter ->
            RepresentationChange

        RandomAdapter ->
            RepresentationChange

        ResultAdapter ->
            RepresentationChange

        SetAdapter ->
            RepresentationChange

        StringAdapter ->
            RepresentationChange

        SvgKeyedAdapter ->
            RepresentationChange

        TaskAdapter ->
            RepresentationChange

        TupleAdapter ->
            RepresentationChange

        VirtualDomHandlerAdapter ->
            RepresentationChange

        VirtualDomKeyedAdapter ->
            RepresentationChange


{-| Classify every mapping target. Direct Gren targets are exact; compatibility
targets inherit their adapter promise, with symbol-level overrides where an
adapter contains both preserving and approximate operations.
-}
guaranteeForTarget : String -> TranslationGuarantee
guaranteeForTarget target =
    if
        target == "ElmToGren.Compat.Char.toLocaleLower"
            || target == "ElmToGren.Compat.Char.toLocaleUpper"
    then
        Approximate

    else
        when adapterIdForTarget target is
            Just adapterId ->
                guarantee adapterId

            Nothing ->
                if String.startsWith prefix target then
                    Unsupported

                else
                    Exact


guaranteeForModule : ModuleMapping -> TranslationGuarantee
guaranteeForModule mapping =
    [ mapping.target ]
        |> Array.append (Dict.values mapping.values)
        |> Array.append (Dict.values mapping.types)
        |> Array.foldl
            (\target found ->
                weakestGuarantee found (guaranteeForTarget target)
            )
            Exact


normalize : String -> Result AdapterError AdapterId
normalize requirement =
    let
        candidate =
            when adapterModuleForTarget requirement is
                Just foundModule ->
                    String.dropFirst (String.count prefix) foundModule

                Nothing ->
                    if String.startsWith prefix requirement then
                        String.dropFirst (String.count prefix) requirement

                    else
                        requirement

        lowered =
            String.toLower candidate
    in
    when Array.findFirst (\adapterId -> String.toLower (adapterIdName adapterId) == lowered) all is
        Just adapterId ->
            Ok adapterId.value

        Nothing ->
            Err
                (UnknownAdapter
                    { requirement = requirement
                    , available = Array.map adapterIdName all
                    }
                )


requiredForModules : Array ModuleMapping -> Array AdapterId
requiredForModules modules =
    modules
        |> Array.foldl collectModuleAdapters Dict.empty
        |> Dict.values


collectModuleAdapters : ModuleMapping -> Dict String AdapterId -> Dict String AdapterId
collectModuleAdapters mapping found =
    let
        targets =
            [ mapping.target ]
                |> Array.append (Dict.values mapping.values)
                |> Array.append (Dict.values mapping.types)
    in
    Array.foldl
        (\target current ->
            when adapterIdForTarget target is
                Just adapterId ->
                    Dict.set (adapterIdName adapterId) adapterId current

                Nothing ->
                    current
        )
        found
        targets


generateFromRequirements : Array String -> Result AdapterError (Array GeneratedModule)
generateFromRequirements requirements =
    requirements
        |> Array.foldl
            (\requirement accumulated ->
                accumulated
                    |> Result.andThen
                        (\byName ->
                            normalize requirement
                                |> Result.map
                                    (\adapterId ->
                                        Dict.set (adapterIdName adapterId) adapterId byName
                                    )
                        )
            )
            (Ok Dict.empty)
        |> Result.map (Dict.values >> generate)


generate : Array AdapterId -> Array GeneratedModule
generate adapterIds =
    adapterIds
        |> Array.foldl
            (\adapterId byName -> Dict.set (adapterIdName adapterId) adapterId byName)
            Dict.empty
        |> Dict.values
        |> Array.map generateOne


generateOne : AdapterId -> GeneratedModule
generateOne adapterId =
    let
        generatedModuleName =
            moduleName adapterId
    in
    { moduleName = generatedModuleName
    , relativePath = String.replace "." "/" generatedModuleName ++ ".gren"
    , source = sourceFor adapterId
    }


sourceFor : AdapterId -> String
sourceFor adapterId =
    when adapterId is
        ArrayAdapter ->
            ArraySource.source

        BasicsAdapter ->
            BasicsSource.source

        BrowserAdapter ->
            BrowserSource.source

        BytesEncodeAdapter ->
            BytesEncodeSource.source

        CharAdapter ->
            CharSource.source

        DictAdapter ->
            DictSource.source

        ExpectAdapter ->
            ExpectSource.source

        HtmlAttributesAdapter ->
            HtmlAttributesSource.source

        HtmlEventsAdapter ->
            HtmlEventsSource.source

        HtmlKeyedAdapter ->
            HtmlKeyedSource.source

        HttpAdapter ->
            HttpSource.source

        JsonDecodeAdapter ->
            JsonDecodeSource.source

        JsonEncodeAdapter ->
            JsonEncodeSource.source

        ListAdapter ->
            ListSource.source

        MarkdownAdapter ->
            MarkdownSource.source

        MaybeAdapter ->
            MaybeSource.source

        RandomAdapter ->
            RandomSource.source

        ResultAdapter ->
            ResultSource.source

        SetAdapter ->
            SetSource.source

        StringAdapter ->
            StringSource.source

        SvgKeyedAdapter ->
            SvgKeyedSource.source

        TaskAdapter ->
            TaskSource.source

        TupleAdapter ->
            TupleSource.source

        VirtualDomHandlerAdapter ->
            VirtualDomHandlerSource.source

        VirtualDomKeyedAdapter ->
            VirtualDomKeyedSource.source
