    "grenPackage": "gren-lang/browser",
    "grenVersion": "6.0.2",
    "platform": "browser",
    "modules": [{ "source": "Http", "target": "Http" }]
  }],
  "versionedPackages": [{
    "elmVersionRange": "1.0.0 <= v < 2.0.0",
    "mapping": {
      "kind": "absorbed",
