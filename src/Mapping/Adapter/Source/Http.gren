module Mapping.Adapter.Source.Http exposing (source)

source : String
source =
    """
module ElmToGren.Compat.Http exposing
    ( Request
    , Expect
    , Error(..)
    , Response
    , get
    , post
    , request
    , send
    , toTask
    , expectString
    , expectJson
    )

{-| elm/http 1.x, expressed against gren-lang/browser.

D106: this adapter is HOISTED into a shared package rather than generated per
consumer, because `Error` is a custom type — two copies would be two unrelated
types and `krisajenkins/remotedata`'s `WebData` could not reach
`ohanhi/remotedata-http`'s `send`. A shared package exposes the module, and an
exposed module has to be documented, which is why this file carries docs where
the other adapters do not.

@docs Request, Expect, Error, Response
@docs get, post, request, send, toTask
@docs expectString, expectJson

-}

import Array exposing (Array)
import Dict exposing (Dict)
import Http
import Json.Decode as Decode
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import Task exposing (Task)


{-| elm/http 1.x error surface (Response body on BadStatus/BadPayload).
-}
type Error
    = BadUrl String
    | Timeout
    | NetworkError
    | BadStatus (Response String)
    | BadPayload { message : String, response : Response String }


{-| An elm/http 1.x response: url, status, headers, and a body of any type.
-}
type alias Response body =
    { url : String
    , status : { code : Int, message : String }
    , headers : Dict String String
    , body : body
    }


{-| How to turn a response body into a value.
-}
type Expect a
    = ExpectJson (Decode.Decoder a)


{-| A request that has been described but not yet sent.
-}
type Request a
    = Request
        { method : String
        , headers : Array Http.Header
        , url : String
        , body : Http.Body
        , expect : Expect a
        , timeout : Maybe Float
        }


{-| Expect the body to be a JSON string.
-}
expectString : Expect String
expectString =
    ExpectJson Decode.string


{-| Expect the body to decode with the given decoder.
-}
expectJson : Decode.Decoder a -> Expect a
expectJson decoder =
    ExpectJson decoder


{-| A GET request whose body decodes with the given decoder.
-}
get : String -> Decode.Decoder a -> Request a
get url decoder =
    request
        { method = "GET"
        , headers = []
        , url = url
        , body = Http.emptyBody
        , expect = expectJson decoder
        , timeout = Nothing
        , withCredentials = False
        }


{-| A POST request with a body, decoding the response.
-}
post : String -> Http.Body -> Decode.Decoder a -> Request a
post url body decoder =
    request
        { method = "POST"
        , headers = []
        , url = url
        , body = body
        , expect = expectJson decoder
        , timeout = Nothing
        , withCredentials = False
        }


{-| Build a request from a full configuration record.
-}
request :
    { method : String
    , headers : Array Http.Header
    , url : String
    , body : Http.Body
    , expect : Expect a
    , timeout : Maybe Float
    , withCredentials : Bool
    }
    -> Request a
request config =
    Request
        { method = config.method
        , headers = config.headers
        , url = config.url
        , body = config.body
        , expect = config.expect
        , timeout = config.timeout
        }


{-| Send a request, tagging the result as a message.
-}
send : (Result Error a -> msg) -> Request a -> Cmd msg
send toMsg (Request config) =
    let
        (ExpectJson decoder) =
            config.expect
    in
    Http.request
        { method = config.method
        , headers = config.headers
        , url = config.url
        , body = config.body
        , expect =
            Http.expectStringResponse toMsg (interpretResponse decoder)
        , timeout = config.timeout
        , tracker = Nothing
        }


{-| Send a request as a task rather than a command.
-}
toTask : Request a -> Task Error a
toTask (Request config) =
    let
        (ExpectJson decoder) =
            config.expect
    in
    Http.task
        { method = config.method
        , headers = config.headers
        , url = config.url
        , body = config.body
        , resolver = Http.stringResolver (interpretResponse decoder)
        , timeout = config.timeout
        }


interpretResponse : Decode.Decoder a -> Http.Response String -> Result Error a
interpretResponse decoder response =
    when response is
        Http.BadUrl_ url ->
            Err (BadUrl url)

        Http.Timeout_ ->
            Err Timeout

        Http.NetworkError_ ->
            Err NetworkError

        Http.BadStatus_ { metadata, body } ->
            Err
                (BadStatus
                    { url = metadata.url
                    , status = { code = metadata.statusCode, message = metadata.statusText }
                    , headers = metadata.headers
                    , body = body
                    }
                )

        Http.GoodStatus_ { metadata, body } ->
            when Decode.decodeString decoder body is
                Ok value ->
                    Ok value

                Err decodeError ->
                    Err
                        (BadPayload
                            { message = Decode.errorToString decodeError
                            , response =
                                { url = metadata.url
                                , status = { code = metadata.statusCode, message = metadata.statusText }
                                , headers = metadata.headers
                                , body = body
                                }
                            }
                        )
"""

