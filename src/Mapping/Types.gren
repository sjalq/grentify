module Mapping.Types exposing
    ( AdapterId(..)
    , GeneratedModule
    , MappingDocument
    , MappingError(..)
    , MappingKind(..)
    , ModuleMapping
    , PackageDetails
    , PackageMapping(..)
    , Platform(..)
    , PlatformInferenceError(..)
    , Registry
    , TranspileDetails
    , TranslationGuarantee(..)
    , VersionedPackageMapping
    , adapterIdName
    , guaranteeName
    , weakestGuarantee
    , mappingAbsentModules
    , mappingElmPackage
    , mappingGrenPackage
    , mappingKind
    , mappingModules
    , mappingPlatform
    , platformName
    )

import Dict exposing (Dict)
import Elm.Semver exposing (Range)


type Platform
    = Common
    | Browser
    | Node


platformName : Platform -> String
platformName platform =
    when platform is
        Common ->
            "common"

        Browser ->
            "browser"

        Node ->
            "node"


type MappingKind
    = GrenAnalogueKind
    | AbsorbedKind
    | TranspileKind


{-| The semantic promise made by a translation rule.

`Exact` keeps both representation and behavior. `RepresentationChange` keeps
behavior through a different Gren representation. `Approximate` intentionally
loses some source behavior and must be diagnosed. `Unsupported` has no safe
translation and must remain a hard diagnostic.
-}
type TranslationGuarantee
    = Exact
    | RepresentationChange
    | Approximate
    | Unsupported


guaranteeName : TranslationGuarantee -> String
guaranteeName guarantee =
    when guarantee is
        Exact ->
            "exact"

        RepresentationChange ->
            "representation-change"

        Approximate ->
            "approximate"

        Unsupported ->
            "unsupported"


weakestGuarantee : TranslationGuarantee -> TranslationGuarantee -> TranslationGuarantee
weakestGuarantee left right =
    if guaranteeRank left >= guaranteeRank right then
        left

    else
        right


guaranteeRank : TranslationGuarantee -> Int
guaranteeRank guarantee =
    when guarantee is
        Exact ->
            0

        RepresentationChange ->
            1

        Approximate ->
            2

        Unsupported ->
            3


{-| `recordAliases` records the field names of record type *aliases* the target
Gren module declares. Elm lets a record alias be applied positionally
(`DeadEnd row col problem`); Gren removed that form entirely, so every such use
must be lowered to a record literal with the alias' real field names.

For transpiled packages the host learns those shapes by reading the alias
declaration (`Ast.RecordAlias.collectFromFile`). Platform packages are *mapped*,
never transpiled, so no port ever sees their declarations — the shape has to be
stated here, read off the Gren package source. Keys are alias names in the
`target` module; values are field names in declaration order.
-}
type alias ModuleMapping =
    { source : String
    , target : String
    , values : Dict String String
    , types : Dict String String
    , recordAliases : Dict String (Array String)
    }


{-| `absentModules` names source modules of a MAPPED package that the Gren
analogue does not have — `Shrink` and `Test.Html.*` against gren-lang/test,
whose 5.0.0 exposes neither. A mapped package is never transpiled, so its
module set is a fact about the mapping and is held nowhere else; without it the
import survives untouched and the port only fails much later, as a Gren
`MODULE NOT FOUND` that names no package and no cause. Values are the reason,
read off the Gren package source, and are printed verbatim in the refusal.
-}
type alias PackageDetails =
    { elmPackage : String
    , grenPackage : String
    , grenVersion : String
    , platform : Platform
    , modules : Array ModuleMapping
    , absentModules : Dict String String
    }


type alias TranspileDetails =
    { elmPackage : String
    , grenPackage : String
    }


type PackageMapping
    = GrenAnalogue PackageDetails
    | Absorbed PackageDetails
    | Transpile TranspileDetails


mappingKind : PackageMapping -> MappingKind
mappingKind mapping =
    when mapping is
        GrenAnalogue _ ->
            GrenAnalogueKind

        Absorbed _ ->
            AbsorbedKind

        Transpile _ ->
            TranspileKind


mappingElmPackage : PackageMapping -> String
mappingElmPackage mapping =
    when mapping is
        GrenAnalogue details ->
            details.elmPackage

        Absorbed details ->
            details.elmPackage

        Transpile details ->
            details.elmPackage


mappingGrenPackage : PackageMapping -> String
mappingGrenPackage mapping =
    when mapping is
        GrenAnalogue details ->
            details.grenPackage

        Absorbed details ->
            details.grenPackage

        Transpile details ->
            details.grenPackage


mappingModules : PackageMapping -> Array ModuleMapping
mappingModules mapping =
    when mapping is
        GrenAnalogue details ->
            details.modules

        Absorbed details ->
            details.modules

        Transpile _ ->
            []


mappingAbsentModules : PackageMapping -> Dict String String
mappingAbsentModules mapping =
    when mapping is
        GrenAnalogue details ->
            details.absentModules

        Absorbed details ->
            details.absentModules

        Transpile _ ->
            Dict.empty


mappingPlatform : PackageMapping -> Maybe Platform
mappingPlatform mapping =
    when mapping is
        GrenAnalogue details ->
            Just details.platform

        Absorbed details ->
            Just details.platform

        Transpile _ ->
            Nothing


type alias MappingDocument =
    { schemaVersion : Int
    , packages : Array PackageMapping
    , versionedPackages : Array VersionedPackageMapping
    }


type alias VersionedPackageMapping =
    { elmVersionRange : Range
    , mapping : PackageMapping
    }


type MappingError
    = InvalidMapping
        { source : String
        , path : String
        , message : String
        }


type alias Registry =
    { packageOrder : Array String
    , packages : Dict String PackageMapping
    , modules : Dict String ModuleMapping
    , versionedPackages : Array VersionedPackageMapping
    }


type PlatformInferenceError
    = BrowserAndNode
        { browserSources : Array String
        , nodeSources : Array String
        }


type AdapterId
    = ArrayAdapter
    | BasicsAdapter
    | BrowserAdapter
    | BytesEncodeAdapter
    | CharAdapter
    | DictAdapter
    | ExpectAdapter
    | HtmlAttributesAdapter
    | HtmlEventsAdapter
    | HtmlKeyedAdapter
    | HttpAdapter
    | JsonDecodeAdapter
    | JsonEncodeAdapter
    | ListAdapter
    | MarkdownAdapter
    | MaybeAdapter
    | RandomAdapter
    | ResultAdapter
    | SetAdapter
    | StringAdapter
    | SvgKeyedAdapter
    | TaskAdapter
    | TupleAdapter
    | VirtualDomHandlerAdapter
    | VirtualDomKeyedAdapter


adapterIdName : AdapterId -> String
adapterIdName adapterId =
    when adapterId is
        ArrayAdapter ->
            "Array"

        BasicsAdapter ->
            "Basics"

        BrowserAdapter ->
            "Browser"

        BytesEncodeAdapter ->
            "Bytes.Encode"

        CharAdapter ->
            "Char"

        DictAdapter ->
            "Dict"

        ExpectAdapter ->
            "Expect"

        HtmlAttributesAdapter ->
            "Html.Attributes"

        HtmlEventsAdapter ->
            "Html.Events"

        HtmlKeyedAdapter ->
            "Html.Keyed"

        HttpAdapter ->
            "Http"

        JsonDecodeAdapter ->
            "Json.Decode"

        JsonEncodeAdapter ->
            "Json.Encode"

        ListAdapter ->
            "List"

        MarkdownAdapter ->
            "Markdown"

        MaybeAdapter ->
            "Maybe"

        RandomAdapter ->
            "Random"

        ResultAdapter ->
            "Result"

        SetAdapter ->
            "Set"

        StringAdapter ->
            "String"

        SvgKeyedAdapter ->
            "Svg.Keyed"

        TaskAdapter ->
            "Task"

        TupleAdapter ->
            "Tuple"

        VirtualDomHandlerAdapter ->
            "VirtualDom.Handler"

        VirtualDomKeyedAdapter ->
            "VirtualDom.Keyed"


type alias GeneratedModule =
    { moduleName : String
    , relativePath : String
    , source : String
    }
