module Port.Mapping exposing (Loaded, load)

{-| Local single-package path: load mappings and stamp a short fingerprint for
the lockfile. Registry loading lives in `Mapping.Load`; this module only adds
the FNV-1a fingerprint Port.Local embeds in its report.
-}

import Array exposing (Array)
import Bitwise
import Char
import FileSystem
import FileSystem.Path exposing (Path)
import Mapping.Load as MappingLoad
import Mapping.Types exposing (Registry)
import Port.Error exposing (Error)
import System.Text
import Task exposing (Task)


type alias Loaded =
    { registry : Registry
    , fingerprint : String
    }


load : FileSystem.Permission -> Path -> Array Path -> Task Error Loaded
load permission builtin overlays =
    MappingLoad.load permission builtin overlays
        |> Task.map
            (\loaded ->
                { registry = loaded.registry
                , fingerprint =
                    loaded.texts
                        |> String.join "\n"
                        |> fingerprint
                }
            )


fingerprint : String -> String
fingerprint source =
    let
        hash =
            source
                |> System.Text.sourceCharacters
                |> Array.foldl
                    (\character current ->
                        Bitwise.xor current (Char.toCode character)
                            * 16777619
                            |> Bitwise.shiftRightZfBy 0
                    )
                    2166136261
    in
    "fnv1a32:" ++ String.fromInt hash
