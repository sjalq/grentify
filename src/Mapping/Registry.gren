module Mapping.Registry exposing
    ( absentModuleFor
    , empty
    , applyVersionedMappings
    , fromDocument
    , inferPlatform
    , inferPlatformFromDependencyDicts
    , mappingFor
    , moduleMappingFor
    , overlayDocument
    , overlayDocuments
    , packagesInOrder
    , recordAliasShapes
    )

import Array
import Dict exposing (Dict)
import Elm.Semver as Semver exposing (Range)
import Mapping.Types exposing (MappingDocument, ModuleMapping, PackageMapping, Platform(..), PlatformInferenceError(..), Registry, mappingAbsentModules, mappingElmPackage, mappingGrenPackage, mappingModules, mappingPlatform, platformName)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))


empty : Registry
empty =
    { packageOrder = []
    , packages = Dict.empty
    , modules = Dict.empty
    , versionedPackages = []
    }


fromDocument : MappingDocument -> Registry
fromDocument document =
    overlayDocument document empty


overlayDocuments : Array MappingDocument -> Registry
overlayDocuments documents =
    Array.foldl overlayDocument empty documents


overlayDocument : MappingDocument -> Registry -> Registry
overlayDocument document registry =
    let
        withPackages =
            Array.foldl overlayPackage registry document.packages
    in
    { withPackages
        | versionedPackages =
            withPackages.versionedPackages ++ document.versionedPackages
    }
        |> rebuildModules


overlayPackage : PackageMapping -> Registry -> Registry
overlayPackage mapping registry =
    let
        elmPackage =
            mappingElmPackage mapping

        nextOrder =
            registry.packageOrder
                |> Array.keepIf (\existing -> existing /= elmPackage)
                |> Array.pushLast elmPackage
    in
    { registry
        | packageOrder = nextOrder
        , packages = Dict.set elmPackage mapping registry.packages
    }


rebuildModules : Registry -> Registry
rebuildModules registry =
    let
        modules =
            Array.foldl
                (\elmPackage collected ->
                    when Dict.get elmPackage registry.packages is
                        Nothing ->
                            collected

                        Just mapping ->
                            Array.foldl
                                (\module_ current -> Dict.set module_.source module_ current)
                                collected
                                (mappingModules mapping)
                )
                Dict.empty
                registry.packageOrder
    in
    { registry | modules = modules }


mappingFor : String -> Registry -> Maybe PackageMapping
mappingFor packageName registry =
    Dict.get packageName registry.packages


moduleMappingFor : String -> Registry -> Maybe ModuleMapping
moduleMappingFor moduleName registry =
    Dict.get moduleName registry.modules


{-| Apply declarative package variants whose Elm version range intersects the
resolved dependency constraint. Documents are applied in overlay order, so a
later user mapping can replace a built-in version policy.
-}
applyVersionedMappings : Dict String Range -> Registry -> Registry
applyVersionedMappings dependencyRanges registry =
    registry.versionedPackages
        |> Array.foldl
            (\versioned current ->
                when
                    Dict.get (mappingElmPackage versioned.mapping)
                        dependencyRanges
                is
                    Just dependencyRange ->
                        when
                            Semver.intersect versioned.elmVersionRange
                                dependencyRange
                        is
                            Just _ ->
                                overlayPackage versioned.mapping current

                            Nothing ->
                                current

                    Nothing ->
                        current
            )
            registry
        |> rebuildModules


{-| Every mapped record-alias shape, keyed `"TargetModule.Alias"` → field names.

Keys use the **target** module because record-alias lowering runs after name
substitution, on the Gren-named AST. These are hints only: a package that
declares the same qualified name itself has real evidence and must win (D12).
-}
recordAliasShapes : Registry -> Dict String (Array String)
recordAliasShapes registry =
    Dict.foldl
        (\_ module_ collected ->
            Dict.foldl
                (\aliasName fields inner ->
                    Dict.set (module_.target ++ "." ++ aliasName) fields inner
                )
                collected
                module_.recordAliases
        )
        Dict.empty
        registry.modules


{-| The mapped package that states `moduleName` has no Gren counterpart.

Answers "the import is unmappable, and here is who says so", which no other
lookup can: a mapped package is never transpiled, so its module set is a fact
about the mapping and is held only in the mapping file.
-}
absentModuleFor :
    String
    -> Registry
    -> Maybe { elmPackage : String, grenPackage : String, reason : String }
absentModuleFor moduleName registry =
    packagesInOrder registry
        |> Array.mapAndKeepJust
            (\mapping ->
                Dict.get moduleName (mappingAbsentModules mapping)
                    |> Maybe.map
                        (\reason ->
                            { elmPackage = mappingElmPackage mapping
                            , grenPackage = mappingGrenPackage mapping
                            , reason = reason
                            }
                        )
            )
        |> Array.first


packagesInOrder : Registry -> Array PackageMapping
packagesInOrder registry =
    Array.mapAndKeepJust
        (\packageName -> Dict.get packageName registry.packages)
        registry.packageOrder


inferPlatformFromDependencyDicts : Registry -> Dict String a -> Dict String b -> Array Platform -> Result PlatformInferenceError Platform
inferPlatformFromDependencyDicts registry dependencies testDependencies inheritedPlatforms =
    inferPlatform
        registry
        (Array.append (Dict.keys dependencies) (Dict.keys testDependencies))
        inheritedPlatforms


inferPlatform : Registry -> Array String -> Array Platform -> Result PlatformInferenceError Platform
inferPlatform registry dependencyNames inheritedPlatforms =
    let
        inheritedEvidence =
            inheritedPlatforms
                |> Array.indexedMap
                    (\index platform ->
                        { platform = platform
                        , source = "inherited[" ++ String.fromInt index ++ "]:" ++ platformName platform
                        }
                    )

        mappedEvidence =
            dependencyNames
                |> uniqueSorted
                |> Array.mapAndKeepJust
                    (\dependencyName ->
                        mappingFor dependencyName registry
                            |> Maybe.andThen
                                (\mapping ->
                                    mappingPlatform mapping
                                        |> Maybe.map
                                            (\platform ->
                                                { platform = platform
                                                , source = dependencyName
                                                }
                                            )
                                )
                    )

        evidence =
            Array.append inheritedEvidence mappedEvidence

        browserSources =
            sourcesFor Browser evidence

        nodeSources =
            sourcesFor Node evidence
    in
    if not (Array.isEmpty browserSources) && not (Array.isEmpty nodeSources) then
        Err
            (BrowserAndNode
                { browserSources = browserSources
                , nodeSources = nodeSources
                }
            )

    else if not (Array.isEmpty browserSources) then
        Ok Browser

    else if not (Array.isEmpty nodeSources) then
        Ok Node

    else
        Ok Common


sourcesFor platform evidence =
    evidence
        |> Array.keepIf (\item -> item.platform == platform)
        |> Array.map .source
        |> uniqueSorted


uniqueSorted : Array String -> Array String
uniqueSorted values =
    values
        |> Array.foldl (\value seen -> Dict.set value True seen) Dict.empty
        |> Dict.keys
