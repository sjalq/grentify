module Transform.Lexical exposing
    ( TransformResult
    , collectLexicalEdits
    , ruleName
    , transform
    )

{-| Syntax-aware finalization of the Elm constructs that differ lexically in
Gren. Only executable code is scanned; comments, strings, character literals,
multiline strings, and GLSL blocks are opaque.
-}

import Array exposing (Array)
import String
import System.Text
import Transform.Scan as Scan exposing
    ( blockCommentStart
    , glslStart
    , isIdentifierStart
    , lineCommentStart
    , matchesAt
    , multilineQuote
    , scanIdentifierEnd
    , skipBlockComment
    , skipGlsl
    , skipLineComment
    , skipMultilineString
    , skipQuoted
    )
import Transform.SourceEdit as SourceEdit exposing (EditKind(..), SourceEdit, SourceError)


type alias TransformResult =
    { source : String
    , edits : Array SourceEdit
    }


type alias OffsetEdit =
    { startOffset : Int
    , endOffset : Int
    , replacement : String
    , kind : EditKind
    }


ruleName : String
ruleName =
    "elm-to-gren/lexical"


collectLexicalEdits : String -> Result SourceError (Array SourceEdit)
collectLexicalEdits source =
    let
        sourceIndex =
            SourceEdit.buildIndex source
    in
    scan source
        |> Array.foldl
            (\offsetEdit collected ->
                collected
                    |> Result.andThen
                        (\edits ->
                            toSourceEdit sourceIndex offsetEdit
                                |> Result.map (\edit -> Array.pushLast edit edits)
                        )
            )
            (Ok [])


transform : String -> Result SourceError TransformResult
transform source =
    collectLexicalEdits source
        |> Result.andThen
            (\edits ->
                SourceEdit.applyEdits source edits
                    |> Result.map
                        (\transformed ->
                            { source = transformed
                            , edits = edits
                            }
                        )
            )


scan : String -> Array OffsetEdit
scan source =
    scanFrom (System.Text.sourceCharacters source) 0 []


scanFrom : Array Char -> Int -> Array OffsetEdit -> Array OffsetEdit
scanFrom characters offset edits =
    when Array.get offset characters is
        Nothing ->
            edits

        Just character ->
            if matchesAt characters offset lineCommentStart then
                let
                    next =
                        skipLineComment characters (offset + 2)
                in
                scanFrom characters next edits

            else if matchesAt characters offset blockCommentStart then
                -- Module docs (`{-|`) list names in `@docs when`. Code renames
                -- reserved `when`/`is` identifiers to `when_`/`is_`; keep docs
                -- in sync so gren docs does not fail on orphan @docs lines.
                let
                    commentEnd =
                        skipBlockComment characters (offset + 2) 1

                    nextEdits =
                        scanReservedDocsEscapesInRange characters (offset + 2) commentEnd edits
                in
                scanFrom characters commentEnd nextEdits

            else if matchesAt characters offset glslStart then
                let
                    next =
                        skipGlsl characters (offset + 6)
                in
                scanFrom characters next edits

            else if matchesAt characters offset multilineQuote then
                -- Gren requires the contents of a multiline string to start on a
                -- new line after the opening """. Elm allows `"""html, body {`.
                let
                    contentStart =
                        offset + 3

                    stringEnd =
                        skipMultilineString characters contentStart

                    needsLeadingNewline =
                        when Array.get contentStart characters is
                            Just '\n' ->
                                False

                            Just '\r' ->
                                False

                            Nothing ->
                                False

                            Just _ ->
                                True

                    nextEdits =
                        if needsLeadingNewline then
                            Array.pushLast
                                { startOffset = contentStart
                                , endOffset = contentStart
                                , replacement = "\n"
                                , kind = CustomEdit "multiline-string-newline"
                                }
                                edits

                        else
                            edits
                in
                scanFrom characters stringEnd nextEdits

            else if character == '"' then
                let
                    next =
                        skipQuoted characters '"' (offset + 1)
                in
                scanFrom characters next edits

            else if character == '\'' then
                let
                    next =
                        skipQuoted characters '\'' (offset + 1)
                in
                scanFrom characters next edits

            else if matchesAt characters offset unitToken then
                let
                    -- Bound first: Gren only eliminates direct self tail calls.
                    nextEdits =
                        Array.pushLast
                            { startOffset = offset
                            , endOffset = offset + 2
                            , replacement = "{}"
                            , kind = UnitEdit
                            }
                            edits
                in
                scanFrom characters (offset + 2) nextEdits

            else if isIdentifierStart character then
                let
                    tokenEnd =
                        scanIdentifierEnd characters (offset + 1)

                    nextEdits =
                        if tokenEnd == offset + 4 && matchesAt characters offset caseKeyword then
                            Array.pushLast
                                { startOffset = offset
                                , endOffset = tokenEnd
                                , replacement = "when"
                                , kind = SyntaxEdit
                                }
                                edits

                        else if tokenEnd == offset + 2 && matchesAt characters offset ofKeyword then
                            Array.pushLast
                                { startOffset = offset
                                , endOffset = tokenEnd
                                , replacement = "is"
                                , kind = SyntaxEdit
                                }
                                edits

                        else
                            -- Do not rename identifiers that merely start with
                            -- "as" (aside, assertive, assoc). Current Gren and
                            -- gren-format accept those; rewriting them breaks
                            -- Html.aside and similar public APIs.
                            edits
                in
                scanFrom characters tokenEnd nextEdits

            else
                scanFrom characters (offset + 1) edits


{-| True for bare Gren-keyword identifiers that the review rule renames with a
trailing underscore in code (`when` → `when_`, `is` → `is_`).
-}
isReservedDocsIdentifier : String -> Bool
isReservedDocsIdentifier token =
    token == "when" || token == "is"


{-| Rewrite reserved identifiers only on `@docs` lines so prose is untouched.
Tracks whether the current line (since last newline) has seen `@docs`.
-}
scanReservedDocsEscapesInRange : Array Char -> Int -> Int -> Array OffsetEdit -> Array OffsetEdit
scanReservedDocsEscapesInRange characters offset end edits =
    scanReservedDocsEscapesFrom characters offset end False edits


scanReservedDocsEscapesFrom : Array Char -> Int -> Int -> Bool -> Array OffsetEdit -> Array OffsetEdit
scanReservedDocsEscapesFrom characters offset end onDocsLine edits =
    if offset >= end then
        edits

    else
        when Array.get offset characters is
            Nothing ->
                edits

            Just character ->
                if character == '\n' || character == '\r' then
                    scanReservedDocsEscapesFrom characters (offset + 1) end False edits

                else if character == '"' then
                    scanReservedDocsEscapesFrom characters (min end (skipQuoted characters '"' (offset + 1))) end onDocsLine edits

                else if character == '\'' then
                    scanReservedDocsEscapesFrom characters (min end (skipQuoted characters '\'' (offset + 1))) end onDocsLine edits

                else if matchesAt characters offset docsTag then
                    scanReservedDocsEscapesFrom characters (offset + 5) end True edits

                else if onDocsLine && isIdentifierStart character then
                    let
                        tokenEnd =
                            min end (scanIdentifierEnd characters (offset + 1))

                        token =
                            Array.slice offset tokenEnd characters
                                |> Array.foldl (\c text -> text ++ String.fromChar c) ""

                        nextEdits =
                            if isReservedDocsIdentifier token then
                                Array.pushLast
                                    { startOffset = offset
                                    , endOffset = tokenEnd
                                    , replacement = token ++ "_"
                                    , kind = SyntaxEdit
                                    }
                                    edits

                            else
                                edits
                    in
                    scanReservedDocsEscapesFrom characters tokenEnd end onDocsLine nextEdits

                else
                    scanReservedDocsEscapesFrom characters (offset + 1) end onDocsLine edits


docsTag : Array Char
docsTag =
    [ '@', 'd', 'o', 'c', 's' ]


unitToken : Array Char
unitToken =
    [ '(', ')' ]


caseKeyword : Array Char
caseKeyword =
    [ 'c', 'a', 's', 'e' ]


ofKeyword : Array Char
ofKeyword =
    [ 'o', 'f' ]


toSourceEdit : SourceEdit.SourceIndex -> OffsetEdit -> Result SourceError SourceEdit
toSourceEdit sourceIndex offsetEdit =
    Result.map2
        (\start end ->
            { range =
                { start = start
                , end = end
                }
            , replacement = offsetEdit.replacement
            , kind = offsetEdit.kind
            , rule = ruleName
            }
        )
        (SourceEdit.offsetToPositionIn sourceIndex offsetEdit.startOffset)
        (SourceEdit.offsetToPositionIn sourceIndex offsetEdit.endOffset)


